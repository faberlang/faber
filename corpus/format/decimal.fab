# =============================================================================
# ¶ on d64 — exact decimal display (DECISIONS D2.6, fork F4)
# =============================================================================
#
# What this teaches:
#   • `value ¶ "spec"` takes a `d64` like any number: fill, align, sign, `0`,
#     width and `.N` precision.
#   • A spec prints exactly what it says: `.2` always shows two fraction
#     digits (`12.5 ¶ ".2"` is `12.50`).
#   • `.N` rounds the exact decimal digits half-even: a tie goes to the even
#     neighbour (`0.25 ¶ ".1"` is `0.2`, `0.35 ¶ ".1"` is `0.4`).
#   • An expression is formatted exactly before it is stored: `1.5 * 2.25` is
#     exactly 3.375, so `.2` gives `3.38`.
#   • Plain display keeps the shortest form: `12.5` stays `12.5`.
#   • The `e` kind is exact scientific built from the same decimal digits, not
#     from a binary approximation: `1234.5 ¶ "e"` is `1.2345e3`, zero is
#     `0e0`, a negative keeps its sign (`-12.5 ¶ "e"` is `-1.25e1`) and the
#     smallest unit is `1e-8` (`0.00000001 ¶ "e"`). With `.N` the coefficient
#     keeps N digits and rounds half-even (`1234.5 ¶ ".3e"` is `1.234e3`).
#
# Common mistakes:
#   • A radix kind on a decimal (`p ¶ "x"`) — a compile error, so `¶` itself
#     never fails. Scientific is the `e` kind, not a radix.
#
# See also: scriptum, textus
# =============================================================================

main {
    let d64 p ← 12.5
    let d64 t ← 0.25
    let d64 u ← 0.35
    let d64 a ← 1.5
    let d64 b ← 2.25

    print p ¶ ".2"
    print t ¶ ".1"
    print u ¶ ".1"
    print a * b ¶ ".2"
    print p ¶ ">8"

    let d64 q ← 1234.5
    let d64 z ← 0.0
    let d64 n ← -12.5
    let d64 m ← 0.00000001

    print q ¶ "e"
    print q ¶ ".3e"
    print z ¶ "e"
    print n ¶ "e"
    print m ¶ "e"
}
