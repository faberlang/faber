+++
term = "¶"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "incipit_stmt", "block_stmt", "fixum_decl", "figendum_decl", "scriptum_expr", "call_expr", "call_suffix", "argument_list", "argument", "expression", "literal", "nota_stmt"]
category = "format"
summary = "The format spec must be a string literal; a computed spec is a parse error."
syntax = "<value> ¶ <identifier>"
aliases = ["format"]
