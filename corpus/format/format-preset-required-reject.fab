# =============================================================================
# ¶ — an instant takes a named preset, not a layout
# =============================================================================
#
# What this teaches:
#   • Instants format through the named presets `iso`, `date`, and `time` only.
#   • A numeric layout spec — here `"10"` — has no meaning for an instant, so
#     the program is refused at check time rather than at run time.
#
# Common mistakes:
#   • writing a width/precision layout for an instant instead of a preset (SEM011)
#
# See also: scriptum, textus, instans
# =============================================================================

fn formo(instant t) → string {
    return t ¶ "10"
}

# This exemplum intentionally fails to compile: `"10"` is a layout, not a preset.
main {
    do {
        let instant t ← "1979-05-27T07:32:00Z" ↦ instant
        print formo(t)
    }
    catch err {
        panic err
    }
}
