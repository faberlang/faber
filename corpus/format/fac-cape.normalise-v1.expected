functio fallax() → numerus ⇥ textus {
    varia numerus v
    fac {
        v ← 42
    }
    cape err {
        redde 0
    }
    redde v
}

functio tuta(numerus x) → numerus ⇥ textus {
    fac {
        si x ≺ 0 {
            iace finge negativa { causa = "negativa" }
        }
        redde x
    }
    cape err {
        redde 0 - 1
    }
}
