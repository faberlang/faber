# =============================================================================
# ¶ — format operator (DECISIONS D2.1–D2.5, D2.7)
# =============================================================================
#
# What this teaches:
#   • `value ¶ "spec"` renders a built-in value as `string`. `§` says where a
#     value goes; `¶` says how it is shown: `"Summa: §"(pretium ¶ ".2")`.
#   • One spec pattern for every type: [fill][align][sign][0][width][.precision][kind].
#   • Numbers: `.2` precision (integers pad too: 42 ¶ ".2" is 42.00); width
#     (numbers align right); `0` zero-pad; `<` `>` `^` align with an optional
#     fill before it; `+` always signs; kinds `x` `b` `o` `e`.
#   • Text: fill, align, width, and `.N` truncates to N characters.
#   • Instants: the named presets `iso`, `date`, `time` only.
#   • `¶` is looser than arithmetic and tighter than comparison:
#     `a + b ¶ ".2"` is `(a + b) ¶ ".2"`. It does not chain.
#
# Common mistakes:
#   • A computed spec (`x ¶ spec`) — the spec must be a string literal.
#   • A spec part the type does not take (`1.5 ¶ "x"`, `name ¶ "+5"`) — a
#     compile error, so `¶` itself never fails.
#   • Formatting your own types — `¶` covers built-in types; write a function.
#
# See also: scriptum, textus, instans
# =============================================================================

# A table row: formatted parameters line up in columns.
fn line(string heading, float value, int tally) → string {
    return "§|§|§"(heading ¶ "<8", value ¶ "8.2", tally ¶ "4")
}

# Numbers: precision, width, zero-pad, align, fill, sign.
fn numbers() {
    let float pretium ← 12.5
    print "Summa: §"(pretium ¶ ".2")
    let int n ← 42
    print n ¶ ".2"
    print "[§]"(n ¶ "5")
    print n ¶ "05"
    print "[§]"(n ¶ "<5")
    print n ¶ "*^7"
    print n ¶ "+"
    let int a ← 3
    let int b ← 4
    print a + b ¶ ".1"
}

# Kinds: hex, binary, octal, scientific; floats; unsigned widths.
fn kinds() {
    print 255 ¶ "x"
    print 255 ¶ "08x"
    print 5 ¶ "b"
    print 8 ¶ "o"
    let float amount ← 1234.5
    print amount ¶ "e"
    print amount ¶ ".2e"
    let float factor ← 1.23456
    print factor ¶ ".3"
    print -1.5 ¶ "08.2"
    print "[§]"(3.0 ¶ ">6")
    let u8 octo ← 200
    print octo ¶ "08b"
}

# Text: truncate to characters, width, fill.
fn strings() {
    let string nomen ← "Aurelia"
    print nomen ¶ ".3"
    print "[§]"(nomen ¶ "9")
    print nomen ¶ "*>10"
    print "[§]"(nomen ¶ "^11.3")
}

# Instants: named presets only.
fn instants() {
    # Both literals are valid instants, so the handler never runs.
    do {
        let instant t ← "1979-05-27T07:32:00Z" ↦ instant
        print t ¶ "iso"
        print t ¶ "date"
        print t ¶ "time"
        let instant<ms> stamp ← "1979-05-27T07:32:00.123Z" ↦ instant<ms>
        print stamp ¶ "iso"
    }
    catch err {
        panic err
    }
}

# Edges: sign plus digits in hex; NaN and infinities ignore precision.
fn edges() {
    print -42 ¶ "x"
    let float zero ← 0.0
    let float notnum ← nan
    let float endless ← 1.0 / zero
    print notnum ¶ ".2"
    print endless ¶ ".2"
    print -endless ¶ ""
    print "[§]"(endless ¶ "4")
}

main {
    numbers()
    kinds()
    strings()
    instants()
    edges()

    # --- parameters: one column layout for every row ---
    print line("alpha", 3.5, 7)
    print line("beta", 12.25, 42)
}
