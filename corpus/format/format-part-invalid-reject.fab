# =============================================================================
# ¶ — a spec part the subject does not take
# =============================================================================
#
# What this teaches:
#   • Parsing and validating are two steps: the spec text may match the
#     pattern and still name a part its subject has no use for.
#   • The radix kinds `x` `b` `o` belong to integers, so a float refuses them.
#   • `textus` takes fill, align, width and precision only — a sign (`+`) is
#     for numbers and is refused on text.
#
# Common mistakes:
#   • copying an integer spec onto a float — drop the kind, keep `".2"`.
#   • signing a text subject instead of formatting a number.
#
# See also: format, textus, instans
# =============================================================================

# format reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let float x ← 1.5
    print x ¶ "x"
    let string nomen ← "Aurelia"
    print nomen ¶ "+5"
}
