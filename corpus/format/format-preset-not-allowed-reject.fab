# =============================================================================
# ¶ — a named preset is for instants only
# =============================================================================
#
# What this teaches:
#   • The presets `iso`, `date`, and `time` render instants; numbers format
#     through a layout instead.
#   • Asking an int for the `"iso"` preset has no meaning, so the program is
#     refused at check time rather than at run time.
#
# Common mistakes:
#   • applying an instant preset to a number (SEM011)
#
# See also: scriptum, textus, instans
# =============================================================================

# This exemplum intentionally fails to compile: `"iso"` is a preset, not a layout.
main {
    let int n ← 7
    print n ¶ "iso"
}
