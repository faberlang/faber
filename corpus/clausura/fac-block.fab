# =============================================================================
# clausura — fac-block closure body
# =============================================================================
#
# What this teaches:
#   • Block body — after the `∴` joint the closure body may be a `do { }`
#     block instead of a single expression; statements (local bindings,
#     guards, `return`) live inside the block
#   • Return clause required for blocks — a block body that `return`s needs
#     `→ int`; the single-expression form may infer its type instead
#   • The la reader spelling — `fac { }` is the la surface of the same
#     block body (`do` in en)
#
# Common mistakes:
#   • using a block body without `→ <type>` — the block cannot infer a
#     return type from bare `return`
#   • confusing `∴` (closure body joint) with `ergo` (single-statement
#     body joint for si/dum/casu) — they are not interchangeable
#
# See also: clausura, fac, ∴
# =============================================================================

# clausura — fac-block body with a local binding
#
# GRAMMAR:
#   closureExpr :← params '→' type '∴' fac-block
#
# EXPECTED OUTPUT:
#   fac-block.expected — the doubled, shifted value.

main {
    let (int) → int f ← int x → int ∴ do {
        let int y ← x + 1
        return y * 2
    }
    print f(5)
}
