# =============================================================================
# clausura — writing a field of a captured value
# =============================================================================
#
# What this teaches:
#   • Field stores reach the captured binding — a closure writing
#     `c.n ← c.n + 1` mutates the value the enclosing frame holds, so the
#     caller sees the change after the closure returns
#   • The captured binding is shared, not copied — the closure holds the
#     enclosing `mut Counter c`, so repeated calls accumulate on one value
#   • `←` is the runtime store — a field write is an assignment to a place,
#     not a construction, so the field modifier (`mut`) is what allows it
#
# Common mistakes:
#   • expecting a snapshot — capturing the value is not copying it; read the
#     field into a `let` first if a snapshot is wanted
#   • declaring the field `let` — a `let` field cannot be stored to, and the
#     closure write is rejected
#   • writing `c.n = c.n + 1` — `=` is structural; a run-time field update
#     takes `←`
#
# See also: clausura, genus, ∴
# =============================================================================

# clausura — capture a genus value and write its field
#
# EXPECTED OUTPUT:
#   capture-field-write.expected — the two closure calls print 1 and 2, and the
#   last line proves the enclosing binding changed too.

class Counter {
    mut int n
}

main {
    mut Counter c ← Counter { n = 0 }
    let () → int bump ← () → int ∴ do {
        c.n ← c.n + 1
        return c.n
    }
    print bump()
    print bump()
    print c.n
}
