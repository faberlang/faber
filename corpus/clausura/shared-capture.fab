# =============================================================================
# clausura — shared capture (captured names are the enclosing bindings)
# =============================================================================
#
# What this teaches:
#   • By reference — an unmarked closure does not copy what it captures; a
#     captured name IS the enclosing binding, so a later outer write is
#     visible inside the closure
#   • Writes flow out — a closure that assigns a captured `mut` binding changes the
#     enclosing binding; an escaping closure (`counter`) keeps its own
#     binding alive
#   • Fresh loop bindings — `for … let i` binds a new `i` each iteration,
#     so closures made in a loop each see their own value
#
# Common mistakes:
#   • expecting a snapshot — capture is not a copy; read the value into a
#     `let` first if a snapshot is wanted
#
# See also: clausura, ∴
# =============================================================================

# clausura — shared capture
#
# EXPECTED OUTPUT:
#   shared-capture.expected

fn counter() → () → int {
    mut int c ← 0
    return () → int ∴ do {
        c ← c + 1
        return c
    }
}

fn adder(int k) → (int) → int {
    return int x → int ∴ x + k
}

main {
    # An outer write after capture is visible inside.
    mut int n ← 1
    let () → int peek ← () → int ∴ n
    n ← 5
    print peek()

    # A closure write is visible outside.
    let () → void bump ← () → void ∴ do { n ← n + 1 }
    bump()
    print n

    # Each escaping counter owns its binding.
    let () → int k ← counter()
    let () → int j ← counter()
    print k()
    print k()
    print j()

    # Loop bindings are fresh per iteration.
    mut list<() → int> fs ← empty
    for range 0‥3 let i {
        fs.append(() → int ∴ i * 10)
    }
    for from fs let f { print f() }

    # An escaping closure keeps its captured parameter.
    let (int) → int add5 ← adder(5)
    print add5(1)
}
