# =============================================================================
# clausura — closure with its own error channel
# =============================================================================
#
# What this teaches:
#   • Own channel — `⇥ string` after the return clause gives the closure its
#     own recoverable error channel; the body throws into it with `throw`
#   • Block bodies need the return clause — a `do { }` body with `return`
#     requires `→ int`; the single-expression `∴` form can infer instead
#   • Fail-closed call sites — invoking a failable closure outside a
#     `do { } catch { }` handler is rejected (failable_call_requires_handler)
#
# Common mistakes:
#   • calling the closure without a handler — the channel is part of the
#     closure type, so every call must be recoverable
#   • `throw` in expression position — `∴ throw …` is not an expression;
#     throw is a statement inside the `do { }` body
#
# See also: clausura, ⇥, fac, cape, iace
# =============================================================================

# clausura — error-channel declaration and both exit paths
#
# GRAMMAR:
#   closureExpr :← params '→' type '⇥' errorType '∴' do-block
#
# EXPECTED OUTPUT:
#   error-channel.expected — the thrown payload and the happy-path value.

main {
    let (int) → int ⇥ string guard ← int x → int ⇥ string ∴ do {
        if x ≻ 3 {
            throw "too big"
        }
        return x + 1
    }
    do {
        print guard(5)
    }
    catch err {
        print "caught: §"(err)
    }
    do {
        print guard(2)
    }
    catch err {
        print "caught: §"(err)
    }
}
