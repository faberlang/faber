# =============================================================================
# clausura — legacy lambda head
# =============================================================================
#
# What this teaches:
#   • Legacy head — `lambda int x: x * 2` opens the closure with the
#     `lambda` keyword and a colon before the body expression
#   • Bare parameter list — legacy params are comma-separated and
#     parenthesized forms (`lambda (int x)`) are not part of this head
#   • The la reader spelling — `clausura numerus x: x * 2` is the la twin
#     of the same head
#
# Common mistakes:
#   • reaching for the legacy head in new code — the compact `∴` form is
#     preferred; the legacy head is kept for reading older sources
#   • parenthesizing legacy params — only the compact signature takes `( )`
#
# See also: clausura, ∴
# =============================================================================

# clausura — legacy lambda head, single and multi-param
#
# GRAMMAR:
#   closureExpr :← 'lambda' params ':' expr
#
# EXPECTED OUTPUT:
#   legacy-head.expected — the doubled and summed values.

main {
    let a ← lambda int x: x * 2
    print a(5)
    let b ← lambda int x, int y: x + y
    print b(2, 3)
}
