# =============================================================================
# ∴ — A closure created in a method captures `self` and writes its fields; the caller sees the change.
# =============================================================================
#
# What this teaches:
#   • A closure written inside a method can use `self`: reading `self.n`
#     and storing `self.n ← …` reach the instance the method was called on
#   • The capture is shared, not copied: the method returns the closure,
#     and every call of it changes the one instance
#   • The caller reads the change straight from the instance
#
# Common mistakes:
#   • Expecting the closure to see a snapshot of the field: it holds the
#     instance, not the value
#   • Declaring the field `let`: a `let` field cannot be stored to, even
#     from a closure
#
# See also: capture-field-write, shared-capture, clausura
# =============================================================================

class Counter {
    mut int n
    mut string log

    fn bumper(int step) → () → int {
        return () → int ∴ do {
            self.n ← self.n + step
            self.log ← self.log + "+"
            return self.n
        }
    }
}

main {
    mut Counter c ← Counter { n = 0, log = "" }
    let () → int by_two ← c.bumper(2)
    let () → int by_ten ← c.bumper(10)
    print by_two()
    print by_two()
    print by_ten()
    print c.n
    print c.log
}
