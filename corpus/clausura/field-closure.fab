# =============================================================================
# ∴ — A closure held in a class field is called through the field, and a field closure can capture an outer binding.
# =============================================================================
#
# What this teaches:
#   • A field may have a function type: `let (int) → int apply` holds a
#     closure, and `box.apply(3)` calls it
#   • The closure in the field keeps the outer binding it captured: it
#     reads `offset` as it is when the call runs
#   • A `mut` field can be given another closure, and the next call uses
#     the new one
#
# Common mistakes:
#   • Expecting the field call to pass the object as `self`: a closure in
#     a field is a plain function value
#   • Declaring a field closure with `=`: a closure is a run-time value,
#     so it is set in the construction literal
#
# See also: clausura, shared-capture, function-types
# =============================================================================

class Box {
    let (int) → int apply
    mut (int) → int fallback
}

main {
    mut int offset ← 10
    mut Box box ← Box {
        apply = int x → int ∴ x + offset,
        fallback = int x → int ∴ x * 2
    }
    print box.apply(3)
    offset ← 20
    print box.apply(3)
    print box.fallback(4)
    box.fallback ← int x → int ∴ x - 1
    print box.fallback(4)
}
