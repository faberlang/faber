# =============================================================================
# bf16 — the bare `bf16` type-position width marker
# =============================================================================
#
# What this teaches:
#   • the bare `bf16` type-position width marker.
#   • Related keywords: fractus, matrix
#
# Common mistakes:
#   • Using `bf16` / `f16` / `f32` / `f64` with `numerus` — float widths belong to `fractus`; write the bare marker, never the wrapped `numerus<...>` form.
#
# See also: fractus, matrix
# =============================================================================

# bf16 — half-width float marker
#
# bf16 x
#
# GRAMMAR:
#   type :← 'bf16'
#
# EXPECTED OUTPUT:
#   none; this is a semantic/MIR systems-lane typecheck example.
#
# BACKEND:
#   TS uses the reference number carrier in e2e. Rust fails closed with
#   `rust_target_fractus_bf16_unsupported`; Go/Swift and LLVM/Wasm/WGSL/Metal
#   stay fail-closed until a real bf16 carrier exists. Sexp can carry this
#   identity-style example but is not a half runtime authority.

fn keep_bf16(bf16 x) → bf16 {
    return x
}

fn keep_bf16_long(bf16 x) → bf16 {
    return x
}
