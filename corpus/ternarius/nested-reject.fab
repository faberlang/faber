+++
term = "✓"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "hole_type", "type_annotation", "owned_type", "base_type", "qualified_type", "ternary", "comparison", "equality", "equality_tail", "cast_expr", "assignment", "place", "call_expr", "call_suffix", "argument_list", "argument", "expression", "literal", "nota_stmt", "functio_decl", "param_list", "parameter", "return_clause", "si_stmt", "secus_clause", "redde_stmt", "unary_expr"]
category = "branch"
canonical = false
summary = "A value conditional cannot be nested; the `✓` conditional has one level only."
syntax = "c ✓ a ✗ d ✓ b ✗ e — rejected"
related = ["si", "sin", "discerne"]
locale = "en"
no_expected = "rejects"
diagnostic = "PARSE030:conditional_nested"
+++
# =============================================================================
# ✓ ✗ — nested value conditionals are refused
#
# Use a function or an `if` ladder when a value conditional needs more cases.
# =============================================================================

fn sign(int n) → int {
    return n ≺ 0 ✓ -1 ✗ n ≡ 0 ✓ 0 ✗ 1
}

main {
    print sign(-4)
}
