# =============================================================================
# sic — Ternary conditional expressions with sic and secus.
# =============================================================================
#
# What this teaches:
#   • Ternary expressions — `sic`/`secus` as Latin-inspired conditional syntax
#   • Nesting — `sic`/`secus` chains read more clearly than nested if-else
#
# Common mistakes:
#   • confusing ternarius (sic/secus ternary) with si/ergo (statement conditional) — ternarius is an expression, si is a statement
#
# See also: sic, secus, si
# =============================================================================




# sic — ternary conditional expressions (sic/secus)
#
# <conditio> sic <tunc> secus <aliter>
#
# GRAMMAR:
#   ternaryExpr :← expr 'sic' expr 'secus' expr
#
# EXPECTED OUTPUT:
#   ternarius.expected — nested and flat ternary results.

main {
    const int aetas ← 25

    # Latin ternary
    const string gradusaetatis ← aetas ≥ 18 yields "adultus" else "minor"
    # "adultus"
    print gradusaetatis

    # Latin nested (reads more clearly)
    const int puncta ← 85
    const string gradus ← puncta ≥ 90 yields "A" else puncta ≥ 80 yields "B" else puncta ≥ 70 yields "C" else "F"
    # "B"
    print gradus

    # In expressions
    const int maximum ← aetas ≻ 30 yields aetas else 30
    print "maximum: §"(maximum)

    # With nullish values
    var string ∪ null forsitan ← null ∷ string ∪ null
    const string solutum ← forsitan not is null yields forsitan else "defectum"
    # "defectum"
    print solutum

    # Prefer sic/secus for clarity
    const string licentia ← aetas ≥ 21 yields "licet bibere" else "bibere non licet"
    print licentia
}
