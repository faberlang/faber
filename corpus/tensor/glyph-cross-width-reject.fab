# =============================================================================
# × — cross width must be 3 on both sides.
# =============================================================================
#
# What this teaches:
#   • `×` is the cross product of 3-space, so both operands carry width 3.
#   • A width-4 operand has no cross product: the glyph is refused by name
#     rather than falling back to an outer or elementwise product.
#
# See also: tensor, ×, glyph-cross
# =============================================================================

# × with a width-4 operand: cross is width-3 on both sides.
main {
    let vf32[3] a ← [1.0, 0.0, 0.0] ↦ vf32[3]
    let vf32[4] b ← [0.0, 1.0, 0.0, 0.0] ↦ vf32[4]
    let vf32[4] c ← a × b
    print c
}
