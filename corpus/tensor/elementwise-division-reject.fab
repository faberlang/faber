# =============================================================================
# tensor — `/` between two aggregates names neither division.
# =============================================================================
#
# What this teaches:
#   • Elementwise division has two spellings, and they differ on integers:
#     `⊘` floors, `÷` is true division.
#   • `/` between two aggregates picks neither, so it is refused by name and
#     the source must say which rounding it wants.
#   • `/` stays scalar: dividing a tensor by a number.
#
# See also: tensor, ⊘, ÷, glyph-elementwise
# =============================================================================

# `/` over two [2] tensors: the elementwise glyph is ⊘ or ÷.
main {
    let tf32[2] a ← [4.0, 9.0] ↦ tf32[2]
    let tf32[2] b ← [2.0, 3.0] ↦ tf32[2]
    let tf32[2] q ← a / b
    print q.flatten()
}
