+++
term = "tensor view"
kind = "type"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "width_type_sugar", "shape_suffix", "figura", "figura_list", "array_literal", "call_expr", "call_suffix", "argument_list", "argument", "member_suffix", "expression", "literal", "nota_stmt"]
category = "collection"
canonical = false
summary = "Borrowed tensor views end at their last use; materialized tensors own independent storage."
related = ["tensor", "materialize"]
locale = "en"
+++

main {
    mut tf32[2, 2] base ← [[1.0, 2.0], [3.0, 4.0]] ↦ tf32[2, 2]
    let tf32[1, 2] view ← base.slice(0, 1)
    let tf32[1, 2] owned ← view.materialize()
    print view.flatten()
    # The borrowed view has no later use, so the base can be mutated.
    base.set([0, 0], 9.0)
    print owned.flatten()
    print base.flatten()
}
