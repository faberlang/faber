interface EdgePolicy<C> {
    fn remap(C coord) → C
}

interface EdgeTransform<C, T> {
    fn transform(C coord, T value) → T
}

class ZeroGhost implements EdgePolicy<vector<int, size 1>> ∩ EdgeTransform<vector<int, size 1>, f32> {
    fn remap(vector<int, size 1> coord) → vector<int, size 1> {
        return [0] ↦ vector<int, size 1>
    }
    fn transform(vector<int, size 1> coord, f32 value) → f32 {
        return -value
    }
}

fn resolve_shift<P>(tf32[3] source) → tf32[3] {
    return source.shift([1]).edge<P>().materialize()
}

main {
    let tf32[3] source ← [1.0, 2.0, 3.0] ↦ tf32[3]
    let tf32[3] generic_clamp ← resolve_shift<clamp>(source)
    let tf32[3] generic_custom ← resolve_shift<ZeroGhost>(source)
    print generic_clamp.flatten()
    print generic_custom.flatten()
}
