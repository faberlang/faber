# =============================================================================
# ᵀ — rank-2 postfix transpose.
# =============================================================================
#
# What this teaches:
#   • `ᵀ` is postfix sugar for the existing `transpone` intrinsic and
#     TensorTranspose plan, not a new runtime operation.
#   • v1 admits rank-2 tensors only: `[M,N] → [N,M]`.
#   • Rank-1 has no row/column distinction and rank-3+ waits for a batched
#     transpose consumer; both are named semantic declines.
#
# Precedence is settled: `a · bᵀ ∇ [x]` parses `(a · bᵀ) ∇ [x]`; the transpose
# suffix binds inside the selected multiplicative value, while ∇ remains
# parse-only.
#
# EXPECTED stdout:
#   [[1.0, 3.0], [2.0, 4.0]]
#
# See also: tensor, matmul, ᵀ
# =============================================================================

fn transpose_demo(tensor<f32, [2, 2]> input) → tensor<f32, [2, 2]> {
    return inputᵀ.materialize()
}

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    mut tf32[2, 2] input ← flat ↦ tf32[2, 2]
    mut tf32[2, 2] output ← transpose_demo(input)
    print output.get([0, 0])
    print output.get([0, 1])
    print output.get([1, 0])
    print output.get([1, 1])
}
