# =============================================================================
# tensor — bound fill (reple) materializes fresh, source stays immutable.
# =============================================================================
#
# What this teaches:
#   • The bound form `filled ← t.reple(v)` yields a NEW tensor of the
#     receiver's shape, filled with `v`.
#   • The receiver keeps its original values — the bound form never aliases
#     or overwrites its source.
#   • The statement form `t.reple(v);` is the opposite posture: the
#     documented in-place mutation (this file statement-forms nothing).
#
# Common mistakes:
#   • expecting the bound form to mutate `t` — rebind with `t ← t.reple(v)`
#     when in-place update is wanted, or use the statement form.
#
# See also: tensor, lista
# =============================================================================

# WHY: pins the fill aliasing law across lanes. The MIR runner always built
# the bound result fresh; the Rust emit lane once repl-ed a clone of the
# receiver — a clone that shared the flat storage, so `t` was overwritten.
# The `t` line below is the parity pin.

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    let tf32[2, 2] t ← flat ↦ tf32[2, 2]

    let tf32[2, 2] filled ← t.fill(0.0)

    let list<f32> source ← t.flatten()
    let list<f32> got ← filled.flatten()
    print source
    print got
}
