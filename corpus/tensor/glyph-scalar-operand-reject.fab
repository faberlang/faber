# =============================================================================
# ⊙ — a scalar operand is a named decline.
# =============================================================================
#
# What this teaches:
#   • `⊙` and `⊘` are elementwise operators over two shaped operands of the
#     same shape; a scalar has no shape, so the pair is refused by name.
#   • Scaling by a scalar keeps its own spelling: `*` and `/` on a tensor.
#
# See also: tensor, ⊙, ⊘, glyph-elementwise
# =============================================================================

# ⊙ with a scalar right operand: shaped-by-scalar is a named decline.
main {
    let list<f32> l ← [1.0, 2.0]
    let tf32[2] a ← l ↦ tf32[2]
    let tf32[2] scaled ← a ⊙ 2.0
    print scaled.flatten()
}
