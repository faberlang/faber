# =============================================================================
# tensor — Built-in math functions lifted elementwise over a tensor.
# =============================================================================
#
# What this teaches:
#   • Lifted math — `abs`, `sqrt`, `exp`, `ln`, `log10`, `sin`, `cos`, `tan` apply to each element and keep the shape
#   • Per-element scalar meaning — a domain miss is NaN and an overflow is infinity, as for the scalar function
#   • Typing — the float functions take float elements; `abs` also takes integers and gives the unsigned twin
#
# Common mistakes:
#   • calling your own scalar function on a tensor — user functions are not lifted; loop per element instead
#   • calling `sqrt` on an integer tensor — convert the elements to a float tensor first
#
# See also: tensor, fractus, lista
# =============================================================================



# tensor — lifted math functions
#
# WHY: rule 15 lifts the built-in math functions over a tensor. Each element is
# the scalar function of the same name, so `sqrt` of a negative element is NaN
# and the shape never changes.
#
# EXPECTED stdout:
#   [2.0, 3.0, 4.0, 1.0]
#   [1.0, 2.0, 3.0, 4.0]
#   [1.0, 1.0]
#   [0.0, 0.0]
#   [2.0, 3.0]
#   [0.0, 0.0]
#   [1.0, 1.0]
#   [1.0, NaN]
#   [3, 0, 5]
#   [3]

incipit {
    sit lista<f32> squares ← [4.0, 9.0, 16.0, 1.0]
    sit tensor<f32, [2, 2]> grid ← squares ↦ tensor<f32, [2, 2]>
    nota grid.radix().planata()
    sit lista<f32> signed ← [-1.0, 2.0, -3.0, 4.0]
    sit tensor<f32, [4]> mixed ← signed ↦ tensor<f32, [4]>
    nota mixed.absolutum().planata()
    sit lista<f32> zeros ← [0.0, 0.0]
    sit tensor<f32, [2]> origin ← zeros ↦ tensor<f32, [2]>
    nota origin.exponentia().planata()
    nota origin.sinus().planata()
    sit lista<f32> decades ← [100.0, 1000.0]
    sit tensor<f32, [2]> powers ← decades ↦ tensor<f32, [2]>
    nota powers.logarithmus_decimalis().planata()
    sit lista<f32> units ← [1.0, 1.0]
    sit tensor<f32, [2]> ones ← units ↦ tensor<f32, [2]>
    nota ones.logarithmus().planata()
    nota origin.cosinus().planata()
    sit lista<f32> edge ← [1.0, -1.0]
    sit tensor<f32, [2]> domain ← edge ↦ tensor<f32, [2]>
    nota domain.radix().planata()
    sit lista<i32> counts ← [-3, 0, 5]
    sit tensor<i32, [3]> whole ← counts ↦ tensor<i32, [3]>
    nota whole.absolutum().planata()
    nota whole.absolutum().magnitudines()
}
