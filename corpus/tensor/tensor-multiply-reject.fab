# =============================================================================
# tensor — `*` is a scalar operator, not a tensor product.
# =============================================================================
#
# What this teaches:
#   • `*` between two tensors is a named decline, not a silent elementwise
#     multiply: the shape-pairing rule belongs to an explicit glyph.
#   • `⊙` is that glyph (elementwise), and `·` is the matrix product.
#   • `*` and `/` stay in their scalar role: scaling a tensor by a scalar.
#
# See also: tensor, ⊙, glyph-elementwise
# =============================================================================

# `*` over two [2] tensors: the elementwise glyph is ⊙.
main {
    let ti32[2] a ← [1, 2] ↦ ti32[2]
    let ti32[2] b ← a * a
    print b.flatten()
}
