# =============================================================================
# itera-ex-rank1 — Value iteration over rank-1 literal-shaped tensors.
# =============================================================================
#
# What this teaches:
#   • `itera ex` over a `tensor<T, [N]>` visits every lane in 0‥N — the bound
#     is the literal shape, not a runtime length call
#   • the binding is the element type T, gathered by index projection
#
# Common mistakes:
#   • iterating rank > 1 tensors — higher ranks defer to coordinate iteration
#   • expecting a runtime `len` — the literal shape is the loop bound
#
# See also: tensor, ex, itera
# =============================================================================

# itera ex over tensor<float, [4]> — element binding is f32
#
# EXPECTED stdout:
#   1.0
#   2.0
#   3.0
#   4.0
#   10.0

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    mut tf32[4] t ← flat ↦ tf32[4]

    mut f32 total ← 0.0
    for from t let x {
        print x
        total ← total + x
    }

    print total
}
