# =============================================================================
# tensor — Tensor method policy parity for accipe, out-of-bounds reads, and ponde.
# =============================================================================
#
# What this teaches:
#   • Bounds checking — `accipe` returns `∪ nihil` for out-of-bounds indices
#   • Mutation — `ponde` updates in-place at the given index
#
# Common mistakes:
#   • assuming out-of-bounds access throws an error rather than returning nihil — accipe returns T ∪ nihil
#
# See also: tensor, accipe, ponde, lista
# =============================================================================




# tensor — method policy parity
#
# EXPECTED stdout:
#   2.0
#   99.0
#   8.0

main {
    const tf32[] seed ← empty
    var tf32[3] input ← seed.from_flat([1.0, 2.0, 3.0], [3])

    const f32 in_bounds ← input.get([1]) coalesce 0.0
    const f32 out_of_bounds ← input.get([9]) coalesce 99.0

    input.set([2], 8.0)
    const f32 updated ← input.get([2]) coalesce 0.0

    print in_bounds
    print out_of_bounds
    print updated
}
