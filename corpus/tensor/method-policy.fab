# =============================================================================
# tensor — Tensor method policy for static literal rejection and checked reads.
# =============================================================================
#
# What this teaches:
#   • Literal bounds — a literal index outside an exact shape is a check error
#   • Dynamic bounds — an in-bounds dynamic read is handler-free; an out-of-bounds
#     dynamic read is a hard program error, never a recoverable `⇥` result
#   • Mutation — `ponde` updates in-place at the given index
#
# The following are deliberate CHECK errors and stay commented so this positive
# fixture retains an executable stdout oracle:
#   input.get([9])   → index 9 is provably out of bounds for static bound 3
#   input[-1]        → index -1 is provably out of bounds for static bound 3
#   input[[3]]       → the same literal-only rejection through bracket sugar
#
# See also: tensor, accipe, ponde, lista
# =============================================================================




# tensor — method policy parity
#
# EXPECTED stdout:
#   2.0
#   2.0
#   8.0

main {
    mut tf32[3] input ← [1.0, 2.0, 3.0] ↦ tf32[3]

    let f32 in_bounds ← input.get([1])
    let int dynamic_index ← 1
    let f32 dynamic_in_bounds ← input.get([dynamic_index]) ⊥ 0.0

    input.set([2], 8.0)
    let f32 updated ← input.get([2])

    print in_bounds
    print dynamic_in_bounds
    print updated
}
