# =============================================================================
# tensor — Tensor bracket read yields T or traps; bracket write lowers to ponde.
# =============================================================================
#
# What this teaches:
#   • Bracket sugar — `tensor[index]` and `tensor[index] ← value` as syntactic sugar
#   • Trapping reads — a bracket read is `T` (like a list index); a bad computed index traps, a literal bad index is a compile error
#
# Common mistakes:
#   • writing `vel` after a bracket read — it is never none; use the `get` method form for a nullable read
#
# See also: tensor, accipe, ponde, lista
# =============================================================================




# tensor — bracket access sugar for accipe / ponde
#
# Rank-1 tensors accept scalar integer indices. Rank-N tensors use a list-shaped
# bracket expression such as `[[r, c]]` or a bound `lista<integer>` value.
# A bracket read returns `T` and traps on a bad index, like a list index. The
# `get` method form is the nullable read and takes `vel` before arithmetic.
#
# EXPECTED stdout:
#   3.0
#   3.0
#   4.0
#   4.0
#   4.0

main {
    mut tf32[4] input ← tf32[4] {}
    mut tf32[4] output ← tf32[4] {}

    let u32 index ← 1
    input[index] ← 3.0
    let f32 old ← input[index]
    let f32 oldMethod ← input.get([index]) ⊥ 0.0
    output[index] ← old + 1.0
    let f32 updated ← output[index]

    mut tf32[2, 2] grid ← tf32[2, 2] {}
    grid[[1, 0]] ← updated
    let f32 elementum ← grid[[1, 0]]
    let f32 elementumMethod ← grid.get([1, 0])

    print old
    print oldMethod
    print updated
    print elementum
    print elementumMethod
}
