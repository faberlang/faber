# =============================================================================
# tensor — Tensor elementwise arithmetic with addita, subtrahe, and multiplica.
# =============================================================================
#
# What this teaches:
#   • Canonical elementwise operators — `a + b` and `a - b`; `.added()`/`.subtract()` are non-preferred method twins where operators are legal
#   • Elementwise multiplication — `multiplica` applies per-element
#
# Common mistakes:
#   • mixing tensors of different shapes without explicit forma (reshape) or broadcast, or using elementwise ops on non-numeric tensors
#
# See also: tensor, fractus, lista
# =============================================================================



# tensor elementwise arithmetic — canonical + / -, plus multiplica
#
# WHY: tensor operators lower by radix into faber::Tensor<T> kernels. Same-shape
# add and subtract here; broadcast coverage lives in the radix typecheck tests
# and arithmetic-reduction exempla.
#
# EXPECTED stdout:
#   [1.0, 4.0, 9.0, 16.0]

main {
    const list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    const list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]
    const tf32[] seed ← empty

    var tf32[2, 2] a ← seed.from_flat(flat_a, [2, 2])
    var tf32[2, 2] b ← seed.from_flat(flat_b, [2, 2])

    const tf32[2, 2] sum ← a + b
    const tf32[2, 2] diff ← sum - b
    const tf32[2, 2] prod ← diff.multiply(a)

    const list<f32> out ← prod.flatten()
    print out
}
