# =============================================================================
# tensor — Tensor elementwise arithmetic with +, -, and ⊙.
# =============================================================================
#
# What this teaches:
#   • Elementwise addition and subtraction — `a + b` and `a - b`
#   • Elementwise multiplication — `⊙` applies per-element
#
# Common mistakes:
#   • mixing tensors of different shapes without explicit forma (reshape) or broadcast, or using elementwise ops on non-numeric tensors
#
# See also: tensor, fractus, lista
# =============================================================================



# tensor elementwise arithmetic — canonical + / - / ⊙
#
# WHY: tensor operators lower by radix into faber::Tensor<T> kernels. Same-shape
# add and subtract here; broadcast coverage lives in the radix typecheck tests
# and arithmetic-reduction exempla.
#
# EXPECTED stdout:
#   [1.0, 4.0, 9.0, 16.0]

main {
    let list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    let list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]

    mut tf32[2, 2] a ← flat_a ↦ tf32[2, 2]
    mut tf32[2, 2] b ← flat_b ↦ tf32[2, 2]

    let tf32[2, 2] sum ← a + b
    let tf32[2, 2] diff ← sum - b
    let tf32[2, 2] prod ← diff ⊙ a

    let list<f32> out ← prod.flatten()
    print out
}
