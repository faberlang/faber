category = "collection"
canonical = false
summary = "Expanded views pin element values in both shape-hole positions, where shape-holes.fab prints only shapes."
related = ["tensor", "magnitudo"]
locale = "en"
+++

# The flatten hides the axis layout, so both hole positions print the same
# values: `expanded([_, 2])` repeats each element down the new axis and
# `expanded([2, _])` repeats it across, where shape-holes.fab prints only shapes.
main {
    let list<f32> l ← [1.0, 2.0]
    let tf32[2] v ← l ↦ tf32[2]
    let tf32[2, 2] e ← v.expanded([_, 2]).materialize()
    print e.flatten()
    let tf32[2, 2] f ← v.expanded([2, _]).materialize()
    print f.flatten()
}
