# Both functions deliberately omit materialize() at an ownership boundary.
fn escape(ref tf32[2, 2] base) → tf32[2, 2] {
    return base.transpose()
}

fn mutable_view(ref tf32[2, 2] base) → void {
    mut tf32[1, 2] view ← base.slice(0, 1)
}

main {}
