# =============================================================================
# store rule — Q-X3: the assignment half of the store rule. The declaration twin
# is `store-rule-narrow-trap.fab`; here the store that aborts is an assignment
# into an already-declared tensor.
#
# `a + a` over `ti8` is a `ti16` intermediate typed by the scalar range rule, so
# 100 + 100 = 200 is carried exactly and the expression itself never traps. The
# declared element width applies once, at the store into `s`: 200 does not fit
# `i8`, so the assignment aborts (`implicit_store_out_of_range`) and
# `print s.flatten()` never runs. A wrapping regression would print and is caught
# by the unexpected-pass ratchet.
# =============================================================================

main {
    let list<i8> flat ← [100, 100]
    let ti8[2] a ← flat ↦ ti8[2]
    mut ti8[2] s ← [0, 0] ↦ ti8[2]
    s ← a + a
    print s.flatten()
}
