# =============================================================================
# vector — `*` is a scalar operator, not a vector product.
# =============================================================================
#
# What this teaches:
#   • A rank-1 aggregate has two products with different answers: the
#     elementwise `⊙` and the dot `·`.
#   • `*` names neither, so it is refused by name instead of defaulting to
#     one of them.
#   • `*` and `/` stay scalar: scaling a vector by a number.
#
# See also: tensor, vector, ⊙, ·
# =============================================================================

# `*` over two [2] vectors: the product glyph is ⊙ or `·`.
main {
    let vf32[2] v ← [1.0, 2.0] ↦ vf32[2]
    let vf32[2] w ← v * v
    print w
}
