# =============================================================================
# ᵀ — rank-1 transpose is a named decline.
# =============================================================================
#
# What this teaches:
#   • `ᵀ` swaps the row and column axes of a rank-2 tensor only.
#   • A rank-1 tensor has one axis and no row/column distinction, so the
#     postfix refuses it by name instead of guessing an identity transpose.
#
# See also: tensor, ᵀ, glyph-transpose
# =============================================================================

# ᵀ on a rank-1 tensor: no row/column distinction to swap.
main {
    let tf32[3] a ← [1.0, 2.0, 3.0] ↦ tf32[3]
    let tf32[3] t ← aᵀ.materialize()
    print t.flatten()
}
