# =============================================================================
# tensor — empty at a dense tensor, vector, or matrix type is the typed zero of that type.
# =============================================================================
#
# What this teaches:
#   • Default empty instance — `empty` is the default empty instance of the declared type
#   • Dense zero — for a tensor, vector, or matrix that instance is the typed zero `Type {}`
#   • Rank-0 — `tensor<T, []>` keeps its one default slot
#
# Common mistakes:
#   • using empty where an extent is `_` — there is no shape to build; write every extent
#
# See also: tensor, lista, magnitudo
# =============================================================================

# tensor — `Type name ← empty` means `Type name ← Type {}` for a dense type
#
# GRAMMAR:
#   empty_init :← type name '←' 'empty'
#
# EXPECTED OUTPUT:
#   empty-zero.fab stdout contract (shape and a zero cell of the tensor, the
#   vector-element tensor shape, a plain vector lane, the matrix, and the
#   rank-0 tensor's rank).

main {
    let tf32[2, 3] grid ← empty
    print grid.shape()
    print grid[[1, 2]]
    let tensor<vector<f32, size 4>, [2]> lanes ← empty
    print lanes.shape()
    let vector<f32, size 4> v ← empty
    print v[3]
    let mf32[2, 2] m ← empty
    print m
    let tensor<f32, []> single ← empty
    print single.shape().length()
}
