# =============================================================================
# ⊙ — differing operand shapes are a named decline.
# =============================================================================
#
# What this teaches:
#   • `⊙` is pairwise elementwise: every lane of the left operand meets the
#     lane at the same index on the right.
#   • When the shapes differ there is no such lane, and no broadcast stretch is
#     implied. Align the shapes at the source instead.
#
# See also: tensor, ⊙, glyph-elementwise
# =============================================================================

# ⊙ over [2] and [3]: Hadamard has no broadcast stretch.
main {
    let tf32[2] a ← [1.0, 2.0] ↦ tf32[2]
    let tf32[3] b ← [1.0, 2.0, 3.0] ↦ tf32[3]
    let tf32[2] h ← a ⊙ b
    print h.flatten()
}
