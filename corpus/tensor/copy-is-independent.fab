# tensor copy independence — `copy` duplicates backing storage.
#
# EXPECTED stdout:
#   [1.0, 2.0]

main {
    mut tf32[2] original ← [1.0, 2.0] ↦ tf32[2]
    mut tf32[2] copied ← copy original
    copied[0] ← 9.0
    print original
}
