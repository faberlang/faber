interface EdgePolicy<C> {
    fn remap(C coord) → C
}

interface EdgeTransform<C, T> {
    fn transform(C coord, T value) → T
}

# A stateless user policy maps ghosts to cell zero and flips their sign.
class ZeroGhost implements EdgePolicy<vector<int, size 1>> ∩ EdgeTransform<vector<int, size 1>, f32> {
    fn remap(vector<int, size 1> coord) → vector<int, size 1> {
        return [0] ↦ vector<int, size 1>
    }
    fn transform(vector<int, size 1> coord, f32 value) → f32 {
        return -value
    }
}

main {
    let tf32[3] base ← [1.0, 2.0, 3.0] ↦ tf32[3]
    let tf32[3] clamped ← base.shift([1]).edge<clamp>()
    let tf32[3] reflected ← base.shift([1]).edge<reflect>()
    let tf32[3] wrapped ← base.shift([1]).edge<wrap>()
    let tf32[3] filled ← base.shift([1]) coalesce 0.0
    let tf32[3] custom ← base.shift([1]).edge<ZeroGhost>()
    print clamped.flatten()
    print reflected.flatten()
    print wrapped.flatten()
    print filled.flatten()
    print custom.materialize().flatten()
}
