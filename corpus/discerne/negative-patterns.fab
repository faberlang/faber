+++
term = "discerne negative patterns"
kind = "feature"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "functio_decl", "param_list", "parameter", "return_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "redde_stmt", "discerne_stmt", "discriminants", "casu_variant_clause", "patterns", "pattern", "literal", "elige_stmt", "casu_elige_clause", "ceterum_clause", "incipit_stmt", "fixum_decl", "expression", "unary_expr", "nota_stmt", "call_expr", "call_suffix", "argument_list", "argument"]
category = "control-flow"
canonical = true
summary = "A leading minus before a number literal is a pattern in discerne and a case value in elige."
syntax = "discerne <number> { case -1 ... case -2.5 ... case -∞ ... }"
related = ["discerne", "elige", "casu"]
locale = "en"
+++
# A number literal never carries its own sign, so the pattern owns the minus.
# It covers integers, decimals, and negative infinity.
fn classify(int n) → string {
    match n {
        case -1 {
            return "minus one"
        }
        case 0 {
            return "zero"
        }
        case _ {
            return "other"
        }
    }
}

fn describe(float x) → string {
    match x {
        case -∞ {
            return "negative infinity"
        }
        case -2.5 {
            return "minus two and a half"
        }
        case _ {
            return "finite"
        }
    }
}

main {
    print classify(-1)
    print classify(0)
    print classify(7)
    print describe(-∞)
    print describe(-2.5)
    print describe(1.0)

    # elige accepts the same negative literals as case values.
    const int floor ← -3
    switch floor {
        case -3 {
            print "basement three"
        }
        case -1 {
            print "basement one"
        }
        default {
            print "above ground"
        }
    }
}
