+++
term = "discerne multi subject"
kind = "feature"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "discretio_decl", "variant", "variant_fields", "type_annotation", "owned_type", "base_type", "qualified_type", "functio_decl", "param_list", "parameter", "return_clause", "discerne_stmt", "discriminants", "subject_path", "casu_variant_clause", "patterns", "pattern", "pattern_atom", "type_pattern", "ut_pattern", "pattern_binding", "ceterum_clause", "redde_stmt", "expression", "literal", "nota_stmt", "call_expr", "call_suffix", "argument_list", "argument", "incipit_stmt"]
category = "branch"
canonical = false
summary = "One discerne can match several scrutinees at once: the header lists subject paths joined by et, each arm lists one pattern per subject, and the first arm whose patterns all match runs."
syntax = "discerne <a> et <b> { casu <pattern> et <pattern> { ... } ceterum { ... } }"
related = ["discerne", "casu", "discretio", "ceterum"]
locale = "en"
+++
# A match over two scrutinees. The header is `match a and b`; every arm lists
# one pattern per subject joined by `and`; the arms are tried in order and the
# first arm whose patterns all match runs. `_` matches anything for its subject,
# and `default` is the catch-all arm. A pattern with `let` binds the
# variant's fields for that arm only.
union Shape {
    Circle {
        int r
    },
    Square {
        int s
    },
    Dot
}

fn describe(Shape a, Shape b) → string {
    match a and b {
        case Circle let r and Square let s {
            return "circle-square §,§"(r, s)
        }
        case Circle let r and _ {
            return "circle-first §"(r)
        }
        case _ and Dot {
            return "dot-second"
        }
        default {
            return "other"
        }
    }
}

# Unit variants match by name alone.
union Side {
    Left,
    Right
}

fn pair(Side a, Side b) → string {
    match a and b {
        case Left and Right {
            return "left-right"
        }
        default {
            return "other"
        }
    }
}

main {
    let Shape c ← variant Circle { r = 1 } ∷ Shape
    let Shape q ← variant Square { s = 2 } ∷ Shape
    let Shape d ← variant Dot { } ∷ Shape
    print describe(c, q)
    print describe(c, d)
    print describe(q, d)
    print describe(d, d)
    print describe(q, c)
    print pair(Side.Left, Side.Right)
    print pair(Side.Right, Side.Right)
}
