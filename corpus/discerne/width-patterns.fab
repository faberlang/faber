# A bounded arm is more specific than the unbounded family arm.
fn classify(list<int> values) → string {
    match values {
        case list<int, 4> { return "short" }
        case list<int> { return "family" }
    }
}

main {
    const list<int> values ← [1, 2]
    print classify(values)
}
