+++
term = "discerne closed set"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "functio_decl", "param_list", "parameter", "return_clause", "discerne_stmt", "discriminants", "casu_variant_clause", "patterns", "pattern", "type_pattern", "type_arguments", "type_argument", "redde_stmt", "expression", "literal", "incipit_stmt"]
category = "control-flow"
canonical = false
summary = "Decline: discerne matches a closed set, so a length-shaped collection pattern or a numeric width pattern is not a member of the scrutinee type and is rejected with SEM010:discerne_pattern_not_in_closed_set."
syntax = "discerne <list<T>> { case list<T, N> ... } — rejected; ask a length with .length() in an if, a width with is"
related = ["discerne", "casu", "est"]
locale = "en"
+++
# discerne matches a closed set: the members of a union, the variants of an
# enum. It is not a generic "match this thing" keyword, so a pattern that is a
# length bound or an integer width names no member of the scrutinee type and is
# rejected (operator ruling 2026-10-02; retires the old width/shape patterns).
#
# DELIBERATE: both functions below are the rejected forms, kept on purpose to pin
# the diagnostic. The accepted spellings are:
#   • a length:        if values.length() <= 4 { ... }
#   • a width / range: if n is u32 { ... }   (an `is` test)
#   • a union member:  match v { case int const n ... case string const s ... }

# A length bound is not a member of list<int>.
fn classify(list<int> values) → string {
    match values {
        case list<int, 4> {
            return "short"
        }
        case list<int> {
            return "family"
        }
    }
}

# An integer width is not a member of int.
fn width(int n) → string {
    match n {
        case u32 let w {
            return "u32"
        }
        case int {
            return "int"
        }
    }
}
