summary = "Decline: a variant pattern must name a member of the matched union; `case Shape.Circe let r` names a variant of no closed set and rejects with SEM001:unknown_variant."
syntax = "case Shape.Circe let r — rejected; name a declared variant: case Shape.Circle let r"
