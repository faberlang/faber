# =============================================================================
# discerne unknown variant — a variant of no closed set is a check error
# =============================================================================
# discerne matches a closed set: the members of a union, the variants of an
# enum. Shape declares exactly two variants (Circle, Dot), yet the third arm
# names Shape.Circe. That name belongs to no closed set, so the arm is rejected
# with SEM001:unknown_variant; the first two arms keep every real variant
# covered, so no missing-variants diagnostic fires alongside it.
#
# DELIBERATE: the third arm below is the rejected form, kept on purpose to pin
# the diagnostic. The accepted spelling names a declared variant.

union Shape {
    Circle {
        int r
    },
    Dot
}

fn area(Shape s) → int {
    match s {
        case Circle let r {
            return r
        }
        case Dot {
            return 0
        }
        case Shape.Circe let r {
            return r
        }
    }
}
