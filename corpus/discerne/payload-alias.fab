# =============================================================================
# discerne — Payload field aliases rename the fields a casu arm binds.
# =============================================================================
#
# What this teaches:
#   • Payload aliases — `case Rect let w as width, h` binds the payload field
#     `w` as `width`; the alias exists only inside that arm's body.
#   • Aliasing is per field — `h` keeps its own name in the same arm.
#   • Variant payload fields are newline-separated; a comma between variant
#     fields is PARSE002.
#
# Common mistakes:
#   • Using the alias outside its arm — the alias is scoped to the arm body.
#
# See also: discretio, casu, ut
# =============================================================================

# A casu arm lists the payload fields it binds, and any one of them can be
# renamed with `as`. The rename is local to the arm: the arm body reads
# `width`, while the payload field keeps the name `w`.
#
# GRAMMAR (en words beside the canonical spellings):
#   casu_variant_clause ::= 'casu' patterns (block_stmt | ergo_joint statement)
#   ut_pattern    ::= ('ut' IDENTIFIER) | (('sit' | 'varia') pattern_binding (',' pattern_binding)*)
#                     en: 'as' alias | ('let' | 'mut') binding, binding, ...
#   pattern_binding ::= IDENTIFIER ('ut' IDENTIFIER)?   en: field ('as' alias)?
#
# EXPECTED OUTPUT:
#   12

union Shape {
    Circle {
        int r
    },
    Rect {
        int w
        int h
    }
}

main {
    let Shape s ← variant Rect { w = 3, h = 4 } ∷ Shape
    match s {
        case Circle let r as radius {
            print radius
        }
        case Rect let w as width, h {
            print width * h
        }
    }
}
