# =============================================================================
# discerne nonexhaustive — a missing union variant is a check error
# =============================================================================
# discerne matches a closed set: the members of a union, the variants of an
# enum. Shape has three variants (Circle, Rect, Dot) and the arms below name
# only two of them. The trailing `return 0` is not an arm, so Dot is never
# matched and the discerne is rejected with SEM040:missing_variants.
#
# DELIBERATE: the discerne below is the rejected form, kept on purpose to pin
# the diagnostic. The accepted spellings are `case Dot { … }` or a default arm.

union Shape { Circle { int r }, Rect { int w }, Dot }

fn f(Shape s) → int {
    match s {
        case Circle let r { return r }
        case Rect let w { return w }
    }
    return 0
}

main { print 1 }
