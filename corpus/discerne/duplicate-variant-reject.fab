# =============================================================================
# discerne duplicate variant — matching one variant twice is a check error
# =============================================================================
# discerne matches a closed set, and each member appears exactly once. Shape
# has two variants (Circle, Dot); the first two arms both name Circle, so the
# second one is unreachable and rejected with SEM042:duplicate_variant.
#
# DELIBERATE: the discerne below is the rejected form, kept on purpose to pin
# the diagnostic. The accepted spelling merges the two Circle arms into one.

union Shape { Circle { int r }, Dot }

fn f(Shape s) → int {
    match s {
        case Circle let r { return r }
        case Circle let r { return r + 1 }
        case Dot { return 0 }
    }
}

main { print 1 }
