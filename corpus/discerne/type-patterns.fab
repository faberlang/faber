# Type-pattern cases use the same member predicate as `est` and bind the
# narrowed value for the arm body.
class Formal {
    mut string greeting
}

class Casual {
    mut string greeting
}

fn classify(Formal ∪ Casual u) → string {
    match u {
        case Formal const f {
            return f.greeting
        }
        case Casual const c {
            return c.greeting
        }
    }
}

main {
    let Formal f ← Formal { greeting = "formal" }
    let Casual c ← Casual { greeting = "casual" }
    print classify(f)
    print classify(c)
}
