summary = "Decline: a variant pattern must bind every field the variant declares; `Rect { int w; int h }` bound as `case Rect let w` leaves `h` unbound and rejects with SEM013:variant_pattern_arity_mismatch."
syntax = "case Rect let w — rejected; bind every variant field: case Rect let w, h"
related = ["discerne", "casu", "discretio"]
