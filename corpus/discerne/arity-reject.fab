# A variant pattern is either a unit pattern (`case Dot`) or a full
# destructuring of the variant's payload (`case Rect let w, h`). Binding a
# prefix of the fields would silently drop state, so the partial binding is a
# check error instead of a shorthand.
#
# DELIBERATE: the arm below is the rejected form, kept on purpose to pin the
# diagnostic. The accepted spelling binds both fields: case Rect let w, h

union Shape {
    Rect {
        int w
        int h
    },
    Dot
}

fn area(Shape s) → int {
    match s {
        case Rect let w {
            return w
        }
        case Dot {
            return 0
        }
    }
}

main {
    print 1
}
