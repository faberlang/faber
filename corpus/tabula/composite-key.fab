# =============================================================================
# composite key — `map<tuple<K1, K2>, V>` is a rank-2 map.
# =============================================================================
#
# What this teaches:
#   • a composite key is a tuple key; there is no separate composite-index
#     feature
#   • the map is rank 2, like a sparse grid: the bracket list is the key,
#     `sales[[region, year]]`, and `at [region, year]` binds each key part
#   • writing the same key parts again replaces the entry
#   • map iteration order is unspecified: collect rows and `sort` them when
#     the output must be stable
#
# Common mistakes:
#   • `at [key]` with one name — a rank-2 map takes two (arity mismatch)
#   • a `f64` key part — keys must be hashable (no floats)
#
# See also: tabula, iuncta, apud, itera
# =============================================================================

# sales[[k1, k2]] ← v
# for from sales at [k1, k2] const v { <body> }
#
# EXPECTED OUTPUT:
#   two lookups, the entry count, then region/year=total rows sorted.

main {
    mut map<tuple<string, int>, int> sales ← empty
    let string east ← "east"
    sales[[east, 2024]] ← 5
    sales[["west", 2024]] ← 7
    sales[[east, 2025]] ← 9
    sales[[east, 2024]] ← 6
    print sales[[east, 2024]]
    print sales[["west", 2024]]
    print sales.length()
    mut list<string> rows ← empty
    for from sales at [region, year] const total {
        rows.append("§/§=§"(region, year, total))
    }
    rows.sort()
    for from rows const row {
        print row
    }
}
