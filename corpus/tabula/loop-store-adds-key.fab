category = "collections"
canonical = false
summary = "A bracket store in a loop over the same map may update existing keys; it may not add one."
syntax = "for from <map> at [<key>] let <value> { <map>[<key>] ← <value> }"
related = ["tabula", "itera", "ex"]
locale = "en"
