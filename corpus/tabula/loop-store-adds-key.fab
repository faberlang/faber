# =============================================================================
# loop-store-adds-key — updating existing keys while looping over the map.
# =============================================================================
#
# What this teaches:
#   • A bracket store `m[k] ← v` inside `for from m …` is allowed when `k` is
#     already a key: the map keeps its size, so the loop is undisturbed.
#   • The loop remembers the map's size when it starts and compares it at each
#     step; a bracket store that adds a key traps (see
#     loop-store-adds-key-trap.fab).
#
# Common mistakes:
#   • Adding a new key from inside the loop that walks the map — the program
#     traps with "map changed size during iteration".
#
# See also: tabula, itera, loop-store-adds-key-trap
# =============================================================================

main {
    mut map<string, int> stock ← { "pear": 3, "apple": 5, "fig": 1 }
    for from stock at [name] let count {
        stock[name] ← count * 10
    }
    mut list<string> rows ← empty
    for from stock at [name] let count {
        rows.append("§=§"(name, count))
    }
    rows.sort()
    for from rows let row {
        print row
    }
}
