# Rejects a brace literal that repeats an object key.
# Duplicate keys are refused at the second occurrence.
# The checker reports the repeated key as an error.
# This exercises the json_duplicate_key diagnostic.

main {
    let _ d ← { "alpha": 1, "beta": 2, "alpha": 3 }
}
