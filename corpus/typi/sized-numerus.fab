# =============================================================================
# numerus — Bare numerus and fractus width markers in type position.
# =============================================================================
#
# What this teaches:
#   • Width markers — `i32`, `u64`, `f32` are written bare and carry explicit bit widths (the wrapped `numerus<W>` / `fractus<W>` spellings are retired)
#   • Signedness — `i32` (signed) vs `u64` (unsigned) distinction in type position
#
# Common mistakes:
#   • confusing sized family widths — `f32` is a float marker, `i32` an integer marker; or modulus<i32> instead of modulus<u32>
#
# See also: numerus, fractus, instans
# =============================================================================




# bare numerus/fractus width markers
#
# WHY: a bare marker (`i32`, `u64`, `f32`) carries the explicit target width in type position.

main {
    let i32 narrow ← 7 ∷ i32
    let u64 wide ← 255 ∷ u64
    let i64 signed ← narrow
    let f32 single ← 1.5 ∷ f32

    print narrow
    print wide
    print signed
    print single
}