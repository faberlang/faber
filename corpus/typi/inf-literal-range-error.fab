+++
term = "inf"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "expression", "literal", "nota_stmt"]
category = "type"
canonical = false
summary = "A literal too big for its slot is a compile error, however long it is; an `inf` slot is the opt-in that holds it."
