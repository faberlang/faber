# =============================================================================
# ∪ — Union overlap access
# =============================================================================
#
# What this teaches:
#   • A union of genus types exposes exactly what every member shares: a method
#     with the same signature, or a field with the same type
#   • Calling a shared method runs the method of whichever member the value is
#   • A shared field can be read and written through the union
#
# Common mistakes:
#   • reaching for a member only one type has (`radius`) — narrow first with
#     `est` or `discerne`; outside the overlap the access is a compile error
#   • sharing a name with a different type (`float area` vs `int area`) — the
#     error names each member's type
#
# See also: typus, genus, discerne
# =============================================================================

class Circulus {
    mut string nomen
    mut int radius

    fn area() → int {
        return 3 * self.radius * self.radius
    }

    fn scala(int k) → int {
        return k * self.radius
    }
}

class Quadratum {
    mut string nomen
    mut int latus

    fn area() → int {
        return self.latus * self.latus
    }

    fn scala(int k) → int {
        return k + self.latus
    }
}

type Figura = Circulus ∪ Quadratum

fn describe(Figura f) → string {
    return "§: §"(f.nomen, f.area())
}

main {
    let Figura c ← Circulus { nomen = "rota", radius = 2 }
    let Figura q ← Quadratum { nomen = "tabula", latus = 3 }

    # Shared method: each value runs its own member's `area`.
    print describe(c)
    print describe(q)

    # Shared method with an argument.
    print c.scala(10)
    print q.scala(10)

    # Shared field write through the union.
    mut Figura f ← Quadratum { nomen = "tessera", latus = 4 }
    f.nomen ← "mensa"
    print f.nomen
    print f.area()
}
