# =============================================================================
# nota — Diagnostic output severities: nota, vide, and mone.
# =============================================================================
#
# What this teaches:
#   • Diagnostic severity levels — `nota` for neutral info, `vide` for inspection, `mone` for warnings.
#   • Multiple arguments — Each statement accepts comma-separated expressions.
#
# Common mistakes:
#   • Confusing diagnostic output (nota/vide/mone) with scribe (stdout) — diagnostic statements go to diagnostic channels, not stdout.
#
# See also: nota, vide, mone, scribe
# =============================================================================

# nota, vide, mone — diagnostic severity levels
#
# nota <expr>[, <expr>…]
# vide <expr>[, <expr>…]
# mone <expr>[, <expr>…]
#
# GRAMMAR:
#   outputStmt :← ('nota' | 'vide' | 'mone') expr (',' expr)*
#
# EXPECTED OUTPUT:
#   none — output mixes diagnostic channels; no .expected sidecar.

main {
    let string condicio ← "currit"
    let int quantitas ← 42

    # Neutral diagnostic note
    print "opus initum"
    print "condicio: §"(condicio)

    # Inspection note
    debug "vide: ansa incipit"
    debug "vide: numerus ←", quantitas

    # Warning note
    warn "mone: forma vetus usa"
    warn "mone: numerus limen superat:", quantitas
}
