# =============================================================================
# nota — Multi-argument output with inline collection literals.
# =============================================================================
#
# What this teaches:
#   • Space joining — comma-separated print arguments are space-joined into ONE line.
#   • Collection literals — an inline list literal renders in list shape, like any other argument.
#
# Common mistakes:
#   • Reaching for print(...) or a manual string join — the statement already space-joins its arguments.
#
# See also: nota, scribe
# =============================================================================

main {
    print 1, [2]
    print [1], [2]
    print 2, [1]
    print 1, [2], 3.5
}
