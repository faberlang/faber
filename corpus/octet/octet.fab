# =============================================================================
# byte — the byte scalar (Latin `octetus`), exactly u8, the element of bytes.
# =============================================================================
#
# What this teaches:
#   • Byte scalar type — `byte` is an exact alias of `u8`, the element type of `bytes`.
#   • Identity — `bytes` is exactly `list<byte>`; a `byte` and an `u8` are one type.
#
# Common mistakes:
#   • Confusing byte (one scalar) with bytes (the buffer) — bytes is list<byte>.
#
# See also: octeti, numerus, lista
# =============================================================================

# byte - byte scalar (u8), D10.4

fn describe(bytes buf) → int {
    return buf.length()
}

fn firstByte(bytes buf) → byte {
    const byte b ← buf.get(0) coalesce 0 ∷ u8
    return b
}

main {
    var bytes sig ← |de ad be ef|
    const u8 b ← 0x80 ∷ u8
    sig.append(b)
    print describe(sig)
    const byte first ← firstByte(sig)
    print first
    const u8 raw ← b
    const u8 back ← raw
    print back
}
