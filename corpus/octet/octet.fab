# =============================================================================
# byte — The word byte (octetus) is retired: write b8 for raw bits or u8 for a number.
# =============================================================================
#
# What this teaches:
#   • `byte` (Latin `octetus`) no longer names a type; the diagnostic names both replacements
#   • A raw byte is `b8`; a numeric byte is `u8`
#
# Common mistakes:
#   • Writing `byte` for an element of `bytes` — the element is `b8`
#
# See also: bits, octeti, numerus
# =============================================================================

# byte reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let byte b ← 0x80 ∷ u8
    print b
}
