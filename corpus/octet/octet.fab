# =============================================================================
# octet — b8 for raw bits, u8 for a number, list<b8> for a byte run
# =============================================================================
#
# What this teaches:
#   • Eight raw bits are `b8`; an eight-bit number is `u8`. They are different
#     types: a `b8` has equality, ordering by bit pattern and the bit
#     operations, but no arithmetic and no mixing with numbers.
#   • Cross between them explicitly with `↦`: `n ↦ b8` reads a number as its
#     bit pattern, `bits ↦ u8` reads a bit pattern as a number.
#   • A run of bytes is a list of raw bits, `list<b8>`; a hex literal such as
#     `|de ad be ef|` writes one.
#
# Common mistakes:
#   • Adding or comparing a `b8` with a number — convert with `↦ u8` first.
#   • Expecting a separate byte word — there is none; pick `b8` or `u8`.
#
# See also: bits, lista, numerus
# =============================================================================

# octet — the three byte-sized forms side by side
#
# EXPECTED stdout: see octet.expected

main {
    let b8 raw ← 0x80
    let u8 number ← raw ↦ u8
    let b8 again ← number ↦ b8
    let list<b8> buffer ← |de ad be ef|
    let u8 first ← buffer[0] ↦ u8
    print raw
    print number
    print again
    print buffer.length()
    print first
}
