# =============================================================================
# trapping — A `trapping<u8>` parameter takes an in-range argument and aborts the run on one that does not fit.
# =============================================================================
#
# What this teaches:
#   • Arithmetic is exact and a width limit applies only at the store: `n
#     + 100` is 200 for `n` of 100, and it lands in a `trapping<u8>`
#     parameter without complaint
#   • The argument is a store site: `n + 200` is exactly 300, and the
#     store into the `trapping<u8>` parameter aborts with "300 does not
#     fit in `u8`"
#   • A constant that does not fit is refused at check time (`SEM010
#     store_constant_out_of_range`), so the trap needs a value known only
#     at run time
#
# Common mistakes:
#   • Reading the trap as happening where the arithmetic is computed:
#     arithmetic is exact, and only the store into the `trapping` slot
#     checks
#   • Expecting the trap to be recoverable with `do … catch`: an implicit
#     store trap is not in the `⇥` error channel
#
# See also: store-sites, store-sites-trap-return, store-sites-trap-field, store-sites-trap-element
# =============================================================================

fn hold(trapping<u8> given) → int {
    return given
}

main {
    let int n ← 100
    print hold(200)
    print hold(n + 100)
    print n + 200
    print "before"
    print hold(n + 200)
    print "after"
}
