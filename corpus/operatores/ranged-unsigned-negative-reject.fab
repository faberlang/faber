# =============================================================================
# ‥ — an unsigned width has no negative values
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • Unsigned widths need a low end of at least 0; signed widths take negative
#     ends (`trapping<i8, -1‥5>` is legal).
#
# Common mistakes:
#   • Using an unsigned width for an offset that can go negative; use a signed width.

main {
    let trapping<u8, -1‥5> x ← 1
    print x
}
