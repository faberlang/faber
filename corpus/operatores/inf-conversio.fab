# =============================================================================
# inf-conversio — `inf` across bytes and `valor`
# =============================================================================
#
# What this teaches:
#   • `inf ↦ octeti via Be` (or `Le`) is the minimal two's-complement byte
#     string, most (or least) significant byte first: 0 is one byte, 128 needs
#     a leading zero byte, -1 is `ff`, -129 is `ff 7f`. `octeti ↦ inf via Be`
#     reads the same bytes back, so the round trip is exact at any size.
#   • `inf ↦ valor` keeps every digit, and `valor ↦ inf` takes any integer
#     back out of a `valor`. A value that is not an integer (a float, text)
#     fails; `⊥` supplies the fallback.
#
# Common mistakes:
#   • Reading bytes without `via Be` or `via Le` — the byte order is part of
#     the conversion, there is no default.
#   • Expecting a fixed width — the byte string is as long as the value
#     needs, so `0` and `-1` are one byte each.
#
# See also: inf, octeti, valor, ↦, ⊥
# =============================================================================

# operatores/inf-conversio — U8a/U8b conversion rows on every carrier
#
# WHY: pins ruling 40's byte and valor rows beyond what operatores/inf prints,
# with the two's-complement edge rows (0, ±1, 127/128, 255/256, -129, 2^64,
# big negatives). The JSON rows live in operatores/inf-json.
#
# EXPECTED OUTPUT:
#   inf-conversio.expected — one result per print.

# One line of hex per byte string, so the byte order is visible.
fn dump(list<b8> buf) → string {
    mut string line ← ""
    for range 0‥buf.length() let i {
        let u8 piece ← buf.get(i) coalesce 0 ∷ b8 ↦ u8
        line ← "§§ "(line, piece ¶ "02x")
    }
    return line
}

fn encode_be(inf value) → string {
    return dump(value ↦ list<b8> via Be)
}

fn encode_le(inf value) → string {
    return dump(value ↦ list<b8> via Le)
}

fn round_be(inf value) → inf {
    return value ↦ list<b8> via Be ↦ inf via Be
}

fn round_le(inf value) → inf {
    return value ↦ list<b8> via Le ↦ inf via Le
}

main {
    # 1. Minimal two's complement, most significant byte first.
    let inf zero ← 0
    let inf minus_one ← -1
    let inf top_positive ← 127
    let inf first_two_bytes ← 128
    let inf minus_128 ← -128
    let inf minus_129 ← -129
    let inf byte_max ← 255
    let inf over_byte ← 256
    let inf big ← 18446744073709551616
    let inf big_negative ← -18446744073709551617
    print encode_be(zero)
    print encode_be(minus_one)
    print encode_be(top_positive)
    print encode_be(first_two_bytes)
    print encode_be(minus_128)
    print encode_be(minus_129)
    print encode_be(byte_max)
    print encode_be(over_byte)
    print encode_be(big)
    print encode_be(big_negative)

    # 2. The same values, least significant byte first.
    print encode_le(first_two_bytes)
    print encode_le(minus_129)
    print encode_le(over_byte)
    print encode_le(big)
    print encode_le(big_negative)

    # 3. Reading the bytes back is exact in both orders.
    print round_be(zero)
    print round_be(minus_one)
    print round_be(minus_129)
    print round_be(byte_max)
    print round_be(big)
    print round_be(big_negative)
    print round_le(minus_129)
    print round_le(over_byte)
    print round_le(big)
    print round_le(big_negative)

    # 4. Decoding fixed bytes: `ff 7f` is -129, `00 80` is 128.
    let list<b8> pattern ← |ff 7f|
    let list<b8> padded ← |00 80|
    print pattern ↦ inf via Be
    print padded ↦ inf via Be
    print pattern ↦ inf via Le

    # 5. A valor carries an inf of any size and gives it back exactly.
    let value boxed ← big ↦ value
    print boxed ↦ inf
    let value small_boxed ← minus_129 ↦ value
    print small_boxed ↦ inf
    let value from_numerus ← 7 ↦ value
    print from_numerus ↦ inf

    # 6. A valor that is not an integer fails; `⊥` recovers.
    let value fractional ← 1.5 ↦ value
    let value word ← "7" ↦ value
    print fractional ↦ inf ⊥ 9
    print word ↦ inf ⊥ 8
}
