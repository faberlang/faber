# =============================================================================
# trapping — A `trapping<u8>` return value takes an in-range result and aborts the run on one that does not fit.
# =============================================================================
#
# What this teaches:
#   • The return value is a store site: `n + 100` is exact, and the slot
#     checks it once, where the value is returned
#   • `grow(100)` returns 200 and fits a `u8`; `grow(200)` is exactly 300,
#     and the return aborts with "300 does not fit in `u8`"
#   • The lines printed before the trap are kept; the line after it never
#     runs
#
# Common mistakes:
#   • Reading the trap as happening where the arithmetic is computed:
#     arithmetic is exact, and only the store into the `trapping` slot
#     checks
#   • Expecting the trap to be recoverable with `do … catch`: an implicit
#     store trap is not in the `⇥` error channel
#
# See also: store-sites, store-sites-trap
# =============================================================================

fn grow(int n) → trapping<u8> {
    return n + 100
}

main {
    print grow(100)
    print "before"
    print grow(200)
    print "after"
}
