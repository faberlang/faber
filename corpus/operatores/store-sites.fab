# =============================================================================
# numerus — saturating and wrapping policies apply once at each store site.
# =============================================================================
#
# What this teaches:
#   • Arithmetic over policy integers is exact until a value is stored.
#   • A declaration, argument, return, genus field and list element each apply
#     their destination policy once: saturation clamps to 255 and wrapping
#     reduces modulo 256.
#   • `250 + 10` remains 260 as an expression; it is not clamped or wrapped
#     between operations.
#
# See also: numerus, saturating, wrapping
# =============================================================================

class Gauge {
    mut saturating<u8> level
    let wrapping<u8> tag
}

fn clamp_at_return() → saturating<u8> {
    return 250 + 10
}

fn clamp_at_argument(saturating<u8> given) → saturating<u8> {
    return given
}

fn wrap_at_return() → wrapping<u8> {
    return 250 + 10
}

main {
    print 250 + 10
    print clamp_at_return()
    print wrap_at_return()
    print clamp_at_argument(250 + 10)
    print clamp_at_argument(5)

    let Gauge gauge ← Gauge { level = 250 + 10, tag = 250 + 10 }
    print gauge

    let list<saturating<u8>> levels ← [250 + 10, 5 - 10]
    print levels
    print levels.sum()
}
