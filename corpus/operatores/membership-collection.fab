# =============================================================================
# ∈ — Checks whether a value appears in a collection
# =============================================================================
#
# What this teaches:
#   • Checks whether a value appears in a collection.
#   • Related operators: ‥, …
#
# Common mistakes:
#   • Using `∈` with a non-collection right operand — `∈` checks membership in a lista, tabula, or copia (or a range), and a scalar right operand is rejected (SEM010); for a substring test on text use `contains`.
#
# See also: ‥, …
# =============================================================================

# ∈ — collection membership (element in set)
#
# <expr> ∈ <lista>
#
# GRAMMAR:
#   membershipExpr :← expr '∈' expr
#
# EXPECTED OUTPUT:
#   none — stdout not pinned for this exemplum.

main {
    let string condicio ← "agens"
    let int aetas ← 21

    # Basic ∈ with textus lista
    if condicio ∈ ["pendens", "agens", "pausa"] {
        print "condicio valida"
    }

    # ∈ with numeric lista
    if aetas ∈ [18, 21, 65] {
        print "aetas insignis"
    }
    print "exempla ∈"
}
