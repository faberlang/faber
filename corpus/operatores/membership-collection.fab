grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "hole_type", "si_stmt", "arm", "comparison", "array_literal", "argument_list", "argument", "expression", "literal", "nota_stmt"]
category = "collection"
