# =============================================================================
# ‥ — a bare width marker takes no range
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • A range refines a store policy, so the policy word comes first: `saturating`,
#     `trapping` or `wrapping`. A bare width like `u8` names the default policy and
#     has no second argument.
#
# Common mistakes:
#   • Writing `u8<0‥8>` hoping the bare marker means trapping; write
#     `trapping<u8, 0‥8>` instead.

main {
    let u8<0‥8> x ← 1
    print x
}
