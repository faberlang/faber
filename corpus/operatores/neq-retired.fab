# =============================================================================
# ≢ — The glyph ≠ is retired; ≢ is the one negation of ≡.
# =============================================================================
#
# What this teaches:
#   • every negation glyph has the same number of lines as the glyph it negates
#     (≡/≢, ≅/≇, ≈/≉); there is no second spelling for inequality
#
# Common mistakes:
#   • writing ≠ by habit — the diagnostic names ≢ as the replacement
#
# See also: comparatio
# =============================================================================

# retired-glyph reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let int a ← 1
    let int b ← 2
    print a ≠ b
}
