# =============================================================================
# ⌈x⌋ — Mixed rounding delimiters are a named error.
# =============================================================================
#
# What this teaches:
#   • `⌈x⌋` is not a rounding form; the diagnostic points at `⌊x⌉` (nearest).
#
# See also: ⌊x⌉
# =============================================================================

# This exemplum intentionally fails to compile.

main {
    let float x ← 2.5
    print ⌈x⌋
}
