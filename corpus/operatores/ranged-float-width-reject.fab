# =============================================================================
# ‥ — float widths take no range yet
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • Ranges are integer only. Float, decimal and `inf` widths keep their whole-width
#     policies (`saturating<f32>` clamps nothing; `inf` has no bound).
#
# Common mistakes:
#   • Expecting a float range to clamp the way an integer range does.

main {
    let saturating<f32, 0‥8> x ← 1
    print x
}
