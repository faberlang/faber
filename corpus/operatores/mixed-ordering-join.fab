# =============================================================================
# mixed-ordering-join — numerus/fractus ordering compares exact values
# =============================================================================
#
# What this teaches:
#   • `numerus ≺ fractus` and `numerus ≻ fractus` compare the true
#     mathematical values of both operands; no `↦` is needed to cross the
#     integer and float families in a comparison.
#   • The comparison is exact above 2^53 too: the integer side is never
#     rounded to a float first, so `9007199254740993` is greater than
#     `9007199254740992.0`.
#
# Common mistakes:
#   • Assuming the integer is converted to a float before comparing, so that
#     distinct integers above 2^53 compare equal. They do not.
#   • Expecting the same freedom in arithmetic: `int + float` still needs `↦`.
#
# See also: ≅, comparatio, fractus, numerus
# =============================================================================

# operatores/mixed-ordering-join — numerus ≺ fractus ≻
#
# WHY: a comparison stores nothing, so it crosses number families without a
# conversion and answers with the true ordering. `9007199254740993` is not
# representable as f64 (it would round to 2^53), yet `above ≻ boundary` is
# verum and `above ≺ boundary` is falsum.
#
# EXPECTED OUTPUT:
#   verum
#   falsum
#   falsum
#   verum
#   verum
#   falsum

# DECLARED DELTA (OX P1): decimal ordering joins scaled carriers before
# comparing. decimal/decimal compares at the d64 scale; decimal/integer scales the integer
# peer exactly. Decimal/fractus remains rejected by the cross-family gate.

main {
    let int small ← 3
    let float lata ← 3.5
    let bool int_lt ← small ≺ lata
    print int_lt
    let bool int_gt ← small ≻ lata
    print int_gt
    let int above ← 9007199254740993
    let float boundary ← 9007199254740992.0
    let bool exact_lt ← above ≺ boundary
    print exact_lt
    let bool exact_gt ← above ≻ boundary
    print exact_gt
    let d64 narrow_decimal ← 4.2
    let d64 wide_decimal ← 1.0
    let bool decimal_width_gt ← narrow_decimal ≻ wide_decimal
    print decimal_width_gt
    let int integer_limit ← 10
    let bool decimal_integer_gt ← narrow_decimal ≻ integer_limit
    print decimal_integer_gt
}
