+++
term = "≈"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "additive_expr", "comparison", "equality", "equality_tail", "expression", "literal", "nota_stmt"]
