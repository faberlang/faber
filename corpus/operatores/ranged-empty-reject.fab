# =============================================================================
# ‥ — an empty range holds no value
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • The half-open `5‥5` stops before the value it starts at, so no value is
#     inside it. The inclusive `5…5` holds exactly 5.
#
# Common mistakes:
#   • Reading `lo‥hi` as inclusive; `‥` is half open, `…` is inclusive.

main {
    let saturating<u32, 5‥5> x ← 1
    print x
}
