# =============================================================================
# ⌊x⌉ — Rounding glyphs in the Latin surface.
# =============================================================================
#
# What this teaches:
#   • The same three glyphs in every locale; nearest sends ties to even.
#
# See also: ⌊x⌋, ⌈x⌉
# =============================================================================

# EXPECTED OUTPUT:
#   2, 3, 2, 4, -2, 2, 3

incipit {
    sit fractus dimidium ← 2.5
    nota ⌊dimidium⌋
    nota ⌈dimidium⌉
    nota ⌊dimidium⌉
    nota ⌊3.5⌉
    nota ⌊-2.5⌉
    nota ⌊2.4⌉
    nota ⌊2.6⌉
}
