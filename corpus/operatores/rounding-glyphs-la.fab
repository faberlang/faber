category = "arithmetic"
canonical = true
summary = "Signa rotundandi: pavimentum, tectum, proximum cum paribus ad parem."
syntax = "⌊x⌋ pavimentum | ⌈x⌉ tectum | ⌊x⌉ proximum (paria ad parem)"
