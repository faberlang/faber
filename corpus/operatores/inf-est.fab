+++
# =============================================================================
# inf-est — type tests on a `valor` that holds an integer
# =============================================================================
#
# What this teaches:
#   • `v is inf` is true for every integer a `valor` holds, of any size. A
#     float, text or boolean is not an integer: false.
#   • `v is int` is true only when the integer fits `int` (inside `i64`).
#     Past `i64` it is false, so `if v is int { v ↦ int }` never falls onto
#     the failing conversion; test `is inf` and take `v ↦ inf` beyond it.
#   • A width on `int` does not change the test: `v is int<u64>` reads the
#     same tag as `v is int`, exactly as `v ↦ int<u64>` extracts through
#     `i64`. A `u64` above `i64::MAX` is therefore not `is int<u64>`.
#   • The test is carrier-independent. The same program gives the same
#     answers on the MIR runner and in generated Rust.
#
# Common mistakes:
#   • Treating `is int` as "this is some integer" — past `i64` that is
#     `is inf`, and `is int` is false.
#   • Reading the `int<u64>` column as a range check — widths are erased in
#     a `valor`, so it matches the `int` column.
#
# See also: inf, valor, est, ↦, ⊥
# =============================================================================

# operatores/inf-est — the `valor` integer tag law on every carrier
#
# WHY: pins the isint-carrier law: `is inf` ⇔ the valor holds an integer;
# `is int` / `is int<w>` ⇔ it holds one inside `i64` (⇔ `↦ int` succeeds).
# The last section keeps `do { return … } catch { }` inside a failable
# function, which Rust once emitted as an untyped `Ok(())` handler arm.
#
# EXPECTED OUTPUT:
#   inf-est.expected — one line per print.

# One line: the three tests, then the extraction both ways.
fn probe(value v) → string {
    return "int=§ inf=§ u64=§ not-inf=§"(v is int, v is inf, v is u64, v not is inf)
}

# `is int` guards the narrowing, so the fallback never triggers for an integer.
fn narrow(value v) → int {
    if v is int {
        return v ↦ int ⊥ -2
    }
    return -1
}

# Past `i64` the integer is still there: `is inf`, then `↦ inf`.
fn widen(value v) → inf {
    if v is inf {
        return v ↦ inf ⊥ -3
    }
    return 0
}

fn risky(int n) → int ⇥ string {
    if n ≻ 5 {
        throw "too big"
    }
    return n
}

# A guarded `return` inside a failable function, with an empty handler.
fn attempt(int n) → string ⇥ string {
    do {
        let int v ← risky(n)
        return "ok §"(v)
    }
    catch err {
    }
    return "caught"
}

main {
    let inf small ← 7
    let inf int_max ← 9223372036854775807
    let inf past_int ← 9223372036854775808
    let inf past_u64 ← 18446744073709551616
    let inf int_min ← -9223372036854775808
    let inf below_int ← -9223372036854775809
    let inf u64_max ← 18446744073709551615

    # 1. The tag table: an integer, at the edges of `i64` and `u64`.
    print probe(small ↦ value)
    print probe(int_max ↦ value)
    print probe(past_int ↦ value)
    print probe(u64_max ↦ value)
    print probe(past_u64 ↦ value)
    print probe(int_min ↦ value)
    print probe(below_int ↦ value)

    # 2. Not integers: a float, text and a boolean fail every integer test.
    print probe(1.5 ↦ value)
    print probe("7" ↦ value)
    print probe(true ↦ value)

    # 3. `is int` guards `↦ int`; `is inf` guards `↦ inf`.
    print narrow(small ↦ value)
    print narrow(int_min ↦ value)
    print narrow(past_int ↦ value)
    print narrow(1.5 ↦ value)
    print widen(past_u64 ↦ value)
    print widen(below_int ↦ value)
    print widen("7" ↦ value)

    # 4. A guarded return in a failable function: the handler only runs on a throw.
    do {
        print attempt(1)
        print attempt(9)
    }
    catch err {
        print "outer: §"(err)
    }
}
