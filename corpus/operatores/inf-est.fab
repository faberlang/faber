canonical = false
summary = "`valor est inf` holds for every integer; `est int` and `est int<w>` hold only for an integer inside `i64`, so a type test agrees with the extraction that follows it."
syntax = "<valor> is inf | <valor> is int | <valor> is int<w> | <valor> not is inf"
