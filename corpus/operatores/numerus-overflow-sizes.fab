# =============================================================================
# numerus — Sized numerus arithmetic is exact; storing past the declared width traps.
# =============================================================================
#
# What this teaches:
#   • Exact intermediates — `i8` arithmetic does not overflow at 8 bits:
#     `127 + 1` is 128 as a number, and it prints as 128.
#   • Trap at the store — `var i8 total ← max + uno()` fails because 128
#     does not fit `i8`; the program aborts with
#     "128 does not fit in `i8`" and never wraps.
#   • Policy distinction — every numerus width traps at its store; only
#     `wrapping<W>` reduces mod 2^W and `saturating<W>` clamps.
#
# Common mistakes:
#   • Assuming sized numerus wraps at the declared width like `wrapping<W>` words.
#   • Expecting the trap at the `+`: the width is a property of the slot, so an
#     expression with no slot (`print max + uno()`) never traps for size.
#
# See also: +, numerus, wrapping
# =============================================================================

# numerus-overflow-sizes — sized-width exact arithmetic, checked store
#
# POLICY:
#   `i8` carries its declared width as the range of its slot. Arithmetic
#   is computed exactly; the store applies the slot's policy and traps on a
#   value outside -128..127. The rhs is a function call so the sum stays a
#   runtime fact on every target.

fn uno() → i8 {
    return 1
}

main {
    mut i8 max ← 127 ∷ i8
    print max + uno()
    mut i8 total ← max + uno()
    print total
}
