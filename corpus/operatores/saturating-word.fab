# =============================================================================
# saturatus — Saturating integers: a store clamps at both ends of the width.
# =============================================================================
#
# What this teaches:
#   • Clamp contract — `saturating<W>` never traps or wraps on a store; a value
#     past either end of `W` lands at that end (pixels, audio, levels).
#   • Signed or unsigned — `saturating<i16>` clamps at −32768 and 32767.
#   • Exact arithmetic — `+ - * / %` on `saturating` operands is exact, like every
#     integer expression: `high + 10` is 260, `high * 2` is 500, `low - 10` is -5.
#     Nothing clamps until the value is stored into a `saturating` slot
#     (declaration, assignment, argument, return, `↑`/`↓`, …).
#   • Clamp once, at the store — a chain clamps where the value lands:
#     `high + 200 - 100` is 255 (exact 350), not 155, and `low - 300 + 100` is 0
#     (exact −190). An inferred slot (`_`) keeps the word and clamps the same way.
#
# Common mistakes:
#   • Mixing families — `saturating<u8> + u8` is an error; convert with `↦`.
#   • Expecting `↦` to fail — a conversion into `saturating<W>` clamps and cannot
#     fail, so it takes no `⊥` recovery (`wrapping<W>` reduces mod 2^W the same way).
#
# See also: numerus, modulus
# =============================================================================

main {
    let saturating<u8> high ← 250
    let saturating<u8> low ← 5
    # Arithmetic is exact: nothing here is stored into a saturating slot.
    print high + 10
    print low - 10
    print high * 2
    print high / 2
    print high % 7
    let saturating<i16> big ← 30000
    let saturating<i16> neg ← -30000
    let saturating<i16> floor ← neg - 10000
    print big + 10000
    print floor
    print big * -2
    print -floor
    print floor / -1
    mut saturating<u8> level ← 200
    # Each assignment is a store into a saturating slot: it clamps.
    level ← level + 100
    print level
    level ← level - 255
    print level
    let int n ← 200
    let saturating<u8> fromInt ← n ↦ saturating<u8>
    let int back ← high ↦ int
    print fromInt
    print back
    print high ≻ low
    # Chains clamp once, at the store.
    let saturating<u8> chainUp ← high + 200 - 100
    let saturating<u8> chainDown ← low - 300 + 100
    let saturating<u8> chainExact ← high * 2 / 4
    let saturating<u8> wide ← 200
    let saturating<u8> chainFits ← wide * 2 / 4
    let saturating<u8> chainRound ← low - wide - wide + wide + wide
    print chainUp
    print chainDown
    print chainExact
    print chainFits
    print chainRound
    mut saturating<u8> acc ← 200
    acc ← acc + 100 - 50
    print acc
    # `↦` into saturating clamps the exact value; into wrapping it reduces mod 2^W.
    let int over ← 300
    let int under ← -5
    let saturating<u8> clampedHigh ← over ↦ saturating<u8>
    let saturating<u8> clampedLow ← under ↦ saturating<u8>
    let wrapping<u8> wrapped ← over ↦ wrapping<u8>
    print clampedHigh
    print clampedLow
    print wrapped
}
