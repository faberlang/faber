# =============================================================================
# saturatus — Saturating integers: arithmetic clamps at both ends of the width.
# =============================================================================
#
# What this teaches:
#   • Clamp contract — `saturating<W>` never traps or wraps on overflow; a result
#     past either end of `W` stays at that end (pixels, audio, levels).
#   • Signed or unsigned — `saturating<i16>` clamps at −32768 and 32767.
#   • Clamp once, at the store — a chain is computed exactly and clamps where the
#     value lands: `high + 200 - 100` is 255 (exact 350), not 155.
#   • A constant beside a saturating operand is an exact number, so
#     `low - 300 + 100` is 0 (exact −190); only the store clamps.
#
# Common mistakes:
#   • Mixing families — `saturating<u8> + int<u8>` is an error; convert with `↦`.
#   • Expecting `↦` to fail — a conversion into `saturating<W>` clamps and cannot
#     fail, so it takes no `⊥` recovery (`wrapping<W>` reduces mod 2^W the same way).
#
# See also: numerus, modulus
# =============================================================================

main {
    const saturating<u8> high ← 250
    const saturating<u8> low ← 5
    print high + 10
    print low - 10
    print high * 2
    print high / 2
    print high % 7
    const saturating<i16> big ← 30000
    const saturating<i16> neg ← -30000
    const saturating<i16> floor ← neg - 10000
    print big + 10000
    print floor
    print big * -2
    print -floor
    print floor / -1
    var saturating<u8> level ← 200
    level ← level + 100
    print level
    level ← level - 255
    print level
    const int n ← 200
    const saturating<u8> fromInt ← n ↦ saturating<u8>
    const int back ← high ↦ int
    print fromInt
    print back
    print high ≻ low
    # Chains clamp once, at the store.
    const saturating<u8> chainUp ← high + 200 - 100
    const saturating<u8> chainDown ← low - 300 + 100
    const saturating<u8> chainExact ← high * 2 / 4
    const saturating<u8> wide ← 200
    const saturating<u8> chainFits ← wide * 2 / 4
    const saturating<u8> chainRound ← low - wide - wide + wide + wide
    print chainUp
    print chainDown
    print chainExact
    print chainFits
    print chainRound
    var saturating<u8> acc ← 200
    acc ← acc + 100 - 50
    print acc
    # `↦` into saturating clamps the exact value; into wrapping it reduces mod 2^W.
    const int over ← 300
    const int under ← -5
    const saturating<u8> clampedHigh ← over ↦ saturating<u8>
    const saturating<u8> clampedLow ← under ↦ saturating<u8>
    const wrapping<u8> wrapped ← over ↦ wrapping<u8>
    print clampedHigh
    print clampedLow
    print wrapped
}
