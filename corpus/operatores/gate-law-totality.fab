# =============================================================================
# gate-law-totality — the operator × carrier truth table (SEM gate law)
# =============================================================================
#
# What this teaches:
#   • ONE pin per operator × carrier-family cell of the SEM gate law. Each
#     cell is either a defined join (executed below, verdict pinned in the
#     expected output) or a named SEM rejection (documented in the table,
#     asserted by the radix-semantic coverage audit).
#   • The gate arms: numeric_ordering_bin (< ≤ > ≥), numeric_arithmetic_bin
#     (+ - * / %), numeric_value_equality_types (≅ ≇ ≈ ≉),
#     exact_equality_types (≡ ≢), check_conversio (↦).
#   • New carrier families (e.g. GEA4) must land a row here before their
#     cells count as proven.
#
# Common mistakes:
#   • Expecting `≡` to join widths — it is fail-closed; widen with `↦` first.
#   • Expecting `+` to cross number families — integer widths join (`u8 + u16`
#     is exact, and range-checked where the result is stored), but int with
#     float or decimal, and `u64` with a signed integer, need `↦` first.
#     Ordering and value equality compare across families with no `↦`, and
#     compare exactly (`9007199254740993 ≅ 9007199254740992.0` is falsum).
#   • Expecting decimal `≅`/`≈` to stay carrier-blind — the d64-scale join
#     (GT-1) makes two 4.2 d64 values ≅ verum; decimal × fractus never compares
#     (GT-2), on either the ordering or the equality tier.
#   • Expecting `est` to compare values — it is a type test (D23.1); the
#     value right-hand side that used to sit in this table names `≡` instead.
#
# See also: ≅, ≈, ≡, ↦, mixed-ordering-join, numeric-value-eq, comparatio, est
# =============================================================================

# =============================================================================
# THE TABLE — 9 operator rows × 9 carrier-pair families = 81 cells.
# J = defined join (executed below, verdict pinned). R = named SEM rejection
# (asserted by the coverage audit, never compiled).
#
#                     ≡/≢   ≅/≇   ≈/≉    <     ≤     >     ≥    arith   ↦
# P1 int identical     J     J     J     J     J     J     J     J       J
# P2 int cross-width   R-eq  J     J     J     J     J     J     J       J
# P3 signed×unsigned   R-eq  J     J     J     J     J     J   R-u64³    J
# P4 int×f32           R-eq  J     J     J     J     J     J    R-fam    J
# P5 int×f64           R-eq  J     J     J     J     J     J    R-fam    J
# P6 f32×f64           R-eq  J     J     J     J     J     J     J       J
# P7 d64×d64           J     J     J     J     J     J     J     J       J
# P8 decimal×integer   R-eq  J     J     J     J     J     J    R-fam    J
# P9 decimal×fractus   R-eq  R-eq²  R-eq²  R-ord R-ord R-ord R-ord R-fam    J
#
# R-eq    SEM010:equality_exact_types_required
# R-u64³  SEM011:u64_signed_arithmetic_requires_conversion (a `u64` beside a
#         signed integer has no lossless join; convert one side with `↦`)
# R-fam   SEM011:numeric_family_crossing_requires_conversio (integer, decimal
#         and float never mix implicitly in arithmetic or at a store; an
#         untyped constant beside a number takes its family)
# R-ord   SEM011:mixed_decimal_fractus_ordering
# R-eq²   SEM011:mixed_decimal_fractus_equality (GT-2 — the ≅/≈ equality tiers
#         now mirror the ordering gate; decimal/fractus never compares)
#
# Closed findings (GT-1..GT-4, pinned by the executed rows below):
#   GT-1  the decimal ≅ and ≈ cells join at the d64 scale in MIR (conversion
#         temps, mirroring the ordering join). `d32` was removed (D11.7), so
#         P7 is the identical d64×d64 pair.
#   GT-3  the signed×unsigned ↦ cell joins for non-negative values; a
#         negative value into an unsigned target fails closed at runtime
#         (conversion never wraps — DEFER-116 boundary contract), recovered
#         inline below. Previously the runner left a negative carrier in an
#         unsigned slot, making print/≡/≅/ordering disagree.
#   GT-4  the signed×unsigned < and ≥ cells now match the runner on every
#         surface: generated Rust joins on i128 instead of `unsigned as i64`
#         (which wrapped u64::MAX to -1 and inverted the verdicts).
# =============================================================================

# operatores/gate-law-totality — the operator × carrier truth table
#
# WHY: three audits found gate law not total over the operator × carrier
# product one cell at a time (mixed int/float ordering + wrap; decimal
# relational carrier-blind). This exemplum pins every cell so new carrier
# families cannot mint unproven ones. The four contested cells (GT-1..GT-4)
# are closed here — every cell is now a defined join or a named rejection,
# with the verdicts pinned below and in the SEM coverage audit.

main {
    # ---------------------------------------------------------------- ints
    const int a ← 7
    const int b ← 7
    const u8 narrow ← 3 ∷ u8
    const u16 wider ← 3 ∷ u16
    const int signed ← -1
    const u64 unsigned ← 18446744073709551615
    const int large ← 10

    # --------------------------------------------------------------- floats
    const f32 single ← 2.5 ∷ f32
    const float double ← 2.5
    const float half ← 0.5
    const float four_two ← 4.2
    const i64 above ← 9007199254740993
    const i64 below ← 9007199254740992
    const float boundary ← 9007199254740992.0

    # -------------------------------------------------------------- decimals
    const d64 d64v ← 4.2
    const d64 d64w ← 4.2
    const int five ← 5

    # ----------------------------------------------------------- conversio
    const u64 five_u ← 5

    # ----------------------------------------------------- ≡ / ≢ (P1 join)
    # Identical types join exactly (P1 ints, P7 decimals); every other family
    # pair is SEM010:equality_exact_types_required.
    print a ≡ b
    print a ≢ 8
    print d64v ≡ d64w

    # --------------------------------------------------- ≅ / ≇ (all joins)
    # Exact value equality across widths and families: nothing is rounded
    # first, so 2⁵³ + 1 ≅ 2⁵³ as a float is falsum.
    print a ≅ b
    print a ≇ 8
    print narrow ≅ wider
    print signed ≅ unsigned
    print large ≅ single
    print above ≅ boundary
    print above ≅ below
    print single ≅ double
    print d64v ≅ five
    print d64v ≅ d64w
    # decimal × fractus ≅ rejects (SEM011:mixed_decimal_fractus_equality,
    # GT-2) — the ordering gate rejects the same family pair.
    # print d64v ≅ four_two

    # --------------------------------------------------- ≈ / ≉ (all joins)
    # Tolerance equality at the float operand's precision (OQ3 isclose
    # default). Unlike ≅ it is not exact: 2⁵³ + 1 ≈ 2⁵³ is verum.
    print a ≈ b
    print a ≉ 8
    print narrow ≈ wider
    print signed ≈ unsigned
    print large ≈ single
    print above ≈ boundary
    print above ≈ below
    print single ≈ double
    print d64v ≈ five
    print d64v ≈ d64w
    # decimal × fractus ≈ rejects (SEM011:mixed_decimal_fractus_equality,
    # GT-2) — the ordering gate rejects the same family pair.
    # print d64v ≈ four_two

    # -------------------------------------------------------- < (P1–P8)
    # Ordering compares the true mathematical values, across families too: an
    # integer joins with an integer, a float with a float, a decimal with a
    # decimal, and int × float never rounds the integer. P9 decimal×fractus
    # is the one rejection: SEM011:mixed_decimal_fractus_ordering.
    print a ≺ b
    print a ≺ 8
    print narrow ≺ wider
    print signed ≺ unsigned
    print large ≺ single
    print half ≺ large
    print single ≺ double
    print d64v ≺ d64w
    print d64v ≺ five

    # -------------------------------------------------------- ≤ (P1–P8)
    print a ≤ b
    print narrow ≤ wider
    print signed ≤ unsigned
    print large ≤ single
    print half ≤ large
    print single ≤ double
    print d64v ≤ d64w
    print d64v ≤ five

    # -------------------------------------------------------- > (P1–P8)
    print a ≻ b
    print a ≻ 6
    print narrow ≻ wider
    print signed ≻ unsigned
    print large ≻ single
    print large ≻ half
    print single ≻ double
    print d64v ≻ d64w
    print d64v ≻ five

    # -------------------------------------------------------- ≥ (P1–P8)
    print a ≥ b
    print narrow ≥ wider
    print signed ≥ unsigned
    print large ≥ single
    print half ≥ large
    print single ≥ double
    print d64v ≥ d64w
    print d64v ≥ five
    # ------------------------------------------------------- arith (P1)
    # Same-family arithmetic is exact and range-checked where it is stored.
    # Crossing families is SEM011:numeric_family_crossing_requires_conversio
    # and u64 with a signed integer is SEM011:u64_signed_arithmetic_requires_
    # conversion; neither is compiled here.
    print a + b
    print a - b
    print a * b
    print a / b
    print a % b
    print narrow + narrow
    print single + single
    print four_two + four_two
    print d64w + d64w

    # ------------------------------------------------------- ↦ (all joins)
    # Conversio is directional. Every family direction admits.
    print narrow ↦ u16
    print a ↦ u8
    print five_u ↦ int
    print a ↦ u64
    # GT-3: a negative value into an unsigned target fails closed at runtime
    # (conversion never wraps — DEFER-116 boundary contract); the inline
    # recovery supplies the target-typed fallback.
    print signed ↦ u32 ⊥ 0 ∷ u32
    print a ↦ f32
    print single ↦ int via Trunc
    print a ↦ float
    print four_two ↦ int via Trunc
    print single ↦ f64
    print double ↦ f32
    print d64v ↦ d64
    print d64v ↦ int via HalfEven
    print five ↦ d64
    print d64v ↦ float
    print four_two ↦ d64

    # ----------------------------------------------------- est (type test)
    # D23.1: `est` / `non est` is a type test, not an equality cell, so it is
    # no longer a column of the table above. The right-hand side is a type.
    print a is int
}
