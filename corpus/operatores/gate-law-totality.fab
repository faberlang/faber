syntax = "<expression> <operator> <expression> for ≡ ≠ ≅ ≇ ≈ ≉ < ≤ > ≥ + - * / % ↦ est"
related = ["≅", "≈", "≡", "↦", "mixed-ordering-join", "numeric-value-eq", "comparatio", "est"]
locale = "en"
+++
# =============================================================================
# gate-law-totality — the operator × carrier truth table (SEM gate law)
# =============================================================================
#
# What this teaches:
#   • ONE pin per operator × carrier-family cell of the SEM gate law. Each
#     cell is either a defined join (executed below, verdict pinned in the
#     expected output) or a named SEM rejection (documented in the table,
#     asserted by the radix-semantic coverage audit).
#   • The gate arms: numeric_ordering_bin (< ≤ > ≥), numeric_arithmetic_bin
#     (+ - * / %), numeric_value_equality_types (≅ ≇ ≈ ≉),
#     exact_equality_types (≡ ≠), check_conversio (↦).
#   • New carrier families (e.g. GEA4) must land a row here before their
#     cells count as proven.
#
# Common mistakes:
#   • Expecting `≡` to join widths — it is fail-closed; widen with `↦` first.
#   • Expecting `+` to promote mixed widths — arithmetic requires identical
#     operands; only ordering and value equality join.
#   • Expecting decimal `≅`/`≈` to stay carrier-blind — the d64-scale join
#     (GT-1) makes 4.2 d32 ≅ 4.2 d64 verum; decimal × fractus never compares
#     (GT-2), on either the ordering or the equality tier.
#   • Expecting `est` to compare values — it is a type test (D23.1); the
#     value right-hand side that used to sit in this table names `≡` instead.
#
# See also: ≅, ≈, ≡, ↦, mixed-ordering-join, numeric-value-eq, comparatio, est
# =============================================================================

# =============================================================================
# THE TABLE — 9 operator rows × 9 carrier-pair families = 81 cells.
# J = defined join (executed below, verdict pinned). R = named SEM rejection
# (asserted by the coverage audit, never compiled).
#
#                     ≡/≠   ≅/≇   ≈/≉    <     ≤     >     ≥    arith   ↦
# P1 int identical     J     J     J     J     J     J     J     J       J
# P2 int cross-width   R-eq  J     J     J     J     J     J     R-ai    J
# P3 signed×unsigned   R-eq  J     J     J     J     J     J     R-ai    J
# P4 int×f32           R-eq  J     J     J     J     J     J     R-ai    J
# P5 int×f64           R-eq  J     J     J     J     J     J     R-ai    J
# P6 f32×f64           R-eq  J     J     J     J     J     J     R-ai    J
# P7 d32×d64           R-eq  J     J     J     J     J     J     R-ai  J / R-narr
# P8 decimal×integer   R-eq  J     J     J     J     J     J     R-ai    J
# P9 decimal×fractus   R-eq  R-eq²  R-eq²  R-ord R-ord R-ord R-ord  R-ai    J
#
# R-eq    SEM010:equality_exact_types_required
# R-ai    SEM011:numeric_arithmetic_operands_identical
# R-ord   SEM011:mixed_decimal_fractus_ordering
# R-eq²   SEM011:mixed_decimal_fractus_equality (GT-2 — the ≅/≈ equality tiers
#         now mirror the ordering gate; decimal/fractus never compares)
# R-narr  SEM016:decimal_width_narrowing_rejected (d64 → d32 only)
#
# Closed findings (GT-1..GT-4, pinned by the executed rows below):
#   GT-1  the d32/d64 ≅ and ≈ cells join at the d64 scale in MIR (conversion
#         temps, mirroring the ordering join) — 4.2 d32 ≅ 4.2 d64 verdicts
#         verum. Previously the runner compared raw scaled carriers.
#   GT-3  the signed×unsigned ↦ cell joins for non-negative values; a
#         negative value into an unsigned target fails closed at runtime
#         (conversion never wraps — DEFER-116 boundary contract), recovered
#         inline below. Previously the runner left a negative carrier in an
#         unsigned slot, making print/≡/≅/ordering disagree.
#   GT-4  the signed×unsigned < and ≥ cells now match the runner on every
#         surface: generated Rust joins on i128 instead of `unsigned as i64`
#         (which wrapped u64::MAX to -1 and inverted the verdicts).
# =============================================================================

# operatores/gate-law-totality — the operator × carrier truth table
#
# WHY: three audits found gate law not total over the operator × carrier
# product one cell at a time (mixed int/float ordering + wrap; decimal
# relational carrier-blind). This exemplum pins every cell so new carrier
# families cannot mint unproven ones. The four contested cells (GT-1..GT-4)
# are closed here — every cell is now a defined join or a named rejection,
# with the verdicts pinned below and in the SEM coverage audit.

main {
    # ---------------------------------------------------------------- ints
    const int a ← 7
    const int b ← 7
    const int<u8> narrow ← 3 ∷ int<u8>
    const int<u16> wider ← 3 ∷ int<u16>
    const int signed ← -1
    const int<u64> unsigned ← 18446744073709551615
    const int large ← 10

    # --------------------------------------------------------------- floats
    const f32 single ← 2.5 ∷ f32
    const float double ← 2.5
    const float half ← 0.5
    const float four_two ← 4.2
    const int<i64> above ← 9007199254740993
    const int<i64> below ← 9007199254740992
    const float boundary ← 9007199254740992.0

    # -------------------------------------------------------------- decimals
    const int<d32> d32v ← 4.2
    const int<d64> d64v ← 4.2
    const int five ← 5

    # ----------------------------------------------------------- conversio
    const int<u64> five_u ← 5

    # ----------------------------------------------------- ≡ / ≠ (P1 join)
    # P1 identical ints join exactly; every other family pair is
    # SEM010:equality_exact_types_required.
    print a ≡ b
    print a ≠ 8

    # --------------------------------------------------- ≅ / ≇ (all joins)
    # Promoted-exact value equality: widths join, then compare exactly.
    print a ≅ b
    print a ≇ 8
    print narrow ≅ wider
    print signed ≅ unsigned
    print large ≅ single
    print above ≅ boundary
    print above ≅ below
    print single ≅ double
    print d32v ≅ five
    print d32v ≅ d64v
    # decimal × fractus ≅ rejects (SEM011:mixed_decimal_fractus_equality,
    # GT-2) — the ordering gate rejects the same family pair.
    # print d32v ≅ four_two

    # --------------------------------------------------- ≈ / ≉ (all joins)
    # Fuzzy equality at the joined precision (OQ3 isclose default).
    print a ≈ b
    print a ≉ 8
    print narrow ≈ wider
    print signed ≈ unsigned
    print large ≈ single
    print above ≈ boundary
    print above ≈ below
    print single ≈ double
    print d32v ≈ five
    print d32v ≈ d64v
    # decimal × fractus ≈ rejects (SEM011:mixed_decimal_fractus_equality,
    # GT-2) — the ordering gate rejects the same family pair.
    # print d32v ≈ four_two

    # -------------------------------------------------------- < (P1–P8)
    # Ordering joins at the widened carrier: numerus for int pairs, f64 for
    # float pairs, d64 for decimal pairs (mixed-ordering-join). P9
    # decimal×fractus is SEM011:mixed_decimal_fractus_ordering.
    print a ≺ b
    print a ≺ 8
    print narrow ≺ wider
    print signed ≺ unsigned
    print large ≺ single
    print half ≺ large
    print single ≺ double
    print d32v ≺ d64v
    print d32v ≺ five

    # -------------------------------------------------------- ≤ (P1–P8)
    print a ≤ b
    print narrow ≤ wider
    print signed ≤ unsigned
    print large ≤ single
    print half ≤ large
    print single ≤ double
    print d32v ≤ d64v
    print d32v ≤ five

    # -------------------------------------------------------- > (P1–P8)
    print a ≻ b
    print a ≻ 6
    print narrow ≻ wider
    print signed ≻ unsigned
    print large ≻ single
    print large ≻ half
    print single ≻ double
    print d32v ≻ d64v
    print d32v ≻ five

    # -------------------------------------------------------- ≥ (P1–P8)
    print a ≥ b
    print narrow ≥ wider
    print signed ≥ unsigned
    print large ≥ single
    print half ≥ large
    print single ≥ double
    print d32v ≥ d64v
    print d32v ≥ five
    # ------------------------------------------------------- arith (P1)
    # Arithmetic requires identical width and primitive
    # (SEM011:numeric_arithmetic_operands_identical for every mixed pair).
    print a + b
    print a - b
    print a * b
    print a / b
    print a % b
    print narrow + narrow
    print single + single
    print four_two + four_two
    print d32v + d32v
    print d64v + d64v

    # ------------------------------------------------------- ↦ (all joins)
    # Conversio is directional. Every family direction admits except the
    # decimal narrowing d64 → d32 (SEM016:decimal_width_narrowing_rejected).
    print narrow ↦ int<u16>
    print a ↦ int<u8>
    print five_u ↦ int
    print a ↦ int<u64>
    # GT-3: a negative value into an unsigned target fails closed at runtime
    # (conversion never wraps — DEFER-116 boundary contract); the inline
    # recovery supplies the target-typed fallback.
    print signed ↦ int<u32> ⊥ 0 ∷ int<u32>
    print a ↦ f32
    print single ↦ int
    print a ↦ float
    print four_two ↦ int
    print single ↦ f64
    print double ↦ f32
    print d32v ↦ int<d64>
    print d32v ↦ int
    print five ↦ int<d32>
    print five ↦ int<d64>
    print d32v ↦ float
    print four_two ↦ int<d64>

    # ----------------------------------------------------- est (type test)
    # D23.1: `est` / `non est` is a type test, not an equality cell, so it is
    # no longer a column of the table above. The right-hand side is a type.
    print a is int
}
