# =============================================================================
# inf-json — `inf` through JSON
# =============================================================================
#
# What this teaches:
#   • A JSON integer token keeps every digit, however long: `json.parse` reads
#     it and `valor ↦ inf` takes it out exactly. A token with a fraction is a
#     float and fails the `inf` conversion; `⊥` supplies the fallback.
#   • An integer beyond 64 bits renders back through `json.stringify` as a
#     bare number, never a string and never a rounded float.
#
# Common mistakes:
#   • Reading a big integer as `numerus` — it needs the `inf` slot.
#
# See also: inf, valor, json, ↦, ⊥
# =============================================================================

# operatores/inf-json — U8a/U8b JSON rows on every carrier
#
# WHY: pins ruling 40's JSON rows: any-length integer tokens in, bare numbers
# out, and a 1000-digit round trip. The byte and valor rows live in
# operatores/inf-conversio.
#
# EXPECTED OUTPUT:
#   inf-json.expected — one result per print.

import from "norma:json" json

# A field of a parsed object, as a plain valor.
fn pick(map<string, value> members, string key) → value {
    return members.get(key) ∷ value
}

main {
    # 1. JSON integer tokens keep every digit; a fraction is a float.
    let json document ← json.parse(«{"a": 18446744073709551616, "b": -18446744073709551617, "c": 18446744073709551615, "d": -5, "e": 1.5}»)
    let value root ← document ↦ value
    let map<string, value> members ← root ↦ map<string, value>
    print pick(members, "a") ↦ inf
    print pick(members, "b") ↦ inf
    print pick(members, "c") ↦ inf
    print pick(members, "d") ↦ inf
    print pick(members, "e") ↦ inf ⊥ 0

    # 2. A thousand digits survive parse, extraction and stringify.
    mut string digits ← "9"
    for range 1‥1000 const i {
        digits ← digits + "7"
    }
    let string payload ← «{"n":§}»(digits)
    let json parsed ← json.parse(payload)
    let value parsed_root ← parsed ↦ value
    let map<string, value> parsed_members ← parsed_root ↦ map<string, value>
    let inf thousand ← pick(parsed_members, "n") ↦ inf
    let string back ← thousand ↦ string
    print back.length()
    print back ≡ digits
    print thousand % 1000
    print thousand / (thousand / 10)
    let json reparsed ← json.parse(payload)
    let string rendered ← json.stringify(reparsed)
    print rendered ≡ payload
}
