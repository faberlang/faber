# =============================================================================
# ∈ — Map-key membership with a literal key
# =============================================================================
#
# What this teaches:
#   • A text literal may be the left operand of `∈` / `∉` over a map; the test is on the keys.
#
# See also: ∈
# =============================================================================

# EXPECTED OUTPUT:
#   literal key in
#   literal key out

main {
    var map<string, int> puncta ← empty
    puncta["alpha"] ← 1
    puncta["beta"] ← 2
    if "beta" ∈ puncta {
        print "literal key in"
    }
    if "gamma" ∉ puncta {
        print "literal key out"
    }
}
