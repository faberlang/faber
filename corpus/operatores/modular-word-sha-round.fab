# =============================================================================
# modulus<u32> — One native SHA-256 compression round using modulus<u32>.
# =============================================================================
#
# What this teaches:
#   • Modular arithmetic in practice — Demonstrates `modulus<u32>` used for a real cryptographic computation.
#   • Bitwise operations on modular words — Combines `⇒`, `⇐`, `⊻`, `∧`, `∨`, `¬` in SHA-256 round logic.
#
# Common mistakes:
#   • Applying regular arithmetic overflow rules instead of modular wrapping.
#
# See also: numerus, ⇐, ⇒, ∧, ∨, ⊻, ¬
# =============================================================================

# A small proof of the word contract: one textbook SHA-256 round for the
# first padded word of "abc". This is not the full digest implementation.

fn dextra(wrapping<u32> value, wrapping<u32> count) → wrapping<u32> {
    return value ⇒ count ∨ value ⇐ 32 - count
}

main {
    const wrapping<u32> a ← 1779033703
    const wrapping<u32> b ← 3144134277
    const wrapping<u32> c ← 1013904242
    const wrapping<u32> d ← 2773480762
    const wrapping<u32> e ← 1359893119
    const wrapping<u32> f ← 2600822924
    const wrapping<u32> g ← 528734635
    const wrapping<u32> h ← 1541459225
    const wrapping<u32> w ← 1633837952
    const wrapping<u32> k ← 1116352408
    const wrapping<u32> sigma1 ← dextra(e, 6 ∷ wrapping<u32>) ⊻ dextra(e, 11 ∷ wrapping<u32>) ⊻ dextra(e, 25 ∷ wrapping<u32>)
    const wrapping<u32> choose ← e ∧ f ⊻ ¬e ∧ g
    const wrapping<u32> temp1 ← h + sigma1 + choose + k + w
    const wrapping<u32> sigma0 ← dextra(a, 2 ∷ wrapping<u32>) ⊻ dextra(a, 13 ∷ wrapping<u32>) ⊻ dextra(a, 22 ∷ wrapping<u32>)
    const wrapping<u32> majority ← a ∧ b ⊻ a ∧ c ⊻ b ∧ c
    const wrapping<u32> temp2 ← sigma0 + majority
    print temp1 + temp2
    print d + temp1
}
