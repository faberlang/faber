# =============================================================================
# f32 — f32 arithmetic rounds to single precision after every operation; nothing traps or clamps.
# =============================================================================
#
# What this teaches:
#   • A bare `f32` is IEEE single precision: each operation rounds its
#     result to 24 bits of significand, so the order of the additions
#     changes the answer
#   • `16777216.0 + 1.0 + 1.0` stays 16777216 in `f32`, while `16777216.0
#     + (1.0 + 1.0)` is 16777218; the same sums in `f64` are exact
#   • An overflow gives infinity as IEEE says; no operation traps and
#     nothing clamps to the largest finite value
#   • Storing each increment rounds too: both a scalar f32 cell and a
#     list<f32> element stay at 16777216 after four additions of 1.0
#
# Common mistakes:
#   • Expecting the `f32` sum to equal the `f64` sum: it is rounded at
#     every operation, not once at the end
#   • Expecting `m * m` to trap or clamp: only a `trapping<f32>` cell
#     checks, and only at a store (see policy-float)
#
# See also: policy-float, f32, f64
# =============================================================================

main {
    let f32 big ← 16777216.0
    let f32 one ← 1.0
    print big + one
    print big + one + one
    print big + (one + one)
    let f64 wide ← 16777216.0
    print wide + 1.0 + 1.0
    let f32 tenth ← 0.1
    print tenth + tenth + tenth
    let f64 wide_tenth ← 0.1
    print wide_tenth + wide_tenth + wide_tenth
    mut f32 s ← big
    s ← s + one
    s ← s + one
    s ← s + one
    s ← s + one
    print s
    mut list<f32> values ← [big]
    values[0] ← values[0] + one
    values[0] ← values[0] + one
    values[0] ← values[0] + one
    values[0] ← values[0] + one
    print values[0]
    let f32 m ← 3.4028235e38
    print m * m
    let f32 sq ← m * m
    print sq - sq
}
