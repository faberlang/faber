# =============================================================================
# modulus<u64> — One native SHA-512 compression round using modulus<u64>.
# =============================================================================
#
# What this teaches:
#   • 64-bit modular arithmetic — Demonstrates `modulus<u64>` in a real SHA-512 compression round.
#   • Bitwise operations on 64-bit words — Combines shifts, xor, and, and not for cryptographic primitives.
#
# Common mistakes:
#   • Forgetting that shift counts must be modulo the word size (64).
#
# See also: numerus, ⇐, ⇒, ∧, ∨, ⊻, ¬
# =============================================================================

# A small proof of the 64-bit word contract: one textbook SHA-512 round for
# the first padded word of "abc". This is not the full digest implementation.

fn dextra(uint<u64> value, uint<u64> count) → uint<u64> {
    return value ⇒ count ∨ value ⇐ 64 - count
}

main {
    const uint<u64> a ← 7640891576956012808
    const uint<u64> b ← 13503953896175478587
    const uint<u64> c ← 4354685564936845355
    const uint<u64> d ← 11912009170470909681
    const uint<u64> e ← 5840696475078001361
    const uint<u64> f ← 11170449401992604703
    const uint<u64> g ← 2270897969802886507
    const uint<u64> h ← 6620516959814648809
    const uint<u64> w ← 7017280452245743616
    const uint<u64> k ← 4794697086780616226
    const uint<u64> sigma1 ← dextra(e, 14 ∷ uint<u64>) ⊻ dextra(e, 18 ∷ uint<u64>) ⊻ dextra(e, 41 ∷ uint<u64>)
    const uint<u64> choose ← e ∧ f ⊻ ¬e ∧ g
    const uint<u64> temp1 ← h + sigma1 + choose + k + w
    const uint<u64> sigma0 ← dextra(a, 28 ∷ uint<u64>) ⊻ dextra(a, 34 ∷ uint<u64>) ⊻ dextra(a, 39 ∷ uint<u64>)
    const uint<u64> majority ← a ∧ b ⊻ a ∧ c ⊻ b ∧ c
    const uint<u64> temp2 ← sigma0 + majority
    print temp1 + temp2
    print d + temp1
}
