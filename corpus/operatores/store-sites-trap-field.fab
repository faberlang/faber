# =============================================================================
# trapping — A `trapping<u8>` class field takes an in-range value and aborts the run on one that does not fit.
# =============================================================================
#
# What this teaches:
#   • A field initializer is a store site: `n + 50` is exact and fits a
#     `trapping<u8>` field when `n` is 150
#   • `n + 150` is exactly 300, and the store into the field aborts with
#     "300 does not fit in `u8`"
#   • A constant that does not fit is refused at check time (`SEM010
#     store_constant_out_of_range`), so the trap needs a value known only
#     at run time
#
# Common mistakes:
#   • Reading the trap as happening where the arithmetic is computed:
#     arithmetic is exact, and only the store into the `trapping` slot
#     checks
#   • Expecting the trap to be recoverable with `do … catch`: an implicit
#     store trap is not in the `⇥` error channel
#
# See also: store-sites, store-sites-trap
# =============================================================================

class Gauge {
    mut trapping<u8> level
}

main {
    let int n ← 150
    let Gauge fine ← Gauge { level = n + 50 }
    print fine.level
    print "before"
    let Gauge over ← Gauge { level = n + 150 }
    print over.level
    print "after"
}
