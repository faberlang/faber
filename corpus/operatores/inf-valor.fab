# =============================================================================
# inf-valor — taking an `inf` out of a `valor`
# =============================================================================
#
# What this teaches:
#   • A `valor` that holds an integer converts to `inf` exactly, whatever the
#     size: a small `int`, a bounded `u8`, or an `inf` far beyond 64 bits.
#   • A `valor` that holds anything else — a float (even a whole one), text,
#     a `bool`, or `null` — does not convert; `⊥` supplies the fallback.
#
# Common mistakes:
#   • Expecting a float or text payload to truncate or parse — only an
#     integer payload converts.
#   • Expecting `true` to read as 1 — a `bool` is not an integer here.
#
# See also: inf, valor, ↦, ⊥, inf-conversio
# =============================================================================

# operatores/inf-valor — `valor ↦ inf` on every integer and non-integer payload
#
# WHY: pins the one-way `valor ↦ inf` row (ruling 40) apart from the byte rows
# of operatores/inf-conversio, so a carrier that has `valor` but no `list<b8>`
# can still prove it. A valor is not printed itself; each row prints the `inf`
# taken out of it, or the `⊥` fallback.
#
# EXPECTED OUTPUT:
#   inf-valor.expected — one result per print.

# The inf in a valor, or -1 when the payload is not an integer.
fn take(value v) → inf {
    return v ↦ inf ⊥ -1
}

main {
    # 1. Integer payloads convert exactly.
    let int small ← 7
    let u8 byte ← 200
    let inf big ← 18446744073709551616
    let inf big_negative ← -18446744073709551617
    let inf edge ← 9223372036854775808
    print take(small ↦ value)
    print take(byte ↦ value)
    print take(big ↦ value)
    print take(big_negative ↦ value)
    print take(edge ↦ value)

    # 2. A stored conversion reads the integer and keeps every digit.
    let value boxed ← big ↦ value
    let inf taken ← boxed ↦ inf
    print taken
    print taken + 1

    # 3. Anything that is not an integer fails.
    let float half ← 1.5
    let float exact_three ← 3.0
    let bool truth ← true
    print take(half ↦ value)
    print take(exact_three ↦ value)
    print take("7" ↦ value)
    print take(truth ↦ value)
    print take(null ↦ value)

    # 4. `⊥` names its own fallback.
    let value word ← "text" ↦ value
    print word ↦ inf ⊥ 8
}
