# =============================================================================
# ?. — Null-safe member, index, and call access.
# =============================================================================
#
# What this teaches:
#   • Optional chaining — `?.` accesses fields only when the receiver is present, returning `null` otherwise.
#   • Index and call safety — `?[ ]` for safe index access, `?( )` for safe call on optional values.
#
# Common mistakes:
#   • Chaining too deeply — each `?.` that hits `null` short-circuits, making debugging harder.
#
# See also: ?., ?[, ?(, vel, sponte
# =============================================================================

# operatores/optional-chain — ?. ?[ ?(
#
# GRAMMAR:
#   optionalSuffix :← '?.' IDENTIFIER | '?[' expr ']' | '?(' argumentList ')'
#
# EXPECTED OUTPUT:
#   Roma, Italia, none, none, a, none, hi!, none
#
# BACKEND:
#   Cross-ref optionalis/optionalis.fab for genus-heavy tour and
#   optionalis/chain-call.fab for the optional call `?(` and `?.method()`.

type Op = (string) → string

class Locus {
    mut string urbs
    mut string regio optional
}

class Civis {
    mut string nomen
    mut Locus locus optional
}

main {
    let Civis aelia ← Civis { nomen = "Aelia", locus = Locus { urbs = "Roma", regio = "Italia" } }
    print aelia?.locus?.urbs
    print aelia?.locus?.regio
    let Civis brutus ← Civis { nomen = "Brutus" }
    print brutus?.locus?.urbs
    print brutus?.locus?.regio
    let list<string, 3> litterae ← ["a", "b", "c"]
    print litterae?[0]
    print litterae?[10]
    let Op ∪ none loud ← string s → string ∴ s + "!"
    let Op ∪ none quiet ← null
    print loud?("hi")
    print quiet?("hi")
}
