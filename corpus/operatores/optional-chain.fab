+++
term = "?."
kind = "operator-group"
category = "optional-chain"
canonical = true
summary = "Null-safe member, index, and call access."
syntax = "<expression>?.<name> | <expression>?[<expression>] | <expression>?(<args>)"
related = ["?.", "?[", "?(", "vel", "sponte"]
locale = "en"
+++

# =============================================================================
# ?. — Null-safe member, index, and call access.
# =============================================================================
#
# What this teaches:
#   • Optional chaining — `?.` accesses fields only when the receiver is present, returning `nihil` otherwise.
#   • Index and call safety — `?[ ]` for safe index access, `?( )` for safe call on optional values.
#
# Common mistakes:
#   • Chaining too deeply — each ?. that hits nihil short-circuits, making debugging harder.
#
# See also: ?., ?[, ?(, vel, sponte
# =============================================================================

# operatores/optional-chain — ?. ?[ ?(
#
# GRAMMAR:
#   optionalSuffix :← '?.' IDENTIFIER | '?[' expr ']' | '?(' argumentList ')'
#
# EXPECTED OUTPUT:
#   Roma, Italia, nihil, nihil, a, nihil
#
# BACKEND:
#   Cross-ref optionalis/optionalis.fab for genus-heavy tour.
#   Optional call ?( — syntax in frontmatter; Rust e2e defers to driver optional-chain tests.

class Locus {
    string urbs
    string regio optional
}

class Civis {
    string nomen
    Locus locus optional
}

main {
    const _ aelia ← Civis {
        nomen = "Aelia",
        locus = Locus { urbs = "Roma", regio = "Italia" }
    }

    print aelia?.locus?.urbs
    print aelia?.locus?.regio

    const _ brutus ← Civis { nomen = "Brutus" }
    print brutus?.locus?.urbs
    print brutus?.locus?.regio

    const _ litterae ← ["a", "b", "c"]
    print litterae?[0]
    print litterae?[10]
}