+++
term = "/"
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "expression", "literal", "nota_stmt", "multiplicative_expr", "assignment", "expr_stmt"]
