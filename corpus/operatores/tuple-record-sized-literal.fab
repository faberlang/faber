# =============================================================================
# iuncta / ratio — sized tuple and record literal constructors
# =============================================================================
#
# What this teaches:
#   • a sized tuple literal `tuple<u8, i16> [7, 9]` stores into a matching
#     `tuple<u8, i16>` slot: as a declaration value, a return value, and an
#     argument
#   • a sized record literal `record<g: u8, w: i16> { g = 7, w = 9 }` works the
#     same way: the constructor's own labeled type arguments carry the field
#     types
#   • sized numerics print decimal (`7`, `9`), not hex, and an en program
#     prints the word `tuple` for a printed tuple value
#
# EXPECTED OUTPUT:
#   tuple [7, 9]
#   7
#   9
#   7
#   9
#   tuple [7, 9]

fn pair() → tuple<u8, i16> {
    return tuple<u8, i16> [7, 9]
}

main {
    let tuple<u8, i16> t ← tuple<u8, i16> [7, 9]
    print t
    print t[0]
    print t[1]

    let record<g: u8, w: i16> r ← record<g: u8, w: i16> { g = 7, w = 9 }
    print r.g
    print r.w

    print pair()
}
