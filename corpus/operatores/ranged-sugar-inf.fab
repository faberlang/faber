# =============================================================================
# trapping<inf, -∞…∞> — the unbounded integer written with its range
# =============================================================================
#
# What this teaches:
#   • \`inf\` has no bound on either side, so \`-∞…∞\` writes exactly that and the
#     result is the bare \`inf\` type: no conversion, no check.
#   • \`∞\` and \`-∞\` mean "no bound on this side" in a range; they are never an
#     integer value. A finite end on \`inf\` (\`trapping<inf, 0…∞>\`) is refused.
#
# Common mistakes:
#   • Writing a finite range on \`inf\` to bound it; use a bounded width.
#
# See also: inf, ranged-sugar
# =============================================================================

main {
    let trapping<inf, -∞…∞> big ← 18446744073709551616
    let inf same ← big
    print same
}
