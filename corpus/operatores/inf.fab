# =============================================================================
# inf — the opt-in unbounded integer
# =============================================================================
#
# What this teaches:
#   • `inf` is an integer with no bound. You opt in by declaring a slot `inf`;
#     nothing becomes `inf` by default. `trapping<inf>`, `wrapping<inf>` and
#     `saturating<inf>` are the same type: there is no bound to trap at, wrap
#     at or clamp to.
#   • A literal of any length is a constant. It is legal where its exact value
#     fits, so `18446744073709551616` (2^64) needs an `inf` slot.
#   • `+ - *`, `⇐` and recursion never overflow: 30! and 2^201 are exact.
#   • `/` and `%` floor, as on every integer: `-7 / 2` is -4 and `-7 % 2` is 1.
#   • `∧ ∨ ⊻ ¬` work on infinite two's complement: `¬x` is `-x - 1`, and
#     `x ∧ -1` is `x`.
#   • Comparison is exact against every number family. `2^64 + 1` is not
#     equal to the float `2^64`, even though the float rounds.
#   • `≈` is tolerance equality, one rule for every integer (`inf` or
#     bounded, any width): equal when `10^9 · |a − b| ≤ max(|a|, |b|)`,
#     computed exactly. A difference of one is inside at 10^12, never at 5.
#   • A bounded integer widens into `inf` without `↦`: the `u64` maximum, put
#     in an `inf` slot, takes `+ 1` exactly instead of trapping.
#   • Going back down is a checked narrowing: `x ↦ u64 ⊥ 9` yields 9 when the
#     value does not fit. `↦ float` rounds, and a value beyond the float
#     range is `inf` or `-inf` (the printed spelling of float infinity; the
#     integer type `inf` is unrelated to it). A float or `d64` enters `inf`
#     only with a rounding choice (`via Trunc`, `via HalfEven`); NaN and ∞ fail.
#   • `↦` and `¶` work on `inf` like any integer: parse and render at a
#     radix with `via Hex`, pad with a format spec, print a field.
#
# Common mistakes:
#   • Writing a big literal into a bounded or unannotated slot — the value
#     does not fit `numerus`; declare the slot `inf`.
#   • Expecting `u64 - u64` to be `inf` — it stays `i64`. Opt in by widening
#     an operand: `(a ↦ inf) - b`.
#   • Using `inf` for a tensor element or in a kernel — both are host-only
#     rejections (see typi/inf-tensor-error and kernel/inf-param-error).
#   • Expecting `∞` to be an `inf` value — `∞` is the float infinity.
#
# See also: numerus, u64, d64, ↦, ⊥, ⇐, ¶
# =============================================================================

# operatores/inf — one exemplum for the whole unbounded-integer surface
#
# WHY: pins F9 rulings 34–38 and 40–42 on the MIR runner (the oracle).
# Each numbered section prints one idea; sections 1–4 are arithmetic, 5–6
# compare and widen, 7–10 convert, 11–12 render and collect, 13 boxes.
#
# EXPECTED OUTPUT:
#   inf.expected — one result per print.

class Sample {
    let inf v
}

fn factorial(inf n) → inf {
    if n ≤ 1 {
        return 1
    }
    return n * factorial(n - 1)
}

main {
    # 1. Opt-in declaration and a literal beyond u64. The three policy
    #    spellings are one type and add without any check.
    let inf big ← 18446744073709551616
    print big
    let trapping<inf> five ← 5
    let wrapping<inf> six ← 6
    print five + six

    # 2. No size trap: 30! and 2^201 are exact.
    print factorial(30)
    let inf pow ← 2 ⇐ 200
    print pow

    # 3. Floor division and remainder take the sign of the divisor.
    let inf neg ← -7
    print neg / 2
    print neg % 2

    # 4. Bitwise operators and shifts on infinite two's complement.
    print ¬neg
    print neg ∧ -1
    print neg ⇒ 1

    # 5. Exact comparison across families. The float 2^64 is exactly 2^64,
    #    so one more is greater; a rounding comparison would call them equal.
    let u64 top ← 18446744073709551615
    let float flt ← 18446744073709551616.0
    let d64 dec ← 1.5
    print big ≻ top
    print top ≺ big
    print big ≅ flt
    print big + 1 ≅ flt
    print big + 1 ≻ flt
    print big ≻ dec

    # 5b. `≈` is the tolerance tier, the same rule for `inf` and bounded
    #     integers: one more than 2^64 is inside 1e-9, twice 2^64 is not.
    let int near ← 1000000000000
    let inf near_inf ← 1000000000001
    print near ≈ near_inf
    print big + 1 ≈ big
    print big ≈ big + big

    # 6. A u64 widens into inf without `↦`; `+ 1` past u64::MAX is exact.
    let inf widened ← top
    print widened + 1

    # 7. Checked narrowing: recovery when the value does not fit.
    print big ↦ u64 ⊥ 9
    let inf small ← 200
    print small ↦ u8 ⊥ 9
    let inf over ← small + 100
    print over ↦ u8 ⊥ 255

    # 8. Floats: finite, then beyond the float range.
    print small ↦ float
    print big ↦ float
    let inf huge ← pow * pow * pow * pow * pow * pow * pow * pow * pow * pow
    print huge ↦ float
    let inf below ← 0 - huge
    print below ↦ float

    # 9. Into inf: a float or d64 converts only with a rounding choice
    #    (`via Trunc` toward zero, `via HalfEven` ties to even); a NaN or
    #    infinite float fails.
    let float frac ← 12.75
    let float negfrac ← -12.75
    let d64 half ← 12.5
    let d64 threequarters ← 12.75
    let float not_a_number ← 0.0 ÷ 0.0
    let float float_infinity ← ∞
    print frac ↦ inf via Trunc
    print negfrac ↦ inf via Trunc
    print half ↦ inf via HalfEven
    print threequarters ↦ inf via HalfEven
    print not_a_number ↦ inf via Trunc ⊥ 5
    print float_infinity ↦ inf via Trunc ⊥ 6
    let inf trillions ← 100000000000000000000
    print trillions ↦ d64 ⊥ 0.5

    # 10. Text: parse and render at a radix.
    print "ff" ↦ inf via Hex
    print big ↦ string
    print big ↦ ascii<size 17> via Hex

    # 11. `¶` formats like any integer.
    print big ¶ "x"
    print big ¶ ".2"

    # 12. A field prints its digits; a list sums exactly.
    let Sample sample ← Sample { v = 18446744073709551616 }
    print sample
    let list<inf> items ← [1, 18446744073709551616, 3]
    print items.sum()

    # 13. `valor` carries an `inf` of any length and gives it back exactly.
    let value boxed ← big ↦ value
    print boxed
    let inf unboxed ← boxed ↦ inf
    print unboxed + 1
}
