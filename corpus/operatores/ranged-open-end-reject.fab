category = "arithmetic"
canonical = false
summary = "Both ends of a range are always written: `0…` alone is refused, `0…∞` says there is no high end."
syntax = "saturating<u32, 0…> — rejected"
related = ["saturating<W, lo‥hi>", "trapping<W, lo‥hi>", "wrapping<W, lo‥hi>"]
