# =============================================================================
# ‥ — a one-sided range is a parse error
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • Both ends are always written, so a range never reads as half a range.
#     "No bound on this side" is `∞` or `-∞`, written out.
#
# Common mistakes:
#   • Dropping the high end to mean "no limit"; write `0…∞` instead.

main {
    let saturating<u32, 0…> x ← 1
    print x
}
