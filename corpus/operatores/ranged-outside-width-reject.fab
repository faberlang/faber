# =============================================================================
# ‥ — the range must fit inside the width
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • The width is explicit and the range refines it, so an end past the width is
#     an error at check time (a half-open `0‥256` is the last one a u8 accepts).
#
# Common mistakes:
#   • Using a range to widen a width; pick a wider width such as `u16` instead.

main {
    let trapping<u8, 0‥300> x ← 1
    print x
}
