# =============================================================================
# ‥ — a range end is a literal integer or ∞
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • The checker can only prove that a range fits its width when both ends are
#     known at check time. A name or a `size` extent as an end parses and is
#     refused by name, so the form can arrive later without changing what is
#     legal today.
#
# Common mistakes:
#   • Writing the extent of a run-time buffer as an end (`0‥n`); spell the
#     literal end, or keep the value in a wider cell and check it explicitly.

fn bound(int n) → void {
    let saturating<u32, 0‥n> x ← 1
    print x
}

main {
    bound(8)
}
