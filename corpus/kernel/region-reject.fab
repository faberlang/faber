+++
term = "machina"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "annotation", "annotation_name", "functio_decl", "param_list", "parameter", "return_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "fac_stmt", "fac_modifier", "cape_clause", "expression", "call_expr", "call_suffix", "argument_list", "argument", "literal", "nota_stmt"]
category = "kernel"
summary = "Device-region legality: a nested region, an exit crossing out, a direct lane loop, an allocation, a device read, a host effect and a host call are named diagnostics."
syntax = "do device { print \"x\" }"
related = ["machina", "fac", "nucleum"]
locale = "en"
