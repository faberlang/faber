# =============================================================================
# do device — a checked device-resident region
# =============================================================================
#
# What this teaches:
#   • `device` between `do` and the block (la `fac machina`) marks a region
#     whose body is checked as device-resident: kernel launches, `for range`
#     bounds and `if` conditions over captured scalars, `mut` scalar state,
#     and nothing else
#   • the region is checked in place by `faber check`; `faber check --device`
#     prints its binding list and its launch and host-sync counts
#   • a fault inside the block runs to the block exit and is reported once to
#     the `catch` handler, exactly as `do all`
#   • V0 lowers a region exactly as `do all`: same launches, same bytes
#
# Common mistakes:
#   • printing, calling a host function, or building a tensor in the block —
#     each is a named diagnostic (see region-reject)
#   • reading a device value to decide control flow — the region refuses it
#     by name until device loop control exists
#
# See also: fac, cape, omnia, nucleum
# =============================================================================

@ kernel
@ public
fn bump(tensor<f32, [4]> dom, mut tensor<f32, [4]> t, i32 step) → void {
    for from dom at [i] thread lane let v {
        t[[i]] ← v + (step ↦ f32)
    }
}

main {
    mut tensor<f32, [4]> t ← tf32[4] {}
    let tensor<f32, [4]> z ← tf32[4] {}
    do device {
        for range 0‥8 let k {
            bump(z, mut t, k ↦ i32)
            if k % 2 ≡ 0 then bump(z, mut t, 1)
        }
    }
    catch err {
        print err
    }
}
