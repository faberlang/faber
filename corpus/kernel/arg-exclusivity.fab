# =============================================================================
# nucleum — kernel argument exclusivity at the call site
# =============================================================================
#
# What this teaches:
#   • A kernel's arguments are device buffers that stay live together for the
#     whole launch, so a writable argument (`mut`, `own`) must not overlap any
#     other argument of the same call: not the whole tensor spelled twice,
#     not a `←` alias of it, not a view of the same storage.
#   • Read-only arguments may overlap freely: duplicate tensors and
#     overlapping views are legal because nothing writes them.
#   • An independent value — a `copy` bind or a `materialize()` result — is
#     fresh storage, so it never overlaps the writable argument.
#   • This is the soundness argument behind `noalias` kernel parameters: the
#     compiler may mark a writable parameter non-overlapping because an
#     overlapping call is refused here, by name.
#
# Common mistakes:
#   • passing `t` twice, one side `mut` — refuse it and pass a `copy` or a
#     `materialize()` result instead (see arg-exclusivity-reject)
#   • assuming argument order matters — the rule is about storage overlap,
#     and it holds whichever side the writable argument is on
#
# See also: nucleum, mutabilitas, tensor
# =============================================================================

@ kernel
@ public
fn axpy(mut tf32[3] y, tf32[3] x) → void {
    y ⇇ x
}

@ kernel
@ public
fn add2(tf32[3] a, tf32[3] b) → f32 {
    return a[[0]] + b[[0]]
}

main {
    mut tf32[3] t ← [1.0, 2.0, 3.0] ↦ tf32[3]
    let tf32[3] s ← [9.0, 8.0, 7.0] ↦ tf32[3]

    # Read-only duplicates stay legal: nothing writes, so the launch may
    # share storage.
    add2(t, t)

    # Read-only overlapping views of one tensor stay legal.
    add2(t.reshape([3]), t.reshape([3]))
    let tf32[3] rv ← t.reshape([3])
    add2(rv, t.reshape([3]))

    # A writable argument beside a disjoint tensor is the ordinary shape.
    axpy(mut t, s)

    # An independent copy is fresh storage, never an overlap.
    let tf32[3] dup ← copy t
    axpy(mut t, dup)
    let tf32[3] solid ← t.reshape([3]).materialize()
    axpy(mut t, solid)
}
