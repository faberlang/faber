+++
term = "nucleum"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "annotation", "annotation_name", "functio_decl", "param_list", "parameter", "return_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "redde_stmt", "expression", "nota_stmt", "call_expr", "call_suffix", "argument_list", "argument", "additive_expr", "multiplicative_expr", "literal"]
