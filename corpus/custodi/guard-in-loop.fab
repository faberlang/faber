# =============================================================================
# custodi — A guard block holding continue and break inside a loop.
# =============================================================================
#
# What this teaches:
#   • Guard exits — a `custodi` block may hold `redde`, `perge` and `rumpe`, not only `redde`.
#   • Loop guards — `perge` skips one iteration and `rumpe` leaves the loop, both from inside `custodi`.
#   • Early returns — multiple `si` checks in one `custodi` block each take their own exit path.
#
# Common mistakes:
#   • Using `custodi` outside a function — guard blocks are only valid inside `functio` bodies.
#   • Expecting `rumpe` in a guard to leave only the guard — it leaves the enclosing loop.
#
# See also: si, redde, perge, rumpe
# =============================================================================

# custodi — guard blocks with return, continue and break
#
# custodi { si <conditio> { <exitus> } }
#
# GRAMMAR:
#   custodiStmt :← 'custodi' '{' stmt* '}'
#
# EXPECTED OUTPUT:
#   neg
#   empty
#   ok
#   8

fn f(int a, string s) → string {
    guard {
        if a ≺ 0 { return "neg" }
        if s.length() ≡ 0 { return "empty" }
    }
    return "ok"
}

fn g(int a) → int {
    mut int t ← 0
    for range 0‥a let i {
        guard {
            if i ≡ 2 { continue }
            if i ≡ 5 { break }
        }
        t ← t + i
    }
    return t
}

main {
    print f(-1, "x")
    print f(1, "")
    print f(1, "x")
    print g(10)
}
