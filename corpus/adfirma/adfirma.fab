+++
term = "adfirma"
explains = ["adfirma"]
kind = "keyword"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "hole_type", "adfirma_stmt", "expression", "literal", "comparison", "equality_tail", "proba_stmt"]
category = "testing"
canonical = true
summary = "Asserts that a condition is true at runtime."
syntax = "adfirma <expression> [mori <expression>]"
aliases = ["assert"]
related = ["proba", "fac", "cape"]
locale = "en"
+++
test "assertions validate invariants" {
    let int x ← 10
    assert x ≻ 0
    assert x ≡ 10 panic "x decem esse debet"
    let string nomen ← "Marcus"
    assert nomen ≡ "Marcus"
    assert nomen ≢ "" panic "nomen vacuum non sit"
    let bool viget ← true
    assert viget
    assert viget ≡ true panic "vigere debet"
}

# =============================================================================
# adfirma — Asserts that a condition is true at runtime.
# =============================================================================
#
# What this teaches:
#   • Runtime assertions — `adfirma <condition>` validates invariants during
#     program execution
#   • Custom messages — `adfirma <condition> mori "message"` adds descriptive
#     diagnostic text on failure
#   • Testing category — adfirma is the primary assertion keyword for test
#     and verification code
#
# Common mistakes:
#   • using `adfirma` outside `proba` or `probandum` (WARN006); use `mori` for invariant violations in production code or move assertions into test blocks
#
# See also: proba, fac, cape
# =============================================================================

# adfirma — runtime assertions
#
# adfirma <condition>
# adfirma <condition> mori "nuntius"
#
# GRAMMAR:
#   adfirmaStmt :← 'adfirma' expr ('mori' expr)?
#
# EXPECTED OUTPUT:
#   empty — adfirma only (adfirma.expected)

main {
    let int x ← 10

    # Simple assertion without message
    assert x ≻ 0

    # Assertion with custom message
    assert x ≡ 10 panic "x decem esse debet"

    # Multiple assertions
    let string nomen ← "Marcus"
    assert nomen ≡ "Marcus"
    assert nomen ≢ "" panic "nomen vacuum non sit"

    # Boolean assertions
    let bool viget ← true
    assert viget
    assert viget ≡ true panic "vigere debet"
}
