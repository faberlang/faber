# =============================================================================
# adfirma — the condition must be boolean
# =============================================================================
# `adfirma` validates an invariant, so its condition is a `bool` expression. A
# value of any other type — here an int literal — is a check error rather than
# an implicit truthiness test.

main {
    assert 5
}
