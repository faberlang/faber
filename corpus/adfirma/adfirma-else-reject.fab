# =============================================================================
# adfirma — no else clause
# =============================================================================
# An assertion has no alternate branch: it either holds or it fails. The
# failure message is introduced by the `panic` particle, so a trailing `else`
# is rejected instead of being folded into some conditional shape.

main {
    assert 1 ≡ 1 else "m"
}
