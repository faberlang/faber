# =============================================================================
# sparsa — sparse<T, Figura> declaration shell with all-zero vacua.
# =============================================================================
#
# What this teaches:
#   • Sparse tensor declaration — the `sparse<T, Figura>` type syntax and `vacua` initializer
#   • Identity functions — passing sparse values through functions preserves shape and rank
#
# Common mistakes:
#   • confusing sparse<T, Figura> with tensor<T, Figura> — sparse tensors use the same shape syntax but different storage semantics
#
# See also: sparsa, tensor, vacua
# =============================================================================


# sparsa — declaration shell for sparse<T, Figura>
#
# sparse<T, Figura> name ← vacua
# functio f(sparse<T, Figura> value) → sparse<T, Figura>
#
# GRAMMAR:
#   type :← 'sparse' '<' type ',' shape '>'
#
# EXPECTED OUTPUT:
#   Rank and stored non-zero count after round-trip identity call.

fn identity(sparse<f32, [2, 3]> value) → sparse<f32, [2, 3]> {
    return value
}

main {
    let sparse<f32, [2, 3]> empty ← empty
    let sparse<f32, [2, 3]> roundtrip ← identity(empty)

    print roundtrip.length(), roundtrip.count_nonzero()
}
