# =============================================================================
# sparsa — Sparse tensor edge behavior: densify, zero-removal, i32 reads, trap.
# =============================================================================
#
# What this teaches:
#   • Densification — `↦` and `.densify()` both produce the dense tensor with
#     the stored entries in place and zeros elsewhere.
#   • Zero is zero — `0.0` and `-0.0` are equal to the element default, so
#     neither is stored and neither counts as a nonzero entry.
#   • Absent reads — `get` on an unset coordinate returns the element type's
#     zero value (an `i32` coordinate reads `0`).
#   • Bounds trap — a `set` outside the shape aborts the run (the last
#     statement after every print).
#
# Common mistakes:
#   • Expecting `-0.0` to count as nonzero, or an unset coordinate to be
#     distinguishable from a stored zero.
#
# See also: sparsa, densify, tensor
# =============================================================================

main {
    mut sparsa<f32, [2, 2]> g1 ← empty
    g1.set([0, 0], 2.0)
    g1.set([1, 1], 3.0)
    let tf32[2, 2] d1 ← g1 ↦ tf32[2, 2]
    print d1.flatten()
    print g1.count_nonzero()

    mut sparsa<f32, [2, 2]> g2 ← empty
    g2.set([0, 1], 5.0)
    let tf32[2, 2] d2 ← g2.densify()
    print d2.flatten()

    mut sparsa<f32, [3]> g3 ← empty
    g3.set([0], 0.0)
    g3.set([1], -0.0)
    print g3.count_nonzero()

    mut sparsa<i32, [4]> g4 ← empty
    g4.set([0], 7)
    g4.set([3], -2)
    let _ a ← g4.get([0])
    let _ b ← g4.get([1])
    let _ c ← g4.get([3])
    print a, b, c, g4.count_nonzero()

    mut sparsa<f32, [2, 2]> oob ← empty
    oob.set([2, 0], 5.0)
}
