+++
term = "?("
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "type_annotation", "owned_type", "base_type", "expression", "literal", "nota_stmt", "functio_decl", "param_list", "parameter", "return_clause", "redde_stmt", "call_expr", "call_suffix", "argument_list", "argument", "function_type", "optional_suffix"]
category = "type"
summary = "An optional chain captures its receiver before effectful index and call arguments run."
