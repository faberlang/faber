# Optional chains capture the receiver before evaluating their operands.

type Op = (int) → int

fn identity(int x) → int {
    return x
}

main {
    mut list<int> ∪ none xs ← [10]
    let () → int idx ← () → int ∴ do {
        xs ← null
        return 0
    }
    print xs?[idx()]

    mut Op ∪ none f ← identity
    let () → int arg ← () → int ∴ do {
        f ← null
        return 7
    }
    print f?(arg())
}
