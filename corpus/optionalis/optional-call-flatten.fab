# Optional calls flatten nullable results, including nested chains.

type Op = (int) → int ∪ none
type Factory = () → Op ∪ none

fn maybe(int x) → int ∪ none {
    return null
}

fn factory() → Op ∪ none {
    return maybe
}

main {
    let Op ∪ none f ← maybe
    print f?(1)

    let Factory ∪ none make ← factory
    print make?()?(1)
}
