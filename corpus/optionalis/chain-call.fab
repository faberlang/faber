# =============================================================================
# ?( — A `?(` call and a `?.method()` call run only when the receiver is present, and give `none` when it is absent.
# =============================================================================
#
# What this teaches:
#   • `f?(x)` calls the optional function value `f` only when it is
#     present; when `f` is `none` the call does not run and the result is
#     `none`
#   • `obj?.method()` calls the method only when `obj` is present; an
#     absent receiver gives `none` and the method body does not run
#   • Both forms give `T ∪ none`, so a `coalesce` default can fill in the
#     absent case
#
# Common mistakes:
#   • Expecting an absent receiver's method to print or change anything:
#     its body never runs
#   • Expecting an absent receiver to give a default value: it gives
#     `none`, and `coalesce` supplies the default
#
# See also: optional-chain, optionalis, vel
# =============================================================================

type Op = (int) → int

class Greeter {
    let string name

    fn greet(string who) → string {
        print "greeting §"(who)
        return "hello §, I am §"(who, self.name)
    }
}

main {
    let Op ∪ none present ← int x → int ∴ x * 2
    let Op ∪ none absent ← null
    print present?(5)
    print absent?(5)
    print absent?(5) coalesce -1
    let int ∪ none found ← present?(1)
    print found

    let Greeter ∪ none here ← Greeter { name = "Aelia" }
    let Greeter ∪ none gone ← null
    print here?.greet("Brutus")
    print gone?.greet("Brutus")
    print gone?.greet("Brutus") coalesce "nobody"
}
