# =============================================================================
# ?. — A `?.method()` call runs only when the receiver is present, and gives `none` when it is absent.
# =============================================================================
#
# What this teaches:
#   • `obj?.method()` calls the method only when `obj` is present; an
#     absent receiver gives `none` and the method body does not run
#   • The result is `T ∪ none`, so a `coalesce` default can fill in the
#     absent case
#
# Common mistakes:
#   • Expecting an absent receiver's method to print or change anything:
#     its body never runs
#   • Expecting an absent receiver to give a default value: it gives
#     `none`, and `coalesce` supplies the default
#
# See also: chain-call, optional-chain, optionalis, vel
# =============================================================================

class Greeter {
    let string name

    fn greet(string who) → string {
        print "greeting §"(who)
        return "hello §, I am §"(who, self.name)
    }
}

main {
    let Greeter ∪ none here ← Greeter { name = "Aelia" }
    let Greeter ∪ none gone ← null
    print here?.greet("Brutus")
    print gone?.greet("Brutus")
    print gone?.greet("Brutus") coalesce "nobody"
}
