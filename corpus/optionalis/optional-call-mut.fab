# A mut argument through an optional call updates its caller.

type Op = (mut list<int>) → int

fn push(mut list<int> xs) → int {
    xs.append(9)
    return xs.length()
}

main {
    let Op ∪ none f ← push
    mut list<int> xs ← []
    print f?(mut xs)
    print xs.length()
}
