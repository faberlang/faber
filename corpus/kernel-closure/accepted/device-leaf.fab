# =============================================================================
# nucleum — kernel closure calls an existing named device leaf
# =============================================================================
# The named leaf is an existing device function boundary. The local closure
# remains private and composes into the caller rather than becoming a public
# launch entry.
# =============================================================================

@ kernel
fn device_leaf(int value) → int {
    return value + 1
}

@ kernel
fn caller(int input) → int {
    const _ region ← (int value) kernel → int ∴ device_leaf(value)
    return region(input)
}
