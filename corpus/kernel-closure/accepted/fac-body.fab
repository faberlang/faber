# =============================================================================
# nucleum — kernel closure with a do/fac body
# =============================================================================
# `do` is the English reader spelling of the existing block body law. Kernel
# status belongs to the closure signature, not to `do`.
# =============================================================================

main {
    const _ twice ← (int value) kernel → int ∴ do {
        const int shifted ← value + 1
        return shifted * 2
    }
    const int result ← twice(5)
}
