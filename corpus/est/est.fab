# =============================================================================
# est — Tests whether a value's runtime type is a given type.
# =============================================================================
#
# What this teaches:
#   • Type checking — `<expr> est <type>` tests a valor's runtime variant tag without extraction.
#   • Null checking — `<expr> est null` tests the null type (the null value is `null`).
#   • Negation — `<expr> non est <type>` negates the type check.
#   • Chaining — `est` composes with `et` and parenthesized expressions.
#
# Common mistakes:
#   • Using `est` to compare values — its right-hand side is always a type; use `≡` (or `≢`) for value comparison: `<expr> ≡ verum`, `<expr> ≡ falsum`.
#
# See also: non est, ≡
# =============================================================================


# est — type and null checks
#
# <expr> est null       — null-type check (lowers to is_nil)
# <expr> est <type>      — variant tag check (lowers to matches!)
# <expr> non est <type>  — negated variant tag check
#
# Value comparison is the equality family's job:
# <expr> ≡ verum         — exact true comparison
# <expr> ≡ falsum        — exact false comparison
#
# GRAMMAR:
#   typeCheckExpr :← expr 'est' type
#
# EXPECTED OUTPUT:
#   est.expected

fn explora(any x) → string {
    if x is none then return "nihil est"
    return "aliud est"
}

fn explora_bivalens(bool x) → string {
    if x ≡ true then return "verum est"
    if x ≡ false then return "falsum est"
    return "aliud est"
}

main {
    # Null checking with est
    let int ∪ none forsitan ← null
    let nihil_est ← forsitan is none
    print nihil_est

    # Boolean true comparison with ≡
    let enabled ← true
    let verum_est ← enabled ≡ true
    print verum_est

    # Boolean false comparison with ≡
    let disabled ← false
    let falsum_est ← disabled ≡ false
    print falsum_est

    # Chained with logical operators
    let string ∪ none nomen ← null
    let defectum_debet ← nomen is none and enabled ≡ true
    print defectum_debet

    # Parenthesized for clarity
    let utraque_nihil ← forsitan is none and nomen is none
    print utraque_nihil

    # Dynamic ignotum dispatch for nihil and exact boolean checks on bivalens
    print explora(null)
    print explora_bivalens(true)
    print explora(42)

    # --- Variant checks against concrete types ---
    #
    # `est <type>` tests a valor's runtime variant tag directly, without
    # attempting extraction. The inner type parameters of lista/tabula are
    # not checked (width and element types are erased at Valor boxing time
    # by design — see docs/factory/est-variant-check/goal.md).

    let value name ← "faber" ↦ value
    let value quantitas ← 42 ↦ value
    let value notae ← ["a", "b"] ↦ value
    let value active ← true ↦ value
    let value proportio ← 1.5 ↦ value
    assert name is string
    assert quantitas is int
    assert notae is list<value>
    assert active is bool
    assert proportio is float
    assert quantitas not is string
    assert name not is int
}
