# =============================================================================
# scriptum — named hole left unfilled
# =============================================================================
#
# What this teaches:
#   • Every named hole (`§{b}`) must be filled by a labeled actual of the same
#     name; a labeled actual naming no hole is also rejected.
#   • The pinned identity of this exemplum is `unfillable_template_hole`; the
#     stray `extra` label additionally reports `unknown_template_hole_label`.
#
# Common mistakes:
#   • Supplying an unrelated label instead of the one the template names.
#
# See also: scriptum, named-holes, forma
#
# This exemplum intentionally fails to compile.
# =============================================================================

main {
    let string out ← "§{a} §{b}"(a: "x", extra: "y")
    print out
}
