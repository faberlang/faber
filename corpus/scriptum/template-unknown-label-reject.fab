# =============================================================================
# scriptum — a labeled actual must name a declared hole
# =============================================================================
#
# What this teaches:
#   • `§{label}` declares a named hole; a labeled actual `label: value` fills
#     exactly that hole.
#   • An actual whose label names no declared hole is reported as
#     `unknown_template_hole_label` and lowering stops.
#   • The same call also leaves `greet` unfilled, which reports
#     `unfillable_template_hole` alongside; this exemplum pins the unknown
#     label.
#
# Common mistakes:
#   • Passing `other: …` to a template that declares `§{greet}`.
#
# See also: lege, lineam — and the positive twin `scriptum.fab`.
# =============================================================================

# scriptum unknown-label reject — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let string out ← "§{greet} world"(other: "salve")
    print out
}
