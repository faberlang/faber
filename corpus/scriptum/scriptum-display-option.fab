+++
term = "scriptum-display-option"
kind = "concept"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "scriptum_expr", "call_expr", "call_suffix", "argument_list", "argument", "expression", "literal", "nota_stmt"]
category = "format"
canonical = true
summary = "A `§` slot shows an option exactly as `print` does: an absent option as `nihil`, a present one as its value."
syntax = "\"<template>\"(<option>)"
