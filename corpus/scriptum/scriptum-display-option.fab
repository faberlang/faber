locale = "en"
+++
# =============================================================================
# scriptum-display-option — an option in a `§` slot
# =============================================================================
#
# What this teaches:
#   • An absent option placed in a `§` slot reads `nihil`, exactly as a bare
#     `print` of it does; a present option reads as the value it holds.
#
# Common mistakes:
#   • Expecting the host language's spelling of an absent value (`null`,
#     `nil`, `None`) in the template text.
#
# See also: scriptum, scriptum-display
# =============================================================================

# scriptum-display-option — absent and present options inside `§` slots
#
# EXPECTED OUTPUT:
#   scriptum-display-option.expected — each template line, then the same values printed alone.

main {
    let int ∪ none absent ← null
    let int ∪ none present ← 4

    print "absent=§"(absent)
    print "present=§"(present)

    print absent
    print present
}
