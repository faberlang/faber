# =============================================================================
# scriptum — one actual per value slot
# =============================================================================
#
# What this teaches:
#   • A template application is checked against its slot count before it is
#     lowered: `"§ §"` has two value slots, so it needs two actuals.
#   • The arity defect is reported as `template_application_arity_mismatch`
#     and lowering stops instead of producing a template with unfilled slots.
#
# Common mistakes:
#   • Supplying one argument for a template with two `§` slots.
#
# See also: lege, lineam — and the positive twin `scriptum.fab`.
# =============================================================================

# scriptum arity reject — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let string out ← "§ §"("x")
    print out
}
