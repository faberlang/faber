# =============================================================================
# scriptum — mixed labeled and positional actuals
# =============================================================================
#
# What this teaches:
#   • One application is either all-labeled (named holes) or all-positional
#     (anonymous `§` holes); the two forms do not mix.
#
# Common mistakes:
#   • Writing a positional argument next to a labeled one in the same call.
#
# See also: scriptum, named-holes, forma
#
# This exemplum intentionally fails to compile.
# =============================================================================

main {
    let string out ← "§{a} §"("x", a: "y")
    print out
}
