# =============================================================================
# scriptum — type arguments on a template application
# =============================================================================
#
# What this teaches:
#   • A string-template application is not a generic call: a turbofish between
#     the literal and its argument list is parsed and then refused in lowering.
#
# Common mistakes:
#   • Annotating the result through `<string>` instead of writing the type slot
#     on the binding (`let string s ← "§"("x")`).
#
# See also: scriptum, named-holes, forma
#
# This exemplum intentionally fails to compile.
# =============================================================================

main {
    let string s ← "§"<string>("x")
    print s
}
