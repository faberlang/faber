# =============================================================================
# praefixum = — Computes a block-level constant at build time.
# =============================================================================
#
# What this teaches:
#   • One initializer surface — `comptime { … }` takes the same positions a
#     module constant does: a block-level `const T x = comptime { … }` inside a
#     function, a method, or the entry block. The `_` slot takes the type of
#     the body's `return`.
#   • The body runs once, during the build, and the program carries the
#     finished literal. Every backend sees an ordinary local with a constant
#     value.
#   • The body stands alone: it may read module constants, call pure
#     functions, and use its own locals. It may not read a parameter or a
#     local of the enclosing body (that is a build error, `praefixum_captures_local`),
#     and inside a generic function or genus it may not mention the type
#     parameter (`praefixum_type_parameter`). Hoist what it needs to a
#     module-level `const`.
#   • A body may hold another `comptime` constant; the inner one runs first.
#
# Common mistakes:
#   • Reading an enclosing parameter or local from the body — compute it
#     inside the body, or hoist it to a module constant.
#   • Using `comptime` outside an `=` constant — `x ← comptime { … }` and
#     `1 + comptime { … }` are `praefixum_outside_constant`.
#
# See also: praefixum, fixum, insere
# =============================================================================

# praefixum = — build-time computation of a block-level constant
#
# GRAMMAR:
#   fixum_decl     :← 'fixum' type_annotation IDENTIFIER '=' const_init
#   const_init     :← expression
#   praefixum_expr :← 'praefixum' block_stmt
#
# EXPECTED OUTPUT:
#   praefixum-local.expected — the values computed at build time.

const int LATUS = comptime {
    return 4
}

fn quadratum(int n) → int {
    return n * n
}

class Cista {
    mut int n

    fn ter() → int {
        const int factor = comptime {
            return 3
        }
        return self.n * factor
    }
}

fn grid_cells(int multiplier) → int {
    # Computed once at build time, read at run time.
    const int cells = comptime {
        return LATUS * LATUS
    }
    return cells * multiplier
}

fn dash_line() → string {
    const string dashes = comptime {
        mut string acc ← ""
        for range 0‥6 const i {
            acc ← acc + "-"
        }
        return acc
    }
    return dashes
}

fn squares_upto() → list<int> {
    const list<int> squares = comptime {
        mut list<int> acc ← empty
        for range 1‥6 const i {
            acc.append(quadratum(i))
        }
        return acc
    }
    return squares
}

main {
    const int seven = comptime {
        return quadratum(2) + 3
    }
    const _ total_sq = comptime {
        mut int total ← 0
        for range 1‥5 const i {
            total ← total + quadratum(i)
        }
        return total
    }
    const int nested = comptime {
        const int inner = comptime {
            return 2
        }
        return inner + 1
    }
    print seven
    print total_sq
    print nested
    print grid_cells(2)
    print dash_line()
    print squares_upto()
    let Cista holder ← Cista { n = 5 }
    print holder.ter()
}
