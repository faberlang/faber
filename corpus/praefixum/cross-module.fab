grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "importa_decl", "importa_sugar", "named_import", "fixum_decl", "type_annotation", "owned_type", "base_type", "multiplicative_expr", "member_suffix", "praefixum_expr", "call_expr", "call_suffix", "argument_list", "incipit_stmt", "nota_stmt", "expression", "literal"]
category = "comptime"
canonical = false
summary = "An importer's comptime constant folds an imported constant and a call to an imported pure function."
syntax = "const <type> <name> = comptime { … return <namespace>.<CONST> + <expression> }"
