# =============================================================================
# praefixum — Sibling module for cross-module comptime folding
# =============================================================================
#
# What this teaches:
#   • An exported `const` and an exported pure `fn` are visible to an importer
#     inside its `comptime { … }` initializers as `module.NAME` and `module.fn()`.
#
# See also: praefixum, importa
# =============================================================================

# praefixum numeri — sibling module for praefixum/cross-module.fab
#
# `BASE` is exported with `@ public`; `septem` with `@ public { }`. The importer
# folds `numeri.BASE + 1` and `numeri.septem()` at build time.
#
# EXPECTED OUTPUT:
#   5 when run standalone.

@ public
const int BASE = 5

@ public { }
fn septem() → int {
    return 7
}

main {
    print BASE
}
