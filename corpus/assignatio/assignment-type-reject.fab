# =============================================================================
# ← — Assigning a value of the wrong type is refused by name.
# =============================================================================
#
# What this teaches:
#   • the declared type of a binding is the type of every later store
#   • `←` checks the value against the place; it does not retype the place
#
# Common mistakes:
#   • storing a string into an `int` binding — `assignment_type_mismatch`
#
# See also: assignatio, fixum
# =============================================================================

# assignatio reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    mut int x ← 1
    x ← "s"
    print x
}
