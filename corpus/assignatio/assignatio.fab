+++
term = "←"
explains = ["⊜", "←", "=", "⊚", "⊘", "⊛"]
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "expr_stmt", "assignment", "additive_expr", "multiplicative_expr", "expression", "literal", "nota_stmt"]
category = "binding"
canonical = true
summary = "Assigns a value to a binding, field, or assignable expression."
syntax = "<place> ← <expression>"
