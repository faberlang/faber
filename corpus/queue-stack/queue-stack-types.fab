# =============================================================================
# queue<T[, N]> / stack<T[, N]> — C1 declaration surface
# =============================================================================
#
# The unbounded and N-bounded forms are distinct semantic types. Runtime
# receiver operations are later queue-stack units, not this declaration probe.
# =============================================================================

type IntQueue = queue<int>

type BoundedIntQueue = queue<int, size 8>

type TextStack = stack<string>

type BoundedTextStack = stack<string, size 8>

fn accepts(queue<int> q, queue<int, size 8> bounded_q, stack<string> s, stack<string, size 8> bounded_s) → void {
}

# =============================================================================
# C2 receiver methods — FIFO/LIFO walkers and the settled asymmetry
# =============================================================================

fn queue_walk(queue<int> input) → int ∪ none {
    mut queue<int> q ← copy input
    q.append(1)
    return q.remove_first()
}

fn stack_walk(stack<string> input) → string ∪ none {
    mut stack<string> s ← copy input
    s.append("top")
    return s.remove_last()
}

fn queue_length(queue<int> input) → int {
    return input.length()
}

# Bounded push remains a recoverable alternate exit; an empty pop yields `null`.
fn bounded_queue_push(queue<int, size 2> input) → void ⇥ string {
    mut queue<int, size 2> q ← copy input
    q.append(1)
}

# =============================================================================
# C4 access law — iteration order and nullable-pop recovery
# =============================================================================

# `for from` reads a queue in insertion order (FIFO).
fn queue_iteration(queue<int> input) → void {
    for from input let item {
        print item
    }
}

# `for from` reads a stack in removal order (top-first LIFO).
fn stack_iteration(stack<int> input) → void {
    for from input let item {
        print item
    }
}

# Empty pop is `T ∪ none`, so `coalesce` recovers a value instead of entering ⇥.
# The in-place pop lands on a local copy, like the C2 walkers above.
fn queue_pop_recover(queue<int> input) → int {
    mut queue<int> q ← copy input
    return q.remove_first() coalesce 0
}

fn stack_pop_recover(stack<int> input) → int {
    mut stack<int> s ← copy input
    return s.remove_last() coalesce 0
}

# =============================================================================
# C5 — numeric elementwise arithmetic, scalar broadcast, and bounded min capacity
# =============================================================================

fn queue_add(queue<int> left, queue<int> right) → queue<int> {
    return left + right
}

fn queue_broadcast(int scalar, queue<int> values) → queue<int> {
    return scalar * values
}

fn stack_sub(stack<int> left, stack<int> right) → stack<int> {
    return left - right
}

fn bounded_queue_min(queue<int, size 8> left, queue<int, size 3> right) → queue<int, size 3> {
    return left ⊘ right
}

fn bounded_stack_min(stack<int, size 5> left, stack<int, size 2> right) → stack<int, size 2> {
    return left + right
}
