# =============================================================================
# nihil — The null value and nullable union bindings.
# =============================================================================
#
# What this teaches:
#   • the `null` value (la `nulla`) — the sole value of the `none` type (la `nihil`)
#   • nullable union types with `∪` — `T ∪ none` (la `T ∪ nihil`) for values that may be absent
#   • null checks with `is none` and `not is none` (la `est nihil` / `non est nihil`)
#
# Common mistakes:
#   • Storing `null` without declaring the type as `T ∪ none` — the null value requires a nullable union type.
#
# See also: ∪, sponte, nihil
# =============================================================================

# literalia/nihil — the null value and T ∪ none
#
# GRAMMAR:
#   literal :← 'null'
#   unionType :← type '∪' 'none'
#
# EXPECTED OUTPUT:
#   nihil, verum, 42
#
# BACKEND:
#   Cross-ref nihil/nihil.fab.

fn maybe() → int ∪ none {
    return 42
}

main {
    let int ∪ none absent ← null
    print absent
    let bool nihilne ← absent is none
    print nihilne
    print maybe() not is none
}
