+++
term = "verum"
kind = "keyword"
category = "literal"
canonical = true
summary = "Boolean literals verum and falsum with bivalens bindings."
syntax = "verum | falsum"
related = ["falsum", "bivalens", "verum"]
locale = "en"
+++
main {
    const bool enabled ← true
    const bool disabled ← false
    print enabled
    print disabled
    print enabled and not disabled
}
