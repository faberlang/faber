main {
    print "a\tb"
    print "a\nb"
    print "q\"q"
    print "back\\slash"
    print "u\u{41}\u{1F600}\u{e9}"
    print "cr[\r]x"
    let string s ← "a\tb"
    print s.length()
    print «a\»b»
    print «a\\b»
    print «a"b'c»
    print «\u{41}\n\t.»
}
