# =============================================================================
# char — A char literal is a call argument, a return value and a class field, and prints as its letter.
# =============================================================================
#
# What this teaches:
#   • A one-letter literal `'x'` is a `char` wherever a `char` is
#     expected: a call argument, a return value, a `let` field and a `mut`
#     field
#   • A `char` compares by value: `c ≡ 'e'` is true for the same letter
#   • A `char` prints as its letter
#
# Common mistakes:
#   • Writing `"x"` where a `char` is wanted: that is a `string` and does
#     not fit a `char` slot
#   • Expecting a `char` to hold more than one letter: it is one Unicode
#     scalar value
#
# See also: char, conversio/littera, ascii
# =============================================================================

class Cell {
    let char glyph
    mut char alt
}

fn echo(char c) → char {
    return c
}

fn dash() → char {
    return '-'
}

fn is_vowel(char c) → bool {
    return c ≡ 'a' or c ≡ 'e' or c ≡ 'i' or c ≡ 'o' or c ≡ 'u'
}

main {
    print echo('x')
    print dash()
    mut Cell cell ← Cell { glyph = 'q', alt = '?' }
    print cell.glyph
    print cell.alt
    cell.alt ← echo('z')
    print cell.alt
    print is_vowel('e')
    print is_vowel('z')
}
