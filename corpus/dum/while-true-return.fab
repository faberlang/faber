# =============================================================================
# dum — `while true` with a return inside.
# =============================================================================
#
# What this teaches:
#   • Diverging loop — `while true` never falls through, so the function's tail needs no return.
#   • Return from inside a loop — `return value` exits the function from within the loop body.
#
# Common mistakes:
#   • Expecting the loop to fall through — `while true` without a `break` or `return` never ends.
#
# See also: dum, redde, rumpe
# =============================================================================

fn f() → int {
    mut int i ← 0
    while true {
        i ← i + 1
        if i ≡ 3 {
            return i
        }
    }
}

main {
    print f()
}
