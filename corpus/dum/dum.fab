grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "assignment", "place", "dum_stmt", "comparison", "additive_expr", "multiplicative_expr", "adfirma_stmt", "proba_stmt", "expression", "literal"]
category = "control-flow"
canonical = true
summary = "Repeats a block while a condition remains true."
syntax = "dum <condition> <block|ergo statement>"
aliases = ["while"]
