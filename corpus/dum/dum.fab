test "dum counts up to its condition" {
    mut int computus ← 0
    while computus ≺ 5 {
        computus ← computus + 1
    }
    assert computus ≡ 5
}

test "dum counts down to zero" {
    mut int reliquum ← 3
    while reliquum ≻ 0 {
        reliquum ← reliquum - 1
    }
    assert reliquum ≡ 0
}
# =============================================================================
# dum — Repeats a block while a condition remains true.
# =============================================================================
#
# What this teaches:
#   • While loop — `dum <condition> { <body> }` repeats a block as long as the condition is true.
#   • Loop variable mutation — mutable `varia` bindings allow counter-based loop control.
#   • Ascending and descending loops — counting up from 0 or down from N until the condition is falsum.
#
# Common mistakes:
#   • Using `rumpe` or `perge` outside a loop — `perge` needs an enclosing loop (`dum`, `itera`, `fac … dum`) in the same function (SEM031); `rumpe` also accepts a plain `fac` block (SEM030).
#
# See also: si, ergo, fac
# =============================================================================

# dum — while loop
#
# dum <condition> { <body> }
#
# GRAMMAR:
#   loopStmt :← 'dum' expr '{' stmt* '}'
#
# EXPECTED OUTPUT:
#   dum.expected

main {
    # Ascending counter: varia so the loop variable can mutate
    mut int computus ← 0
    while computus ≺ 5 {
        print computus
        computus ← computus + 1
    }

    # Descending loop: condition becomes falsum at 0
    mut int reliquum ← 3
    while reliquum ≻ 0 {
        print "reliquum: §"(reliquum)
        reliquum ← reliquum - 1
    }
    print "perfectum!"
}
