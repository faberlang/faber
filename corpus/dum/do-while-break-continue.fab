# =============================================================================
# dum — do-while with continue and break.
# =============================================================================
#
# What this teaches:
#   • `do { … } while <condition>` runs the body first, then tests the condition.
#   • `continue` skips the rest of one iteration; `break` leaves the loop at once.
#
# Common mistakes:
#   • Expecting `continue` to re-test the condition first — it goes to the loop's
#     condition test, not to the top of the body.
#   • Placing the increment after `continue` — it is skipped, so the loop can hang.
#
# See also: rumpe, perge, si
# =============================================================================

main {
    mut int i ← 0
    do {
        i ← i + 1
        if i ≡ 2 { continue }
        if i ≡ 5 { break }
        print i
    } while i ≺ 10
    print "end §"(i)
}
