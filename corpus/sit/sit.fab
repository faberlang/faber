# =============================================================================
# sit — Declares an inferred immutable local.
# =============================================================================
#
# What this teaches:
#   • Write-once binding — `sit name` declares an inferred-type local that
#     is written once
#   • Supports immediate init (`sit x ← expr`) and deferred init
#     (`sit x` then `x ← expr` later)
#
# Common mistakes:
#   • Confusing `sit` with `varia` — `sit` creates a write-once binding.
#
# See also: fixum, varia, ←
# =============================================================================



# sit — inferred immutable bindings
#
# Immediate init:
#   sit nomen ← expr        -- inferred write-once local
#
# Deferred init:
#   sit nomen               -- deferred: assign once later
#   nomen ← expr
#
# `sit` infers the type; write `sit T nomen ← expr` to state it. `fixum` is for
# compile-time constants only.
#
# GRAMMAR:
#   sitDecl := 'sit' IDENTIFIER ('←' expression)?
#
# EXPECTED OUTPUT:
#   sit.expected

main {
    let salve ← "Salve"
    let nomen ← "Marcus"
    let nuntius ← "§, §!"(salve, nomen)

    print nuntius

    let label
    label ← "deferred"
    print label

    let idem ← nuntius
    print idem
}