+++
term = "vel"
explains = ["vel"]
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "sit_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "functio_decl", "param_list", "parameter", "return_clause", "redde_stmt", "si_stmt", "call_expr", "call_suffix", "argument_list", "argument", "vel_expr", "vel_rhs", "proba_stmt", "adfirma_stmt", "equality", "equality_tail", "expression", "literal", "nota_stmt"]
category = "logic"
canonical = true
summary = "Provides a default when the left side is null."
syntax = "<expression> vel <expression>"
aliases = ["nullish coalescing"]
related = ["nihil"]
locale = "en"
+++
test "vel supplies a fallback for nihil" {
    let string ∪ none nomen ← null
    let ostensum ← nomen coalesce "ignotus"
    assert ostensum ≡ "ignotus"
}

test "vel preserves non-nihil values" {
    let nihilum ← 0
    let vacuus ← ""
    let falsus2 ← false
    assert nihilum coalesce 999 ≡ 0
    assert vacuus coalesce "defectum" ≡ ""
    assert falsus2 coalesce true ≡ false
}

test "vel chains to the first non-nihil value" {
    let string ∪ none a ← null
    let string ∪ none b ← null
    let string ∪ none c ← "inventum"
    let primum ← ((a coalesce b) coalesce c) coalesce "nihil"
    assert primum ≡ "inventum"
}
# =============================================================================
# vel — Provides a default when the left side is null.
# =============================================================================
#
# What this teaches:
#   • Nullish coalescing — `vel` supplies a fallback when the left operand is `nihil`
#   • Chaining — multiple `vel` expressions fall through until the first non-`nihil` value
#   • Short-circuit — like `et`/`aut`, the right operand runs only when the left is `nihil`
#
# Common mistakes:
#   • confusing vel (nullish coalescing, checks nihil only) with aut (logical OR), or using vel for conversio recovery instead of ⇥
#
# See also: nihil
# =============================================================================




# vel — nullish coalescing (not logical OR)
#
# <expr> vel <expr>   -- right side only when left is nihil
#
# GRAMMAR:
#   coalesceExpr :← expr 'vel' expr
#
# EXPECTED OUTPUT:
#   ignotus, Marcus, 0, false, defectum, inventum, 7, supplementum, 9 (vel.expected).

fn fortasse(bool adest) → int ∪ none {
    if adest { return 7 }
    return null
}

fn supplementum(int valor) → int {
    print "supplementum"
    return valor
}

main {
    # Basic nihil coalescing
    let string ∪ none nomen ← null
    let ostensum ← nomen coalesce "ignotus"
    # "ignotus"
    print ostensum

    # With present value
    let string ∪ none adest ← "Marcus"
    let ostensum2 ← adest coalesce "ignotus"
    # "Marcus"
    print ostensum2

    # Difference from logical aut: vel only checks nihil
    let nihilum ← 0
    let vacuus ← ""
    let falsus2 ← false

    # vel preserves non-nihil values
    # 0
    print nihilum coalesce 999
    # ""
    print vacuus coalesce "defectum"
    # falsum
    print falsus2 coalesce true
    let alter ← nomen coalesce "defectum"
    print alter

    # Chaining
    let string ∪ none a ← null
    let string ∪ none b ← null
    let string ∪ none c ← "inventum"
    let primum ← ((a coalesce b) coalesce c) coalesce "nihil"
    # "inventum"
    print primum

    # Short-circuit: the fallback runs only when the left side is nihil
    # 7 (no "supplementum" line)
    print fortasse(true) coalesce supplementum(9)
    # "supplementum", then 9
    print fortasse(false) coalesce supplementum(9)
}
