# iace — a throw needs an alternate exit
#
# h has no ⇥ error channel and no do/catch handler, so the throw has nowhere
# to go: the checker rejects the file (SEM010 iace_requires_alternate_exit).

fn h() → int {
    throw "x"
}

main {
    print h()
}
