# =============================================================================
# iace — an await binder outside an async context is a check error
# =============================================================================
# An await binder (`await_const` / `figendum`) suspends the callable that
# contains it. A synchronous body has nowhere to suspend, so the binding is
# refused before any code is emitted.

fn work() async → int {
    return 1
}

fn sync() → int {
    await_const int v ← work()
    return v
}

main {
    print sync()
}
