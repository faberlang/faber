# =============================================================================
# functio — A handler that falls through continues after the block
# =============================================================================
#
# What this teaches:
#   • A `redde` inside `fac { }` returns from the enclosing function — but
#     only on the path where the body succeeds.
#   • When the body fails, the `cape` handler runs. A handler that does not
#     leave (`redde`, `iace`) is not the end of the function: execution
#     continues with the statement after the block.
#   • A handler that throws sends its error out through the function's own
#     `⇥` channel.
#
# Common mistakes:
#   • Reading `fac { … redde … } cape { }` as "always returns": on failure
#     the function carries on after the block.
#
# See also: functio, ⇥, fac, cape, redde
# =============================================================================

# functio — guarded return with a fall-through handler
#
# EXPECTED OUTPUT:
#   handled-return-fallthrough.expected — one line per print.

fn risky(int n) → int ⇥ string {
    if n ≻ 5 {
        throw "too big"
    }
    return n
}

# An empty handler: failure falls through to the code after the block.
fn attempt(int n) → string ⇥ string {
    do {
        let int v ← risky(n)
        return "ok §"(v)
    }
    catch err {
    }
    return "caught"
}

# A handler with a side effect that still falls through.
fn recover(int n) → string ⇥ string {
    do {
        let int v ← risky(n)
        return "ok §"(v)
    }
    catch err {
        print "recovering: §"(err)
    }
    return "fell through"
}

# A handler that leaves: through the function's own ⇥ channel.
fn escalate(int n) → string ⇥ string {
    do {
        let int v ← risky(n)
        return "ok §"(v)
    }
    catch err {
        throw "wrapped: §"(err)
    }
    return "unreached"
}

main {
    print attempt(1)
    print attempt(9)
    print recover(2)
    print recover(7)
    do {
        print escalate(3)
        print escalate(8)
        print "unreached"
    }
    catch err {
        print "outer: §"(err)
    }
}
