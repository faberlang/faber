# =============================================================================
# functio — Failable function returns with ⇥ error channel and fac/cape recovery
# =============================================================================
#
# What this teaches:
#   • Failable function returns with ⇥ error channel and fac/cape recovery.
#   • Related keywords: functio, ⇥, fac, cape
#
# Common mistakes:
#   • Calling a failable function (`→ T ⇥ E`) without handling the error path — wrap in `fac { ... } cape err { ... }` or declare `⇥` on the enclosing function.
#
# See also: functio, ⇥, fac, cape
# =============================================================================

# functio fallibilis — failable return with ⇥ error channel
#
# functio … → T ⇥ E
# fac { … }
# cape err { … }
#
# GRAMMAR:
#   funcDecl :← 'functio' ident '(' params ')' '→' type '⇥' type block
#
# EXPECTED OUTPUT:
#   5 then 0 (recovered from division-by-zero).
#
# BACKEND:
#   Rust/Go lowering does not emit failable ⇥ syntax yet — compile-only smoke.

fn divide(int a, int b) → int ⇥ string {
    if b ≡ 0 then throw "division by zero"
    return a / b
}

# Non-failable wrapper: cape intercepts ⇥ textus from divide
fn tutum(int a, int b) → int {
    do {
        return divide(a, b)
    }
    catch err {
        # log the error channel value
        warn err
        return 0
    }
}

main {
    print tutum(10, 2)
    print tutum(10, 0)
}
