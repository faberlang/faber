# =============================================================================
# failable async function — a ⇥ failure leaves at await
# =============================================================================
#
# What this teaches:
#   • An async finite function can declare its own `⇥` channel.
#   • The call creates an async result; the failure leaves when the caller
#     awaits it, so the handler surrounds the await rather than the call.
#   • An async function with the same `⇥` channel can await and propagate the
#     failure to its own caller.
#
# EXPECTED OUTPUT:
#   failable-async.expected — one line per print.

fn compute(int n) async → int ⇥ string {
    if n ≻ 3 then throw "too big"
    return n * 2
}

fn relay(int n) async → int ⇥ string {
    await_const int v ← compute(n)
    return v + 1
}

async_main {
    do {
        await_const int v ← compute(2)
        print v
    }
    catch e { print "compute caught: §"(e) }

    do {
        await_const int v ← compute(5)
        print v
    }
    catch e { print "compute caught: §"(e) }

    do {
        await_const int v ← relay(2)
        print v
    }
    catch e { print "relay caught: §"(e) }

    do {
        await_const int v ← relay(5)
        print v
    }
    catch e { print "relay caught: §"(e) }
}
