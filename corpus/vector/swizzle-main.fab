fn permute(vf32[4] v) → vf32[4] {
    return v.swizzle("wzyx")
}

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    let vf32[4] v ← [flat[0], flat[1], flat[2], flat[3]] ↦ vf32[4]

    print permute(v)
    print permute(v).dot(v)
    print permute(permute(v))
}
