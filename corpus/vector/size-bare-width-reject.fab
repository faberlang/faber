# =============================================================================
# vector<T, N> — the bare lane count is retired
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • A vector lane count is a count, so the long form writes it after `size`: `vector<f32, size 4>`. The `vf32[4]` shorthand keeps its brackets, which already mark an extent.
#
# Common mistakes:
#   • Writing the lane count as a bare number or name in the long form; it takes `size` first.

fn passthrough(vector<f32, 4> v) → vector<f32, 4> {
    return v
}

