# =============================================================================
# vector — vector elementwise arithmetic lowers for GPU text emit.
# =============================================================================
#
# What this teaches:
#   • Elementwise operations — `addita`, `subtrahe`, `multiplica`, `divida` per-element
#   • GPU kernel composition — chaining elementwise ops in `@ nucleum` functions
#
# Common mistakes:
#   • mixing vector and tensor arithmetic methods in the same expression — vector arithmetic uses GPU register intrinsics
#
# See also: vector, gpu, nucleum
# =============================================================================



@ kernel
@ public
fn addita(f32 x) → f32 {
    let vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    let vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    let vf32[4] c ← a.added(b)
    return c.dot(b)
}

@ kernel
@ public
fn subtrahe(f32 x) → f32 {
    let vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    let vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    let vf32[4] c ← a.subtracted(b)
    return c.dot(b)
}

@ kernel
@ public
fn multiplica(f32 x) → f32 {
    let vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    let vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    let vf32[4] c ← a.multiplied(b)
    return c.dot(b)
}

@ kernel
@ public
fn divida(f32 x) → f32 {
    let vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    let vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    let vf32[4] c ← a.divided(b)
    return c.dot(b)
}
