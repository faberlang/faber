# =============================================================================
# vector — vector elementwise arithmetic lowers for GPU text emit.
# =============================================================================
#
# What this teaches:
#   • Elementwise operations — `addita`, `subtrahe`, `multiplica`, `divida` per-element
#   • GPU kernel composition — chaining elementwise ops in `@ nucleum` functions
#
# Common mistakes:
#   • mixing vector and tensor arithmetic methods in the same expression — vector arithmetic uses GPU register intrinsics
#
# See also: vector, gpu, nucleum
# =============================================================================



@ kernel
fn addita(float<f32> x) → float<f32> {
    const vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    const vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    const vf32[4] c ← a.added(b)
    return c.dot(b)
}

@ kernel
fn subtrahe(float<f32> x) → float<f32> {
    const vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    const vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    const vf32[4] c ← a.subtract(b)
    return c.dot(b)
}

@ kernel
fn multiplica(float<f32> x) → float<f32> {
    const vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    const vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    const vf32[4] c ← a.multiply(b)
    return c.dot(b)
}

@ kernel
fn divida(float<f32> x) → float<f32> {
    const vf32[4] a ← [x, 2.0, 3.0, 4.0] ↦ vf32[4]
    const vf32[4] b ← [1.0, 1.0, 1.0, 1.0] ↦ vf32[4]
    const vf32[4] c ← a.divide(b)
    return c.dot(b)
}
