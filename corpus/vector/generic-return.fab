# =============================================================================
# vector — a width-generic vector returned from a generic function
# =============================================================================
#
# What this teaches:
#   • `size N` binds the width from the argument: calling with a
#     `vector<f32, size 3>` makes the result `vector<f32, size 3>`.
#   • The call result needs no annotation: `let _ w ← idv(v)` infers the
#     bound width, and a call can be printed directly.
#   • The body can compute with the generic width (`v + v`).
#
# Common mistakes:
#   • annotating the result with a different width than the argument's — the
#     width is bound once per call, so both must agree
#
# See also: vector, generic, magnitudo
#
# EXPECTED OUTPUT:
#   generic-return.expected
# =============================================================================

fn idv<size N>(vector<f32, size N> v) → vector<f32, size N> {
    return v
}

fn dbl<size N>(vector<f32, size N> v) → vector<f32, size N> {
    return v + v
}

main {
    let vector<f32, size 3> v ← [3.0, 4.0, 0.0] ↦ vector<f32, size 3>
    print idv(v)
    let _ w ← dbl(v)
    print w
    print dbl(idv(v))
}
