# =============================================================================
# vector — a vector is a silent value, so `b ← a` copies
# =============================================================================
#
# What this teaches:
#   • `b ← a` COPIES a vector. The two bindings hold independent lanes, so a
#     write through one is invisible to the other.
#   • A lane write (`b[0] ← 9.0`) therefore leaves `a[0]` at 1.0 on every
#     target, not only where the carrier happens to be a value.
#   • This is why `ref` is refused over a vector, exactly as over a scalar
#     (`SEM008 scalar_access_marker`): there is no storage for a marker to
#     name.
#
# Common mistakes:
#   • Reading `b ← a` as an alias and expecting `a[0]` to change. Write
#     `ref` for a second name — which a vector refuses, so the intent is
#     always the copy.
#
# See also: vector, vector-index
#
# EXPECTED OUTPUT:
#   copy-on-assign.expected
# =============================================================================

main {
    let vf32[3] a ← [1.0, 2.0, 3.0] ↦ vf32[3]
    mut vf32[3] b ← a
    b[0] ← 9.0
    print a[0]
    print b[0]
}
