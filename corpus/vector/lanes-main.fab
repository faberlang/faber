category = "vector"
canonical = false
summary = "Run-time vector lanes can be read, written in a loop, and reduced from a host main."
syntax = "<vector>[<integer expression>]"
related = ["vector", "dot"]
locale = "en"
+++
fn lane_sum(vf32[4] v) → f32 {
    mut f32 total ← 0.0
    mut int j ← 0
    while j ≺ 4 {
        total ← total + v[j]
        j ← j + 1
    }
    return total
}

fn scale(vf32[4] v, f32 s) → vf32[4] {
    mut vf32[4] out ← v
    mut int j ← 0
    while j ≺ 4 {
        out[j] ← v[j] * s
        j ← j + 1
    }
    return out
}

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    let vf32[4] v ← [flat[0], flat[1], flat[2], flat[3]] ↦ vf32[4]
    print lane_sum(v)
    print scale(v, 2.0)
    print v[3]
}
