# =============================================================================
# vector — constant lane read and write with v[k]
# =============================================================================
#
# What this teaches:
#   • `v[k]` on a `vector<T, size N>` is one lane of the register value, typed as
#     the element `T` (f32 and i32 alike), with `k` a constant below `N`.
#   • After a null assertion the same form reads a lane: `hit![0]`.
#   • A lane read is a value, so a sum over lanes needs no loop.
#   • A lane of a `mut` vector can be written: `v[1] ← 9.0`.
#
# Common mistakes:
#   • indexing with a constant outside the width — `v[3]` on a three-lane
#     vector is rejected at check time, not at run time
#   • indexing with a run-time value — only constant lanes are supported today
#
# See also: vector, dot
#
# EXPECTED OUTPUT:
#   vector-index.expected
# =============================================================================

fn normal(int code) → vector<f32, size 3> ∪ none {
    if code ≡ 1 then return [-1.0, 0.0, 0.5] ↦ vector<f32, size 3>
    return null
}

main {
    let vector<f32, size 3> v ← [1.0, 2.0, 3.0] ↦ vector<f32, size 3>
    let vector<i32, size 4> w ← [10, 20, 30, 40] ↦ vector<i32, size 4>
    print v[1]
    let f32 a ← v[2]
    print a
    print w[3]
    let vector<f32, size 3> ∪ none hit ← normal(1)
    print hit![2]
    print v[0] + v[1] + v[2]
    mut vector<f32, size 3> u ← [1.0, 2.0, 3.0] ↦ vector<f32, size 3>
    u[1] ← 9.0
    print u
}
