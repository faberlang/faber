# =============================================================================
# vector — A scalar operator against a vector
# =============================================================================
#
# What this teaches:
#   • Lifted arithmetic — `+ - * / % ÷` with a scalar on either side apply to each lane
#   • Unary minus — `-v` negates each lane
#   • True division and extrema — `÷`, `⤒`, `⤓` also pair two vectors of one width
#   • New values — the result is a new vector; the operand is not changed
#   • Same rule as a tensor — an untyped literal adopts the vector's element type
#
# Common mistakes:
#   • writing `a * b` for two vectors — it is not elementwise; use `⊙` or the dot `·`
#   • writing `a / b` for two vectors — use `⊘` (floor) or `÷` (true division)
#   • mixing an integer scalar with a float vector — convert one operand with `↦`
#
# See also: vector, tensor, fractus
# =============================================================================

# vector — scalar lifting
#
# WHY: rule 15 lifts the scalar operators over a vector exactly as over a
# tensor. `s - v` keeps its operand order: each lane is `s - v[i]`.
#
# EXPECTED stdout: see lift-scalar.expected

fn scaled(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return a * s
}

fn scaled_left(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return s * a
}

fn shrunk(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return a / s
}

fn inverted(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return s / a
}

fn shifted(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return s - a
}

fn remainder(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return a % s
}

fn lifted(vector<f32, size 3> a) → vector<f32, size 3> {
    return a + 1.0
}

fn flipped(vector<f32, size 3> a) → vector<f32, size 3> {
    return -a
}

fn halved(vector<f32, size 4> a) → vector<f32, size 4> {
    return a * 0.5
}

fn true_scaled(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return a ÷ s
}

fn true_paired(vector<f32, size 3> a, vector<f32, size 3> b) → vector<f32, size 3> {
    return a ÷ b
}

fn raised(vector<f32, size 3> a, f32 s) → vector<f32, size 3> {
    return a ⤒ s
}

fn lowered(vector<f32, size 3> a, vector<f32, size 3> b) → vector<f32, size 3> {
    return a ⤓ b
}

main {
    let vector<f32, size 3> a ← [1.0, 2.0, 4.0] ↦ vector<f32, size 3>
    print scaled(a, 2.5)
    print scaled_left(a, 2.5)
    print shrunk(a, 4.0)
    print inverted(a, 8.0)
    print shifted(a, 10.0)
    print remainder(a, 3.0)
    print lifted(a)
    print flipped(a)
    print a
    let vector<f32, size 4> w ← [1.0, 2.0, 3.0, 4.0] ↦ vector<f32, size 4>
    print halved(w)
    print true_scaled(a, 4.0)
    let vector<f32, size 3> b ← [4.0, 2.0, 1.0] ↦ vector<f32, size 3>
    print true_paired(a, b)
    print raised(a, 2.0)
    print lowered(a, b)
}
