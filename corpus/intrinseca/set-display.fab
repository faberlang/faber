# =============================================================================
# copia — a set prints in list shape
# =============================================================================
#
# What this teaches:
#   • `print` shows a set as `[a, b]`, the same shape as a list, with each
#     element rendered exactly as it renders inside a list.
#   • An empty set prints `[]`.
#   • Set order is unspecified (D19.2) and the print never sorts, so a set with
#     more than one element is materialized to a list and sorted first.
#
# Common mistakes:
#   • printing a multi-element set directly and expecting a fixed order
#
# See also: copia, lista, ↦
# =============================================================================

# EXPECTED OUTPUT:
#   [3]
#   ["x"]
#   []
#   [3, 5, 7]

main {
    var set<int> one ← empty
    one.add(3)
    print one

    var set<string> name ← empty
    name.add("x")
    print name

    const set<int> blank ← empty
    print blank

    var set<int> several ← empty
    several.add(7)
    several.add(3)
    several.add(5)
    var list<int> ordered ← several ↦ list<int>
    ordered.sort()
    print ordered
}
