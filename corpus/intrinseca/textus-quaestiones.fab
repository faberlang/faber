# =============================================================================
# textus — Compiler-owned textus query methodi
# =============================================================================
#
# What this teaches:
#   • Compiler-owned textus query methodi.
#   • Related keywords: textus, intrinseca
#
# Common mistakes:
#   • Using `textus` query methods on non-text types — `.contains()`, `.starts_with()`, `.ends_with()` are textus-only compiler intrinsics.
#
# See also: textus, intrinseca
# =============================================================================

# textus query intrinsics
#
# Compiler-owned textus methodi — longitudo, continet, initium, finis.
#
# GRAMMAR:
#   s.length() | s.contains(sub) | s.starts_with(prefix) | s.ends_with(suffix)
#
# Predicate methodi return bivalens; Wasm tier Runnable.
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.

main {
    const _ nuntius ← " Ave Roma "
    const _ longitudo ← nuntius.length()
    const _ habetroma ← nuntius.contains("Roma")
    const _ initiumest ← nuntius.starts_with(" Ave")
    const _ finisest ← nuntius.ends_with(" ")
    print longitudo, habetroma, initiumest, finisest
}
