+++
# =============================================================================
# empty — typed empty collections, plus an empty-named binding
# =============================================================================
#
# What this teaches:
#   • Typed empty collection construction with the en marker `empty`.
#   • A binding named `empty` is legal; RHS `empty` claims as the marker.
#   • The name is unreferenceable in expression position (null-like shadowing).
#
# Common mistakes:
#   • Using `vacua` under en — the Latin spelling is rejected after V-5.
#   • Using `empty` without an explicit declared type — the compiler cannot infer the collection type from `empty` alone; always annotate the type (SEM014).
#
# See also: empty, list, map, set
# =============================================================================
#
# GRAMMAR:
#   mut map<K,V> t ← empty
#   mut list<T> res ← empty
#   mut set<T> visi ← empty
#   mut list<int> empty ← empty   (binding legal; RHS is the marker)
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.
#
# BACKEND: Go e2e whitelist — collection method surface not yet lowered for Go.

main {
    mut map<string, int> map ← empty
    map["primus"] ← 42
    map["secundus"] ← 99
    mut list<string> res ← empty
    res.append("alpha")
    res.append("beta")
    mut set<int> visi ← empty
    visi.add(1)
    visi.add(2)
    let map<string, int> puncta ← { "aelia": 95, "balbus": 87 }
    let list<int> numeri ← [1, 2, 3] ∷ list<int>
    let list<string> claves ← ["primus", "secundus"] ∷ list<string>
    print map["primus"], res.length(), visi.has(2)
    print puncta["aelia"], numeri.first(), claves.last()

    # Shadowing pin last so earlier `empty` inits stay the marker.
    mut list<int> empty ← empty
}
