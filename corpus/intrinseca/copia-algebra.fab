# =============================================================================
# copia — Compiler-owned copia set-algebra methodi
# =============================================================================
#
# What this teaches:
#   • Compiler-owned copia set-algebra methodi.
#   • Related keywords: copia, intrinseca
#
# Common mistakes:
#   • Expecting set operations to modify in-place — `.union()`, `.intersection()`, `.difference()` return new copia values; they do not mutate the receiver.
#
# See also: copia, intrinseca
# =============================================================================

# copia<T> set-algebra intrinsics
#
# Compiler-owned copia<T> methodi — unio, intersectio, differentia,
# symmetrica, subcopia, supercopia.
#
# GRAMMAR:
#   a.union(b) | a.intersection(b) | a.difference(b) | a.symmetric_difference(b)
#   a.is_subset(b) | a.is_superset(b)
#
# Set operations return new copia<T> values; operands are not mutated.
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.
#
# BACKEND: Go e2e whitelist — copia method surface not yet lowered for Go.

main {
    var set<int> primi ← empty
    primi.add(1)
    primi.add(2)
    primi.add(3)

    var set<int> pares ← empty
    pares.add(2)
    pares.add(4)
    pares.add(6)

    const _ omnes ← primi.union(pares)
    const _ communia ← primi.intersection(pares)
    const _ reliqua ← primi.difference(pares)
    const _ disiuncta ← primi.symmetric_difference(pares)
    const _ subcopiaest ← communia.is_subset(omnes)
    const _ supercopiaest ← omnes.is_superset(communia)

    print omnes, communia, reliqua, disiuncta
    print subcopiaest, supercopiaest
}
