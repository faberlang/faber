# =============================================================================
# copia — Compiler-owned copia set-algebra methodi
# =============================================================================
#
# What this teaches:
#   • Compiler-owned copia set-algebra methodi.
#   • Related keywords: copia, intrinseca
#
# Common mistakes:
#   • Expecting set operations to modify in-place — `.union()`, `.intersection()`, `.difference()` return new copia values; they do not mutate the receiver.
#
# See also: copia, intrinseca
# =============================================================================

# copia<T> set-algebra intrinsics
#
# Compiler-owned copia<T> methodi — unio, intersectio, differentia,
# symmetrica, subcopia, supercopia.
#
# GRAMMAR:
#   a.union(b) | a.intersection(b) | a.difference(b) | a.difference_symmetric(b)
#   a.is_subset(b) | a.is_superset(b)
#
# Set operations return new copia<T> values; operands are not mutated.
# copia iteration order is unspecified (D19.2); each result is materialized
# to a lista and sorted before printing.
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.
#
# BACKEND: Go e2e whitelist — copia method surface not yet lowered for Go.

main {
    mut set<int> primi ← empty
    primi.add(1)
    primi.add(2)
    primi.add(3)
    mut set<int> pares ← empty
    pares.add(2)
    pares.add(4)
    pares.add(6)
    let set<int> omnes ← primi.union(pares)
    let set<int> communia ← primi.intersection(pares)
    let set<int> reliqua ← primi.difference(pares)
    let set<int> disiuncta ← primi.difference_symmetric(pares)
    let bool subcopiaest ← communia.is_subset(omnes)
    let bool supercopiaest ← omnes.is_superset(communia)

    # copia iteration order is unspecified (D19.2) — sort before printing
    mut list<int> omnesOrd ← omnes ↦ list<int>
    omnesOrd.sort()
    mut list<int> communiaOrd ← communia ↦ list<int>
    communiaOrd.sort()
    mut list<int> reliquaOrd ← reliqua ↦ list<int>
    reliquaOrd.sort()
    mut list<int> disiunctaOrd ← disiuncta ↦ list<int>
    disiunctaOrd.sort()
    print omnesOrd, communiaOrd, reliquaOrd, disiunctaOrd
    print subcopiaest, supercopiaest
}
