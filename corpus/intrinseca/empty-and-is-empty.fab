# =============================================================================
# empty marker + is_empty intrinsic (en-pack-surface-fidelity V-1)
# =============================================================================
#
# What this teaches:
#   • The empty-collection marker spelling under en is `empty`.
#   • The collection intrinsic is `is_empty` — a separate concept.
#
# Pin: both spellings in one file so the concepts cannot cross-contaminate.
# en rejects `vacua` as the marker (V-5); null-like shadowing of a binding
# named `empty` is pinned by corpus/intrinseca/vacua-ascribere.fab.
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.

main {
    mut list<int> xs ← empty
    let bool vacant ← xs.is_empty()
    xs.append(1)
    print vacant, xs.is_empty(), xs.length()
}
