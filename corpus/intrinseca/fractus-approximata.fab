# =============================================================================
# fractus-approximata — default fuzzy ≈ and explicit .approx tolerance compare (DEFER-036)
# =============================================================================
#
# What this teaches:
#   • `≈` is the default fuzzy tolerance comparison.
#   • `.approx(aliud, toleratio)` / `approximata` supplies explicit tolerance.
#   • `≅` remains exact promoted equality.
#   • Fuzzy joins use the operands' own precision: f32 values round as f32.
#   • Related keywords: fractus, approximata, DEFER-036
#
# Common mistakes:
#   • Using `≅` when tolerance is intended — use `≈` for the default or `.approx(aliud, toleratio)` for explicit tolerance.
#
# See also: ≈, ≅, fractus, approximata, DEFER-036
# =============================================================================

# intrinseca/fractus-approximata — tolerance-based float compare (DEFER-036)
#
# EXPECTED OUTPUT:
#   verum
#   falsum
#   falsum
#   verum
#   verum
#   verum

main {
    const float a ← 42.145
    const float b ← 42.0

    const bool near ← a.approx(b, 0.2)
    const bool fuzzy ← a ≈ b
    const bool exact_promo ← a ≅ b

    print near
    print fuzzy
    print exact_promo

    # Cross-width and int↔float honesty rows follow the joined f64 formula.
    const i64 above_precision ← 9007199254740993
    const u64 below_precision ← 9007199254740992
    const f64 float_boundary ← 9007199254740992.0
    const bool fuzzy_cross_width ← above_precision ≈ below_precision
    const bool fuzzy_int_float ← above_precision ≈ float_boundary

    # Own-precision pin: both values round to 1.0 as f32 before isclose.
    const float<f32> f32a ← 1.00000001 ∷ float<f32>
    const float<f32> f32b ← 1.0 ∷ float<f32>
    const bool fuzzy_f32 ← f32a ≈ f32b

    print fuzzy_cross_width
    print fuzzy_int_float
    print fuzzy_f32
}