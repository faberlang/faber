# =============================================================================
# fractus-approximata — default fuzzy ≈ and explicit .approx tolerance compare (DEFER-036)
# =============================================================================
#
# What this teaches:
#   • `≈` is the default fuzzy tolerance comparison.
#   • `.approx(aliud, toleratio)` / `approximata` supplies explicit tolerance.
#   • `≅` remains exact promoted equality.
#   • Related keywords: fractus, approximata, DEFER-036
#
# Common mistakes:
#   • Using `≅` when tolerance is intended — use `≈` for the default or `.approx(aliud, toleratio)` for explicit tolerance.
#
# See also: ≈, ≅, fractus, approximata, DEFER-036
# =============================================================================

# intrinseca/fractus-approximata — tolerance-based float compare (DEFER-036)
#
# EXPECTED OUTPUT:
#   verum
#   falsum
#   falsum

main {
    const float a ← 42.145
    const float b ← 42.0

    const bool near ← a.approx(b, 0.2)
    const bool fuzzy ← a ≈ b
    const bool exact_promo ← a ≅ b

    print near
    print fuzzy
    print exact_promo
}