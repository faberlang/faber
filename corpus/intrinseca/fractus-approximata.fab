# =============================================================================
# fractus-approximata — DEFER-036 tolerance compare on fractus receiver (not ≈)
# =============================================================================
#
# What this teaches:
#   • DEFER-036 tolerance compare on fractus receiver (not ≈).
#   • Related keywords: fractus, approximata, DEFER-036
#
# Common mistakes:
#   • Using `≡` for floating-point comparison — direct float equality is unreliable; use `.approx(aliud, toleratio)` instead.
#
# See also: fractus, approximata, DEFER-036
# =============================================================================

# intrinseca/fractus-approximata — tolerance-based float compare (DEFER-036)
#
# EXPECTED OUTPUT:
#   verum
#   falsum

main {
    const float a ← 42.145
    const float b ← 42.0

    const bool near ← a.approx(b, 0.2)
    const bool exact_promo ← a ≈ b

    print near
    print exact_promo
}