# =============================================================================
# numeric-operator-methods — Receiver operator methods emit glyphs; imperativus mutates varia
# =============================================================================
#
# What this teaches:
#   • Receiver operator methods emit glyphs; imperativus mutates varia.
#   • Related keywords: numerus, fractus, mathesis
#
# Common mistakes:
#   • Calling operator methods like `.adde()` on a `fixum` binding — imperative mutation methods require `varia`.
#
# See also: numerus, fractus, mathesis
# =============================================================================

# intrinseca/numeric-operator-methods — receiver operator ledger smoke
#
# EXPECTED OUTPUT:
#   9.0
#   15.0
#   8

main {
    const float x ← 2.0
    const float chained ← x.addita(1.0).multiplicata(3.0)

    var float acc ← 10.0
    acc.adde(5.0)

    const int mask ← 12
    const int bits ← mask.coniuncta(10)

    print chained
    print acc
    print bits
}
