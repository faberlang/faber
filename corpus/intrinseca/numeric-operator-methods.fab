# =============================================================================
# numeric-operator-methods — Receiver operator methods emit glyphs; imperativus mutates varia
# =============================================================================
#
# What this teaches:
#   • Receiver operator methods emit glyphs; imperativus mutates varia.
#   • Related keywords: numerus, fractus, mathesis
#
# Common mistakes:
#   • Calling operator methods like `.add()` on a `sit` binding — imperative mutation methods require `varia`.
#
# See also: numerus, fractus, mathesis
# =============================================================================

# intrinseca/numeric-operator-methods — receiver operator ledger smoke
#
# EXPECTED OUTPUT:
#   9.0
#   15.0
#   8

main {
    let float x ← 2.0
    let float chained ← x.added(1.0).multiplied(3.0)
    mut float acc ← 10.0
    acc.add(5.0)
    let int mask ← 12
    let int bits ← mask.bit_and(10)
    print chained
    print acc
    print bits
}
