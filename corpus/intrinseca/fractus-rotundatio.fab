# =============================================================================
# fractus — Compiler-owned fractus rounding methodi
# =============================================================================
#
# What this teaches:
#   • Compiler-owned fractus rounding methodi.
#   • Related keywords: fractus, intrinseca
#
# Common mistakes:
#   • Confusing rounding modes — `.rotunda()` rounds to nearest, `.pavimentum()` floors, `.tectum()` ceilings, `.trunca()` truncates toward zero.
#
# See also: fractus, intrinseca
# =============================================================================

# fractus rounding intrinsics
#
# Compiler-owned fractus methodi — rotunda, pavimentum, tectum, trunca.
#
# GRAMMAR:
#   valor.rotunda() | valor.pavimentum() | valor.tectum() | valor.trunca()
#
# Rounding modes lower to per-target float intrinsics; Wasm tier Runnable.
#
# EXPECTED OUTPUT:
#   Smoke asserts exit 0 only.

main {
    const float value ← -3.75

    const _ rotundus ← value.rotunda()
    const _ basis ← value.pavimentum()
    const _ culmen ← value.tectum()
    const _ truncatus ← value.trunca()

    print rotundus, basis, culmen, truncatus
}
