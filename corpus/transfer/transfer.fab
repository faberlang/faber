# =============================================================================
# ⇇ — exact-output transfer (EBNF rows [126] transfer / [127] assignment).
# =============================================================================
#
# What this teaches:
#   • Callable sink — `sink ⇇ payload` invokes a callable sink value (one
#     argument, `vacuum` result) once per payload; the bound value owns
#     destination and behavior, and the compiler holds no console knowledge
#   • No formatting — the operator adds no separator or terminator, selects
#     no channel, and runs no conversions; formatting is explicit on the
#     right, e.g. `output ⇇ "§ §\n"(a, b)`
#   • Chain — `sink ⇇ a ⇇ b` evaluates the sink expression once, each payload
#     once left-to-right, and invokes the sink once per payload left-to-right;
#     the chain result is `vacuum`
#   • Precedence — `⇇` binds below assignment and above ternary: postfix
#     calls, conversions, and string-constructor applications finish before
#     transfer (EBNF [126] `transfer ::= ternary ('⇇' ternary)*`, consumed by
#     [127] `assignment ::= transfer ('←' assignment | '↤' assignment …)?`)
#   • Sinks arrive as values — the sink may be an imported callable (see
#     selective_import) or any callable local, parameter, or member value
#
# Common mistakes:
#   • expecting `⇇` to print — the compiler formats nothing; import a sink
#     value (e.g. `importa ex "norma:consolum" fixum dic ut output`) and
#     format explicitly on the right
#   • using the chain result — a transfer chain is `vacuum`, never a payload
#
# See also: selective_import, importa
# =============================================================================

functio mittite((textus) → vacuum sink, textus nomen) → vacuum {
    sink ⇇ nomen
}

functio mittite_duplex((textus) → vacuum sink, textus prior, textus posterior) → vacuum {
    sink ⇇ prior ⇇ posterior
}

incipit {
    fixum textus nomen ← "salve"
    nota nomen
}
