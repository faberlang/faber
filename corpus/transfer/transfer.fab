# =============================================================================
# ⇇ — copy-into (EBNF row [158] transfer, consumed by row [159] assignment).
# =============================================================================
#
# What this teaches:
#   • Writing in place — `target ⇇ value` copies every value of `value` INTO
#     the existing storage of `target`. `←` only ever rebinds a name; `⇇` is
#     the one way to write into a tensor that already exists
#   • Writable targets — the left side is tensor storage you may write: a
#     `mut` local, a `mut` parameter, or a field of a writable root. The write
#     is visible to the caller of a `mut` parameter and through every `←`
#     alias of the target (see copy-into-alias)
#   • Views on the right — the value may be any tensor expression, including a
#     view such as `source.transpose()`; the logical values are copied through
#     the destination's own layout
#   • Exact match — both sides have the same element type and the same shape
#   • Statement — a copy-into is a statement and its result is `vacuum`; it
#     does not chain and is never a value
#   • Precedence — `⇇` binds below every binary operator and above assignment
#     (EBNF [158] `transfer ::= ternary ('⇇' ternary)?`, consumed by [159]
#     `assignment`), so `target ⇇ a + b` copies the whole sum
#
# Common mistakes:
#   • writing `target ← value` into a `mut` tensor parameter of a kernel — a
#     kernel parameter is a device buffer with no binding to rebind, so a
#     whole-tensor `←` there is rejected (`mut_tensor_param_rebind`); write `⇇`
#   • a `let` or non-`mut` target, a scalar/list/matrix/vector target (a
#     value type is written by `←`), or a view target such as
#     `out.slice(0, 1) ⇇ x` — all rejected
#   • a right side that aliases the left, or a chain `a ⇇ b ⇇ c`
#   • using the retired callable-sink form `sink ⇇ payload` — it is retired
#     (`transfer_sink_retired`); output is `print`
#
# See also: tensor
# =============================================================================

# transfer — copy-into on tensors
#
# GRAMMAR:
#   transfer :← ternary ( '⇇' ternary )?
#
# EXPECTED stdout:
#   [1.0, 2.0, 3.0, 4.0]
#   [1.0, 3.0, 2.0, 4.0]
#   [2.0, 4.0, 6.0, 8.0]

fn fill_transposed(mut tf32[2, 2] target, tf32[2, 2] source) → void {
    target ⇇ source.transpose()
}

main {
    let list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    let list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]
    let tf32[2, 2] source ← flat_a ↦ tf32[2, 2]
    mut tf32[2, 2] target ← flat_b ↦ tf32[2, 2]

    # Into a mut tensor.
    target ⇇ source
    print target.flatten()

    # Into a mut parameter, from a view: the caller sees the write.
    fill_transposed(mut target, source)
    print target.flatten()

    # The right side is any tensor expression; the whole sum is copied.
    target ⇇ source + source
    print target.flatten()
}
