# =============================================================================
# ⇇ — a host `mut` tensor parameter may be rebound whole (R6, host side).
# =============================================================================
#
# What this teaches:
#   • `←` rebinds a name, and on the host that includes a `mut` tensor
#     parameter: `b ← a + a` is the ordinary rebind, not an error
#   • only a kernel parameter is a device buffer with no binding to rebind;
#     there a whole-tensor `←` is rejected (`mut_tensor_param_rebind`, see
#     copy-into-rebind-reject) and `⇇` is the one way to write it
#
# See also: ⇇, tensor
# =============================================================================

# EXPECTED stdout:
#   [2.0, 4.0, 6.0, 8.0]

fn double_into(tf32[2, 2] a, mut tf32[2, 2] b) → void {
    b ← a + a
    print b.flatten()
}

main {
    let list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    let list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]
    let tf32[2, 2] source ← flat_a ↦ tf32[2, 2]
    mut tf32[2, 2] target ← flat_b ↦ tf32[2, 2]
    double_into(source, mut target)
}
