# =============================================================================
# ⇇ — copy-into preserves storage identity (EBNF row [158] transfer).
# =============================================================================
#
# What this teaches:
#   • `←` only rebinds a name, so `alias ← target` makes a second name for the
#     same tensor storage, and `target ⇇ value` writes that storage in place;
#     the alias sees the new values without being rebound
#
# See also: ⇇, tensor
# =============================================================================

# EXPECTED stdout:
#   [1.0, 2.0, 3.0, 4.0]
#   [1.0, 2.0, 3.0, 4.0]

main {
    let list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    let list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]
    let tf32[2, 2] source ← flat_a ↦ tf32[2, 2]
    mut tf32[2, 2] target ← flat_b ↦ tf32[2, 2]
    let tf32[2, 2] alias ← target
    target ⇇ source
    print alias.flatten()
    print target.flatten()
}
