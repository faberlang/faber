+++
term = "⇇"
kind = "operator"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "assignment", "transfer", "expression", "ternary", "array_literal", "call_expr", "call_suffix", "argument_list", "argument", "member_suffix", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "width_type_sugar", "shape_suffix", "figura", "figura_list", "literal", "nota_stmt"]
category = "tensor"
canonical = false
summary = "Copy-into preserves storage identity: a write through ⇇ is visible through every ← alias of the target."
syntax = "<tensor storage> ⇇ <tensor>"
related = ["tensor", "⇇"]
locale = "en"
