# =============================================================================
# ⇇ — run-time extents make copy-into failable (EBNF row [158] transfer).
# =============================================================================
#
# What this teaches:
#   • a static shape mismatch in `⇇` is a compile error, but extents that are
#     run-time values cannot be decided at check time, so a `⇇` between them is
#     a failable statement: the function declares `⇥ string`
#   • the mismatch surfaces as an error value, so `do { } catch error { }`
#     recovers instead of the program dying, and only the catch line prints
#
# See also: ⇇, tensor, magnitudo, fac
# =============================================================================

fn runtime_extent(int value) → int {
    return value
}

fn assign<size N>(mut tf32[N] dst, tf32[N] src) → void ⇥ string {
    dst ⇇ src
}

main {
    let int n ← runtime_extent(2)
    let int m ← runtime_extent(3)
    let list<f32> l2 ← [1.0, 2.0]
    let list<f32> l3 ← [1.0, 2.0, 3.0]
    mut tf32[size n] d ← l2 ↦ tf32[size n]
    let tf32[size m] s ← l3 ↦ tf32[size m]
    do {
        assign(mut d, s)
        print d.flatten()
    } catch error {
        print "shape mismatch"
    }
}
