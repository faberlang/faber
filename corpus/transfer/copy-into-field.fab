# =============================================================================
# ⇇ — a genus (class) field is writable tensor storage (E17).
# =============================================================================
#
# What this teaches:
#   • a field of a writable root is a legal copy-into target, the same as a
#     `mut` local or a `mut` parameter; `b.data ⇇ s` writes into the storage
#     the field already owns
#   • the field is declared `mut` in the genus body — genus fields take
#     `let` (read-only) or `mut` (writable), never the retired `var`
#   • the field initializer keeps `=`: `Box { data = … }` is construction,
#     not a binding
#
# See also: ⇇, tensor
# =============================================================================

# EXPECTED stdout:
#   [5.0, 6.0]

class Box {
    mut tf32[2] data
}

main {
    mut Box b ← Box { data = [1.0, 2.0] ↦ tf32[2] }
    let tf32[2] s ← [5.0, 6.0] ↦ tf32[2]
    b.data ⇇ s
    print b.data.flatten()
}
