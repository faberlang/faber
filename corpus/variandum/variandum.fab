# =============================================================================
# variandum — Await-bind mutable
# =============================================================================
#
# What this teaches:
#   • Await a `promissum<T>` and bind the success value mutably.
#
# See also: figendum, tacebit, fiet, promissum
# =============================================================================

``
`fab
functio responde() fiet → numerus {
    redde 3
}

incipiet {
    variandum numerus responsum ← responde()
    responsum ← responsum + 1
    nota responsum
}
`
``
