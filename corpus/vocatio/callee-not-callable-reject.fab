# =============================================================================
# vocatio — calling a non-callable value is refused
#
# What this teaches:
#   • A call target must be a function, closure, or callable value
#
# Common mistake:
#   • calling an integer binding as if its name were a function
#
# See also: vocatio, call_expr
# =============================================================================
# This exemplum intentionally fails to compile.

main {
    let int x ← 1
    print x(2)
}
