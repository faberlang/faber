# =============================================================================
# valor — genus, lista, tabula, and tensor behind a valor
# =============================================================================
#
# What this teaches:
#   • Boxing — `T ↦ valor` keeps the composite itself behind the dynamic carrier; nothing is copied or converted.
#   • Display — a valor prints JSON-shaped whatever it holds: text unquoted, map keys quoted, a genus as an object in declaration order.
#   • Extraction — `valor ↦ T` takes the composite back out: a genus by its own type, a lista or tabula element by element.
#
# Common mistakes:
#   • Expecting `valor ↦ tensor` to return a boxed tensor — a tensor behind a valor prints but never extracts; compose through `lista<T>` (see valor-tensor).
#   • Printing a map with several keys and pinning its order — tabula order is unspecified, so this file boxes a single key.
#
# See also: ↦, valor, lista, tabula, genus, tensor
# =============================================================================

# conversio — composites behind a valor
#
# WHY: `valor` is the dynamic carrier, so the runner keeps a composite as it is
# behind one and displays it as JSON. This pins the display and the round trip
# for each flat composite family, separately from the scalar rows
# (valor-scalaria), the byte row (valor-boxing) and the deeper rows — nested
# genus, widening, recovery and tag tests (valor-composita-deep).

# The fields are declared y then x; the boxed object prints declaration order,
# not the order the literal below writes them.
class Punctum {
    mut int y
    mut int x
}

main {
    # 1. A genus: the object prints in field order and comes back with its fields.
    let Punctum punctum ← Punctum { x = 3, y = 4 }
    let value boxedGenus ← punctum ↦ value
    print boxedGenus
    let Punctum unboxed ← boxedGenus ↦ Punctum
    print unboxed.x
    print unboxed.y

    # 2. A lista: elements keep their type, so text is unquoted behind the valor and quoted again after.
    let list<int> numeri ← [1, 2]
    let value boxedNumeri ← numeri ↦ value
    print boxedNumeri
    let list<int> backNumeri ← boxedNumeri ↦ list<int>
    print backNumeri
    let list<string> verba ← ["a", "b"]
    let value boxedVerba ← verba ↦ value
    print boxedVerba
    let list<string> backVerba ← boxedVerba ↦ list<string>
    print backVerba

    # 3. A tabula: keys print quoted, and the map comes back key for key.
    let map<string, int> scores ← { "alpha": 10 }
    let value boxedScores ← scores ↦ value
    print boxedScores
    let map<string, int> backScores ← boxedScores ↦ map<string, int>
    print backScores.get("alpha") coalesce 0

    # 4. A tensor: it prints flat.
    let tensor<int, [2]> grid ← [5, 6] ↦ tensor<int, [2]>
    let value boxedGrid ← grid ↦ value
    print boxedGrid
}
