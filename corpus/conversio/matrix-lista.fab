# =============================================================================
# ↦ — Matrix to flat lista conversio.
# =============================================================================
#
# What this teaches:
#   • Shaped to flat conversion — a `matrix` converts into a flat `list<T>` of its cells.
#   • Row-major order — the cells lower in row-major order, so row 0 precedes row 1.
#
# Common mistakes:
#   • Expecting a nested lista — the target `list<T>` is flat, not one lista per row.
#
# See also: ↦, matrix, lista, tensor
# =============================================================================


# conversio — matrix to flat lista
#
# WHY: dropping the Figura leaves an unbounded flat lista of the cells in
# row-major order. The list `print` renders the flat elements.

main {
    let matrix<f32, [2, 2]> m ← [[1.0, 2.0], [3.0, 4.0]] ↦ matrix<f32, [2, 2]>
    let list<f32> l ← m ↦ list<f32>
    print l
}
