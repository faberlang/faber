# =============================================================================
# ↦ — lista<b8> as a tensor whose extent is a run-time size.
# =============================================================================
#
# What this teaches:
#   • A run-time extent — `magnitudo n` in the target shape reads the value
#     bound to `n`, so the byte count the conversion needs is known only when
#     it runs.
#   • Exact length — the byte count must equal `product(shape) * element width`
#     for the extents as they are at run time; no truncation, no padding.
#   • A wrong length is a recoverable failure: `fac { } cape err { }` handles
#     it, exactly as it does for a literal extent.
#
# Common mistakes:
#   • Naming a `magnitudo` parameter that no tensor argument witnesses as the
#     extent — Rust cannot read a value for it and declines by name. A
#     `magnitudo` parameter witnessed by a tensor argument axis works, as does
#     an expression extent over an in-scope binding (`magnitudo (n - 1)`).
#   • Omitting Be/Le — the byte order is never implied, for any element width.
#
# See also: ↦, lista<b8>, tensor, magnitudo
# =============================================================================


# conversio — lista<b8> ↦ tensor<E, [N, magnitudo n]> via Be|Le
#
# EXPECTED stdout: see octeti-tensor-runtime-extent-la.expected
#
# BACKEND:
#   The runner and Rust both compare the byte length with the product of the
#   extents when the conversion runs. TypeScript, Go and Swift decline by name.

functio runtime_extent(numerus value) → numerus {
    redde value
}

incipit {
    sit numerus n ← runtime_extent(3)
    sit lista<b8> raw ← |00 00 80 3f 00 00 00 40 00 00 40 40 00 00 80 40 00 00 a0 40 00 00 c0 40|
    sit lista<b8> short_raw ← |00 00 80 3f 00 00 00 40|

    sit tensor<f32, [2, magnitudo n]> grid ← raw ↦ tensor<f32, [2, magnitudo n]> via Le
    sit lista<numerus, 2> dims ← grid.magnitudines()

    nota grid[[0, 0]]
    nota grid[[1, 2]]
    nota dims

    fac {
        sit tensor<f32, [2, magnitudo n]> bad ← short_raw ↦ tensor<f32, [2, magnitudo n]> via Le
        nota bad[[0, 0]]
    }
    cape err {
        nota "caught"
    }
}
