# =============================================================================
# ↦ — Fixed-width ascii format pack from numerus.
# =============================================================================
#
# What this teaches:
#   • The type argument is capacity — `ascii<size N> via Hex` zero-pads to N digits.
#   • The `via` clause is the format hint — Hex/Bin/Oct; lowercase emission.
#   • Overflow, negatives, and floats fail closed (not shown here).
#
# Common mistakes:
#   • `n ↦ ascii<Hex>` — a type argument is never a hint; write `ascii<size N> via Hex`.
#   • Expecting `-ff` or two's-complement blowout from a negative source.
#
# See also: ↦, ascii, numerus
# =============================================================================


# conversio — n ↦ ascii<size N> via Hex|Bin|Oct
#
# <numerus> ↦ ascii<size N> via Hex|Bin|Oct
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'ascii' '<' N '>' 'via' radix
#
# EXPECTED OUTPUT:
#   ff
#   00000025
#   11111111
#   377
#
# BACKEND:
#   HIR-direct Rust and MIR-stepper routes must agree for ascii format pack.

main {
    let ascii<size 2> hex ← 255 ↦ ascii<size 2> via Hex
    let ascii<size 8> padded ← 37 ↦ ascii<size 8> via Hex
    let ascii<size 8> bin ← 255 ↦ ascii<size 8> via Bin
    let ascii<size 3> oct ← 255 ↦ ascii<size 3> via Oct
    let ascii<size 2> inferred_hex ← 255 ↦ ascii<_> via Hex
    let ascii<size 8> inferred_bin ← 255 ↦ ascii<_> via Bin
    let ascii<size 3> inferred_oct ← 255 ↦ ascii<_> via Oct
    print hex
    print padded
    print bin
    print oct
    print inferred_hex
    print inferred_bin
    print inferred_oct
}
