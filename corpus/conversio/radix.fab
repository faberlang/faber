# =============================================================================
# ↦ — Radix-parameterized integer parsing from textus.
# =============================================================================
#
# What this teaches:
#   • Radix-aware parsing — `textus ↦ i32 via Hex|Bin|Oct` parses integers with an explicit radix hint on the conversion.
#   • The `via` clause — the target type carries the width (`i32`) and the clause carries the radix (`Hex`), showing how a hint selects the conversion row.
#
# Common mistakes:
#   • Omitting the radix hint when parsing non-decimal text — use `i32 via Hex` for hex, `i32 via Bin` for binary, or `i32 via Oct` for octal.
#
# See also: ↦, numerus, textus
# =============================================================================


# conversio — radix-parameterized integer parsing
#
# <textus> ↦ i32 via Hex|Bin|Oct
#
# GRAMMAR:
#   convertExpr :← expr '↦' type ('via' radix)?
#
# EXPECTED OUTPUT:
#   255
#   10
#   493
#
# BACKEND:
#   HIR-direct Rust and MIR-stepper routes must agree for radix parsing.

main {
    let i32 hex ← "ff" ↦ i32 via Hex
    let i32 bin ← "1010" ↦ i32 via Bin
    let i32 oct ← "755" ↦ i32 via Oct
    print hex
    print bin
    print oct
}
