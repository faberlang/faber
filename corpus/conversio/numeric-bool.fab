# =============================================================================
# ↦ — Scalar numeric and bivalens primitive conversio.
# =============================================================================
#
# What this teaches:
#   • Numeric truncation — `fractus ↦ numerus` truncates toward zero (Rust `as` default).
#   • Truthiness from numbers — `fractus ↦ bivalens` and `numerus ↦ bivalens` use non-zero truthiness.
#   • Bool-to-number — `bivalens ↦ numerus` yields 0/1; `bivalens ↦ fractus` yields 0.0/1.0.
#   • Byte reinterpretation boundary — numerus/fractus/bivalens ↔ octeti is rejected at typecheck (use chorda instead).
#
# Common mistakes:
#   • Expecting `fractus ↦ numerus` to round rather than truncate — it truncates toward zero like Rust `as`.
#
# See also: ↦, numerus, fractus, bivalens
# =============================================================================


# conversio — numeric and bivalens primitive conversions
#
# WHY: `↦` owns the normal expectation for scalar numeric/bool conversions.
# `fractus ↦ numerus` truncates toward zero (Rust `as` default). `fractus ↦
# bivalens` and `numerus ↦ bivalens` use non-zero truthiness. `bivalens ↦
# numerus` yields 0/1. `bivalens ↦ fractus` uses 1.0/0.0 because `bool as f64`
# is invalid in Rust. `ascii ↦ bivalens` parallels `textus ↦ bivalens`.
# Byte reinterpretation (`numerus`/`fractus`/`bivalens` ↔ `octeti`) is rejected
# at typecheck — use `chorda` instead. See docs/factory/conversio-numeric-bool-coverage/.

main {
    const float pi ← 3.7
    const int truncated ← pi ↦ int
    print truncated
    const bool fromFractus ← pi ↦ bool
    print fromFractus
    const int count ← 42
    const bool fromNumerus ← count ↦ bool
    print fromNumerus
    const bool flag ← true
    const int asInt ← flag ↦ int
    const float asFloat ← flag ↦ float
    print asInt
    print asFloat
    const ascii token ← 'yes'
    const bool fromAscii ← token ↦ bool
    print fromAscii
}
