# =============================================================================
# conversio-narrowing-cape — a bare failing numeric ↦ is recoverable
# =============================================================================
#
# What this teaches:
#   • `300 ↦ u8`, `1e300 ↦ int` and a NaN `↦ int` fail without `⊥`; the
#     failure is the recoverable `⇥` channel, so `fac { … } cape err { … }`
#     catches it directly and a `⇥ string` function propagates it to its
#     caller's `cape` (D1.11).
#
# See also: ↦, ⊥, ⇥, fac, cape
# =============================================================================

fn narrow(int n) → u8 ⇥ string {
    return n ↦ u8
}

fn truncate(float x) → int ⇥ string {
    return x ↦ int via Trunc
}

main {
    const int big ← 300
    const float huge ← 1e300
    const float zero ← 0.0
    const float nan ← zero / zero

    do {
        const u8 a ← big ↦ u8
        print a
    }
    catch err {
        print "caught direct narrowing"
    }
    do {
        const u8 b ← narrow(big)
        print b
    }
    catch err {
        print "caught propagated narrowing"
    }
    do {
        const int c ← huge ↦ int via Trunc
        print c
    }
    catch err {
        print "caught direct float overflow"
    }
    do {
        const int d ← truncate(nan)
        print d
    }
    catch err {
        print "caught propagated NaN"
    }
    do {
        const int e ← truncate(2.5)
        print e
    }
    catch err {
        print "unreachable"
    }
}
