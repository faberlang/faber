# =============================================================================
# ↦ — lista<b8> as a tensor whose extent is a magnitudo parameter witnessed by the
# tensor argument.
# =============================================================================
#
# What this teaches:
#   • A `magnitudo N` parameter in the target shape and a `tensor<f32, [N]>`
#     argument that witnesses it: the extent is read from the argument's axis
#     when the conversion runs, so the byte count is known only then.
#   • Exact length — the byte count must equal `product(shape) * element width`
#     for the extents as they are at run time; no truncation, no padding.
#   • A wrong length is a recoverable failure: `fac { } cape err { }` handles
#     it, exactly as it does for a literal extent.
#
# Common mistakes:
#   • Naming a `magnitudo` parameter that no tensor argument witnesses — no
#     lane can read a value for it, so the conversion is declined by name. A
#     `magnitudo` parameter witnessed by a tensor argument axis works, as does
#     an expression extent over an in-scope binding (`magnitudo (n - 1)`).
#   • Omitting Be/Le — the byte order is never implied, for any element width.
#
# See also: ↦, lista<b8>, tensor, magnitudo
# =============================================================================


# conversio — lista<b8> ↦ tensor<E, [N]> via Be|Le
#
# EXPECTED stdout: see octeti-tensor-size-param-la.expected
#
# BACKEND:
#   The runner and Rust both compare the byte length with the product of the
#   extents when the conversion runs, reading the witnessed magnitudo
#   parameter from the tensor argument. TypeScript, Go and Swift decline by name.

functio runtime_extent(numerus value) → numerus {
    redde value
}

functio decode<magnitudo N>(tensor<f32, [N]> proto, lista<b8> raw) → tensor<f32, [N]> ⇥ textus {
    redde raw ↦ tensor<f32, [N]> via Le
}

incipit {
    sit numerus n ← runtime_extent(3)
    sit lista<f32> values ← [1.0, 2.0, 3.0]
    sit tensor<f32, [magnitudo n]> proto ← values ↦ tensor<f32, [magnitudo n]>
    sit lista<b8> raw ← |00 00 80 3f 00 00 00 40 00 00 40 40|

    fac {
        sit tensor<f32, [magnitudo n]> decoded ← decode(proto, raw)
        nota decoded[[0]]
        nota decoded[[2]]
        sit lista<numerus, 1> dims ← proto.magnitudines()
        nota dims
    }
    cape err {
        nota "unexpected"
    }

    sit lista<b8> short_raw ← |00 00 80 3f 00 00 00 40|
    fac {
        sit tensor<f32, [magnitudo n]> bad ← decode(proto, short_raw)
        nota bad[[0]]
    }
    cape err {
        nota "caught"
    }
}
