# =============================================================================
# regex — Regex carrier construction from textus and ascii.
# =============================================================================
#
# What this teaches:
#   • Regex carrier creation — `textus ↦ regex` and `ascii ↦ regex` construct a regex pattern carrier from text inputs.
#   • Failable conversion — the conversion compiles the pattern, so a pattern the RE2 dialect rejects fails with a textus payload that starts with a stable construct id (`syntax`, `lookahead`, …); `fac`/`cape` (or a `⇥ textus` function) handles it.
#
# Common mistakes:
#   • Assuming an invalid pattern is preserved — the conversion fails at the `↦`, not at the first match.
#   • Matching on the engine's prose — only the leading construct id is stable.
#
# See also: ↦, regex, textus, ascii
# =============================================================================


# conversio — regex carrier construction
#
# WHY: `↦ regex` is failable. A pattern that does not compile fails the
# conversion itself with a payload that starts with a stable construct id, then
# detail text. Only the id is a contract: `syntax` for a malformed pattern,
# `lookahead` for a construct the RE2 dialect does not have.

main {
    const string digitsWire ← "\\d+"
    const regex digits ← digitsWire ↦ regex
    print digits
    const ascii wordWire ← '(?i)[a-z]+'
    const regex word ← wordWire ↦ regex
    print word
    const string brokenWire ← "\\d["
    do {
        const regex broken ← brokenWire ↦ regex
        print broken
    }
    catch err {
        if err.starts_with("syntax") {
            print "rejected: syntax"
        }
    }
    const string lookaheadWire ← "a(?=b)"
    do {
        const regex lookahead ← lookaheadWire ↦ regex
        print lookahead
    }
    catch err {
        if err.starts_with("lookahead") {
            print "rejected: lookahead"
        }
    }
}
