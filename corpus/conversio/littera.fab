category = "conversion"
canonical = false
summary = "A char (littera) is a one-letter string: numbers convert to their digits, and code points use the Code hint."
syntax = "<n> ↦ string | ascii | char, <char> ↦ int | string, <string> ↦ char, <char> ↦ u32 via Code, <n> ↦ char via Code"
