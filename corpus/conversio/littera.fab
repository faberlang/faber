# =============================================================================
# char — conversions of a one-letter string (littera, D10.6).
# =============================================================================
#
# What this teaches:
#   • A char means a one-letter string, so a number converted to any text type
#     is its digits: `7 ↦ string` is "7", `7 ↦ ascii` is "7", `7 ↦ char` is '7'.
#   • `n ↦ char` fails unless n is a single digit 0–9; `42 ↦ char` fails
#     because "42" is two letters.
#   • `c ↦ int` parses the digit and fails otherwise; `c ↦ string` is the
#     one-letter string and never fails.
#   • `s ↦ char` is the only letter of s and fails unless s has exactly one.
#   • `list<b8> ↦ string` decodes UTF-8 and can fail; `list<b8> ↦ ascii` checks every
#     byte is below 128; one byte converts through a window `b[i‥i+1] ↦ ascii`.
#   • Code points use the `Code` hint: `'A' ↦ u32 via Code` is 65 and
#     `65 ↦ char via Code` is 'A' (fails above U+10FFFF and on surrogates).
#   • Every failable row takes a `⊥` default (or propagates through `⇥`).
#     A one-letter literal is ascii<size 1>, so a bare ascii default needs two.
#
# Common mistakes:
#   • Expecting `65 ↦ char` to be 'A' — without `Code` it is the digits rule
#     and fails (two letters). A byte is a number, so `b ↦ char` is digits too.
#
# See also: ↦, char, string, ascii, list<b8>
# =============================================================================

main {
    # A number converted to text is its digits.
    let string s ← 7 ↦ string
    print s
    let ascii a ← 42 ↦ ascii
    print a
    let char seven ← 7 ↦ char ⊥ '?'
    print seven
    let char two ← 42 ↦ char ⊥ '?'
    print two

    # A char parses as its digit.
    let char d ← '7'
    let int n ← d ↦ int ⊥ -1
    print n
    let char x ← 'x'
    let int bad ← x ↦ int ⊥ -1
    print bad

    # A char is a one-letter string.
    let string letter ← x ↦ string
    print letter

    # A string converts to a char only with exactly one letter.
    let string u ← "ü"
    let char uc ← u ↦ char ⊥ '?'
    print uc
    let string pair ← "xy"
    let char pc ← pair ↦ char ⊥ '?'
    print pc

    # Bytes decode to text; one byte converts through a window.
    let list<b8> raw ← |68 69 ff|
    let string hi ← raw[0‥2] ↦ string ⊥ "?"
    print hi
    let string broken ← raw ↦ string ⊥ "?"
    print broken
    let ascii first ← raw[0‥1] ↦ ascii ⊥ '--'
    print first
    let ascii high ← raw[2‥3] ↦ ascii ⊥ '--'
    print high

    # Code points use the Code hint.
    let char big ← 'A'
    let u32 code ← big ↦ u32 via Code
    print code
    let char back ← 65 ↦ char via Code ⊥ '?'
    print back
    let char surrogate ← 55296 ↦ char via Code ⊥ '?'
    print surrogate
    let char beyond ← 1114112 ↦ char via Code ⊥ '?'
    print beyond
}
