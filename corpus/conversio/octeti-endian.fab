# =============================================================================
# ↦ — Endian integer unpack from an octeti window.
# =============================================================================
#
# What this teaches:
#   • Locked read form — `corpus[0‥4] ↦ u32 via Be` and `… ↦ u32 via Le`.
#   • Float read form — `corpus[0‥4] ↦ f32 via Be|Le` and `corpus[0‥8] ↦ f64 via Be|Le`.
#   • Convert hints — `Be` / `Le` are `via` hints, like `Hex` / `Bin` / `Oct`.
#   • Exact width — the window length must match the integer or float width (2 / 4 / 8).
#
# Common mistakes:
#   • Omitting Be/Le — `bytes ↦ u32` or `bytes ↦ f32` stays rejected (endian unspecified).
#   • Using a short window — a 3-byte source does not pad.
#
# See also: ↦, octeti, int
# =============================================================================


# conversio — octeti window ↦ W via Be|Le
#
# GRAMMAR:
#   convertExpr :← expr '↦' width 'via' endian
#
# EXPECTED OUTPUT:
#   3735928559
#   4022250974
#   1.0
#   1.0
#   1.0
#   1.0
#
# BACKEND:
#   HIR-direct Rust emits from_be_bytes / from_le_bytes. MIR-stepper agrees.

main {
    let _ be ← |de ad be ef|[0‥4] ↦ u32 via Be
    let _ le ← |de ad be ef|[0‥4] ↦ u32 via Le
    let _ f32_be ← |3f 80 00 00|[0‥4] ↦ f32 via Be
    let _ f32_le ← |00 00 80 3f|[0‥4] ↦ f32 via Le
    let _ f64_be ← |3f f0 00 00 00 00 00 00|[0‥8] ↦ f64 via Be
    let _ f64_le ← |00 00 00 00 00 00 f0 3f|[0‥8] ↦ f64 via Le
    print be
    print le
    print f32_be
    print f32_le
    print f64_be
    print f64_le
}
