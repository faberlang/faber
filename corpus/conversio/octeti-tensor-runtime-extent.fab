# =============================================================================
# ↦ — list<b8> as a tensor whose extent is a run-time size.
# =============================================================================
#
# What this teaches:
#   • A run-time extent — `size n` in the target shape reads the value bound to
#     `n`, so the byte count the conversion needs is known only when it runs.
#   • Exact length — the byte count must equal `product(shape) * element width`
#     for the extents as they are at run time; no truncation, no padding.
#   • A wrong length is a recoverable failure: `do { } catch err { }` handles it,
#     exactly as it does for a literal extent.
#
# Common mistakes:
#   • Naming a `size` parameter that no tensor argument witnesses as the
#     extent — Rust cannot read a value for it and declines by name. A `size`
#     parameter witnessed by a tensor argument axis works, as does an
#     expression extent over an in-scope binding (`size (n - 1)`).
#   • Omitting Be/Le — the byte order is never implied, for any element width.
#
# See also: ↦, list<b8>, tensor, magnitudo
# =============================================================================


# conversio — list<b8> ↦ tensor<E, [N, size n]> via Be|Le
#
# GRAMMAR:
#   convertExpr :← expr '↦' tensorType 'via' endian
#
# EXPECTED OUTPUT:
#   1.0
#   6.0
#   [2, 3]
#   caught
#
# BACKEND:
#   The runner and Rust both compare the byte length with the product of the
#   extents when the conversion runs. TypeScript, Go and Swift decline by name.

fn runtime_extent(int value) → int {
    return value
}

main {
    let int n ← runtime_extent(3)
    let list<b8> raw ← |00 00 80 3f 00 00 00 40 00 00 40 40 00 00 80 40 00 00 a0 40 00 00 c0 40|
    let list<b8> short_raw ← |00 00 80 3f 00 00 00 40|

    let tensor<f32, [2, size n]> grid ← raw ↦ tensor<f32, [2, size n]> via Le
    let list<int, _> dims ← grid.shape()

    print grid[[0, 0]]
    print grid[[1, 2]]
    print dims

    do {
        let tensor<f32, [2, size n]> bad ← short_raw ↦ tensor<f32, [2, size n]> via Le
        print bad[[0, 0]]
    }
    catch err {
        print "caught"
    }
}
