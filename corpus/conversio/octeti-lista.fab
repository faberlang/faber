# =============================================================================
# ↦ — Boundary bridge from octeti to lista<numerus<u8>>.
# =============================================================================
#
# What this teaches:
#   • Representation change — `bytes ↦ list<int<u8>>` copies the buffer once.
#   • Symmetric reverse — `list<int<u8>> ↦ bytes` is the live lista → octeti direction.
#   • One endian host — endian windows stay on octeti; lists are for element work.
#
# Common mistakes:
#   • Detouring through valor (`bytes ↦ value ↦ list<int>`) instead of the bulk bridge.
#   • Treating `bytes ↦ list<int>` (unsized) as the same convert — only u8 elements.
#
# See also: ↦, octeti, lista, numerus
# =============================================================================


# conversio — octeti ↦ lista<numerus<u8>>
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'list' '<' 'int' '<' 'u8' '>' '>'
#
# EXPECTED OUTPUT:
#   4
#   4
#
# BACKEND:
#   HIR-direct Rust emits a one-pass Vec<u8> copy. MIR-stepper agrees.

main {
    const bytes raw ← |de ad be ef|
    const list<int<u8>> asList ← raw ↦ list<int<u8>>
    const bytes back ← asList ↦ bytes

    print asList.length()
    print back.length()
}
