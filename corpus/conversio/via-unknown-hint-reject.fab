# =============================================================================
# Unknown conversion hint — a name is refused, never silently reinterpreted.
# =============================================================================
#
# What this teaches:
#   • Conversion hints are the fixed set Hex, Bin, Oct, Be, Le and Code.
#     An unknown word is refused by name instead of falling back.
#   • `via Hex` is the spelling that works; a hint on a target that takes
#     none is refused too.
#
main {
    let i32 parsed ← "ff" ↦ i32 via Base16
}
