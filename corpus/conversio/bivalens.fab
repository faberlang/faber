# =============================================================================
# ↦ — Conversion to bivalens.
# =============================================================================
#
# What this teaches:
#   • Number truthiness — `<number> ↦ bivalens` is false for zero and true otherwise.
#   • Text parsing — `<text> ↦ bivalens` parses exactly the code locale's two words (`true`, `false` in an `en` file) and fails on anything else; non-empty text is not true.
#   • Syntax shape — `<expr> ↦ bivalens` over numbers and text.
#
# Common mistakes:
#   • Expecting `"salve" ↦ bivalens` to be true — only the locale's own words parse; any other text fails.
#   • Confusing number truthiness (`0 ↦ bivalens` = false) with an explicit comparison — it is non-zero truthiness, not `≡ 0`.
#
# See also: ↦, bivalens
# =============================================================================


# conversio — conversion to bivalens
#
# <expr> ↦ bivalens
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'bivalens'
#
# EXPECTED OUTPUT:
#   false
#   true
#   false
#   true
#   true
#
# BACKEND:
#   HIR-direct Rust and MIR-stepper routes must agree for truthiness and word parsing.

main {
    let bool b1 ← 0 ↦ bool
    let bool b2 ← 42 ↦ bool
    print b1
    print b2
    let bool b3 ← "false" ↦ bool
    let bool b4 ← "true" ↦ bool
    print b3
    print b4
    let bool habet ← ("123" ↦ int ⊥ 0) ↦ bool
    print habet
}
