# =============================================================================
# ↦ — Converts a value with explicit runtime parsing or coercion semantics.
# =============================================================================
#
# What this teaches:
#   • Core conversion — the `↦` operator converts between types with explicit parsing (textus→numerus) and coercion (numerus→textus).
#   • Default with `⊥` — the `⊥` operator supplies a default value when conversion fails at runtime (`⇥` only names error types).
#   • Chaining — `↦` composes left-to-right for roundtrip conversions.
#
# Common mistakes:
#   • Confusing `∷` (compile-time type ascription) with `↦` (runtime conversion) and using `vel` instead of `⊥` for conversio recovery.
#
# See also: ∷, ⊥
# =============================================================================

# conversio — type conversion operator (↦)
#
# <expr> ↦ <typus>
# <expr> ↦ <typus><params>
#
# GRAMMAR:
#   convertExpr :← expr '↦' type
#
# EXPECTED OUTPUT:
#   conversio.expected
#
# BACKEND:
#   Siblings radix.fab and bivalens.fab compile-only until Go semantics align.

main {
    # ↦ converts textus → numerus
    const int n1 ← "42" ↦ int
    # ⊥ supplies a default on failure
    const int n2 ← "invalid" ↦ int ⊥ 0
    const int<i32> n3 ← "255" ↦ int<i32>
    const float f1 ← "3.14159" ↦ float
    const float f2 ← "invalid" ↦ float ⊥ 0.0
    const string s1 ← 42 ↦ string
    const string s2 ← 3.14 ↦ string
    const string s3 ← true ↦ string

    # chained ↦ left-to-right
    const string roundtrip ← ("42" ↦ int) ↦ string
    print n1
    print n2
    print n3
    print f1
    print f2
    print s1
    print s2
    print s3
    print roundtrip
}
