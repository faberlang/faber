# =============================================================================
# ↦ — Text and byte conversio between textus, ascii, and octeti.
# =============================================================================
#
# What this teaches:
#   • Text↔byte bridges — `textus ↦ octeti` (UTF-8 encode), `ascii ↦ octeti` (ASCII encode), `octeti ↦ textus` (UTF-8 decode), `octeti ↦ ascii` (ASCII narrow).
#   • Fallible decoding — byte-to-text conversions can fail on invalid bytes; recover with a `⊥` default.
#   • Stdlib foundation — these language-level bridges are what stdlib's chorda mechanical trio (pange/solve/tempta) builds on.
#
# Common mistakes:
#   • Assuming `octeti ↦ textus` always succeeds — invalid UTF-8 bytes require a `⊥` recovery value.
#
# See also: ↦, octeti, textus, chorda
# =============================================================================


# conversio — textus/ascii ↔ octeti (byte conversions)
#
# WHY: `↦ octeti` and `↦ textus`/`↦ ascii` are the standard Faber conversion
# paths between text and bytes. They are the language-level bridge that the
# stdlib's chorda mechanical trio (pange/solve/tempta) builds on, not a
# competitor to it. See DEFER-029 and docs/factory/octeti-unify-lista/.
#
# textus ↦ octeti: UTF-8 encode (lossless; String is already UTF-8 in Rust).
# ascii  ↦ octeti: ASCII encode (lossless; ASCII is a strict subset of UTF-8).
# octeti ↦ textus: UTF-8 decode (can fail on invalid bytes; use `⊥` for a default).
# octeti ↦ ascii:  ASCII narrow (can fail on any byte ≥ 128; use `⊥`).

main {
    # textus → octeti (UTF-8 encode)
    const string hi ← "hi"
    const list<b8> enc ← hi ↦ list<b8>
    print enc.length()

    # octeti → textus (UTF-8 decode, valid bytes)
    # "hi" in UTF-8
    const list<b8> raw ← |68 69|
    const string dec ← raw ↦ string
    print dec

    # octeti → textus with recovery (invalid UTF-8 → recovery value)
    const list<b8> badUtf8 ← |ff ff|
    const string recovered ← badUtf8 ↦ string ⊥ "?"
    print recovered

    # ascii → octeti
    const ascii a ← 'hi'
    const list<b8> aenc ← a ↦ list<b8>
    print aenc.length()

    # octeti → ascii (valid ASCII bytes)
    const ascii adec ← raw ↦ ascii
    print adec

    # octeti → ascii with recovery (non-ASCII byte → recovery value)
    # A one-scalar ascii literal is ascii<1>, which does not assign to bare
    # ascii. Recovery for ↦ ascii must be bare ascii (a multi-char literal).
    const list<b8> nonAscii ← |ff|
    const ascii arecovery ← nonAscii ↦ ascii ⊥ 'n/a'
    print arecovery
}
