# =============================================================================
# ↦ — lista ↦ copia and copia ↦ lista read their source.
# =============================================================================
#
# What this teaches:
#   • `list<T> ↦ set<T>` deduplicates into a new set; the list is unchanged and
#     still readable afterwards.
#   • `set<T> ↦ list<T>` materializes the elements into a new list; the set is
#     unchanged, so it can be converted again.
#   • set order is unspecified, so materialized lists are sorted before they
#     are printed.
#
# Common mistakes:
#   • assuming a conversion consumes its source — `↦` always reads
#   • printing a list materialized from a set without sorting it first
#
# See also: ↦, lista, copia
# =============================================================================

# EXPECTED OUTPUT:
#   3
#   [3, 1, 2, 1]
#   [1, 2, 3]
#   3
#   [1, 2, 3]
#   ["a", "b"]
#   ["a", "b", "a"]

main {
    mut list<int> xs ← [3, 1, 2, 1]
    mut set<int> unique ← xs ↦ set<int>
    print unique.length()
    print xs
    mut list<int> first ← unique ↦ list<int>
    first.sort()
    print first
    print unique.length()
    mut list<int> second ← unique ↦ list<int>
    second.sort()
    print second

    mut list<string> names ← ["a", "b", "a"]
    mut set<string> nameSet ← names ↦ set<string>
    mut list<string> nameList ← nameSet ↦ list<string>
    nameList.sort()
    print nameList
    print names
}
