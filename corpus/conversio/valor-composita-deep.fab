# =============================================================================
# valor-composita-deep — the deeper rows of a composite behind a valor
# =============================================================================
#
# What this teaches:
#   • A genus held by another genus, or by a lista, is still a genus behind the valor: it prints as an object at every depth and comes back typed.
#   • `valor ↦ lista<fractus>` widens integer elements; a value of the wrong shape takes the `⊥` recovery.
#   • A tensor behind a valor prints as the flat list of its elements.
#
# Common mistakes:
#   • Expecting a nested genus to print as a construction literal — behind a valor every depth prints as JSON, `{"x": 3, "y": 4}`, not `Punctum { x = 3, y = 4 }`.
#
# See also: ↦, ⊥, valor, genus, lista, tensor, valor-composita-tags
# =============================================================================

# conversio/valor-composita-deep — the rows valor-composita leaves out
#
# WHY: pins, on the runner (the oracle), what composites do behind a valor
# beyond the flat boxing and round trips of valor-composita. The `valor is T`
# tag tests live in valor-composita-tags.
#
# EXPECTED OUTPUT:
#   valor-composita-deep.expected — one line per print.

class Punctum {
    mut int x
    mut int y
}

class Linea {
    mut string nomen
    mut list<Punctum> puncta
}

class Figura {
    mut Linea basis
    mut list<int> notae
}

main {
    # 1. A genus nested in a genus or a lista keeps its fields at every depth.
    let Punctum punctum ← Punctum { x = 3, y = 4 }
    let Linea linea ← Linea { nomen = "recta", puncta = [punctum] }
    let value boxedLinea ← linea ↦ value
    print boxedLinea
    let Linea backLinea ← boxedLinea ↦ Linea
    print backLinea.nomen
    print backLinea.puncta.length()
    let Figura figura ← Figura { basis = linea, notae = [1, 2] }
    let value boxedFigura ← figura ↦ value
    print boxedFigura
    let Figura backFigura ← boxedFigura ↦ Figura
    print backFigura.basis.nomen
    let list<Punctum> ordo ← [punctum]
    let value boxedOrdo ← ordo ↦ value
    print boxedOrdo
    let list<Punctum> backOrdo ← boxedOrdo ↦ list<Punctum>
    print backOrdo.length()

    # 2. Integer elements widen to float; the wrong shape takes the recovery.
    let list<int> numeri ← [1, 2]
    let value boxedNumeri ← numeri ↦ value
    let list<float> widened ← boxedNumeri ↦ list<float>
    print widened
    let list<string> wrong ← boxedNumeri ↦ list<string> ⊥ ["none"]
    print wrong
    let Punctum missing ← boxedNumeri ↦ Punctum ⊥ punctum
    print missing.x

    # 3. A tensor behind a valor prints as the flat list of its elements.
    let tensor<f32, [2]> grid ← [1.5, 2.5] ↦ tensor<f32, [2]>
    let value boxedGrid ← grid ↦ value
    print boxedGrid
}
