# =============================================================================
# valor-composita-deep — the deeper rows of a composite behind a valor
# =============================================================================
#
# What this teaches:
#   • A genus held by another genus, or by a lista, is still a genus behind the valor: it prints as an object at every depth and comes back typed.
#   • `valor ↦ lista<fractus>` widens integer elements; a value of the wrong shape takes the `⊥` recovery.
#   • `valor is T` reads the carrier's kind: a genus matches only its own type, a lista or tabula matches `is list<T>` or `is map<K, V>` with the element types erased, and a tensor matches no list.
#
# Common mistakes:
#   • Expecting a nested genus to print as a construction literal — behind a valor every depth prints as JSON, `{"x": 3, "y": 4}`, not `Punctum { x = 3, y = 4 }`.
#   • Reading `is list<int>` as a check of the elements — it only checks that the carrier is a list, so a list of text matches too.
#
# See also: ↦, ⊥, valor, genus, lista, tabula, tensor, est
# =============================================================================

# conversio/valor-composita-deep — the rows valor-composita leaves out
#
# WHY: pins, on the runner (the oracle), what composites do behind a valor
# beyond the flat boxing and round trips of valor-composita.
#
# EXPECTED OUTPUT:
#   valor-composita-deep.expected — one line per print.

class Punctum {
    var int x
    var int y
}

class Linea {
    var string nomen
    var list<Punctum> puncta
}

class Figura {
    var Linea basis
    var list<int> notae
}

main {
    # 1. A genus nested in a genus or a lista keeps its fields at every depth.
    const Punctum punctum ← Punctum { x = 3, y = 4 }
    const Linea linea ← Linea { nomen = "recta", puncta = [punctum] }
    const value boxedLinea ← linea ↦ value
    print boxedLinea
    const Linea backLinea ← boxedLinea ↦ Linea
    print backLinea.nomen
    print backLinea.puncta.length()
    const Figura figura ← Figura { basis = linea, notae = [1, 2] }
    const value boxedFigura ← figura ↦ value
    print boxedFigura
    const Figura backFigura ← boxedFigura ↦ Figura
    print backFigura.basis.nomen
    const list<Punctum> ordo ← [punctum]
    const value boxedOrdo ← ordo ↦ value
    print boxedOrdo
    const list<Punctum> backOrdo ← boxedOrdo ↦ list<Punctum>
    print backOrdo.length()

    # 2. Integer elements widen to float; the wrong shape takes the recovery.
    const list<int> numeri ← [1, 2]
    const value boxedNumeri ← numeri ↦ value
    const list<float> widened ← boxedNumeri ↦ list<float>
    print widened
    const list<string> wrong ← boxedNumeri ↦ list<string> ⊥ ["none"]
    print wrong
    const Punctum missing ← boxedNumeri ↦ Punctum ⊥ punctum
    print missing.x

    # 3. Tag tests: a genus is only its own type.
    const value boxedGenus ← punctum ↦ value
    print boxedGenus is Punctum
    print boxedGenus is Linea
    print boxedGenus is int
    print boxedGenus not is Linea

    # 4. A lista matches any list type (elements erased) and no genus.
    print boxedNumeri is list<int>
    print boxedNumeri is list<string>
    print boxedNumeri is Punctum
    print boxedOrdo is list<Punctum>

    # 5. A tabula matches a map type, a tensor matches no list.
    const map<string, int> scores ← { "alpha": 10 }
    const value boxedScores ← scores ↦ value
    print boxedScores is map<string, int>
    print boxedScores is list<int>
    const tensor<f32, [2]> grid ← [1.5, 2.5] ↦ tensor<f32, [2]>
    const value boxedGrid ← grid ↦ value
    print boxedGrid
    print boxedGrid is list<float>
    print boxedGrid is tensor<f32, [2]>
}
