+++
term = "conversio-functio"
kind = "conversio"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "genus_decl", "genus_member", "field_decl", "annotation", "annotation_sugar", "functio_decl", "param_list", "parameter", "return_clause", "alternate_exit_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "redde_stmt", "si_stmt", "iace_stmt", "comparison", "additive_expr", "multiplicative_expr", "typed_constructor", "incipit_stmt", "fixum_decl", "conversio_expr", "inline_default", "expression", "unary_expr", "literal", "member_suffix", "nota_stmt"]
category = "conversion"
canonical = true
summary = "A registered @ conversion function also serves an explicit ↦ between its two types."
syntax = "@ conversion fn f(A a) → B [⇥ E] { … } … a ↦ B [⊥ <default>]"
related = ["↦", "⊥", "⇥"]
