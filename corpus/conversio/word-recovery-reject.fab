# =============================================================================
# Policy-word recovery — total conversions have no failure to recover from.
# =============================================================================
#
# What this teaches:
#   • A conversion into a policy word cannot fail, so a `⊥` recovery slot is
#     refused rather than accepted and ignored.
#   • Wrap and clamp are values, not failures.
#
main {
    let int n ← 300
    let wrapping<u8> w ← n ↦ wrapping<u8> ⊥ 0
}
