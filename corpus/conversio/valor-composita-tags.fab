# =============================================================================
# valor-composita-tags — `valor is T` tag tests on a composite carrier
# =============================================================================
#
# What this teaches:
#   • `valor is T` reads the carrier's kind: a genus matches only its own type, a lista or tabula matches `is list<T>` or `is map<K, V>` with the element types erased, and a tensor matches no list.
#
# Common mistakes:
#   • Reading `is list<int>` as a check of the elements — it only checks that the carrier is a list, so a list of text matches too.
#
# See also: valor, est, genus, lista, tabula, tensor, valor-composita-deep
# =============================================================================

# conversio/valor-composita-tags — the tag tests valor-composita-deep leaves out
#
# WHY: pins, on the runner (the oracle), which carrier kinds `valor is T`
# accepts. Split out of valor-composita-deep so the lanes that decline the
# `est` rows do not hide the recovery rows of that file.
#
# EXPECTED OUTPUT:
#   valor-composita-tags.expected — one line per print.

class Punctum {
    mut int x
    mut int y
}

class Linea {
    mut string nomen
    mut list<Punctum> puncta
}

main {
    let Punctum punctum ← Punctum { x = 3, y = 4 }
    let list<int> numeri ← [1, 2]
    let value boxedNumeri ← numeri ↦ value
    let list<Punctum> ordo ← [punctum]
    let value boxedOrdo ← ordo ↦ value

    # 1. Tag tests: a genus is only its own type.
    let value boxedGenus ← punctum ↦ value
    print boxedGenus is Punctum
    print boxedGenus is Linea
    print boxedGenus is int
    print boxedGenus not is Linea

    # 2. A lista matches any list type (elements erased) and no genus.
    print boxedNumeri is list<int>
    print boxedNumeri is list<string>
    print boxedNumeri is Punctum
    print boxedOrdo is list<Punctum>

    # 3. A tabula matches a map type, a tensor matches no list.
    let map<string, int> scores ← { "alpha": 10 }
    let value boxedScores ← scores ↦ value
    print boxedScores is map<string, int>
    print boxedScores is list<int>
    let tensor<f32, [2]> grid ← [1.5, 2.5] ↦ tensor<f32, [2]>
    let value boxedGrid ← grid ↦ value
    print boxedGrid is list<float>
    print boxedGrid is tensor<f32, [2]>
}
