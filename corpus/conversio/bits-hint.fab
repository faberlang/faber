# =============================================================================
# Bits — exact-width bitcast hint on the ↦ conversio.
# =============================================================================
#
# What this teaches:
#   • Exact pairs only — u16 pairs with f16 and bf16, u32 with f32, u64 with
#     f64; any other width pairing rejects at the semantic gate with
#     `bits_pair_width_mismatch`
#   • Reinterpretation, not conversion — Bits copies the bit pattern
#     verbatim; the same u16 payload is a different value through a plain
#     `↦` than through `↦ … via Bits`
#   • bf16 is not f16 — bf16 is the top half of an f32 value, not an f16
#     representation, so bf16↔f16 remains an ordinary value conversion and
#     is never a Bits row
#   • Both directions — integer↦float and float↦integer through the hint are
#     admitted symmetrically
#
# Common mistakes:
#   • cross-width pairing — `n ↦ f32 via Bits` from numerus<u16>
#     rejects (bits_pair_width_mismatch)
#   • expecting a float source to be a Bits row — a plain float→float hop
#     with the hint rejects; spell the integer bit pattern side instead
#
# See also: ↦, fractus, octeti
# =============================================================================

functio in_f16(numerus<u16> n) → f16 {
    redde n ↦ f16 via Bits
}

functio ex_bf16(bf16 x) → numerus<u16> {
    redde x ↦ u16 via Bits
}

functio in_f32(numerus<u32> n) → f32 {
    redde n ↦ f32 via Bits
}

functio ex_f64(f64 x) → numerus<u64> {
    redde x ↦ u64 via Bits
}

incipit {
    fixum numerus<u32> n ← 1065353216
    nota in_f32(n)
}
