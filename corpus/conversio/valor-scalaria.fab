# =============================================================================
# valor — Scalar valor ↦ T extraction via FromValor (variant match, fractus widen, textus|instans wire).
# =============================================================================
#
# What this teaches:
#   • Scalar extraction — `valor ↦ T` extracts typed values from dynamic JSON carriers using variant matching.
#   • Widening — `valor ↦ fractus` widens `Numerus` variants losslessly.
#   • Wire text — `valor ↦ textus` accepts both `Textus` and `Instans` wire strings.
#   • Recovery — `⇥` provides a fallback on variant mismatch.
#
# Common mistakes:
#   • Assuming `valor ↦ textus` works for non-text valor variants — only Textus and Instans wire strings are accepted; other variants fail without a `⊥` default.
#
# See also: ↦, ⊥, instans, textus
# =============================================================================

# conversio — scalar valor extraction
#
# WHY: `valor ↦ T` is the default runtime extraction for dynamic JSON carriers.
# Scalar arms match `Valor` variants; `valor ↦ fractus` widens `Numerus` losslessly;
# `valor ↦ textus` accepts `Textus` and `Instans` wire strings. Typed datetime
# provenance stays on `valor ↦ instans` (see conversio/instans.fab). `⊥`
# recovers on variant mismatch.

main {
    let value asInt ← 42
    let int count ← asInt ↦ int
    assert count ≡ 42
    let value asFloat ← 3.5
    let float ratio ← asFloat ↦ float
    assert ratio ≡ 3.5
    let value intForFloat ← 7
    let float widened ← intForFloat ↦ float
    assert widened ≡ 7.0
    let value asBool ← true
    let bool flag ← asBool ↦ bool
    assert flag ≡ true
    let value asText ← "salve"
    let string greeting ← asText ↦ string
    assert greeting ≡ "salve"
    let value asWire ← "1979-05-27T07:32:00Z"
    let string wire ← asWire ↦ string
    assert wire ≡ "1979-05-27T07:32:00Z"
    let value asAscii ← 'yes'
    let ascii token ← asAscii ↦ ascii
    assert token ≡ 'yes'
    let value bad ← "not-a-number"
    let int recovered ← bad ↦ int ⊥ 0
    assert recovered ≡ 0
    print count
    print ratio
    print widened
    print flag
    print greeting
    print wire
    print token
    print recovered
}
