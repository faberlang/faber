# =============================================================================
# lista-tensor-padded — Route C padded-snapshot conversio (AEU-5).
# =============================================================================
#
# What this teaches:
#   • `list<T, size N> ↦ tensor<T, [N]>` snapshots the live prefix 0..len and pads
#     slots len..N with a real fill value — the default fill is the numeric
#     zero of T; a `⊥` default names a different fill (element-typed)
#   • the fill is a real value written at the conversion site, never a read of
#     the carrier's spare slots
#   • iterating the padded tensor is a plain Route T unroll (N lanes, budget 64)
#   • zero fill plus an additive body (`sum`) needs no mask — 0 is the additive
#     neutral; every non-neutral exit (product, min/max, first-match, append)
#     requires a caller-built 0/1 len-mask operand at the conversion site
#     (3F rule: in-region mask construction never admits)
#
# Common mistakes:
#   • Padding a non-numeric list<text, size N> — Route C is numeric T only.
#   • Padding from an unbounded list<T> — the bound must be in the type.
#   • Relying on zero fill for a product exit — the fill 0 zeroes the product;
#     pass a 0/1 len-mask operand instead.
#
# See also: lista, tensor, itera-ex-air-rank1
# =============================================================================

# Route C drivers — declaration-only; the semantic/MIR/runner unit tests pin
# the padded TensorFromFlat fill contract and the mask-required decline.

# Zero-fill additive exit: maskless (0 is the additive neutral).
fn sumPadded(list<float, size 8> xs) → float {
    let tensor<float, [8]> t ← xs ↦ tensor<float, [8]>
    mut float total ← 0.0
    for from t let x {
        total ← total + x
    }
    return total
}

# A ⊥ default names a different dead-slot fill (element-typed).
fn sumFilled(list<float, size 8> xs) → float {
    let tensor<float, [8]> t ← xs ↦ tensor<float, [8]> ⊥ 1.0
    mut float total ← 0.0
    for from t let x {
        total ← total + x
    }
    return total
}

# Non-neutral product exit: the caller builds the 0/1 len-mask outside the
# region and passes it as an operand at the conversion site.
fn productMasked(list<float, size 8> xs, tensor<float, [8]> lenMask) → float {
    let tensor<float, [8]> t ← xs ↦ tensor<float, [8]>
    mut float total ← 1.0
    for from t let x {
        total ← total * x
    }
    return total * lenMask.sum()
}
