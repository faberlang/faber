category = "conversion"
canonical = false
summary = "Route C: numeric list<T, size N> ↦ tensor<T, [N]> pads spare slots with a real fill (zero default, ⊥ names another); the padded loop unrolls via Route T; non-neutral exits need a caller-built 0/1 len-mask."
syntax = "xs ↦ tensor<T, [N]> [⊥ fill]"
related = ["lista", "tensor", "itera", "ex"]
locale = "en"
