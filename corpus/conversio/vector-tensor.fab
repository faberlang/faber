# =============================================================================
# ↦ — Vector to tensor conversio.
# =============================================================================
#
# What this teaches:
#   • Register-class to shaped conversion — a `vector` converts into a shaped `tensor` when the target type witnesses a literal Figura.
#   • Same flat body — the vector lanes lower in order into the tensor's flat storage.
#
# Common mistakes:
#   • Mismatching the vector lane count and the target tensor Figura — the element counts must agree.
#
# See also: ↦, vector, tensor, Figura
# =============================================================================


# conversio — vector to tensor
#
# WHY: a vector is the rank-1 register form of a tensor, so the conversion
# carries its lanes in order into the target Figura. `flatten` reads the tensor
# back flat.

main {
    let vf32[3] v ← [1.0, 2.0, 3.0] ↦ vf32[3]
    let tf32[3] t ← v ↦ tf32[3]
    print t.flatten()
}
