# =============================================================================
# ↦ — tabula ↦ lista projects keys or values by the target element type.
# =============================================================================
#
# What this teaches:
#   • `map<K, V> ↦ list<K>` is the keys; `map<K, V> ↦ list<V>` is the values.
#     The target element type picks the projection — it is not guessed from
#     the type's shape, so a `map<int, string>` and a `map<string, int>` both
#     read the same way: name the side you want.
#   • map order is unspecified, so the projected lists are sorted before they
#     are printed.
#
# Common mistakes:
#   • assuming `↦ list<int>` always means the values (true only when the
#     values are the ints)
#   • printing a projected list without sorting it first
#
# See also: ↦, lista, tabula
# =============================================================================

# EXPECTED OUTPUT:
#   [5, 9]
#   ["x", "y"]
#   ["a", "b"]
#   [1, 2]

main {
    mut map<int, string> names ← empty
    names[9] ← "y"
    names[5] ← "x"
    mut list<int> nameKeys ← names ↦ list<int>
    nameKeys.sort()
    print nameKeys
    mut list<string> nameValues ← names ↦ list<string>
    nameValues.sort()
    print nameValues

    mut map<string, int> counts ← empty
    counts["b"] ← 2
    counts["a"] ← 1
    mut list<string> countKeys ← counts ↦ list<string>
    countKeys.sort()
    print countKeys
    mut list<int> countValues ← counts ↦ list<int>
    countValues.sort()
    print countValues
}
