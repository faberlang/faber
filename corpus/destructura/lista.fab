# =============================================================================
# ex — Extracts fields from a value into local bindings.
# =============================================================================
#
# What this teaches:
#   • Lista destructuring — `fixum [a, b, c] ← lista` extracts elements from a lista into individual bindings.
#   • Rest patterns — `fixum [caput, ceteri cauda] ← lista` captures remaining elements.
#   • Mutable destructuring — `varia [x, y] ← lista` for mutable bindings.
#   • Skip and nested patterns — underscore `_` skips elements; nested listas destructure recursively.
#
# Common mistakes:
#   • Destructuring fewer or more elements than the lista contains without handling bounds — pattern must match or the destructuring will fail.
#
# See also: de, ut, ceteri
# =============================================================================


# destructura — lista destructuring patterns
#
# fixum [a, b, c] ← lista
# varia [x, y, z] ← lista
# fixum [caput, ceteri cauda] ← lista
# fixum [_, medius, _] ← lista
#
# GRAMMAR:
#   destructStmt :← ('fixum' | 'varia') '[' patternList ']' '←' expr
#
# EXPECTED OUTPUT:
#   Element values from inline and bound listas, rest slices, nested rows.

main {
    # --- Basic lista destructuring ---

    let numeri ← [1, 2, 3]
    let [a, b, c] ← numeri
    print a
    print b
    print c

    # Destructure inline lista literal
    let [primus, secundus, tertius] ← [10, 20, 30]
    print primus
    print secundus
    print tertius

    # --- Mutable destructuring with varia ---

    let coordinata ← [100, 200]
    mut [x, y] ← coordinata
    print x
    print y
    x ← x + 50
    y ← y + 50
    print x
    print y

    # --- Partial destructuring (fewer variables than elements) ---

    let valores ← [1, 2, 3, 4, 5]
    let [unus, duo] ← valores
    print unus
    print duo

    # --- Rest pattern with ceteri ---

    let res ← [1, 2, 3, 4, 5]
    let [caput, rest cauda] ← res
    print caput
    print cauda

    # --- Skip elements with underscore ---

    let triplex ← [10, 20, 30]
    let [_, medius, _] ← triplex
    print medius

    # --- Nested listas ---

    let matrix ← [[1, 2], [3, 4]]
    let [ordo1, ordo2] ← matrix
    print ordo1
    print ordo2
}
