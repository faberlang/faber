# =============================================================================
# ex — Extracts fields from a value into local bindings.
# =============================================================================
#
# What this teaches:
#   • Field destructuring — `ex <expr> sit <field>, ...` extracts named fields from genus records into local bindings.
#   • Aliasing — `ex <expr> sit <field> ut <alias>` renames extracted fields.
#   • Mutable extraction — `ex <expr> varia <field>, ...` for mutable field bindings.
#   • Rest pattern — `ex <expr> sit <field>, ceteri <rest>` captures remaining fields as a tabula.
#   • Nested paths — `ex <expr>.<field> sit ...` destructures through nested paths.
#
# Common mistakes:
#   • Destructuring a field that does not exist on the target type — the field must be present in the genus definition or the type must support open shapes.
#
# See also: de, ut, ceteri
# =============================================================================


# destructura — field destructuring with `ex`
#
# ex <expr> sit <field>, ...
# ex <expr> varia <field>, ...
# ex <expr> sit <field> ut <alias>
# ex <expr> sit <field>, ceteri <rest>
#
# Field destructuring works on genus records (fixed fields) and tabula/valor
# (open shapes). This tour uses genus types so that field names are statically
# known and codegen-complete.
#
# GRAMMAR:
#   destructStmt :← 'ex' expr ('sit' | 'varia') patternList
#
# EXPECTED OUTPUT:
#   Extracted field values, aliased names, mutated varia bindings, rest maps.

class Persona {
    mut string nomen
    mut int aetas
    mut string urbs
}

class Civis {
    mut string nomen
    mut string epistula
}

class Datum {
    mut int numerus
    mut bool activus
}

class Forma {
    mut string hospes
    mut int portus
    mut bool tutus
}

class Plenus {
    mut int signum
    mut string nomen
    mut string epistula
    mut string munus
}

class Sodalis {
    mut string nomen
    mut bool probatus
}

class Relatus {
    mut Sodalis civis
}

class Responsum {
    mut Relatus datum
}

class Vestis {
    mut string modus
    mut string lingua
}

main {
    # --- Basic field extraction ---

    let _ persona ← Persona { nomen = "Marcus", aetas = 30, urbs = "Roma" }
    from persona let nomen, aetas

    print nomen
    print aetas

    # --- Extract with alias using 'ut' ---

    let _ civis ← Civis { nomen = "Julia", epistula = "julia@roma.com" }
    from civis let nomen as cognomen, epistula as epistula2

    print cognomen
    print epistula2

    # --- Mutable destructuring with varia ---

    let _ datum ← Datum { numerus = 100, activus = true }
    from datum mut numerus, activus

    print numerus
    print activus

    numerus ← 200
    activus ← false

    print numerus
    print activus

    # --- Mixed alias and regular fields ---

    let _ forma ← Forma { hospes = "localis", portus = 8080, tutus = true }
    from forma let hospes, portus as porta, tutus

    print hospes
    print porta
    print tutus

    # --- Rest pattern with ceteri ---

    let _ plenus ← Plenus { signum = 1, nomen = "Gaius", epistula = "g@roma.com", munus = "admin" }
    from plenus let signum, rest reliqua

    print signum
    print reliqua

    # --- Destructura ex nested path ---

    let _ responsum ← Responsum { datum = Relatus { civis = Sodalis { nomen = "Claudia", probatus = true } } }
    from responsum.datum.civis let nomen as internum, probatus

    print internum
    print probatus

    # --- Single field extraction ---

    let _ vestis ← Vestis { modus = "nigrum", lingua = "la" }
    from vestis let modus

    print modus
}
