# =============================================================================
# ex — Extracts fields from a value into local bindings.
# =============================================================================
#
# What this teaches:
#   • Field destructuring — `ex <expr> fixum <field>, ...` extracts named fields from genus records into local bindings.
#   • Aliasing — `ex <expr> fixum <field> ut <alias>` renames extracted fields.
#   • Mutable extraction — `ex <expr> varia <field>, ...` for mutable field bindings.
#   • Rest pattern — `ex <expr> fixum <field>, ceteri <rest>` captures remaining fields as a tabula.
#   • Nested paths — `ex <expr>.<field> fixum ...` destructures through nested paths.
#
# Common mistakes:
#   • Destructuring a field that does not exist on the target type — the field must be present in the genus definition or the type must support open shapes.
#
# See also: de, ut, ceteri
# =============================================================================


# destructura — field destructuring with `ex`
#
# ex <expr> fixum <field>, ...
# ex <expr> varia <field>, ...
# ex <expr> fixum <field> ut <alias>
# ex <expr> fixum <field>, ceteri <rest>
#
# Field destructuring works on genus records (fixed fields) and tabula/valor
# (open shapes). This tour uses genus types so that field names are statically
# known and codegen-complete.
#
# GRAMMAR:
#   destructStmt :← 'ex' expr ('fixum' | 'varia') patternList
#
# EXPECTED OUTPUT:
#   Extracted field values, aliased names, mutated varia bindings, rest maps.

class Persona {
    var string nomen
    var int aetas
    var string urbs
}

class Civis {
    var string nomen
    var string epistula
}

class Datum {
    var int numerus
    var bool activus
}

class Forma {
    var string hospes
    var int portus
    var bool tutus
}

class Plenus {
    var int signum
    var string nomen
    var string epistula
    var string munus
}

class Sodalis {
    var string nomen
    var bool probatus
}

class Relatus {
    var Sodalis civis
}

class Responsum {
    var Relatus datum
}

class Vestis {
    var string modus
    var string lingua
}

main {
    # --- Basic field extraction ---

    const Persona persona ← Persona { nomen = "Marcus", aetas = 30, urbs = "Roma" }
    const string nomen ← persona.nomen
    const int aetas ← persona.aetas
    print nomen
    print aetas

    # --- Extract with alias using 'ut' ---

    const Civis civis ← Civis { nomen = "Julia", epistula = "julia@roma.com" }
    const string cognomen ← civis.nomen
    const string epistula2 ← civis.epistula
    print cognomen
    print epistula2

    # --- Mutable destructuring with varia ---

    const Datum datum ← Datum { numerus = 100, activus = true }
    var int numerus ← datum.numerus
    var bool activus ← datum.activus
    print numerus
    print activus
    numerus ← 200
    activus ← false
    print numerus
    print activus

    # --- Mixed alias and regular fields ---

    const Forma forma ← Forma { hospes = "localis", portus = 8080, tutus = true }
    const string hospes ← forma.hospes
    const int porta ← forma.portus
    const bool tutus ← forma.tutus
    print hospes
    print porta
    print tutus

    # --- Rest pattern with ceteri ---

    const Plenus plenus ← Plenus { signum = 1, nomen = "Gaius", epistula = "g@roma.com", munus = "admin" }
    const int signum ← plenus.signum
    const Plenus reliqua ← plenus
    print signum
    print reliqua

    # --- Destructura ex nested path ---

    const Responsum responsum ← Responsum { datum = Relatus { civis = Sodalis { nomen = "Claudia", probatus = true } } }
    const string internum ← responsum.datum.civis.nomen
    const bool probatus ← responsum.datum.civis.probatus
    print internum
    print probatus

    # --- Single field extraction ---

    const Vestis vestis ← Vestis { modus = "nigrum", lingua = "la" }
    const string modus ← vestis.modus
    print modus
}
