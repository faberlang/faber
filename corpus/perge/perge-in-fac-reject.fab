# =============================================================================
# perge — reject harness: perge inside a fac block
# =============================================================================
# This exemplum intentionally fails to compile. The sibling .expected file
# pins only the stable diagnostic identity, not paths or rendered prose.
#
# `rumpe` inside a `fac` block leaves the `fac` (see rumpe/fac-si-rumpe.fab).
# `perge` targets the same construct as `rumpe`, and a `fac` block does not
# repeat, so `perge` here has no meaning even though a loop encloses the
# `fac`. Restructure with `si`/`secus`, or move `perge` outside the `fac`.
# `perge` inside a loop nested in the `fac`, inside the `cape` arm, or inside
# `fac … dum` stays legal.

main {
    for range 0‥3 const i {
        do {
            if i ≡ 1 {
                continue
            }
            print i
        }
        catch err {
            print "caught"
        }
    }
}
