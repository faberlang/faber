# =============================================================================
# Exact-bound lista lattice — dynamic, inferred, and explicit capacities.
# =============================================================================
#
# What this teaches:
#   • `list<T>` keeps a dynamic length; elementwise operators perform their
#     equal-length check at runtime for values whose lengths are not static.
#   • `list<T, _>` is a capacity hole; a literal witness solves `_` to the
#     literal's exact element count.
#   • `list<T, size N>` is an explicit checked capacity; the literal must contain
#     exactly N elements.
#   • Widening is conversion-only: `↦` converts an expression and `↤` converts
#     on assignment. A bare `←` never widens a dynamic list into a bounded one.
#
# Common mistakes:
#   • reading `list<T, size N>` as a promise that the current runtime length is N;
#     N is capacity, while `length()` remains the current length
#   • expecting `list<T, _>` to infer from a dynamic expression; only an
#     elementwise literal witness solves the hole
#   • treating `list<T, size N>` as an implicit widening target; write `↦` or `↤`
#
# The unequal literal pair lives in exact-bound-lattice-decline.fab. Its two
# literal witnesses carry different exact bounds, so the elementwise operator
# rejects it during `check`, before any runtime length check is needed.
# =============================================================================

# Dynamic operands keep the runtime equal-length check on the elementwise path.
fn dynamic_pair(list<int> left, list<int> right) → list<int> {
    return left + right
}

main {
    let list<int> dynamic_left ← [1, 2, 3]
    let list<int> dynamic_right ← [10, 20, 30]
    let list<int> dynamic_sum ← dynamic_pair(dynamic_left, dynamic_right)
    let list<int, size 3> inferred ← [4, 5, 6]
    let list<int, size 3> explicit ← [7, 8, 9]

    # Both widening spellings are checked here. The dead branch keeps the
    # runnable output on the current list-literal runner path while the
    # conversion-only source contract remains executable compiler input.
    if false {
        let list<int, size 4> widened_expression ← dynamic_left ↦ list<int, size 4>
        mut list<int, size 4> widened_assignment ← [0, 0, 0, 0]
        widened_assignment ↤ dynamic_left
        print widened_expression
        print widened_assignment
    }
    print dynamic_sum
    print inferred
    print explicit
}
