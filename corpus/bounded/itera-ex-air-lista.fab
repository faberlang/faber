# =============================================================================
# itera-ex-air-bounded-lista — AIR-lane bounded lista iteration.
# =============================================================================
#
# What this teaches:
#   • a full literal lista<T, N> proves len == N for Route A
#   • inference-chained immutable values preserve that fullness fact
#   • runtime-length bounded listas decline SEM059.itera_loop with
#     causa=not_concrete; spare slots are never read
#
# The semantic unit tests pin the emitted lanes and decline identity. This is
# a declaration-only driver, so it does not route an AIR function through main.
# =============================================================================

@ radix lane "air"
fn bounded_full() → void {
    const list<f32, 4> xs ← [1.0, 2.0, 3.0, 4.0] ↦ list<f32, 4> ⊥ [0.0, 0.0, 0.0, 0.0]
    for from xs const value { }
}

@ radix lane "air"
fn bounded_partial() → void {
    const list<f32> raw ← [1.0, 2.0, 3.0]
    const list<f32, 4> xs ← raw ↦ list<f32, 4> ⊥ [0.0, 0.0, 0.0, 0.0]
    for from xs const value { }
}
