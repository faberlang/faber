# =============================================================================
# queue<T, N> / stack<T, N> / string<N> / ascii<N> — the bare capacity is retired
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • A capacity is a count, so it follows `size`: `queue<int, size 4>` holds at most 4 elements, `stack<int, size 4>` the same, and `string<size 8>` / `ascii<size 8>` hold at most 8 characters. The bare number is the same retirement `list<int, 4>` has.
#
# Common mistakes:
#   • Writing the capacity as a bare number, as these heads once allowed; every bounded head takes `size` first.
#   • Putting `size` on the `_` hole: the hole stays bare (`queue<int, _>`).

main {
    mut queue<int, 4> q ← empty
    mut stack<int, 4> s ← empty
    let string<8> t ← "ab" ↦ string<8>
    let ascii<4> c ← 'x'
    print q.length()
    print s.length()
    print t
    print c
}
