# =============================================================================
# string<size N> — text methods on a bounded receiver
# =============================================================================
#
# What this teaches:
#   • A bounded `string<size N>` receiver takes the whole text method surface:
#     length, is_empty, slice, uppercase, lowercase, trim, contains,
#     starts_with, ends_with, replace and split.
#   • `N` counts Unicode scalars, so `length` and `slice` count scalars, not
#     bytes; the accented letter below is one scalar.
#   • Methods that return text return unbounded `string`.
#   • An ASCII argument widens to `string` implicitly.
#
# Common mistakes:
#   • Counting UTF-8 bytes for `slice` bounds — they are scalar positions.
#
# See also: string<size N>, ascii<size N>, ascii-methods
# =============================================================================

main {
    let string raw ← " Héllo "
    let string<size 16> s ← raw ↦ string<size 16>

    print s.length(), s.is_empty()
    print s.slice(1, 4)
    print s.uppercase()
    print s.lowercase()
    print s.trim()
    print s.contains("éll"), s.contains('ll')
    print s.starts_with(" H"), s.starts_with(' H')
    print s.ends_with("o "), s.ends_with('x')
    print s.replace("l", "L")
    print s.replace('l', 'L')
    print s.split("l")
    print s.split('l')
}
