# =============================================================================
# ascii<size N> — text methods on a bounded receiver
# =============================================================================
#
# What this teaches:
#   • A bounded `ascii<size N>` receiver takes the whole text method surface:
#     length, is_empty, slice, uppercase, lowercase, trim, contains,
#     starts_with, ends_with, replace and split.
#   • Methods that return text return unbounded `string`; the receiver's
#     capacity does not carry over to the result.
#   • Text arguments may be ASCII values: an ASCII literal, a bare `ascii`
#     value, or a one-letter `ascii<size 1>` value widen to `string` implicitly.
#
# Choice: implement, not reject. The checker already widens bare `ascii` and
# `ascii<size 1>` to `string`, so those arguments are run on every target. A longer
# bounded `ascii<size N>` argument does not widen implicitly; it crosses with an
# explicit `↦ string` (see conversio-ascii-textus.fab).
#
# Common mistakes:
#   • Passing an `ascii<size 4>` value where a `string` argument is expected;
#     convert it first with `↦ string`.
#   • Reading `slice` as clamping: a window outside the text is an error.
#
# See also: ascii<size N>, string<size N>, conversio-ascii-textus
# =============================================================================

main {
    let ascii<size 16> a ← ' Hello '
    let ascii prefix ← ' H'
    let ascii<size 1> from ← 'l'
    let ascii<size 1> into ← 'L'

    print a.length(), a.is_empty()
    print a.slice(1, 4)
    print a.uppercase()
    print a.lowercase()
    print a.trim()
    print a.contains('ell'), a.contains(from)
    print a.starts_with(' H'), a.starts_with(prefix)
    print a.ends_with('o '), a.ends_with(prefix)
    print a.replace('l', 'L')
    print a.replace(from, into)
    print a.split('l')
    print a.split(from)
}
