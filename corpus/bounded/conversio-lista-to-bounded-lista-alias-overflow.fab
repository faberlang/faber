category = "conversion"
summary = "A list longer than an aliased bounded list's capacity takes the recovery value."
syntax = "lista<T> ↦ lista<T, magnitudo N> ⊥ [7, 8]"
related = ["↦", "⊥", "lista", "bounded"]
