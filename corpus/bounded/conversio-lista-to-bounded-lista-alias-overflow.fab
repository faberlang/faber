# =============================================================================
# bounded lista alias overflow — the alias carries the capacity
# =============================================================================
#
# What this teaches:
#   • `list<int> ↦ Pair`, with `type Pair = list<int, size 2>`, checks the source
#     length against the alias's capacity when the conversion runs.
#   • A source longer than the capacity takes the `⊥` recovery value.
#
# Common mistakes:
#   • expecting the longer list to be truncated or stored as is.

type Pair = list<int, size 2>

main {
    let list<int> big ← [1, 2, 3]

    let Pair over ← big ↦ Pair ⊥ [7, 8]
    print over
    print over.length()
}
