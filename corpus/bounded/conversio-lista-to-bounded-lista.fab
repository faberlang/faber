# =============================================================================
# bounded lista resize — compile-admitted capacity route
# =============================================================================
#
# What this teaches:
#   • A bounded list may name a different bounded-list target explicitly.
#   • The capacity change is not implicit; it is a conversion expression.
#   • The route is currently a check-level contract; the runner lacks the
#     runtime bounded-array conversion carrier.
#
# Common mistakes:
#   • assigning between capacities with a bare `←`.

main {
    let list<int> base ← [1, 2]
    let list<int, size 8> raw ← base ↦ list<int, size 8>
    let list<int, size 4> out ← raw ↦ list<int, size 4>
    print out
}
