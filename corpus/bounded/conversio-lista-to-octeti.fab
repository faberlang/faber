# =============================================================================
# bounded list<u8, N> to list<b8, M> — compile-admitted byte carrier route
# =============================================================================
#
# What this teaches:
#   • The bounded u8 list names a bounded byte target explicitly.
#   • The route is currently a check-level contract; the runner has no
#     bounded list<b8, N> carrier.
#
# Common mistakes:
#   • using a general integer list for a byte carrier — the element width is
#     part of the source contract.

main {
    let list<u8> base ← [1, 2]
    let list<u8, 8> raw ← base ↦ list<u8, 8>
    let list<b8, 8> out ← raw ↦ list<b8, 8>
    print out
}
