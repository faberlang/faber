# =============================================================================
# bounded lista to octeti — compile-admitted byte carrier route
# =============================================================================
#
# What this teaches:
#   • The bounded u8 list names a bounded byte target explicitly.
#   • The route is currently a check-level contract; the runner has no
#     bounded octeti carrier.
#
# Common mistakes:
#   • using a general integer list for a byte carrier — the element width is
#     part of the source contract.

main {
    const list<int<u8>> base ← [1, 2]
    const list<int<u8>, 8> raw ← base ↦ list<int<u8>, 8>
    const bytes<8> out ← raw ↦ bytes<8>
    print out
}
