# =============================================================================
# ↦ — bounded ascii<N> widens to unbounded textus
# =============================================================================
#
# What this teaches:
#   • Width release — a bounded `ascii<8>` converts to the unbounded
#     `string` surface with `↦`; the widened value is an ordinary textus
#   • Distinct types — the bounded cord is not implicitly assignable to
#     `string`; the conversion is explicit
#
# Common mistakes:
#   • writing `string s ← a` without `↦` — widening a bounded cord is
#     conversion-only
#   • reading `ascii<N>` capacity as the runtime length — `longitudo` stays
#     the current length
#
# See also: ↦, ascii, textus
# =============================================================================

# conversio — ascii<N> ↦ textus
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'string'
#
# EXPECTED OUTPUT:
#   conversio-ascii-textus.expected — the widened textus value.

main {
    let ascii<8> a ← 'ab'
    let string s ← a ↦ string
    print s
}
