+++
# =============================================================================
# ↦ — bounded textus<magnitudo N> widens to unbounded textus
# =============================================================================
#
# What this teaches:
#   • Width release — a bounded `string<size 8>` converts to the unbounded
#     `string` surface with `↦`; the widened value is an ordinary textus
#   • The bounded value itself is conversion-built — `raw ↦ string<size 8>` is
#     the only way into the capacity from a runtime string
#
# Common mistakes:
#   • writing `string u ← t` without `↦` — bounded-to-unbounded widening is
#     conversion-only, never implicit
#
# See also: ↦, textus
# =============================================================================

# conversio — textus<magnitudo N> ↦ textus
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'string'
#
# NOTE: check-admitted; the runner does not yet carry bounded textus values
# (UnsupportedMir), so stdout stays unpinned.

main {
    let string raw ← "abcd"
    let string<size 8> t ← raw ↦ string<size 8>
    let string u ← t ↦ string
    print u
}
