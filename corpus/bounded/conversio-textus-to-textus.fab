+++
term = "↦"
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "conversio_expr", "expression", "literal", "nota_stmt"]
category = "conversion"
canonical = false
summary = "Bounded textus<magnitudo N> widens to unbounded textus: string<size 8> ↦ string."
syntax = "textus<magnitudo N> ↦ textus"
