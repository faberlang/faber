# =============================================================================
# ↦ — ascii<size N> ↔ ascii<size M> resize (grow / shrink / identity)
# =============================================================================
#
# What this teaches:
#   • D7 resize — a bounded ascii converts to another capacity with `↦`;
#     the initialized prefix is copied and overflow fails closed
#   • All three directions are the same rule — grow (`ascii<size 4> ↦ ascii<size 8>`),
#     shrink (`ascii<size 8> ↦ ascii<size 4>`), and identity (`ascii<size 8> ↦ ascii<size 8>`)
#     are each one explicit conversion
#
# Common mistakes:
#   • expecting a bare `←` to resize — capacity changes are conversion-only
#   • reading shrink as truncating the string — the copy keeps the prefix
#     that fits and fails closed when the source is longer than the target
#
# See also: ↦, ascii
# =============================================================================

# conversio — ascii<size N> ↔ ascii<size M> D7 resize
#
# GRAMMAR:
#   convertExpr :← expr '↦' 'ascii' '<' capacity '>'
#
# NOTE: check-admitted; the runner does not yet carry the bounded ascii
# runtime conversio (UnsupportedMir), so stdout stays unpinned.

main {
    let ascii<size 4> a ← 'ab'
    let ascii<size 8> grown ← a ↦ ascii<size 8>
    let ascii<size 8> b ← 'abcd'
    let ascii<size 4> shrunk ← b ↦ ascii<size 4>
    let ascii<size 8> same ← a ↦ ascii<size 8>
    print grown
    print shrunk
    print same
}
