# =============================================================================
# itera-ex-bounded-lista — Route B runtime-len lista iteration.
# =============================================================================
#
# What this teaches:
#   • `for from` over a `list<T, size N>` with runtime len becomes a `discerne` on
#     len with N+1 arms — arm k runs the body exactly k times (lanes 0..k)
#   • each arm reads only 0..k ⊆ 0..len, so spare slots past len are never read
#   • the branch lives in the base lane; AIR functions keep declining this
#     shape (causa=not_concrete) — runtime-len listas are non-AD through
#     Route B
#
# Common mistakes:
#   • expecting this to unroll in an `@ radix lane "air"` function — Route B
#     is base-language only
#   • capacities above 10 — the static split caps at N = 10; above it the
#     loop lowers as the plain runtime-length loop (see
#     itera-ex-bounded-lista-above-ten)
#
# See also: lista, itera-ex-air-lista
# =============================================================================

# Route B static split on the carrier len — declaration-only driver; the MIR
# unit tests pin the N+1-arm switch and the N <= 10 decline.

fn sumBounded(list<int, size 8> xs) → int {
    mut int total ← 0
    for from xs let x {
        total ← total + x
    }
    return total
}
