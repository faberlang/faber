# =============================================================================
# itera-ex-scalar-buffers — Route B runtime-len scalar buffer iteration.
# =============================================================================
#
# What this teaches:
#   • `for from` over a runtime-length `list<b8, size N>` / `ascii<size N>` / `string<size N>`
#     becomes a `discerne` on len with N+1 arms — arm k runs the body exactly
#     k times (lanes 0..k)
#   • each arm reads only 0..k ⊆ 0..len, so spare slots past len are never
#     read and the `string<size N>` non-ASCII trap row never fires from a dead slot
#   • the branch lives in the base lane; AIR functions keep declining this
#     shape (causa=not_concrete)
#
# Common mistakes:
#   • expecting this to unroll in an `@ radix lane "air"` function — Route B
#     is base-language only
#   • capacities above 10 — the N(N+1)/2 lane budget caps at N = 10
#
# See also: list<b8, size N>, ascii, string, itera-ex-air-scalar-buffers
# =============================================================================

# Route B static split on the carrier len — declaration-only driver (no
# incipit: the runner lane classifies this NoEntryReference). The MIR unit
# tests pin the N+1-arm switch and the N <= 10 decline; the ascii<size N> carrier
# runs in the runner, while the list<b8, size N>/string<size N> carriers stay compile-only
# (the runner overlay declines the bounded list<b8, size N>/textus carriers).

fn visit_bytes(list<b8, size 8> xs) → void {
    for from xs let b {
        print b
    }
}

fn visit_ascii(ascii<size 8> xs) → void {
    for from xs let l {
        print l
    }
}

fn visit_string(string<size 8> xs) → void {
    for from xs let c {
        print c
    }
}
