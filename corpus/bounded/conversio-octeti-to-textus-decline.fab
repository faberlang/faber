# =============================================================================
# bounded list<b8, N> to textus — unsupported conversion decline
# =============================================================================
#
# What this teaches:
#   • A bounded byte carrier does not silently become textus through `↦`.
#   • The unsupported route fails closed with `SEM016:unsupported_conversio`.
#
# Common mistakes:
#   • assuming byte decoding is the same as a bounded-width copy — decoding
#     needs an explicit list<b8>/textus library route, not this conversion.

fn widen(list<b8, 8> raw) → string {
    return raw ↦ string
}
