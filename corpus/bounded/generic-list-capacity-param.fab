# =============================================================================
# Generic list capacity parameter — `list<T, N>` binds T and N at the call.
# =============================================================================
#
# What this teaches:
#   • `<T, size N>` declares a type parameter and a size parameter; a
#     `list<T, N>` parameter is witnessed by the argument's element type and
#     its exact capacity, so `first(numbers)` needs no explicit type arguments.
#   • Bounded lists with different capacities or element types (`list<int, 3>`,
#     `list<string, 2>`, `list<int, 2>`) instantiate separate copies of the
#     same function.
#   • N is the capacity, not a promise about the current length: `length()`
#     still reports the live element count.
#
# Common mistakes:
#   • passing a dynamic `list<int>` where `list<int, N>` is declared; widening
#     is conversion-only (`↦`), see exact-bound-lattice.fab
# =============================================================================

fn first<T, size N>(list<T, N> xs) → T {
    return xs[0]
}

fn count<T, size N>(list<T, N> xs) → int {
    return xs.length()
}

main {
    let list<int, 3> numbers ← [4, 5, 6]
    let list<string, 2> words ← ["alpha", "beta"]
    let list<int, 3> triple ← [7, 8, 9]
    let list<int, 2> pair ← [1, 2]

    print first(numbers)
    print first(words)
    print count(triple)
    print count(pair)
}
