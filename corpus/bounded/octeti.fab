# =============================================================================
# octeti<N> — bounded byte buffer (BB-8R)
# =============================================================================
#
# Latin spelling: octeti<8>
# English surface: bytes<8>
#
# What this teaches:
#   • `octeti<N>` is a distinct type from unbounded `octeti`.
#   • `longitudo` / `vacua` observe runtime `len`, not capacity `N`.
#   • Unbounded → bounded copies the prefix through `↦` and fails closed when `len > N`.
#
# Common mistakes:
#   • Reading spare `len..N` slots — they are unreadable.
#   • Implicit assignment from `octeti` to `octeti<N>` — conversion is explicit.
#
# See also: lista<numerus, N>, textus<N>, ascii<N>
# =============================================================================

main {
    const bytes raw ← |61 62|
    const bytes<8> a ← raw ↦ bytes<8>
    const bytes<8> b ← raw ↦ bytes<8>
    const int n ← a.length()
    const bool vacant ← a.is_empty()
    print n
    print vacant
    if a ≡ b {
        print 1
    }
}
