# =============================================================================
# list<b8, size N> — bounded byte buffer (BB-8R)
# =============================================================================
#
# Surface: list<b8, size 8> (la: lista<b8, magnitudo 8>)
#
# What this teaches:
#   • `list<b8, size N>` is a distinct type from unbounded `list<b8>`.
#   • `longitudo` / `vacua` observe runtime `len`, not capacity `N`.
#   • Unbounded → bounded copies the prefix through `↦` and fails closed when `len > N`.
#
# Common mistakes:
#   • Reading spare `len..N` slots — they are unreadable.
#   • Implicit assignment from `list<b8>` to `list<b8, size N>` — conversion is explicit.
#
# See also: lista<numerus, magnitudo N>, textus<magnitudo N>, ascii<size N>
# =============================================================================

main {
    let list<b8> raw ← |61 62|
    let list<b8, size 8> a ← raw ↦ list<b8, size 8>
    let list<b8, size 8> b ← raw ↦ list<b8, size 8>
    let int n ← a.length()
    let bool vacant ← a.is_empty()
    print n
    print vacant
    if a ≡ b {
        print 1
    }
}
