# =============================================================================
# bounded list<b8, size N> to list<u8> — compile-admitted byte-list bridge
# =============================================================================
#
# What this teaches:
#   • The bounded byte carrier can be widened to the explicit u8 list bridge.
#   • Only initialized bytes participate; the capacity is not a list length.
#
# Common mistakes:
#   • using an unsized integer element type — the byte bridge requires
#     `list<u8>`.

main {
    let list<b8, size 8> raw ← |61 62| ↦ list<b8, size 8>
    let list<u8> out ← raw ↦ list<u8>
    print out
}
