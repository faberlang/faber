# =============================================================================
# textus<N> — bounded Unicode buffer (BB-8R)
# =============================================================================
#
# Latin spelling: textus<8>
# English surface: string<8>
#
# What this teaches:
#   • `textus<N>` is a distinct type from unbounded `textus`.
#   • `N` counts Unicode scalars; `longitudo` is runtime `len`.
#   • Two values with the same prefix compare equal (`≡`).
#
# Common mistakes:
#   • Counting UTF-8 bytes as `N` — capacity is scalars.
#   • Assigning a bare `textus` into `textus<N>` without `↦`.
#
# See also: lista<numerus, N>, ascii<N>, list<b8, N>
# =============================================================================

main {
    let string raw ← "ab"
    let string<8> a ← raw ↦ string<8>
    let string<8> b ← raw ↦ string<8>
    let int n ← a.length()
    let bool vacant ← a.is_empty()
    print n
    print vacant
    print a.slice(0, 1)
    if a ≡ b {
        print 1
    }
}
