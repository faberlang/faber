# =============================================================================
# ascii<N> — bounded ASCII cord (BB-8R)
# =============================================================================
#
# Latin spelling: ascii<8>
# English surface: ascii<8>
#
# What this teaches:
#   • `ascii<N>` is a distinct type from unbounded `ascii`.
#   • `longitudo` is runtime `len`, not capacity `N`.
#   • Same prefix, independently constructed, compares equal (`≡`).
#
# Common mistakes:
#   • Treating bare `ascii` as `ascii<64>` — capacity is not a language default.
#   • Calling `capacitas` — `N` is the type, not a method.
#
# See also: lista<numerus, N>, textus<N>, list<b8, N>
# =============================================================================

main {
    let ascii<8> a ← 'ab'
    let ascii<8> b ← 'ab'
    let int n ← a.length()
    let bool vacant ← a.is_empty()
    print n
    print vacant
    if a ≡ b {
        print 1
    }
}
