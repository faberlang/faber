# =============================================================================
# lista<T, N> — bounded array (BB-8R)
# =============================================================================
#
# Latin spelling: lista<numerus, 8>
# English surface: list<int, 8>
#
# What this teaches:
#   • `lista<T, N>` is a distinct type from unbounded `lista<T>`.
#   • `longitudo` / `vacua` observe runtime `len`, not capacity `N`.
#   • `appende` past `N` is a recoverable alternate exit (`⇥ textus`).
#
# Common mistakes:
#   • Treating `N` as exact length — spare slots are unreadable.
#   • Inventing `capacitas` — capacity is type identity, not a method.
#
# See also: textus<N>, ascii<N>, list<b8, N>
# =============================================================================

main {
    let list<int, 8> xs ← empty
    let int n ← xs.length()
    let bool vacant ← xs.is_empty()
    print n
    print vacant
}
