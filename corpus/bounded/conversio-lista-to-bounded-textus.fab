# =============================================================================
# bounded lista to bounded textus — rejected route
# =============================================================================
#
# What this teaches:
#   • A list of ints is not text: the element type does not say which
#     encoding it is (UTF-8, UTF-16, UTF-32), so `list<int, size N> ↦ string<size M>`
#     is refused at check time (operator ruling 05ac0534).
#   • Say the meaning instead: convert to list<b8>, list<b16> or list<b32>
#     first and then ↦ string (a decode that can fail), or show the list
#     with the format string "§"(xs).
#
# Common mistakes:
#   • assuming a list of numbers decodes as bytes — it does not; name the
#     bits width.

main {
    let list<int> base ← [1, 2]
    let list<int, size 8> raw ← base ↦ list<int, size 8>
    let string<size 8> out ← raw ↦ string<size 8>
    print out
}
