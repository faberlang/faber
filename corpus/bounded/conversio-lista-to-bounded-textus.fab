# =============================================================================
# bounded lista to bounded textus — compile-admitted route
# =============================================================================
#
# What this teaches:
#   • A bounded list can name a bounded textus target explicitly.
#   • The route is currently a check-level contract; the runner has no
#     bounded textus carrier.
#
# Common mistakes:
#   • treating the list capacity as the target text capacity — the target
#     supplies its own bound.

main {
    const list<int> base ← [1, 2]
    const list<int, 8> raw ← base ↦ list<int, 8>
    const string<8> out ← raw ↦ string<8>
    print out
}
