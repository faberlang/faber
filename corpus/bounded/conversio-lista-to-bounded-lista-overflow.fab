+++
term = "↦"
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "conversio_expr", "expression", "literal", "call_expr", "call_suffix", "argument_list", "argument", "member_suffix", "nota_stmt"]
category = "conversion"
summary = "A list longer than the target capacity takes the recovery value; one that fits converts."
syntax = "lista<T> ↦ lista<T, magnitudo N> ⊥ [7, 8]"
related = ["↦", "⊥", "lista", "bounded"]
