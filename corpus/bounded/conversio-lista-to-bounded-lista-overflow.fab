# =============================================================================
# bounded lista overflow — the length check runs at the conversion
# =============================================================================
#
# What this teaches:
#   • `list<int> ↦ list<int, size 2>` checks the source length against the
#     capacity when the conversion runs.
#   • A source longer than the capacity takes the `⊥` recovery value.
#   • A source that fits converts unchanged.
#
# Common mistakes:
#   • expecting the longer list to be truncated or stored as is.

main {
    let list<int> big ← [1, 2, 3]
    let list<int> small ← [4, 5]

    let list<int, size 2> over ← big ↦ list<int, size 2> ⊥ [7, 8]
    print over
    print over.length()

    let list<int, size 2> fits ← small ↦ list<int, size 2> ⊥ [7, 8]
    print fits
}
