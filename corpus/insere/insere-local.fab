+++
term = "insere ="
kind = "operator-group"
grammar = ["fab_file", "program", "statement", "statement_core", "fixum_decl", "const_init", "insere_expr", "praefixum_expr", "block_stmt", "genus_decl", "genus_member", "genus_field_decl", "field_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "functio_decl", "redde_stmt", "incipit_stmt", "expression", "literal", "nota_stmt", "call_expr", "call_suffix", "member_suffix"]
