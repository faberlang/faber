# =============================================================================
# fac — Postfix dum loop attached to a fac block
# =============================================================================
#
# What this teaches:
#   • Postfix dum loop attached to a fac block.
#   • Related keywords: fac, dum
#
# Common mistakes:
#   • Using `fac ... dum` inside a closure — closure `fac` bodies cannot use `dum`; restructure as a standalone loop.
#
# See also: fac, dum
# =============================================================================

# fac — postfix dum loop (do-while style)
#
# fac { <body> } dum <condition>
#
# GRAMMAR:
#   facStmt :← 'fac' block 'dum' expr
#
# EXPECTED OUTPUT:
#   fac-dum.expected

main {
    mut int counter ← 0
    do {
        counter ← counter + 1
        print "Iteration §"(counter)
    } while counter ≺ 3
    mut int attempts ← 0
    do {
        attempts ← attempts + 1
        print "Attempt §"(attempts)
    } while attempts ≺ 2
}
