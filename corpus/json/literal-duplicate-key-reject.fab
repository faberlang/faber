# =============================================================================
# json — A JSON object literal cannot repeat a key
# =============================================================================
#
# What this teaches:
#   • An object literal like `{ "a": 1, "a": 2 }` is ambiguous: which value wins?
#   • The typechecker rejects the second occurrence at its key, not the object as a whole
#   • Nested objects are checked the same way
#
# Common mistakes:
#   • Retyping an object and leaving an older key in place
#
# See also: json
# =============================================================================

# JSON duplicate-key reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let json a ← { "a": 1, "a": 2 }
    print a
}
