# =============================================================================
# json unquoted key — JSON object keys must be quoted strings.
# =============================================================================
#
# What this teaches:
#   • A bare `{` in expression position enters the JSON literal grammar
#   • JSON object keys are quoted strings: { "a": 1 }, never { a: 1 }
#   • A bare identifier key rejects with PARSE001:json_quoted_key
#
# Common mistakes:
#   • Writing { a: 1 } instead of { "a": 1 } — keys are JSON strings, not Faber names
#
# See also: json
# =============================================================================

# json unquoted-key reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let json a ← { a: 1 }
    print a
}
