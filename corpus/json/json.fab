# =============================================================================
# json — JSON serialization and deserialization
# =============================================================================
#
# What this teaches:
#   • JSON type conversions using `↦` — converting between `json`, `valor`, and concrete Faber types
#   • the `@json` annotation for custom field naming and genus-level JSON configuration
#   • roundtrip serialization with `json.stringify()` and deserialization with `json.parse()`
#
# Common mistakes:
#   • Applying @ json to a non-genus declaration — @ json is only supported on genus declarations and their fields.
#
# See also:
# =============================================================================

import from "norma:json" json

@ json { }
class Payload {
    @ json { name = "wire_name" }
    mut string name
}

main {
    let json literal ← { "wire_name": "Ada", "items": [1, { "ok": true }] }
    let value broad ← literal ↦ value
    let json narrowed ← broad ↦ json
    let Payload payload ← narrowed ↦ Payload
    let json encoded ← payload ↦ json
    let string wire ← json.stringify(encoded)
    let json ∪ none tentativa ← json.try_parse(wire)
    print payload.name
    print wire
    print tentativa
    do {
        let json reparsed ← json.parse(wire)
        let Payload roundtrip ← reparsed ↦ Payload
        print roundtrip.name
    }
    catch err {
        print err
    }
}
