# =============================================================================
# json — JSON follows RFC 8259: a comma before the closing brace rejects
# =============================================================================
#
# What this teaches:
#   • A JSON object literal is an RFC 8259 document: `{ "a": 1, }` is not one
#   • A comma directly before the closing brace rejects at parse time
#   • The same item-list law holds everywhere; JSON rows also name RFC 8259
#
# Common mistakes:
#   • Copying a pretty-printed object that leaves a dangling comma
#
# See also: json
# =============================================================================

# JSON trailing-comma reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let json a ← { "a": 1, }
    print a
}
