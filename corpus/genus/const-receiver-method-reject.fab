# =============================================================================
# genus const receiver method — writes need a writable receiver binding
# =============================================================================
# The method changes its own value through `self`. Calling it through a `let`
# binding would write through a read-only receiver, so the call is rejected.

class Counter {
    mut int value

    fn bump() {
        self.value ← self.value + 1
    }
}

main {
    let Counter c ← Counter { value = 0 }
    c.bump()
}
