# =============================================================================
# genus — Member privacy
# =============================================================================
#
# What this teaches:
#   • Members are public by default; unmarked fields and methods need no
#     annotation.
#   • `@ private` limits a member to the type: only the type's own methods
#     may read, write, or call it.
#   • `@ internal` limits a member to code in the same package.
#   • A construction literal may still set a private field, from any file,
#     and `Genus { … } from source` copies private fields across.
#
# Common mistakes:
#   • Reading a private field from outside the type (`r.summa`) — add a public
#     method that returns what callers need.
#   • Writing `@ public` on a member — members are already public (WARN028).
#
# See also: genus, privata, interna
# =============================================================================

# GRAMMAR:
#   genus_member :← annotation* (field_decl | functio_method_decl)
#
# EXPECTED OUTPUT:
#   12, 2, gradus, 12, 2, copia

class Tabula {
    @ private
    mut int summa
    @ private
    mut int numerus
    @ internal
    mut string nomen

    fn adde(int valor) → void {
        self.summa ← self.summa + valor
        self.numerus ← self.numerus + 1
    }

    fn totum() → int {
        return self.summa
    }

    fn mensura() → int {
        return self.numera()
    }

    @ private
    fn numera() → int {
        return self.numerus
    }
}

main {
    # A construction literal may set private fields; the binding is `mut`
    # because `adde` changes the object in place, and a method that mutates its
    # receiver needs a `mut` binding exactly as a field write does
    mut Tabula t ← Tabula { summa = 0, numerus = 0, nomen = "gradus" }
    t.adde(4)
    t.adde(8)
    print t.totum()
    print t.mensura()
    print t.nomen

    # Copy with changes carries the private fields across
    let Tabula copia ← Tabula { nomen = "copia" } from t
    print copia.totum()
    print copia.mensura()
    print copia.nomen
}
