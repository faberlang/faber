# =============================================================================
# genus — Genus constructor hook that runs after field initialization
# =============================================================================
#
# What this teaches:
#   • Genus constructor hook that runs after field initialization.
#   • Related keywords: genus, creo
#
# Common mistakes:
#   • Using `ego` outside a genus method — `ego` is only valid inside genus methods including `creo` (SEM008).
#
# See also: genus, creo
# =============================================================================

# Genus with constructor hook (creo)
#
# genus Nomen {
#     <type> <field> = <initium>
#     functio creo() { ... }
# }
#
# creo() runs after defaults and field overrides are merged.
# Use for validation, clamping, or derived initialization.
#
# GRAMMAR:
#   creo method inside genusDecl; ego fields are fully initialized before creo runs
#
# EXPECTED OUTPUT:
#   50, 100 (clamped), then radius 5 with derived diameter 10 and area

class Terminus {
    int valor = 0

    fn creo() {
        if self.valor < 0 {
            self.valor ← 0
        }

        if self.valor > 100 {
            self.valor ← 100
        }
    }

    fn accipe() → int {
        return self.valor
    }
}

class Circulus {
    int radius = 1
    int diameter = 0
    float area = 0

    fn creo() {
        self.diameter ← self.radius * 2
        self.area ← 3.14159 * (self.radius ↦ float) * (self.radius ↦ float)
    }
}

main {
    # --- Validation in creo ---

    const _ rectus ← Terminus {
        valor = 50
    }

    print rectus.accipe()

    # creo clamps to 100
    const _ coactus ← Terminus {
        valor = 200
    }

    print coactus.accipe()

    # --- Derived initialization in creo ---

    const _ c ← Circulus {
        radius = 5
    }

    print c.radius
    print c.diameter
    print c.area
}
