# A returned record stored in a returned list remains valid after its creator exits.
# The second call reuses the creator's stack frame, so the first list must own its
# record value rather than retain a pointer into that frame.

class Punctum {
    mut int x = 0
    mut int y = 0
}

fn make_punctum(int seed) → Punctum {
    return Punctum { x = seed, y = seed + 1 }
}

fn make_list(int seed) → list<Punctum> {
    return [make_punctum(seed)]
}

main {
    let list<Punctum> first ← make_list(10)
    let list<Punctum> second ← make_list(20)

    print first[0].x
    print first[0].y
    print second[0].x
    print second[0].y
}
