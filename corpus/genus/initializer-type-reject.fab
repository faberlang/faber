# =============================================================================
# genus — a field initializer has the wrong type for the declared field
# =============================================================================
# Each field initializer in a construction literal must match the type the
# genus declares for that field. A `text` initializer for an `int` field is a
# check error, so a mismatched value never enters a genus.

class A { mut int x }

main {
    let A a ← A { x = "text" }
    print a.x
}
