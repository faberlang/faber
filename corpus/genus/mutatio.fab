# =============================================================================
# genus — Copy with changes
# =============================================================================
#
# What this teaches:
#   • `Genus { field = value } from source` builds a new value: the braced
#     fields override, every other field is copied from `source`.
#   • The change comes first and the source last; there is exactly one source.
#   • A `let` field can be set here, because this is a construction literal.
#   • The copy is shallow: a list field is shared with the source. Use the
#     `copy` marker on the value when you need an independent list.
#
# Common mistakes:
#   • Copying from a different genus — the source must be the type being built.
#   • Writing two sources (`from p from q`) — pick one and name the changes.
#   • Starting `from` on the next line — it must follow the closing brace;
#     a line that starts with `from` is the extraction statement.
#
# See also: genus, ex
# =============================================================================

# GRAMMAR:
#   instance :← ident '{' fieldInit (',' fieldInit)* '}' 'from' postfixExpr
#
# EXPECTED OUTPUT:
#   1, 2, origo, 1, 9, origo, 5, 9, finis, 2, 1, 2, origo, 7, 2, origo

class Punctum {
    let int x
    mut int y
    let string nomen
    let list<int> gradus
}

fn origo() → Punctum {
    return Punctum { x = 7, y = 2, nomen = "origo", gradus = [0] }
}

main {
    let Punctum p ← Punctum { x = 1, y = 2, nomen = "origo", gradus = [1, 2] }
    print p.x
    print p.y
    print p.nomen

    # One override; every other field comes from p
    let Punctum q ← Punctum { y = 9 } from p
    print q.x
    print q.y
    print q.nomen

    # let fields can be set: this is still a construction literal
    let Punctum r ← Punctum { x = 5, nomen = "finis" } from q
    print r.x
    print r.y
    print r.nomen
    print r.gradus.length()

    # No overrides: a field-for-field copy
    let Punctum s ← Punctum {} from p
    print s.x
    print s.y
    print s.nomen

    # The source may be any postfix expression, such as a call
    let Punctum t ← Punctum { gradus = [3, 4] } from origo()
    print t.x
    print t.gradus.length()
    print t.nomen
}
