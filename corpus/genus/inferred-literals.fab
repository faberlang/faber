# =============================================================================
# genus — literals that take the cell's type
# =============================================================================
#
# What this teaches:
#   • `_ [ a, b ]` builds the expected tuple (or list) from its cell.
#   • A bare `[ a, b ]` takes a tuple cell's type; with no typed cell it stays a list.
#   • A bare `{ field = value }` takes a class cell's type, like `_ { … }`.
#
# See also: genus
# =============================================================================

class Punctum {
    mut int x = 0
    mut int y = 0
}

fn par() → tuple<int, string> {
    return _ [3, "c"]
}

fn origo() → Punctum {
    return { x = 7, y = 9 }
}

fn summa(Punctum p) → int {
    return p.x + p.y
}

main {
    let tuple<int, string> t ← _ [1, "a"]
    print t[0]
    print t[1]

    let tuple<int, string> u ← par()
    print u[0]

    let tuple<int, int> v ← [5, 6]
    print v[1]

    let Punctum p ← { x = 1, y = 2 }
    print p.x
    print p.y

    let Punctum q ← origo()
    print q.y
    print summa({ x = 10, y = 20 })

    let list<int> xs ← _ [1, 2, 3]
    print xs.length()
    let list<int> ys ← [4, 5]
    print ys.length()
}
