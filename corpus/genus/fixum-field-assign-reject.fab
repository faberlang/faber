# =============================================================================
# genus fixum field assignment — set once in construction
# =============================================================================
# A `let` field is initialized by the construction literal. Even when the
# containing genus binding is writable, that field cannot be assigned again.

class Point {
    let int x
}

main {
    mut Point p ← Point { x = 1 }
    p.x ← 5
}
