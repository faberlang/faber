# =============================================================================
# air-struct-literal — genus construction in an AIR-lane function.
# =============================================================================
#
# The constructor in `make` is a source-level genus literal. Its HIR is a
# `Verte` with object entries, which the AIR lowerer represents as a struct.
#
# See also: radix, genus
# =============================================================================

class Point { let int x }

@ radix lane "air"
fn make(int x) → Point {
    return Point { x = x }
}

main {
    let Point point ← make(42)
    print point.x
}
