# =============================================================================
# genus — A self-referential optional field
# =============================================================================
#
# A genus field may be `mut Node ∪ none next` because the non-none member is
# a reference type (never a scalar): a `mut` node field that is sometimes
# missing. `?.` chains read through a missing node as none.
#
# =============================================================================

class Node {
    mut int v
    mut Node ∪ none next
}

main {
    mut Node a ← Node { v = 1, next = null }
    mut Node b ← Node { v = 2, next = a }
    print b.next?.v
    print a.next?.v
    a.next ← Node { v = 9, next = null }
    print b.next?.next?.v
}
