# =============================================================================
# genus — A recursive linked list with an optional tail
# =============================================================================
#
# What this teaches:
#   • A genus can refer to itself through `Nodus ∪ none`; the indirection is
#     implied, so no box type or recursion keyword is needed.
#   • Two nodes form a list whose last link is `null` (`none` in the type).
#   • A `ref` cursor re-points along the links. `while cursor not is none`
#     narrows it before reading the payload and stops at the absent tail.
#
# See also: genus, dum, nihil
# =============================================================================

class Nodus {
    let int valor
    mut Nodus ∪ none sequens
}

main {
    let Nodus tail ← Nodus { valor = 2, sequens = null }
    let Nodus head ← Nodus { valor = 1, sequens = tail }

    ref Nodus ∪ none cursor ← head
    while cursor not is none {
        print cursor.valor
        cursor ← cursor.sequens
    }
    print cursor
}
