# =============================================================================
# genus — A method returning self chains
# =============================================================================
#
# What this teaches:
#   • A method whose return type is the genus returns `self`, so the next call
#     attaches to the value the method returned.
#   • Chaining is plain member access on that returned value, not a special
#     call form: `a.add(3).add(4)` is two calls in sequence.
#   • The mutations land on the same object, so `get()` sees both of them.
#
# Common mistakes:
#   • Returning nothing from a method declared to return the genus — the chain
#     has no receiver.
#   • Forgetting the `mut` field: a read-only field cannot be written by the
#     method body.
#   • Reading the result of a chain as a copy — it is the same value.
#
# See also: genus
# =============================================================================

# GRAMMAR:
#   assign : place '←' expression
#   place  : postfixExpr ('.' ident | '[' expression ']')*
#
# EXPECTED OUTPUT:
#   9, 18

class Acc {
    mut int v = 0
    fn add(int n) → Acc {
        self.v ← self.v + n
        return self
    }
    fn get() → int { return self.v }
    fn twice() → int { return self.get() * 2 }
}

main {
    mut Acc a ← Acc {}
    a.add(2)
    a.add(3).add(4)
    print a.get()
    print a.twice()
}
