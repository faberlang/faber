# =============================================================================
# genus — Printing shows the construction literal
# =============================================================================
#
# What this teaches:
#   • `print` of a genus value shows the literal that would build it: the type
#     name, then each field in declaration order as `name = value`.
#   • `=` marks a value, so it is not `:`; text fields are quoted as in source.
#   • A nested genus prints by the same rule; a list prints in its `[a, b]` form.
#   • A discretio variant prints qualified: `Discretio.Variant { … }`.
#   • A genus with no fields prints as `Name {}`; a variant with no fields
#     prints as `Discretio.Variant`, with no braces.
#   • A bare text value at the top level stays unquoted.
#
# Common mistakes:
#   • Expecting `:` between name and value — that is a label, not a value.
#   • Expecting the fields in the order they were written in a literal —
#     the order is always the declaration order.
#
# See also: genus, discretio, nota
# =============================================================================

# GRAMMAR:
#   instance :← ident '{' fieldInit (',' fieldInit)* '}'
#
# EXPECTED OUTPUT:
#   Punctum { x = 1, nomen = "hello" }, Vacuus {}, Involucrum { … }, Nuntius.Pulsus { … }

class Punctum {
    mut int x
    mut string nomen
}

class Vacuus {
}

class Involucrum {
    mut Punctum p
    mut list<int> gradus
    mut string titulus
}

union Nuntius {
    Pulsus {
        int x
        string y
    },
    Finis
}

main {
    let Punctum p ← Punctum { x = 1, nomen = "hello" }
    print p

    print Vacuus {}

    let Involucrum i ← Involucrum { p = p, gradus = [0, 1, 2], titulus = "t" }
    print i

    let Nuntius n ← variant Pulsus { x = 1, y = "hello" } ∷ Nuntius
    print n

    let Nuntius f ← variant Finis ∷ Nuntius
    print f

    print "hello"
}
