# =============================================================================
# genus — the inferred constructor against an optional slot
# =============================================================================
#
# What this teaches:
#   • Against `T ∪ none`, `_ { … }` builds T: the hole matches the expected
#     format of T, and T is the type that gets captured.
#   • The same holds for a map: `_ { "key": value }` against a map ∪ none.
#   • Binding, argument and return positions all work.
#
# See also: genus
# =============================================================================

class Punctum {
    mut int x = 0
    mut int y = 0
}

fn origo() → Punctum ∪ none {
    return _ { x = 7, y = 9 }
}

fn abscissa(Punctum ∪ none p) → int {
    return p?.x coalesce -1
}

fn pondus(map<string, int> ∪ none m) → int {
    return m?["a"] coalesce -1
}

main {
    let Punctum ∪ none a ← _ { x = 1, y = 2 }
    print a?.x coalesce -1
    print a?.y coalesce -1

    let Punctum ∪ none b ← origo()
    print b?.x coalesce -1
    print b?.y coalesce -1

    print abscissa(_ { x = 5 })

    let map<string, int> ∪ none m ← _ { "a": 3 }
    print m?["a"] coalesce -1
    print pondus(_ { "a": 4 })
}
