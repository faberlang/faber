# =============================================================================
# genus — Nested mutation
# =============================================================================
#
# What this teaches:
#   • A place reaches through a field (`o.inner.v`) and through a list element
#     (`o.items[0].v`); the write mutates the object inside.
#   • The reassignment is `←`, the same arrow used for a plain field write.
#   • A `let` binding of a genus value aliases the object; a write seen through
#     the alias is seen through the original.
#
# Common mistakes:
#   • Writing to a `let` field — the field must be declared `mut`.
#   • Expecting the alias to be a copy: nothing is copied by a binding.
#   • Indexing a list that has no element at that position.
#
# See also: genus
# =============================================================================

# GRAMMAR:
#   assign : place '←' expression
#   place  : postfixExpr ('.' ident | '[' expression ']')*
#
# EXPECTED OUTPUT:
#   7, 11, 7

class In { mut int v }
class Out {
    mut In inner
    mut list<In> items
}

main {
    mut Out o ← Out { inner = In { v = 1 }, items = [In { v = 10 }] }
    o.inner.v ← 7
    o.items[0].v ← 11
    print o.inner.v
    print o.items[0].v
    let In alias ← o.inner
    print alias.v
}
