# =============================================================================
# genus — the inferred constructor `_ { … }` for json and the typed zero
# =============================================================================
#
# What this teaches:
#   • `_ { "key": value }` against `json` builds what the bare `{ … }` literal builds.
#   • `_ {}` against a tensor, vector or matrix is the typed zero `Type {}`.
#   • The expected type comes from a binding, a parameter, or a declared return.
#
# See also: genus
# =============================================================================

fn doc() → json {
    return _ { "x": 7 }
}

fn cells(tensor<f32, [2, 2]> t) → int {
    return t.shape()[0]
}

fn blank() → tf32[3] {
    return _ {}
}

main {
    let json j ← _ { "a": 1 }
    let json same ← { "a": 1 }
    print j
    print same
    print doc()

    let tensor<f32, [8]> b ← _ {}
    print b.shape()
    print b[[3]]

    let tf32[2, 3] g ← _ {}
    print g.shape()
    print g[[1, 2]]

    print cells(_ {})
    print blank().shape()
}
