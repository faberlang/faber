# A record returned by a callee is appended to a list and index-stored into it, then read
# back. The callee's frame is gone by the time of the read, so the list must own the
# record, including the list field it carries.

class H {
    mut list<int> values
    mut int n
}

fn build(int n) → H {
    mut list<int> v ← empty
    for range 0‥n let i {
        v.append(i * 10)
    }
    return H { values = v, n = n }
}

fn fill(int n) → list<H> {
    mut list<H> hs ← empty
    hs.append(build(1))
    hs.append(build(1))
    hs[1] ← build(n)
    return hs
}

main {
    let list<H> first ← fill(3)
    let list<H> second ← fill(1)
    print first[1].values[2] + first[1].n
    print first[1].values.length()
    print second[1].values.length()
}
