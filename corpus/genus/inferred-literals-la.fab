# =============================================================================
# genus — literals that take the cell's type
# =============================================================================
#
# What this teaches:
#   • `_ [ a, b ]` builds the expected tuple (or list) from its cell.
#   • A bare `[ a, b ]` takes a tuple cell's type; with no typed cell it stays a list.
#   • A bare `{ field = value }` takes a class cell's type, like `_ { … }`.
#
# See also: genus
# =============================================================================

genus Punctum {
    varia numerus x = 0
    varia numerus y = 0
}

functio par() → iuncta<numerus, textus> {
    redde _ [3, "c"]
}

functio origo() → Punctum {
    redde { x = 7, y = 9 }
}

functio summa(Punctum p) → numerus {
    redde p.x + p.y
}

incipit {
    fixum iuncta<numerus, textus> t ← _ [1, "a"]
    nota t[0]
    nota t[1]
    fixum iuncta<numerus, textus> u ← par()
    nota u[0]
    fixum iuncta<numerus, numerus> v ← [5, 6]
    nota v[1]
    fixum Punctum p ← { x = 1, y = 2 }
    nota p.x
    nota p.y
    fixum Punctum q ← origo()
    nota q.y
    nota summa({ x = 10, y = 20 })
    fixum lista<numerus> xs ← _ [1, 2, 3]
    nota xs.longitudo()
    fixum lista<numerus> ys ← [4, 5]
    nota ys.longitudo()
}
