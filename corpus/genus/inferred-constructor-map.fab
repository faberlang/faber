# =============================================================================
# genus — the inferred constructor `_ { … }` with entries
# =============================================================================
#
# What this teaches:
#   • `_ { "key": value }` builds the expected map, entry for entry what the
#     bare `{ "key": value }` literal builds.
#   • The expected type comes from a binding, a parameter, or a declared return.
#   • `_ {}` against a map is the empty map.
#
# See also: genus
# =============================================================================

fn pondus() → map<string, int> {
    return _ { "x": 7, "y": 9 }
}

fn summa(map<string, int> m) → int {
    return m["a"] + m["b"]
}

main {
    let map<string, int> puncta ← _ { "aelia": 95, "balbus": 87 }
    print puncta["aelia"]
    print puncta["balbus"]

    let map<string, int> p ← pondus()
    print p["x"]
    print p["y"]

    print summa(_ { "a": 3, "b": 4 })

    mut map<string, int> vacuum ← _ {}
    vacuum["k"] ← 5
    print vacuum["k"]
}
