# =============================================================================
# genus — the inferred constructor `_ { … }`
# =============================================================================
#
# What this teaches:
#   • `_ { field = value }` is the short form of `Type { field = value }`.
#   • The hole takes the expected type: an annotated binding or a declared return.
#
# See also: genus
# =============================================================================

class Punctum {
    mut int x = 0
    mut int y = 0
}

fn origo() → Punctum {
    return _ { x = 7, y = 9 }
}

main {
    let Punctum a ← _ { x = 1, y = 2 }
    print a.x
    print a.y

    let Punctum b ← origo()
    print b.x
    print b.y
}
