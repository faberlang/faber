# =============================================================================
# genus — empty literal ascription
# =============================================================================
#
# What this teaches:
#   • `{} ∷ Class` is the same value as `Class {}`: every field takes its default.
#
# See also: genus
# =============================================================================

class Calc {
    mut int value = 0
    fn set(int n) → void {
        self.value ← n
    }
}

main {
    mut Calc c ← {} ∷ Calc
    c.set(5)
    print c.value
}
