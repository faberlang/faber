# =============================================================================
# genus — a construction literal names a field the genus does not declare
# =============================================================================
# Every key in a construction literal must be a declared field. A key that the
# genus does not declare — a typo, or a field from another type — is a check
# error, so the value can never diverge from the declaration.

class A { mut int x }

main {
    let A a ← A { x = 1, z = 2 }
    print a.x
}
