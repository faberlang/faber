# =============================================================================
# genus — a construction literal without a source omits a required field
# =============================================================================
# A construction literal builds a complete value. Without a `from` source to
# copy from, every declared field must be named; leaving one out is a check
# error, so a genus value never exists half-built.

class A {
    mut int x
    mut int y
}

main {
    let A a ← A { x = 1 }
    print a.x
}
