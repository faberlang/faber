# =============================================================================
# genus — Genus methods using ego for field access
# =============================================================================
#
# What this teaches:
#   • Genus methods using ego for field access.
#   • Related keywords: genus, ego, functio
#
# Common mistakes:
#   • Mutating `ego` fields on a `sit` instance — methods that mutate state via `ego` require the instance to be bound with `varia`.
#
# See also: genus, ego, functio
# =============================================================================

# Genus with methods using ego
#
# genus Nomen {
#     <type> <field>
#     functio <opus>() → <type> { ... ego.<field> ... }
# }
#
# GRAMMAR:
#   methodDecl inside genusDecl; ego refers to the current instance
#
# EXPECTED OUTPUT:
#   50, 30, falsum, then counter values 0, 1, 3

class Forma {
    mut int latitudo = 1
    mut int altitudo = 1

    fn area() → int {
        return self.latitudo * self.altitudo
    }

    fn ambitus() → int {
        return 2 * (self.latitudo + self.altitudo)
    }

    fn aequilatera() → bool {
        return self.latitudo ≡ self.altitudo
    }
}

class Numerator {
    mut int numerus = 0

    fn auge() → void {
        # mutate instance state via ego
        self.numerus ← self.numerus + 1
    }

    fn accipe() → int {
        return self.numerus
    }
}

main {
    # --- Methods that return values ---

    let Forma forma ← Forma { latitudo = 10, altitudo = 5 }
    print forma.area()
    print forma.ambitus()
    print forma.aequilatera()

    # --- Methods that modify state (mut instance binding) ---

    mut Numerator numerator ← Numerator {}
    print numerator.accipe()
    numerator.auge()
    print numerator.accipe()
    numerator.auge()
    numerator.auge()
    print numerator.accipe()
}
