# =============================================================================
# genus construction source type — copy-with-changes needs the same genus
# =============================================================================
# `B { x = 2 } from a` copies every unlisted field from the source, so the
# source must itself be a B. A different genus type has no fields to copy.

class A { mut int x }
class B { mut int x }

main {
    let A a ← A { x = 1 }
    let B b ← B { x = 2 } from a
    print b.x
}
