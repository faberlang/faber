# =============================================================================
# genus — Printing composites and scalars
# =============================================================================
#
# What this teaches:
#   • A composite prints its construction literal and a scalar prints its
#     value: `print "hello"` shows `hello`, but a text inside a composite is
#     quoted as in source (`["a", "b"]`, `names = ["a", "b"]`).
#   • Chars and ascii texts are quoted inside a composite too: a `char` is
#     single-quoted (`c = 'q'`) and every `ascii` is double-quoted like a
#     textus (`a = "abc"`, and a one-character `u = "q"` the same, since
#     `ascii<size 1>` is text and not the char type); the declared type decides the
#     quotes, never the length. At the top level `print 'q'` shows `q`.
#   • An absent optional field prints `nihil`; a present one prints its bare
#     value (`opt = 3`); booleans print `verum` and `falsum`.
#   • A `const` class member is not part of the construction literal.
#   • A discretio variant prints `Type.Variant { … }`; a variant with no fields
#     prints `Type.Variant` with no braces, as does every member of an all-unit
#     discretio and of an `ordo`. A genus with no fields keeps `Name {}`.
#   • Fields of a discretio print in declaration order: the shared region
#     first, then the variant's own fields.
#
# Common mistakes:
#   • Expecting `Some(3)` or `None` for an optional field — Faber has no `Some`.
#   • Expecting braces on a unit variant — `Node.Finis` has no field list.
#
# See also: genus, discretio, ordo, lista, nota
# =============================================================================

# GRAMMAR:
#   instance :← ident '{' fieldInit (',' fieldInit)* '}'
#
# EXPECTED OUTPUT:
#   composites as construction literals, scalars as values.

class Rec {
    mut bool ok
    mut int ∪ none opt
    mut char c
    mut ascii a
    mut ascii u
    mut list<string> names
    mut d64 price
    mut f32 ratio
    const int LIMIT = 4
}

class Vacuus {
}

union Node {
    Leaf {
        int v
    },
    Finis
}

union Signum {
    Alpha,
    Beta
}

enum Color {
    Red,
    Green
}

union Shape {
    @ shared
    int kind

    Dot,
    Circle {
        float r
    }
}

main {
    let Rec r ← Rec { ok = true, opt = 3, c = 'q', a = 'abc', u = 'q', names = ["a", "b"], price = 0.1, ratio = 0.1 }
    print r

    let Rec e ← Rec { ok = false, opt = null, c = 'z', a = 'xyz', u = 'z', names = [], price = 2.0, ratio = 0.25 }
    print e

    print Vacuus {}

    let Node leaf ← variant Leaf { v = 1 } ∷ Node
    print leaf
    let Node end ← variant Finis ∷ Node
    print end

    let Signum s ← variant Alpha ∷ Signum
    print s
    let Color k ← Color.Red
    print k

    let Shape dot ← variant Dot { kind = 1 } ∷ Shape
    print dot
    let Shape circle ← variant Circle { kind = 2, r = 1.5 } ∷ Shape
    print circle

    let list<string> words ← ["a", "b"]
    print words
    let list<char> letters ← ['x', 'y']
    print letters
    let list<ascii> marks ← ['q', 'abc']
    print marks
    let list<int> numbers ← [0, 1, 2]
    print numbers
    let list<bool> flags ← [true, false]
    print flags

    print "hello"
    print 'q'
    let ascii one ← 'q'
    print one
    print 7
    print true
}
