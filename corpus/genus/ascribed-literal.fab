# =============================================================================
# genus — non-empty literal ascription
# =============================================================================
#
# What this teaches:
#   • `{ field = value, … } ∷ Class` is the same value as `Class { field = value, … }`.
#   • A bare `{ field = value }` into a typed cell takes the cell's class.
#   • A field left out of the literal keeps its declared default.
#
# See also: genus
# =============================================================================

class Calc {
    mut bool flag = false
    mut int ∪ none bonus = null
}

main {
    let Calc a ← { flag = true, bonus = null } ∷ Calc
    let Calc b ← { flag = false }
    print a.flag
    print b.flag
    print a.bonus
}
