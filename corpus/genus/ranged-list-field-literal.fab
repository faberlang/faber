# =============================================================================
# genus — list literals in length-range list fields
# =============================================================================
#
# What this teaches:
#   • `Class { field = [a, b] }` stores the literal in a `list<T, size lo‥hi>`
#     field; the range is a store rule on the plain list, not a bounded carrier.
#
# See also: genus
# =============================================================================

class Window {
    let list<int, size 1‥3> ranged
    let list<int, size 2…∞> open
}

main {
    let Window window ← Window { ranged = [9, 10], open = [1, 2, 3] }
    print window.ranged
    print window.open
}
