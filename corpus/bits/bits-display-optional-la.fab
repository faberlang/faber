# =============================================================================
# bits — Display of optional and nested bits values
# =============================================================================
#
# What this teaches:
#   • a present `b8 ∪ nihil` prints exactly as its b8: hex at full width
#   • an absent `b8 ∪ nihil` prints `nihil`
#   • a present `lista<b8> ∪ nihil` prints in list shape, each element in hex
#   • an absent `lista<b8> ∪ nihil` prints `nihil`
#   • a nested `lista<lista<b8>>` prints its inner lists in brackets
#
# Common mistakes:
#   • expecting an absent optional to print `0x00` or `[]` — absent is `nihil`
#   • expecting a nested list to flatten into one bracket level
#
# See also: bits-display, bits-literals, optionalis
# =============================================================================

# bits — optional and nested display
#
# EXPECTED stdout: see bits-display-optional-la.expected

incipit {
    # a present optional scalar prints as the b8 it holds
    sit b8 sample ← 0xff
    sit b8 ∪ nihil present ← sample
    nota present

    # an absent optional scalar prints nihil
    sit b8 ∪ nihil absent ← nulla
    nota absent

    # a present optional list prints each element in hex
    sit lista<b8> raw ← [0xde, 0xad]
    sit lista<b8> ∪ nihil bytes ← raw
    nota bytes

    # an absent optional list prints nihil
    sit lista<b8> ∪ nihil missing ← nulla
    nota missing

    # a nested list keeps its inner brackets
    sit lista<lista<b8>> rows ← [[0x01], [0x02, 0xff]]
    nota rows
}
