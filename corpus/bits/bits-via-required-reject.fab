# =============================================================================
# bits — A list<b8> bulk conversion names its byte order: via Le or via Be.
# =============================================================================
#
# What this teaches:
#   • a width-changing list conversion takes a via clause naming the byte order
#
# Common mistakes:
#   • writing raw ↦ list<u16> with no via clause — the two byte orders differ,
#     so the compiler refuses to guess
#
# See also: bits-bulk
# =============================================================================

# bits reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let list<b8> raw ← [0x01, 0x02, 0x03, 0x04]
    let list<u16> le ← raw ↦ list<u16>
    print le
}
