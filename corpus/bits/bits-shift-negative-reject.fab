# =============================================================================
# bits — A literal negative shift count is refused before the run.
# =============================================================================
#
# What this teaches:
#   • a shift count written as a literal negative number is a compile error
#   • the checker refuses it by name, before any emission or run
#
# Common mistakes:
#   • expecting the literal to become the run-time trap — a *variable*
#     negative count is the run-time one (bits-shift-negative); a literal is
#     caught here
#
# See also: bits-shift-negative, bits-operations
# =============================================================================

# bits reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let b8 a ← 0xf3
    print a ⇐ -1
}
