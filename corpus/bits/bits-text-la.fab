+++
term = "bits"
kind = "conversio"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "expression", "literal", "nota_stmt"]
category = "conversio"
canonical = true
summary = "A lista<b8> converts to textus as UTF-8, a lista<b16> as UTF-16 and a lista<b32> as UTF-32; the decode can fail and the encode cannot."
syntax = "fixum textus s ← lista<b8> ↦ textus ⊥ \"?\" | fixum lista<b16> units ← s ↦ lista<b16>"
related = ["bits", "↦"]
locale = "la"
+++
# =============================================================================
# bits — Text conversions at widths 8, 16 and 32
# =============================================================================
#
# What this teaches:
#   • lista<b8> ↦ textus is a UTF-8 decode, lista<b16> UTF-16, lista<b32> UTF-32
#   • textus ↦ lista<bN> is the encode and cannot fail
#   • a decode can fail on ill-formed input; recover with a ⊥ default
#   • the elements are the code units, so no byte order is involved
#
# Common mistakes:
#   • expecting a decode to succeed on any bits — ill-formed units fail
#   • reaching for b64 — it has no text conversion
#
# See also: bits-bulk, bits-display
# =============================================================================

# bits — UTF-8, UTF-16 and UTF-32 round trips and a failing decode
#
# EXPECTED stdout: see bits-text-la.expected

incipit {
    # UTF-8: "é" is two bytes
    fixum textus word ← "héllo"
    fixum lista<b8> utf8 ← word ↦ lista<b8>
    nota utf8
    nota utf8 ↦ textus ⊥ "?"

    # UTF-16: a character outside the basic plane is a surrogate pair
    fixum textus face ← "a😀"
    fixum lista<b16> utf16 ← face ↦ lista<b16>
    nota utf16
    nota utf16 ↦ textus ⊥ "?"

    # UTF-32: one unit per character
    fixum lista<b32> utf32 ← face ↦ lista<b32>
    nota utf32
    nota utf32 ↦ textus ⊥ "?"

    # a failing decode: 0xff is never valid in UTF-8
    fixum lista<b8> bad ← [0x68, 0xff]
    nota bad ↦ textus ⊥ "?"
}
