# =============================================================================
# b8 — Raw-bit values pass through parameters, returns, fields, lists and map values at their own width.
# =============================================================================
#
# What this teaches:
#   • A hex literal takes the width of the `bN` slot it lands in: as an
#     argument, a return value, a `let` field, a `mut` field, a list
#     element and a map value
#   • Display is the fixed-width hex form of the type: `0xa5` for a `b8`,
#     `0x00ff` for a `b16`
#   • A bit operation acts at the type's width every time: `(b ⇐ 4)` on a
#     `b8` drops the high bits
#
# Common mistakes:
#   • Treating a `bN` as a number: it has no arithmetic and no mixing with
#     numbers or other widths
#   • Expecting a literal argument to need a conversion: a literal fits
#     the declared parameter width
#
# See also: bits-display, bits-operations, bits-literals
# =============================================================================

class Frame {
    let b8 tag
    mut b16 mask
}

fn echo(b8 x) → b8 {
    return x
}

fn high_nibble(b8 x) → b8 {
    return (x ⇒ 4) ⇐ 4
}

fn full_mask() → b16 {
    return 0x00ff
}

main {
    print echo(0xa5)
    print high_nibble(0xf3)
    print full_mask()
    mut Frame frame ← Frame { tag = 0x7e, mask = 0x1234 }
    print frame.tag
    print frame.mask
    frame.mask ← full_mask()
    print frame.mask
    mut list<b8> bytes ← [0x01, 0x02]
    bytes.append(0xff)
    print bytes
    print bytes[2]
    mut map<string, b16> table ← empty
    table["low"] ← 0x00ff
    table["high"] ← 0xff00
    print table["low"]
    print table["high"]
}
