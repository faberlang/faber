# =============================================================================
# intra — Checks whether a value lies within a range
# =============================================================================
#
# What this teaches:
#   • Checks whether a value lies within a range.
#   • Related keywords: inter
#
# Common mistakes:
#   • Confusing `intra` (range containment) with `inter` (collection membership) — `intra` checks numeric intervals; `inter` checks set membership.
#
# See also: inter
# =============================================================================

# intra — range containment (membership in a numeric interval)
#
# <expr> intra <initium>‥<finis>    — half-open [initium, finis)
# <expr> intra <initium>…<finis>     — inclusive [initium, finis]
# <expr> intra <initium> ante <finis> — explicit exclusive end
#
# GRAMMAR:
#   rangeMembership :← expr 'intra' rangeExpr
#
# EXPECTED OUTPUT:
#   none — stdout not pinned for this exemplum.

const int aetas = 25

main {
    print "exempla intra"

    # Basic intra with ‥ operator (exclusive end)
    if aetas within 0‥100 {
        print "aetas intra fines est"
    }

    # intra with … (inclusive end)
    if aetas within 18…65 {
        print "aetas laboris"
    }

    # intra with ante (explicit exclusive)
    if aetas within 0 before 18 {
        print "minor"
    }
}
