# =============================================================================
# textus — s[i] is the i-th Unicode character
# =============================================================================
#
# What this teaches:
#   • `s[i]` on a string counts characters, not bytes: in "Grüße" the
#     characters at 0, 2 and 3 are G, ü and ß.
#   • A multi-byte character is one character, so indexing past it lands on
#     the next one, never inside it.
#
# Common mistakes:
#   • expecting a byte offset — to index per byte, use the ascii type
#   • indexing past the last character — that dies; it does not wrap or trim
#
# See also: textus, textus-quaestiones
#
# EXPECTED OUTPUT:
#   index-unicode.expected
# =============================================================================

main {
    let string s ← "Grüße"
    print s[0]
    print s[2]
    print s[3]
    print s[4]
}
