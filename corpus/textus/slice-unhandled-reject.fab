# textus reject case — an unhandled text slice is refused.
# `slice` reports an out-of-range window on the error channel, so a function
# that neither handles it (`⊥ default`, `do { } catch err { }`) nor declares
# its own `⇥` cannot call it. The checker names
# `failable_call_requires_handler`. This exemplum intentionally fails to check.

fn first(string s) → string {
    return s.slice(0, 1)
}

main {
    print first("abc")
}
