# =============================================================================
# rust-reserved-names — names spelled like reserved words of a target language
# =============================================================================
#
# What this teaches:
#   • A Faber name is only a Faber name. `box`, `match`, `final`, `type`,
#     `yield` and `move` are ordinary identifiers here, and the program means
#     the same on every backend even where the target language reserves the
#     word (Rust reserves all six).
#   • The same name works as a field, a method, a parameter and a local.
#
# Common mistakes:
#   • Renaming a name to dodge a target's reserved word — the compiler spells
#     it safely for each target.
#
# See also: keyword-as-ident, fixum
# =============================================================================

# rust-reserved-names — fields, methods, parameters and locals with reserved spellings
#
# EXPECTED OUTPUT:
#   rust-reserved-names.expected — the computed values.

class Cista {
    mut int box
    mut int final

    fn move(int yield, int type) → int {
        let int match ← yield + type
        let int box ← match + self.box
        return box + self.final
    }
}

fn pack(int box) → int {
    return box + 1
}

main {
    let Cista c ← Cista { box = 2, final = 3 }
    print c.move(10, 20)
    print pack(4)
}
