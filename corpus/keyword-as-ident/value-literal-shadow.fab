# =============================================================================
# keyword-as-ident — binding named after a value literal
# =============================================================================
#
# What this teaches:
#   • A binding may be named after a value literal (`true`, `false`, `null`,
#     `nan`); the live binding wins inside its scope.
#   • Every use reads the binding, so the program still runs.
#   • The checker reports WARN021 `value_literal_shadowing` for the binding.
#
# See also: verum, falsum, nulla, print-binding.fab
# =============================================================================
#
# Operator example:
#   let string true ← "t"
#   let string false ← "f"
#   print true
#   print false
#
# GRAMMAR:
#   sit_decl :← 'let' type name '←' expr
#
# EXPECTED OUTPUT:
#   value-literal-shadow.expected — t, then f

main {
    let string true ← "t"
    let string false ← "f"
    print true
    print false
}
