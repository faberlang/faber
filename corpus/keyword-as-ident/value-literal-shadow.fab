grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "expression", "literal", "nota_stmt", "genus_decl", "field_decl", "member_suffix", "sit_decl"]
category = "identifier"
canonical = false
summary = "A binding named after a value literal shadows it and warns WARN021."
syntax = "let string true - WARN021 value_literal_shadowing"
