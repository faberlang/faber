# =============================================================================
# keyword-as-ident — unshadowed `read` builtin
# =============================================================================
#
# What this teaches:
#   • When no binding named `read` is in scope, bare `read` is the lege
#     builtin (all of stdin). Same rule as corpus/lege/lege.fab.
#   • No syntactic escape hatch — the builtin stays reachable by not
#     shadowing the spelling.
#
# Common mistakes:
#   • Expecting a prompt: stdin comes from the sibling read-unshadowed.stdin
#     fixture, which is empty, so the read reaches end of input at once.
#
# See also: lege, read-shadowed.fab
# =============================================================================
#
# Operator example:
#   let _ input ← read
#
# GRAMMAR:
#   readExpr :← 'read'
#
# EXPECTED OUTPUT:
#   none — the empty stdin fixture ends the input, so the read gives `none`
#   (read-unshadowed.expected).
#
# BACKEND:
#   Targets read the fixture through the case manifest's `stdin` field; the
#   outcomes row of each target pins how it handles a read to end of input.

main {
    let string ∪ none input ← read
    print input
}
