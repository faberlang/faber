# =============================================================================
# keyword-as-ident — class fields named after keywords
# =============================================================================
#
# What this teaches:
#   • Class fields and member reads keep keyword names unchanged.
#
# See also: genus, nota, print-binding.fab
# =============================================================================
#
# EXPECTED OUTPUT:
#   field-names.expected — 10

class K {
    mut int class
    mut int fn
    mut int if
    mut int return
}

main {
    let K k ← K { class = 1, fn = 2, if = 3, return = 4 }
    print k.class + k.fn + k.if + k.return
}
