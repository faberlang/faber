+++
term = "ts-reserved-field-names"
kind = "concept"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "genus_decl", "genus_member", "genus_field_decl", "field_decl", "functio_decl", "param_list", "parameter", "return_clause", "redde_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "expression", "literal", "additive_expr", "call_expr", "call_suffix", "argument_list", "argument", "member_suffix", "assignment", "incipit_stmt", "nota_stmt", "discretio_decl", "variant", "variant_fields", "finge_expr", "field_init", "field_key", "discerne_stmt", "ex_stmt", "extract_fields", "extract_field"]
category = "identifier"
canonical = true
summary = "Genus fields, methods, variant fields, parameters and locals may be spelled like ECMAScript reserved words; a field is read, written and built under the name it was declared with."
