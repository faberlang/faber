# =============================================================================
# fiunt — Streams are lazy
# =============================================================================
#
# What this teaches:
#   • A `fiunt` stream is lazy: each `itera ex` step resumes the producer
#     until its next `cede`, so producer and consumer prints interleave.
#   • An endless producer is fine when the consumer stops early: `rumpe`
#     abandons the suspended stream.
#
# Common mistakes:
#   • Expecting the whole stream to run before the loop body starts.
#
# See also: cede, itera, rumpe
# =============================================================================

# BACKEND:
#   Lazy on the MIR runner, TypeScript, Go (range-over-func iterator) and
#   Rust (`itera ex` over a same-module generator resumes an async-block
#   state machine per step).

functio potentiae() fiunt → numerus {
    varia numerus n ← 1
    dum verum {
        nota "produco §"(n)
        cede n
        n ← n * 2
    }
}

incipit {
    itera ex potentiae() sit n {
        nota "consumo §"(n)
        si n ≥ 4 {
            rumpe
        }
    }
    nota "finis"
}
