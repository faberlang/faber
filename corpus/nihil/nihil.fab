# =============================================================================
# nihil — The absent-member type: none (la nihil) is the type, null (la nulla) is its value.
# =============================================================================
#
# What this teaches:
#   • the type — `none` (la `nihil`) is the absent member of a nullable union `T ∪ none` (la `T ∪ nihil`)
#   • the value — `null` (la `nulla`) is the null value; `none` is never a value (SEM001 name_not_value)
#   • the check — `x is none` (la `est nihil`) tests the none type; `is` with the `null` value literal is refused (PARSE040 est_value_literal_names_equality)
#
# Common mistakes:
#   • Putting the null value literal in a type position — PARSE040 null_value_in_type_position; the nullable union is `T ∪ none`.
#
# See also: ∪, sponte
# =============================================================================

# nihil — the none type and the null value
#
# GRAMMAR:
#   literal :← 'null'
#
# EXPECTED OUTPUT:
#   Scalar stdout smoke (see body).
#

main {
    let none nothing ← null
    print nothing
}
