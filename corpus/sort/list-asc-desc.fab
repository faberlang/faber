+++
locale = "la"
term = "sort-list"
kind = "concept"
category = "collection"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++
# sort via asc|desc from <list> builds a new list; the source is unchanged.
incipit {
    sit lista<numerus> xs ← [3, 1, 2, 3, 0]
    sit lista<numerus> up ← ordinata via ascendens ex xs
    sit lista<numerus> down ← ordinata via descendens ex xs
    nota up
    nota down
    nota xs
}
