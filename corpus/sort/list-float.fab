+++
locale = "la"
term = "sort-float"
kind = "concept"
category = "collection"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++
# Floats use IEEE total order: -0.0 sorts before +0.0, varia ascending order.
incipit {
    sit lista<f64> xs ← [2.5, 0.0, -1.5, -0.0, 1.0, 0.0, -0.0]
    nota ordinata via ascendens ex xs
    nota ordinata via descendens ex xs
    nota xs
}
