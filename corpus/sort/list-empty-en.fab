+++
locale = "en"
term = "sort-empty-en"
kind = "concept"
category = "sort"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++

# Sorting an empty list gives an empty list in both directions.
main {
    let list<int> xs ← empty
    let list<int> up ← sort via asc from xs
    let list<int> down ← sort via desc from xs
    print up
    print down
    print up.length()
}
