+++
locale = "en"
term = "sort-body-stable-en"
kind = "concept"
category = "collection"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++

# A body returns the sort key. Ties keep source order in both directions:
# descending is not the reverse of ascending.
class Person {
    mut string name
    mut int age
}

fn names(list<Person> ps) → string {
    mut string out ← ""
    for from ps const p {
        if out ≡ "" {
            out ← p.name
        } else {
            out ← out + " " + p.name
        }
    }
    return out
}

main {
    let list<Person> people ← [
        Person { name = "Livia", age = 30 },
        Person { name = "Marcus", age = 30 },
        Person { name = "Aulus", age = 25 },
        Person { name = "Cornelia", age = 25 },
        Person { name = "Titus", age = 40 }
    ]
    let list<Person> young ← sort via asc from people const p { return p.age }
    let list<Person> old ← sort via desc from people const p { return p.age }
    print names(young)
    print names(old)
    print names(people)
}
