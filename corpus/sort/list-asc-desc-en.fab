+++
locale = "en"
term = "sort-list-en"
kind = "concept"
category = "collection"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++

# sort via asc|desc from <list> builds a new list; the source is unchanged.
main {
    let list<int> xs ← [3, 1, 2, 3, 0]
    let list<int> up ← sort via asc from xs
    let list<int> down ← sort via desc from xs
    print up
    print down
    print xs
}
