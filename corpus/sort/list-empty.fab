+++
locale = "la"
term = "sort-empty"
kind = "concept"
category = "sort"
grammar = ["sort_expr", "sort_direction", "sort_body"]
canonical = true
+++
# Sorting an empty list gives an empty list in both directions.
incipit {
    sit lista<numerus> xs ← vacua
    sit lista<numerus> up ← ordinata via ascendens ex xs
    sit lista<numerus> down ← ordinata via descendens ex xs
    nota up
    nota down
    nota up.longitudo()
}
