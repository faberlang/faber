# =============================================================================
# mori — A runtime text panic message is preserved by the host trap.
# =============================================================================
#
# EXPECTED:
#   stdout: before
#   stderr: abort: boom
#   exit: 70

main {
    let string reason ← "boom"
    print "before"
    panic reason
    print "after"
}
