# =============================================================================
# copia — Filters and maps a copia of integers.
# =============================================================================
#
# What this teaches:
#   • higher-order methods on copia (set) values — filter and map return new sets
#   • a bracket literal takes the set cell's type: `let set<int> s ← [1, 2, 3]`
#   • set iteration order is unspecified (D19.2) — print set-derived values
#     through `sort via asc from`, which yields a sorted list
#
# Common mistakes:
#   • Printing a set (or a set-derived value) directly — the order is not defined.
#
# See also: copia, lista, sort
# =============================================================================

main {
    let set<int> res ← [1, 2, 3, 4, 5]
    let set<int> magni ← res.filter(int x ∴ x ≻ 2)
    print sort via asc from magni
    let set<int> paria ← res.map(int x → int ∴ x % 2)
    print sort via asc from paria
    print magni.length()
}
