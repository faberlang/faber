# =============================================================================
# apud rank-2 — `at [r, c]` walks a matrix row-major with one statement.
# =============================================================================
#
# What this teaches:
#   • `at [r, c]` over `matrix<T, [R, C]>` binds row then column — the
#     first-bound coordinate is the outer axis, so the walk is row-major
#   • the operator's database-metadata origin: one statement replaces the
#     nested `for range` pair `nidificatus.fab` needs for the same grid
#
# Common mistakes:
#   • reading the coordinates as (column, row) — the statement declares the
#     flattening order; nothing is silently chosen
#
# See also: apud, itera, ex, matrix
# =============================================================================

# Rank-2 `apud [r, c]` over a matrix built by vector outer product
#
# for from m at [r, c] let cell { <body> }
#
# GRAMMAR:
#   iteraStmt :← 'for' 'from' expr ('at' '[' ident (',' ident)* ']')? …
#
# EXPECTED OUTPUT:
#   r, c, cell per line — rows outer (0‥2), columns inner (0‥3).

main {
    let vf32[2] a ← [1.0, 2.0] ↦ vf32[2]
    let vf32[3] b ← [10.0, 20.0, 30.0] ↦ vf32[3]
    let matrix<f32, [2, 3]> m ← a ⊗ b

    for from m at [r, c] let cell {
        print r, c, cell
    }
}
