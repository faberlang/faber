# =============================================================================
# ex-tabula — `for from <tabula>` value iteration.
# =============================================================================
#
# What this teaches:
#   • `itera ex` over a tabula yields the VALUES — the binder never receives
#     the key
#   • iteration order is unspecified (D19.2) — this exemplum sorts the
#     collected values before printing so the golden is order-independent
#   • the ex binder alone is keyless — `itera de` is the key surface (see
#     itera/de.fab), and `at [k]` binds key and value together (see
#     itera/apud-tabula.fab)
#
# Common mistakes:
#   • expecting the ex binder to carry the key — ex binds values; de binds
#     keys/indices
#   • assuming insertion or any other stable order — tabula order is
#     unspecified; collect and `ordina` (sort) before printing
#
# See also: tabula, de, ex, itera
# =============================================================================

# itera ex over tabula — value iteration
#
# for from <tabula> let <value> { <body> }
#
# GRAMMAR:
#   iteraStmt :← 'itera' 'ex' expr ('sit' | 'varia') IDENTIFIER block
#
# EXPECTED OUTPUT:
#   ex-tabula.expected — sorted values (1, 2, 3), then the order-independent
#   sum (6).

main {
    let map<string, int> puncta ← { "alpha": 1, "beta": 2, "gamma": 3 }

    # the ex binder receives each value, never the key — collect then sort,
    # since tabula order is unspecified (D19.2)
    mut list<int> valores ← empty
    for from puncta let v {
        valores.append(v)
    }
    valores.sort()
    for from valores let v {
        print v
    }

    # order-independent aggregate — the sum is stable whatever the map order
    mut int totum ← 0
    for from puncta let v {
        totum ← totum + v
    }
    print totum
}
