+++
locale = "en"
term = "itera-loop-shape-reject-list-sort"
kind = "reject"
category = "loop"
grammar = ["itera_stmt", "expression", "call_expr"]
canonical = false
summary = "An in-place sort inside a loop over that same list is refused at check time."
no_expected = "rejects"
diagnostic = "SEM011:loop_collection_shape_change"
+++

# This exemplum intentionally fails to compile: `xs.sort()` reorders the list
# that the loop is walking. The length does not move, but the positions do, so
# the rule counts order as shape. Methods are checked; a bracket store is the
# unchecked "developer knows best" form. Sort a copy with `xs.sorted(...)` when
# the loop needs an ordered view.
main {
    mut list<int> xs ← [3, 1, 2]
    for from xs let x {
        xs.sort()
    }
}
