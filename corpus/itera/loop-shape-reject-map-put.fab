+++
locale = "en"
term = "itera-loop-shape-reject-map-put"
kind = "reject"
category = "loop"
grammar = ["itera_stmt", "expression", "call_expr"]
canonical = false
summary = "A put inside a loop over that same map is refused at check time."
no_expected = "rejects"
diagnostic = "SEM011:loop_collection_shape_change"
+++

# This exemplum intentionally fails to compile: `m.put("zz", 1)` changes the
# shape of the map that the loop is walking. A method that changes the
# iterated collection's shape or order is refused at check time, and put
# counts even when it would only update an existing key. Methods are checked;
# a bracket store (`m[k] ← v`) is the unchecked "developer knows best" form.
main {
    mut map<string, int> m ← empty
    m["a"] ← 1
    for ref m let k {
        m.put("zz", 1)
    }
}
