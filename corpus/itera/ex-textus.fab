# =============================================================================
# ex over textus — iterate the characters of a string.
# =============================================================================
#
# What this teaches:
#   • `itera ex` over a textus binds each Unicode scalar as a `char`
#     (`littera`): one character, four bytes, never a heap string
#   • non-ASCII text iterates the same way on every backend — no trap
#   • a loop character compares directly with a one-letter literal ('o')
#     and converts to string with `↦`
#
# Common mistakes:
#   • Treating the loop character as a number: it is a character, not a
#     code point.
#   • Expecting grapheme clusters: 👍🏽 is two scalars, so it iterates twice.
#
# See also: ex, de, textus, char
# =============================================================================

main {
    let string verbum ← "roma"
    for from verbum const c {
        print c ↦ string
    }

    mut int vocales ← 0
    for from verbum const c {
        if c ≡ 'o' {
            vocales ← vocales + 1
        }
        if c ≡ 'a' {
            vocales ← vocales + 1
        }
    }
    print vocales

    let string salutatio ← "Grüße👍"
    mut int litterae ← 0
    for from salutatio const c {
        print c
        litterae ← litterae + 1
    }
    print litterae
}
