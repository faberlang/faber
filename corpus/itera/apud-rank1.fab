# =============================================================================
# apud rank-1 — `at [i]` binds the single axis coordinate next to the element.
# =============================================================================
#
# What this teaches:
#   • `at [i]` on a rank-1 tensor binds the lane index as a `numerus`
#     alongside the element — one statement, no nested `from range` loop
#   • the coordinate is outer-first by construction: rank 1 has exactly one
#     axis, so the flattening order is the axis itself
#
# Common mistakes:
#   • expecting `at [i, j]` on a rank-1 tensor to bind two coordinates —
#     coordinate count must equal the iterable rank (arity mismatch)
#
# See also: apud, itera, ex, tensor
# =============================================================================

# Rank-1 `apud [i]` over a literal-shaped tensor
#
# for from t at [i] let cell { <body> }
#
# GRAMMAR:
#   iteraStmt :← 'for' 'from' expr ('at' '[' ident (',' ident)* ']')? …
#
# EXPECTED OUTPUT:
#   lane index and element, one line per lane (0‥3).

main {
    let list<f32> flat ← [1.0, 2.0, 3.0]
    mut tf32[3] line ← flat ↦ tf32[3]

    for from line at [i] let cell {
        print i, cell
    }
}
