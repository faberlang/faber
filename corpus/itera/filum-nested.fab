# =============================================================================
# nested filum — independent `thread` loops compose their coordinates.
# =============================================================================
#
# What this teaches:
#   • a `thread` body must not depend on the order of its iterations: it writes
#     only its own coordinate and reads a written tensor only at that same
#     coordinate
#   • in a nest the own coordinate is the outer coordinates followed by the
#     inner ones, so `grid[[i, j]]` is the one cell this `(i, j)` iteration owns
#   • the nest still runs sequentially, outer loop first, and prints exactly
#     what the same nest of plain loops prints
#
# Common mistakes:
#   • writing `grid[[i + 1, j]]` or `grid[[i, 0]]` from the inner loop — another
#     iteration owns or also writes that cell, so the body is declined with an
#     independence diagnostic
#   • updating an outer iteration's `var` from an inner `thread` loop — a plain
#     inner loop may do it, a `thread` loop may not
#
# See also: apud, itera, ex, filum, thread
# =============================================================================

# Nested `at [i] thread a` and `at [j] thread b` over two lists of lanes
#
# EXPECTED OUTPUT:
#   the 2×3 grid of sums twice, flat in row-major order — first from the nested
#   thread loops, then from the plain loops; the two lines are identical.

main {
    let tf32[2] rows ← [1.0, 2.0] ↦ tf32[2]
    let tf32[3] cols ← [10.0, 20.0, 30.0] ↦ tf32[3]
    mut tf32[2, 3] grid ← tf32[2, 3] {}
    mut tf32[2, 3] plain ← tf32[2, 3] {}

    for from rows at [i] thread outer let row {
        for from cols at [j] thread inner let col {
            grid[[i, j]] ← row + col
        }
    }

    for from rows at [i] let row {
        for from cols at [j] let col {
            plain[[i, j]] ← row + col
        }
    }

    print grid
    print plain
}
