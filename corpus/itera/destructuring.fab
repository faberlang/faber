# =============================================================================
# ex — Extracts fields from a value into local bindings.
# =============================================================================
#
# What this teaches:
#   • Loop-binder destructuring — `for from xs const [a, b] { ... }` binds each
#     element through the same pattern grammar as binding-position forms.
#   • Records (genus) — `for from puncta const {x, y} { ... }` object_pattern
#     binds fields by name on each element.
#   • Positional tuples — `for from ordines const [a, b] { ... }` binds tuple
#     slots positionally.
#   • Rest patterns — `for from matricula const [caput, rest cauda]` captures
#     the remaining lista.
#   • Holes — `for from ordines const [_, secundus]` skips a slot with `_`.
#
# Common mistakes:
#   • Binding more pattern slots than the tuple element has — the loop binder
#     inherits the binding-form width rules and rejects with
#     `tuple_index_out_of_bounds`.
#   • Naming an element label the tuple does not declare — by-label patterns
#     must name declared labels and reject with `unknown_tuple_element_label`.
#
# See also: de, ut, ceteri
# =============================================================================

# itera — destructuring loop binders
#
# for from <collection> <const|var> <pattern> { <body> }
#
# The binder accepts the same array/object patterns as binding position:
#   [a, b]              positional slots
#   {x, y}              record fields
#   [caput, rest cauda] rest pattern
#   [_, x]              holes
#
# GRAMMAR:
#   forInStmt :← 'itera' 'ex' expr ('fixum' | 'varia') pattern block
#
# EXPECTED OUTPUT:
#   destructuring.expected — sums and elements from every pattern form.

class Punctum {
    int x
    int y
}

main {
    # --- Records: object_pattern over lista of genus elements ---

    const list<Punctum, 2> puncta ← [Punctum { x = 1, y = 2 }, Punctum { x = 3, y = 4 }]
    for from puncta const __itera_element_0 {
        const int x ← __itera_element_0.x
        const int y ← __itera_element_0.y
        print x + y
    }

    # --- Labeled tuples: object_pattern binds by label ---

    const list<tuple<int, int>> paria ← [tuple<int, int> [50, 60], tuple<int, int> [70, 80]]
    for from paria const __itera_element_0 {
        const int gx ← __itera_element_0[0]
        print gx
    }

    # --- Positional tuples: array_pattern over fixed-width rows ---

    const list<tuple<int, int>> ordines ← [tuple<int, int> [10, 20], tuple<int, int> [30, 40]]
    for from ordines const __itera_element_0 {
        const int a ← __itera_element_0[0]
        const int b ← __itera_element_0[1]
        print a + b
    }

    # --- Rest patterns: first element plus the remaining lista ---

    const list<list<int, 3>, 2> matricula ← [[1, 2, 3], [4, 5, 6]]
    for from matricula const __itera_element_0 {
        const int caput ← __itera_element_0[0]
        const list<int, 3> cauda ← __itera_element_0
        print caput
        print cauda[1]
    }

    # --- Holes: `_` skips a slot ---

    for from ordines const __itera_element_0 {
        const int secundus ← __itera_element_0[1]
        print secundus
    }
}
