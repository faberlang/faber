+++
term = "itera"
kind = "keyword"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "itera_stmt", "itera_binding", "range_expr", "range_tail", "expression", "literal", "nota_stmt"]
category = "loop"
canonical = true
summary = "Range product semantics: sign classes, offsets, and step directions with exclusive/inclusive boundary twins."
syntax = "for range <a>‥<b> step <s>, <c>‥<d> let <i>, <j> { }"
related = ["ex", "de", "apud"]
locale = "en"
+++
# =============================================================================
# range product semantics — the sign/offset/step matrix, end to end.
# =============================================================================
#
# What this teaches:
#   • every walk below is a Cartesian product in arity N=2: the leftmost
#     range is the outer axis, and each outer value carries the complete
#     ordered inner walk — no axis is ever zipped, reordered, or truncated
#   • sign classes are not normalized: crossing (-5‥5), negative-to-
#     negative (-8‥-3), and positive-to-positive (2‥7) axes all keep their
#     declared values, with and without a step
#   • a step applies to its own axis only: a stepped outer offset (1‥9 step
#     3) still walks the inner axis completely, and a stepped inner axis
#     (0‥10 step 2) never reorders the product
#   • boundary twins: each row appears in the exclusive form (`‥`) and the
#     inclusive form (`…`); the twin includes the upper endpoint only when
#     the progression reaches it — values are never appended or dropped to
#     force the endpoint (2…7 step 2 stays 2, 4, 6; -5…5 step 2 gains 5)
#
# Common mistakes:
#   • assuming a zero-based axis — offsets (3‥12, -2‥4) keep their declared
#     starts and ends on both axes
#   • assuming a descending range needs a negative step — the step is a
#     positive stride and the bounds pick the direction: 10‥0 step 2 walks
#     10, 8, 6, 4, 2 and includes 0 only in the inclusive twin
#
# See also: ex, apud
# =============================================================================

main {
    # crossing sign class, no step / stepped, exclusive + inclusive twins
    for range -5‥5, 2‥4 let i, j {
        print i
        print j
    }
    for range -5…5, 2…4 let i, j {
        print i
        print j
    }
    for range -5‥5 step 2, 2‥4 let i, j {
        print i
        print j
    }
    for range -5…5 step 2, 2…4 let i, j {
        print i
        print j
    }

    # negative-to-negative sign class, no step / stepped, twins
    for range -8‥-3, 2‥4 let i, j {
        print i
        print j
    }
    for range -8…-3, 2…4 let i, j {
        print i
        print j
    }
    for range -8‥-3 step 2, 2‥4 let i, j {
        print i
        print j
    }
    for range -8…-3 step 2, 2…4 let i, j {
        print i
        print j
    }

    # positive-to-positive sign class, no step / stepped, twins
    for range 2‥7, 2‥4 let i, j {
        print i
        print j
    }
    for range 2…7, 2…4 let i, j {
        print i
        print j
    }
    for range 2‥7 step 2, 2‥4 let i, j {
        print i
        print j
    }
    for range 2…7 step 2, 2…4 let i, j {
        print i
        print j
    }

    # offset row — both axes off zero, twins
    for range 3‥12, -2‥4 let i, j {
        print i
        print j
    }
    for range 3…12, -2…4 let i, j {
        print i
        print j
    }

    # stepped offset row — the stepped outer axis stays outer, twins
    for range 1‥9 step 3, -2‥4 let i, j {
        print i
        print j
    }
    for range 1…9 step 3, -2…4 let i, j {
        print i
        print j
    }

    # zero-start step on the inner axis (product form of 0‥10 step 2), twins
    for range 3‥5, 0‥10 step 2 let i, j {
        print i
        print j
    }
    for range 3…5, 0…10 step 2 let i, j {
        print i
        print j
    }

    # descending outer axis with a positive stride, twins
    for range 10‥0 step 2, 1‥3 let i, j {
        print i
        print j
    }
    for range 10…0 step 2, 1…3 let i, j {
        print i
        print j
    }
}
