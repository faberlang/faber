# =============================================================================
# apud decline — arity mismatch and unindexed iterables fail closed.
# =============================================================================
#
# Decline rows (reject reason in each comment):
#   1. arity mismatch — `at [i]` over tensor<f32, [2, 3]> binds 1 coordinate
#      for rank 2: SEM010 itera_apud_arity_mismatch (expected=2, actual=1);
#      partial binding never happens — the statement declines whole
#   2. ragged — `list<list<f32>>` is a lista, and a lista is rank 1
#      (`rows[r]` takes one index): SEM010 itera_apud_arity_mismatch
#      (expected=1, actual=2). Changed by D3.1 — it was
#      itera_apud_requires_shaped_iterable while lists had no `at` form.
#   3. set — a copia has no index to name: SEM010
#      itera_apud_requires_indexed_iterable (`at` needs a lista, tabula,
#      tensor, or matrix)
#   4. generic dims — `size R, size C` dims are admitted: the loop bounds are
#      read from the tensor at run time (an admit row, not a decline; it was a
#      MIR-lane decline until loops over run-time extents landed)
#
# Common mistakes:
#   • expecting half-bound coordinates on mismatch — arity == rank is a type
#     error, never a partial bind
#
# See also: apud, itera, ex, tensor
# =============================================================================

# apud reject cases — expected compile failure
#
# WHY: documents the arity and indexed-iterable contracts for coordinate
# iteration. Cases 1–3 must reject under `faber check` with the tokens
# pinned in apud-decline.expected; case 4 is an admit row kept here beside them.

fn arity(tensor<f32, [2, 3]> grid) → void {
    for from grid at [i] let cell {
        print cell
    }
}

fn ragged(list<list<f32>> rows) → void {
    for from rows at [r, c] let cell {
        print cell
    }
}

fn members(set<int> s) → void {
    for from s at [i] let member {
        print member
    }
}

fn generic<size R, size C>(tensor<f32, [R, C]> grid) → void {
    for from grid at [r, c] let cell {
        print cell
    }
}
