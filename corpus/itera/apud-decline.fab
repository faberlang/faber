# =============================================================================
# apud decline — arity mismatch and non-shaped iterables fail closed.
# =============================================================================
#
# Decline rows (reject reason in each comment):
#   1. arity mismatch — `at [i]` over tensor<f32, [2, 3]> binds 1 coordinate
#      for rank 2: SEM010 itera_apud_arity_mismatch (expected=2, actual=1);
#      partial binding never happens — the statement declines whole
#   2. ragged — `list<list<f32>>` has no static rank: SEM010
#      itera_apud_requires_shaped_iterable (apud requires a tensor or matrix
#      iterable with a static rank)
#   3. generic dims — `size R, size C` dims are not concrete at lowering, so
#      the base lane declines with the MIR unsupported diagnostic
#      "itera collection before iterator MIR lowering" (declared fail-closed;
#      `faber check` admits the symbolic rank — the decline is at MIR, pinned
#      in radix-module lower_test, not in this checker oracle)
#
# Common mistakes:
#   • expecting half-bound coordinates on mismatch — arity == rank is a type
#     error, never a partial bind
#
# See also: apud, itera, ex, tensor
# =============================================================================

# apud reject cases — expected compile failure
#
# WHY: documents the arity and shaped-iterable contracts for coordinate
# iteration. Cases 1 and 2 must reject under `faber check` with the tokens
# pinned in apud-decline.expected; case 3 is an MIR-lane decline kept here as
# the documented third row.

fn arity(tensor<f32, [2, 3]> grid) → void {
    for from grid at [i] const cell {
        print cell
    }
}

fn ragged(list<list<f32>> rows) → void {
    for from rows at [r, c] const cell {
        print cell
    }
}

fn generic<size R, size C>(tensor<f32, [R, C]> grid) → void {
    for from grid at [r, c] const cell {
        print cell
    }
}
