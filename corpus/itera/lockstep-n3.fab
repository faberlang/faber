# =============================================================================
# lockstep N=3 — one walk over three aligned lists.
# =============================================================================
#
# What this teaches:
#   • the source series takes any N — three collections walk in lockstep with
#     three binders, replacing a `for range` loop whose only job was keeping
#     three index-aligned lists together
#
# Common mistakes:
#   • nesting pair walks for three lists — the series is flat: one clause,
#     N sources, N binders
#
# See also: ex, apud
# =============================================================================

main {
    let list<int> bases ← [100, 200, 300]
    let list<int> keys ← [1, 2, 3]
    let list<int> payloads ← [10, 20, 30]
    for from bases, keys, payloads let base, key, payload {
        let int total ← base + key + payload
        print total
    }
    let list<int> rows ← [1, 2]
    let list<int> cols ← [3, 4]
    let list<int> cells ← [5, 6]
    for from rows, cols, cells let row, col, cell {
        let int grid ← row * col + cell
        print grid
    }
}
