+++
locale = "la"
term = "itera-reduce-source-reject"
kind = "reject"
category = "control-flow"
grammar = ["itera_stmt", "reducta_expr"]
canonical = false
summary = "A bare reduce expression is refused as a loop source; bind it to a name first."
no_expected = "rejects"
diagnostic = "PARSE030:itera_source_sort_reduce_unbound"
+++

# This exemplum intentionally fails to compile: a reduce expression is never
# written in a loop header. Bind the reduced value to a name, then loop over it.
incipit {
    fixum lista<numerus> xs ← [3, 1, 2]
    itera ex reducta via summa ex xs fixum x {
        nota x
    }
}
