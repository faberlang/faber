# =============================================================================
# itera varia — the mutable loop binder
# =============================================================================
#
# What this teaches:
#   • `for from valores var v { ... }` binds each element to a fresh mutable
#     slot — writes inside the body are legal and never leak across
#     iterations, so the loop needs no manual reset
#   • the binder is an ordinary `varia` binding: runtime assignment (`←`)
#     inside the body works exactly as it does on any mutable local
#
# Common mistakes:
#   • expecting writes to the binder to accumulate across iterations — each
#     element gets its own slot
#   • reading `var` as permission to mutate the source collection — the
#     element is a copy
#
# See also: ex, fixum, de
# =============================================================================

# itera — mutable varia binder
#
# for from <collection> var <binder> { <body> }
#
# GRAMMAR:
#   forInStmt :← 'itera' 'ex' expr ('fixum' | 'varia') ident block
#
# EXPECTED OUTPUT:
#   varia-binder.expected — each element doubled inside its own slot.

main {
    let list<int> valores ← [1, 2, 3]

    for from valores mut v {
        v ← v * 10
        print v
    }
}
