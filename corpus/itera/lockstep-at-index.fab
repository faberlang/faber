# =============================================================================
# lockstep at [i] — the shared coordinate does not grow with the series.
# =============================================================================
#
# What this teaches:
#   • the optional `at [i]` clause names the walk's shared index — ONE
#     coordinate for the whole series, whether N is 2 or 3
#   • on one list the coordinate clause still requires a shaped iterable
#     (tensor/matrix rank); on a list zip it is exactly the shared index
#
# Common mistakes:
#   • writing `at [i, j]` for two sources — the coordinate count never grows
#     with N; that spelling is a check error on a list zip
#
# See also: apud, itera
# =============================================================================

main {
    let list<string> labels ← ["a", "b", "c"]
    let list<int> values ← [1, 2, 3]
    for from labels, values at [i] let label, value {
        print i
        print label
    }
    let list<int> bases ← [100, 200]
    let list<int> keys ← [1, 2]
    let list<int> payloads ← [10, 20]
    for from bases, keys, payloads at [slot] let base, key, payload {
        let int total ← slot + base + key + payload
        print total
    }
}
