# =============================================================================
# apud causal — an index-dependent body over the upper triangle.
# =============================================================================
#
# What this teaches:
#   • coordinates are plain immutable `numerus` locals: `if r ≤ c` is an
#     ordinary pure condition, no new index-space operators
#   • index-dependent bodies keep the single statement — the causal filter
#     lives inside the loop body, not in a hand-built index walk
#
# Common mistakes:
#   • building the triangle with a nested `for range` pair and manual bounds —
#     the condition belongs in the body; the loop walks the full grid
#
# See also: apud, itera, ex, si
# =============================================================================

# Index-dependent causal body — keep only r ≤ c (upper triangle)
#
# for from m at [r, c] let cell { if r ≤ c { print r, c, cell } }
#
# GRAMMAR:
#   iteraStmt :← 'for' 'from' expr ('at' '[' ident (',' ident)* ']')? …
#
# EXPECTED OUTPUT:
#   six upper-triangle cells of the 3×3 outer product, row-major.

main {
    let vf32[3] a ← [2.0, 3.0, 4.0] ↦ vf32[3]
    let vf32[3] b ← [5.0, 7.0, 11.0] ↦ vf32[3]
    let matrix<f32, [3, 3]> m ← a ⊗ b

    for from m at [r, c] let cell {
        if r ≤ c {
            print r, c, cell
        }
    }
}
