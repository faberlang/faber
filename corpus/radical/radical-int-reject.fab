# =============================================================================
# √ — the radical is sugar for `.sqrt()`, never wider.
# =============================================================================
#
# What this teaches:
#   • `√ n` means `n.sqrt()` and is legal exactly where that method is legal:
#     floats and float tensors
#   • An `int` has no `.sqrt()`, so `√ n` is `SEM004 unknown_method`, the same
#     refusal as calling the method itself
#   • The fix is an explicit conversion first: `√ (n ↦ f64)`
#
# See also: radical-scalar, radical-tensor
# =============================================================================

# √ over an int: refused, an int has no .sqrt().
main {
    let int n ← 81
    print √ n
}
