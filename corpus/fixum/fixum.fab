# =============================================================================
# fixum — Declares an immutable binding
# =============================================================================
#
# What this teaches:
#   • Declares an immutable binding.
#   • Related keywords: varia, sit, ←
#
# Common mistakes:
#   • Reassigning a `sit` binding after initialization — `sit` is write-once; use `varia` for mutable bindings (SEM020) or defer init with a single later assignment.
#
# See also: varia, sit, ←
# =============================================================================

# fixum — immutable bindings
#
# Immediate init:
#   sit numerus count ← 0
#   sit nomen ← "Marcus"
#
# Deferred init (write-once): declare without ←, assign exactly once later, then
# freeze. The definite-assignment pass rejects reads before that assignment and
# any second assignment.
#   sit numerus pending
#   pending ← 42
#
# `sit x` infers the type in both immediate and deferred shapes; see
# sit/sit.fab for the compact inferred spelling. `fixum` itself now states a
# compile-time constant (`fixum T X = e`).
#
# GRAMMAR:
#   varDecl := ('sit' | 'varia') typeAnnotation IDENTIFIER ('←' expression)?
#
# EXPECTED OUTPUT:
#   fixum.expected (Salve, Marcus! / 7 / 30 / 300)

fn scale(bool compact, int base) → int {
    let int factor
    if compact {
        factor ← 10
    }
    else {
        factor ← 100
    }
    return base * factor
}

test "fixum immediate init" {
    let string nomen ← "Marcus"
    let string salve ← "Salve, §!"(nomen)
    assert nomen ≡ "Marcus"
    assert salve ≡ "Salve, Marcus!"
}

test "fixum deferred init writes once" {
    let int pending
    pending ← 7
    assert pending ≡ 7
}

test "fixum factor selected per branch" {
    assert scale(true, 3) ≡ 30
    assert scale(false, 3) ≡ 300
}

main {
    let string nomen ← "Marcus"
    let string salve ← "Salve, §!"(nomen)
    print salve
    let int pending
    pending ← 7
    print pending
    print scale(true, 3)
    print scale(false, 3)
}
