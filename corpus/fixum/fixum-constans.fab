# =============================================================================
# fixum T x = e — a typed local compile-time constant
# =============================================================================
#
# What this teaches:
#   • `=` states a compile-time fact; `←` stores at runtime (the glyph law).
#     `const T x = e` is a local constant: the compiler evaluates `e` while
#     compiling, so it can only use literals, arithmetic, other constants
#     (module constants and earlier `const … =` locals).
#   • The value must fit `T` exactly, whatever `T`'s overflow policy —
#     `const u8 d = 300` is a compile error, even for `saturating<u8>`.
#   • The constant is an ordinary immutable local of type `T`: it works in
#     arithmetic like any other `T` value.
#   • `const _ x = 10` infers `int` for an integer constant.
#
# Common mistakes:
#   • `const int k = p + 1` where `p` is a parameter — SEM060
#     `constant_initializer_not_constant`; a runtime value is stored with `←`.
#   • `mut int n = 3` — `mut` is a runtime binding, so `=` is a parse error
#     (`varia_compile_time_initializer`); write `mut int n ← 3`.
#   • `const u8 d = 300` — the constant does not fit `u8`
#     (`store_constant_out_of_range`).
#
# See also: fixum, varia, ←
# =============================================================================

# fixum = — local compile-time constants
#
# GRAMMAR:
#   varDecl := 'fixum' typeAnnotation IDENTIFIER '=' expression
#
# EXPECTED OUTPUT:
#   fixum-constans.expected (11 / 27 / 200)

const int BASE_UNIT = 10

fn total(int width) → int {
    const int edge = 3
    const int cells = edge * edge
    const _ margin = 2
    return width * cells + margin
}

fn ceiling() → int {
    const int shifted = BASE_UNIT * 2 + 7
    return shifted
}

test "local constants combine in arithmetic" {
    assert total(1) ≡ 11
    assert ceiling() ≡ 27
}

main {
    print total(1)
    print ceiling()
    const u8 top = 200
    print top
}
