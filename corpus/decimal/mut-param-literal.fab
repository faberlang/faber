# A decimal literal in a mutable decimal parameter
#
# A written decimal literal in arithmetic with a `mut d64` parameter belongs
# to the decimal family, just as it does beside a local `d64` value.

fn increment(mut d64 p) → void {
    p ← p + 1.0
}

fn increment_local() → d64 {
    mut d64 p ← 2.5
    p ← p + 1.0
    return p
}

main {
    mut d64 p ← 2.5
    increment(mut p)
    print p
    print increment_local()
}
