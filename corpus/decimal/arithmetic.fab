# =============================================================================
# d64 — decimal arithmetic at the scaled carrier
# =============================================================================
#
# What this teaches:
#   • Annotated decimal literals — `d64 a ← 4.2` carries the exact
#     digit text to typing; 4.2 is 42×10⁻¹, not a float approximation.
#   • Scaled-integer execution — a stored `d64` is an `i64` carrier at
#     scale 8 (D11.7: 8 fraction digits, range ±92,233,720,368.54775807;
#     `d64` is the only decimal width). Arithmetic is exact until the
#     store: `+ -` are exact, `*` is exact with the scale growing (scale 8
#     × scale 8 is scale 16), and `/` rounds half-even to the larger operand
#     scale, all in a 128-bit intermediate. The slot that receives the value
#     rounds half-even to scale 8 and traps past the range. So 4.2 + 0.1 =
#     4.3 exactly, and `a * b * c` rounds once, when it is stored.
#   • A decimal prints in its shortest form (D2.6) — trailing zeros are
#     dropped and a whole number has no fractional part: 4.2 prints `4.2`,
#     4.2 + 0.1 prints `4.3`, and 4.2 / 0.1 prints `42`, never `42.0`.
#   • Untyped constants join by exact value — beside a `d64` or in a `d64`
#     slot, a written constant is a decimal: `a + 1`, `a * 2`, `a * 2.0`,
#     `a ≅ 4.2`, and `let d64 e ← 5` are exact (`a * 2` is 8.4). The
#     constant may have at most 8 fractional digits and must fit the range.
#   • A conditional, `discerne` or block that yields decimal arithmetic
#     rounds at the slot like any other computed decimal: 0.00000005 * 0.5
#     is 0.000000025 exactly and lands in a `d64` as `0.00000002`
#     (half-even to scale 8).
#   • A conditional that is an operand of decimal arithmetic keeps its
#     branch tails exact: `(c ✓ a * b ✗ a) * 100.0` multiplies the exact
#     0.000000025 by 100 and stores `0.0000025`, not the 0.00000002 that
#     rounding the branch first would give (that would store `0.000002`).
#     Rounding happens once, at the slot, on every target. `discerne` is a
#     statement and a block is not an operand in source, so the conditional
#     is the operand form this surface can write.
#
# Common mistakes:
#   • expecting a trailing zero or `.0` — `4.2 / 0.1` prints `42`, since a
#     `.0` would read as a float
#   • assuming decimal arithmetic degrades to float error — the scaled
#     integer carrier keeps 4.2 + 0.1 = 4.3 exact where f64 rounds
#   • mixing a typed integer or float with a decimal — `a + n` with `n` an
#     `int` or `f64` variable is `numeric_family_crossing_requires_conversio`;
#     convert it with `↦`. A written constant needs no conversion, and a
#     constant with more than 8 fractional digits is
#     `decimal_literal_out_of_range`, never rounded
#
# See also: numerus, d64, ↦, fractus
# =============================================================================

# decimal — 4.2 arithmetic at the d64 carrier
#
# WHY: pins the D4 runner contract and the D2.6 display end-to-end. Each
# line below prints the shortest decimal of the expression to its right.
#
# EXPECTED OUTPUT:
#   arithmetic.expected — shortest decimals, one per print.

main {
    let d64 a ← 4.2
    let d64 b ← 0.1
    print a
    print b
    print a + b
    print a - b
    print a * b
    print a / b
    let d64 tiny ← 0.00000005
    let d64 half ← 0.5
    let d64 z ← true ✓ tiny * half ✗ a
    print z
    let d64 w ← false ✓ a ✗ tiny * half
    print w
    let d64 n ← -1.5
    print n
    print "§ and §"(a, n)
    print a + 1
    print a * 2
    print a * 2.0
    print a + 0.1
    print a ≅ 4.2
    let d64 e ← 5
    print e
    let bool t ← true
    let bool f ← false
    let d64 on ← (t ✓ tiny * half ✗ tiny) * 100.0
    print on
    let d64 lead ← 100.0 * (t ✓ tiny * half ✗ tiny)
    print lead
    let d64 off ← (f ✓ tiny ✗ tiny * half) * 100.0
    print off
    let d64 sum ← (t ✓ tiny * half ✗ tiny) + (f ✓ tiny ✗ tiny * half)
    print sum
    let d64 quot ← (t ✓ tiny * half ✗ tiny) / 2.0
    print quot
}
