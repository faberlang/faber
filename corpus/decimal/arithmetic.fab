# =============================================================================
# numerus<d64> — decimal arithmetic at the scaled carrier
# =============================================================================
#
# What this teaches:
#   • Annotated decimal literals — `numerus<d64> a ← 4.2` carries the exact
#     digit text to typing; 4.2 is 42×10⁻¹, not a float approximation.
#   • Scaled-integer execution — a stored `d64` is an `i64` carrier at
#     scale 8 (D11.7: 8 fraction digits, range ±92,233,720,368.54775807;
#     `d64` is the only decimal width). Arithmetic is exact until the
#     store: `+ -` are exact, `*` is exact with the scale growing (scale 8
#     × scale 8 is scale 16), and `/` rounds half-even to the larger operand
#     scale, all in a 128-bit intermediate. The slot that receives the value
#     rounds half-even to scale 8 and traps past the range. So 4.2 + 0.1 =
#     4.3 exactly, and `a * b * c` rounds once, when it is stored.
#   • The runner prints the RAW scaled carrier — 4.2 prints as `420000000`
#     (42 × 10⁷ at the d64 scale), and 4.2 + 0.1 prints `430000000`
#     (43 × 10⁷). Exactness is visible in the carrier, not in a formatted
#     decimal string.
#
# Common mistakes:
#   • reading a printed carrier as a formatted decimal — `430000000` IS 4.3
#     at the d64 scale, not four hundred thirty million
#   • assuming decimal arithmetic degrades to float error — the scaled
#     integer carrier keeps 4.2 + 0.1 = 4.3 exact where f64 rounds
#   • treating integer literals as decimal literals — `a + 1`, `a / 2`, and
#     `numerus<d64> e ← 5` reject with `decimal_integer_literal_rejected`;
#     write `1.0`, `2.0`, or `5.0`, or use explicit `↦` conversion
#
# See also: numerus, d64, ↦, fractus
# =============================================================================

# decimal — 4.2 arithmetic at the d64 carrier
#
# WHY: pins the D4 runner contract end-to-end. Each line below prints the
# raw scaled carrier of the expression to its right.
#
# EXPECTED OUTPUT:
#   decimal-arithmetic.expected — raw d64 carriers, one per print.

main {
    const int<d64> a ← 4.2
    const int<d64> b ← 0.1
    print a
    print b
    print a + b
    print a - b
    print a * b
    print a / b
}
