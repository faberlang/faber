# d64 arithmetic on llvm-host
#
# Keep this case to the admitted host surface: addition and subtraction retain
# scale 8, multiplication computes at scale 16, and the destination store
# rounds half-even back to scale 8.

main {
    let d64 left ← 4.2
    let d64 right ← 0.1
    print left + right
    print left - right
    print left * right

    let d64 even_tie ← 0.00000005 * 0.5
    print even_tie
    let d64 odd_tie ← 0.00000015 * 0.5
    print odd_tie
}
