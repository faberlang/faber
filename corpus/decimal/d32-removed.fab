# =============================================================================
# d32 — the removed decimal width
# =============================================================================
#
# What this teaches:
#   • `d64` is the only decimal width. `d32` was removed because its range
#     (±214.7483647) cannot hold ordinary prices (D11.7).
#   • The bare marker `d32` fails closed with the teaching diagnostic
#     `SEM002:removed_decimal_width_d32`, whose help names `d64`. There is no
#     compatibility alias. (The wrapped `numerus<d32>` is no longer a
#     spelling at all: it is `PARSE040:numeric_wrapper_retired`.)
#
# Common mistakes:
#   • keeping `d32` for "small" money values — use `d64`
#
# See also: numerus, d64
# =============================================================================

# decimal — the removed d32 width
#
# WHY: a retired spelling must reject with a pointer to its replacement, not
# with a generic unknown-marker error.

fn small(d32 x) → d32 {
    return x
}
