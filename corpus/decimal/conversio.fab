# =============================================================================
# d64 — the decimal conversio rows
# =============================================================================
#
# What this teaches:
#   • decimal → integer — `a ↦ numerus<i64>` rounds half-even; it never
#     truncates. 4.2 → 4, 2.5 → 2, 3.5 → 4.
#   • integer → decimal — `n ↦ numerus<d64>` scales the integer to the
#     carrier: 5 prints as `5`.
#   • fractus → decimal — `g ↦ numerus<d64>` uses the string round-trip,
#     so 1.5 prints as `1.5` exactly.
#   • decimal → fractus — `a ↦ fractus` is a defined rounding; 4.2 keeps
#     its value through the float carrier.
#   • `d64` is the only decimal width — there is no decimal-to-decimal
#     width conversion (`d32` was removed; see d32-removed.fab).
#
# Common mistakes:
#   • expecting `5.0` — a whole decimal prints without a fractional part
#
# See also: ↦, numerus, d64, fractus
# =============================================================================

# decimal — the conversio rows at the runner
#
# WHY: pins the D3 conversio matrix end-to-end. Decimals print in the
# shortest form (D2.6).
#
# EXPECTED OUTPUT:
#   conversio.expected — one value per print, in order.

main {
    const int<d64> a ← 4.2
    const int<i64> i ← a ↦ int<i64>
    print i
    const int<i64> n ← 5
    const int<d64> d ← n ↦ int<d64>
    print d
    const float f ← a ↦ float
    print f
    const float g ← 1.5
    const int<d64> h ← g ↦ int<d64>
    print h
    const int<d64> p ← 2.5
    print p ↦ int<i64>
    const int<d64> r ← 3.5
    print r ↦ int<i64>
}
