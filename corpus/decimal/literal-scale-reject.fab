+++
# =============================================================================
# d64 literal scale — precision loss is refused, never rounded
# =============================================================================
#
# What this teaches:
#   • d64 has scale 8. A literal with a ninth fractional digit cannot be
#     represented exactly by its carrier and is rejected as
#     SEM010:decimal_literal_out_of_range rather than rounded.
#   • A value that needs rounding must be computed or read from text, not
#     written as a literal.
#
# Common mistake:
#   • expecting a literal with excess fractional digits to round to scale 8.
#
# Control (checks clean): let d64 fine ← 0.00000001
# See also: d64, numerus
# =============================================================================

main {
    let d64 fine ← 0.000000001
}
