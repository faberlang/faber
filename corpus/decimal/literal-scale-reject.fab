+++
term = "d64 literal scale"
kind = "reject"
no_expected = "rejects"
diagnostic = "SEM010:decimal_literal_out_of_range"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "width_type_sugar", "expression", "additive_expr", "multiplicative_expr", "literal", "nota_stmt"]
category = "arithmetic"
canonical = false
summary = "A d64 literal cannot carry a ninth fractional digit because its scale is 8."
