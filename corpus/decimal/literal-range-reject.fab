# =============================================================================
# d64 literal range — the scaled carrier sets the maximum
# =============================================================================
#
# What this teaches:
#   • A d64 literal must fit after scaling to its 10^-8 carrier. Its largest
#     value is 92233720368.54775807; the next final digit overflows the i64
#     carrier and is rejected as SEM010:decimal_literal_out_of_range.
#   • The check is on the scaled carrier, not on the digits alone.
#
# Common mistake:
#   • assuming a decimal-looking literal is acceptable because its digits
#     look small; compare the scaled value with the carrier maximum.
#
# Control (checks clean): let d64 big ← 92233720368.54775807
# See also: d64, numerus
# =============================================================================

main {
    let d64 big ← 92233720368.54775808
}
