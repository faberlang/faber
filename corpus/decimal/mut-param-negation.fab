# Negation of mutable scalar parameters
#
# The parameter's mut access marker describes writable access; negation reads
# the numeric value from its parameter place before assigning the result back.

fn negate_float(mut float p) → void {
    p ← -p
}

fn negate_int(mut i64 p) → void {
    p ← -p
}

fn negate_decimal(mut d64 p) → void {
    p ← -p
}

main {
    mut float f ← 2.5
    negate_float(mut f)
    print f

    mut i64 i ← 5
    negate_int(mut i)
    print i

    mut d64 d ← 2.5
    negate_decimal(mut d)
    print d
}
