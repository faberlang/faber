# =============================================================================
# enum nonexhaustive switch — a closed set is covered whole or caught
# =============================================================================
# An enum is a closed set: its members are every value it has. A value switch
# over an enum must therefore name every member or carry a `default`. This one
# skips `blue` and has no default, so the check reports SEM040 with the issue
# `missing_variants` instead of letting a value fall through unhandled.

enum Color { red, green, blue }

fn f(Color c) → string {
    switch c {
        case red {
            return "r"
        }
        case green {
            return "g"
        }
    }
    return "z"
}

main {
    print f(Color.red)
}
