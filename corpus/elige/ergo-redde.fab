# =============================================================================
# elige — Compact casu and ceterum branches with ergo redde.
# =============================================================================
#
# What this teaches:
#   • Compact returns — `casu <value> ergo redde <expr>` as a concise branch form inside elige.
#   • Mixed branch styles — some branches use `ergo redde` for one-liners, others use a block body for side effects plus return.
#
# Common mistakes:
#   • Using `ergo redde` when the branch needs multiple statements — use a block body `{ ... redde ... }` instead.
#
# See also: elige, ergo, redde
# =============================================================================


# elige — ergo redde compact returns
#
# casu <value> ergo redde <expression>
# ceterum ergo redde <expression>
#
# GRAMMAR:
#   casuClause :← 'casu' expr ('ergo' 'redde' expr | block)
#
# EXPECTED OUTPUT:
#   Status codes, type ids, and mixed-case handler output.

fn nuntius(int codex) → string {
    match codex {
        case 1 {
            return "paratum"
        }
        case 2 {
            return "missum"
        }
        case 3 {
            return "fractum"
        }
        case 4 {
            return "absens"
        }
        case _ {
            return "ignotum"
        }
    }
}

fn qualis(string nomen) → int {
    match nomen {
        case "textus" {
            return 1
        }
        case "numerus" {
            return 2
        }
        case "fractus" {
            return 3
        }
        case "bivalens" {
            return 4
        }
        case _ {
            return 0
        }
    }
}

# casu 2 uses a block body instead of ergo redde (side effect + return)
fn tracta(int codex) → string {
    match codex {
        case 1 {
            return "simplex"
        }
        case 2 {
            print "codex 2 tractatur..."
            return "compositus"
        }
        case 3 {
            return "iterum simplex"
        }
        case _ {
            return "defectum"
        }
    }
}

main {
    print nuntius(1)
    print nuntius(4)
    print nuntius(9)
    print qualis("textus")
    print qualis("ignotum")
    print tracta(1)
    print tracta(2)
}
