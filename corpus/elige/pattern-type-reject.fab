diagnostic = "SEM010:pattern_type_mismatch"
+++
# =============================================================================
# elige pattern type mismatch — a case literal types against its scrutinee
# =============================================================================
# Every case literal is checked against the type of the scrutinee. This
# switch is over an int, but its second arm claims a string, so the check
# reports SEM010 with the issue pattern_type_mismatch instead of building
# an arm that can never run.

fn gate(int level) → string {
    switch level {
        case 1 {
            return "low"
        }
        case "high" {
            return "high"
        }
        default {
            return "other"
        }
    }
}

main {
    print gate(1)
}
