# =============================================================================
# nondum — a call of a not-yet function is refused
# =============================================================================
#
# What this teaches:
#   • `@ nondum` without a target marks the declaration unavailable everywhere
#   • A signature-only `fn` under `@ nondum` is declared and exported, but any
#     use of it is refused
#
# Common mistakes:
#   • calling a declaration that is still pending for the current target (SEM017)
#
# See also: nondum, annotation-sugar
# =============================================================================

@ unstable "pending"
fn later(string t) → string

main {
    print later("x")
}
