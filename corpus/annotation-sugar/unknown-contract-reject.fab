# =============================================================================
# annotation-sugar — an unknown braced annotation family is refused
# =============================================================================
#
# What this teaches:
#   • A braced annotation family is either compiler-owned (`@ cli`, `@ optio`,
#     `@ futura`, …) or a genus marked `@ annotatio`
#   • Any other name is not resolved as a contract, so the application fails
#
# Common mistakes:
#   • inventing a braced family that no `@ annotatio` genus declares (SEM018)
#
# See also: annotatio, annotation-sugar
# =============================================================================

@ bogus { a = 1 }
fn f() → int {
    return 1
}

main {
    print f()
}
