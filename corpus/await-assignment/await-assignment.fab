# =============================================================================
# ↢ — Await-directed binding initializer
# =============================================================================
#
# What this teaches:
#   • Keep fixum, varia, or sit while awaiting the initializer.
#   • The glyph is a binding boundary, not an inline expression operator.
#   • A stored promissum can be resolved in a later declaration.
#
# See also: figendum, variandum, fiet, promissum
# =============================================================================

functio responde(numerus valor) fiet → numerus {
    redde valor
}

incipiet {
    sit promissum<numerus> futurum ← responde(7)
    sit numerus immotum ↢ futurum
    varia numerus mutabile ↢ responde(8)
    sit _ illatum ↢ responde(9)
    mutabile ← mutabile + 1
    nota immotum
    nota mutabile
    nota illatum
}
