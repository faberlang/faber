# =============================================================================
# instans — Approximate equality and ordering across precisions
# =============================================================================
#
# What this teaches:
#   • `≅` across precisions means equal at the coarser precision: a
#     whole-second instant and a millisecond instant in the same second match.
#   • `≤` and `≥` likewise hold at the coarser precision.
#   • `≇` is the negation of `≅`.
#
# Common mistakes:
#   • Reading `≅` as `≡` — across precisions `≡` is still a compile error and
#     is pinned elsewhere.
#
# See also: instans, conversio/instans
# =============================================================================

# instans — one second, two precisions
#
# EXPECTED stdout: see instans-approx-cross-precision.expected

main {
    # same second; the millisecond wire adds sub-second precision
    let value secondWire ← "1979-05-27T07:32:00Z"
    let value millisWire ← "1979-05-27T07:32:00.500Z"
    let instant whole ← secondWire ↦ instant
    let instant<ms> half ← millisWire ↦ instant<ms>

    let bool approx ← whole ≅ half
    let bool atMost ← whole ≤ half
    let bool atLeast ← whole ≥ half
    let bool distinct ← whole ≇ half

    print approx
    print atMost
    print atLeast
    print distinct
}
