+++
# =============================================================================
# lineam — Reads one line from stdin without its terminator.
# =============================================================================
#
# What this teaches:
#   • successive line reads — the read at EOF produces none
#
# Common mistakes:
#   • Treating lineam as including the line terminator.
#
# See also: lineam.fab, lege
# =============================================================================

main {
    let _ a ← line
    let _ b ← line
    let _ c ← line
    print a
    print b
    print c
}
