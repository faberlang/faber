# =============================================================================
# !. — A non-null assertion on a missing value aborts the run: stdout before it is printed, the run exits non-zero.
# =============================================================================
#
# What this teaches:
#   • `x!.name` asserts that `x` is present and reads the member: a
#     present value reads normally
#   • A missing value is not recoverable: the assertion ends the run at
#     the access, and the lines printed before it stay printed
#   • Nothing after the failed assertion runs
#
# Common mistakes:
#   • Expecting `x!.name` to give `none` on a missing receiver: that is
#     `x?.name`; the assertion kills the run instead
#   • Expecting the abort to be catchable with `do … catch`: it is not in
#     the `⇥` error channel
#
# See also: nonnulla, non-null-method-call, optionalis
# =============================================================================

class Persona {
    mut string nomen
}

fn find(bool present) → Persona ∪ none {
    if present then return Persona { nomen = "Marcus" }
    return null
}

main {
    let Persona ∪ none here ← find(true)
    print here!.nomen
    let Persona ∪ none gone ← find(false)
    print "before"
    print gone!.nomen
    print "after"
}
