# matrix — a literal coordinate outside the shape is refused at check time
#
# Row 2 does not exist in a 2-row matrix, so `m[[2, 0]]` is provably out of
# bounds: the read is rejected at check time rather than trapping at run time.
#
# This exemplum intentionally fails to check.

main {
    let matrix<f32, [2, 2]> m ← [[1.0, 2.0], [3.0, 4.0]] ↦ matrix<f32, [2, 2]>
    print m[[2, 0]]
}
