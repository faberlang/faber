# =============================================================================
# class constant store — a store into a const member is a check error
# =============================================================================
# A class `const` is read-only for the whole program: no store reaches it
# through the type name, `self`, or an instance. State that changes belongs in
# a `mut` field.

class Tab {
    const int LIMIT = 7
    mut int w = 1
}

main {
    Tab.LIMIT ← 9
    print Tab.LIMIT
}
