# =============================================================================
# class constant import — a class constant of an imported genus
# =============================================================================
#
# What this teaches:
#   • `lectio.Tab.LIMIT` reads the class constant `LIMIT` of the imported genus
#     `Tab`; no instance is needed.
#   • The value comes from the constant's initializer in the providing module.
#
# EXPECTED OUTPUT:
#   lectio-importata.expected
#
# Requires module layout: lectio-importata.fab imports lectio.fab.

import from "./lectio" lectio

main {
    print lectio.Tab.LIMIT
}
