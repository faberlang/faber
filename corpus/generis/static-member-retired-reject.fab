# =============================================================================
# generis — the static member word is retired
# =============================================================================
# A type-level member is `const T X = e`: the same compile-time constant as a
# module or block `const`. `static` no longer introduces a member.

class Punctum {
    static int ORIGO = 0
    mut int y
}

main {
    print "unreachable"
}
