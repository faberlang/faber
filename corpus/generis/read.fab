# =============================================================================
# generis read — a static genus field read through the type name
# =============================================================================
#
# What this teaches:
#   • `Tab.Z` reads the static field `Z` of the genus `Tab`; no instance is needed.
#   • The field's initializer is its value: a literal, a `comptime` body, or an
#     `embed` of a package file (here the sibling `generis.expected`, read as bytes).
#   • Reading a static field through an instance (`t.Z`) and an instance field
#     through the type (`Tab.w`) are compile errors.
#
# EXPECTED OUTPUT:
#   read.expected

class Tab {
    static int LIMIT = 3
    static int SQUARES = comptime {
        var int total ← 0
        for range 1‥4 const i {
            total ← total + i * i
        }
        return total
    }
    static list<b8> DATA = embed "generis.expected"
    var int w = 1
}

main {
    print Tab.LIMIT
    print Tab.SQUARES
    print Tab.DATA.length()
    const Tab t ← Tab {}
    print t.w
}
