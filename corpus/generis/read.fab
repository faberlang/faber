# =============================================================================
# class constant read — a genus constant read through the type name
# =============================================================================
#
# What this teaches:
#   • `Tab.LIMIT` reads the class constant `LIMIT` of the genus `Tab`; no instance
#     is needed.
#   • The constant's initializer is its value: a literal, a `comptime` body, or an
#     `embed` of a package file (here the sibling `generis.expected`, read as bytes).
#   • Reading a class constant through an instance (`t.LIMIT`) and an instance
#     field through the type (`Tab.w`) are compile errors; storing to a class
#     constant is a compile error too (`assignment_to_const_member`).
#
# EXPECTED OUTPUT:
#   read.expected

class Tab {
    const int LIMIT = 3
    const int SQUARES = comptime {
        mut int total ← 0
        for range 1‥4 let i {
            total ← total + i * i
        }
        return total
    }
    const list<b8> DATA = embed "generis.expected"
    mut int w = 1
}

main {
    print Tab.LIMIT
    print Tab.SQUARES
    print Tab.DATA.length()
    let Tab t ← Tab {}
    print t.w
}
