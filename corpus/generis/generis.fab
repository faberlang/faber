# =============================================================================
# class constant — a genus member that belongs to the type
# =============================================================================
#
# What this teaches:
#   • `const T X = e` inside a class is a type-level constant: one per type,
#     compile-time, read-only. It is the same declaration as a module or block
#     constant, with the same `=` initializer.
#   • It is read through the type name (`Color.RUBER`), never through an
#     instance, and it is never stored to.
#   • The old `static` member word is retired (PARSE010 static_member_retired).
#
# Common mistakes:
#   • Reading a class constant on an instance instead of the type — class
#     constants are read through the genus name, not via `ego` or a value.
#   • Writing `static T X = e` — use `const T X = e`.
#   • Storing to a class constant — it is a compile-time fact, so a store is
#     SEM020 assignment_to_const_member.
#
# See also: fixum, genus, ego
# =============================================================================

# const inside a class declares a type-level constant (shared by every instance)
#
# const <type> <NAME> = <initium>  -- class-level constant, not per-instance
#
# GRAMMAR:
#   genus_const_decl :← 'fixum' type_annotation IDENTIFIER '=' const_init
#
# EXPECTED OUTPUT:
#   ruber
#
# Instance field `nomen` is per-object; the constant `RUBER` is read on the
# type (`Color.RUBER`). Here only the instance field is printed.

class Color {
    const string ruber = "#ff0000"
    mut string nomen = "ruber"
}

main {
    let Color color ← Color {}
    print color.nomen
}
