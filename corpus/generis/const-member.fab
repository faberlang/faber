# =============================================================================
# class constant use — const members with folded initializers
# =============================================================================
#
# What this teaches:
#   • A class constant has the same `=` initializer as a module or block
#     constant: a foldable expression (`3 * 2`). The `comptime` and `embed`
#     initializers are shown in generis/read.fab.
#   • Any function reads it through the type name (`Tab.LIMIT`) with no
#     instance.
#   • A method of the class reads the constant the same way, `Tab.LIMIT`; `self`
#     still names the instance for `mut` fields.
#   • Per-instance state stays `mut`/`let`; the constant is never stored to.
#
# EXPECTED OUTPUT:
#   const-member.expected

class Tab {
    const int LIMIT = 3
    const int TWICE = 3 * 2
    const int SQUARES = 1 * 1 + 2 * 2 + 3 * 3
    mut int w = 1

    fn limen() → int {
        if self.w ≻ Tab.LIMIT {
            return Tab.TWICE
        }
        return Tab.LIMIT
    }
}

fn capped(int n) → int {
    if n ≻ Tab.LIMIT {
        return Tab.LIMIT
    }
    return n
}

main {
    print Tab.LIMIT
    print Tab.TWICE
    print Tab.SQUARES
    print capped(10)
    print capped(2)
    let Tab t ← Tab {}
    print t.limen()
}
