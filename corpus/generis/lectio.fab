# =============================================================================
# class constant export — Sibling module exporting a genus with a class constant
# =============================================================================
#
# What this teaches:
#   • An exported genus carries its class constant and the constant's initializer
#     through the file interface, so an importing module reads `module.Tab.LIMIT`.
#
# See also: fixum, genus, importa
# =============================================================================

# class constant export — sibling module for generis/lectio-importata.fab
#
# EXPECTED OUTPUT:
#   7 when run standalone.

@ public
class Tab {
    const int LIMIT = 7
    mut int w = 1
}

main {
    print Tab.LIMIT
}
