# =============================================================================
# generis read — Sibling module exporting a genus with a static field
# =============================================================================
#
# What this teaches:
#   • An exported genus carries its static field and the field's initializer
#     through the file interface, so an importing module reads `module.Tab.Z`.
#
# See also: generis, genus, importa
# =============================================================================

# generis read lectio — sibling module for generis/lectio-importata.fab
#
# EXPECTED OUTPUT:
#   7 when run standalone.

@ public
class Tab {
    static int LIMIT = 7
    mut int w = 1
}

main {
    print Tab.LIMIT
}
