locale = "en"
+++

fn take<size M, size N>(tensor<f32, [M, N]> value) → tensor<f32, [M, N]> {
    return value
}

main {
    let list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    let tensor<f32, [2, 2]> grid ← flat ↦ tensor<f32, [2, 2]>
    let tensor<f32, [2, 2]> same ← take<size 2, size 2>(grid)
    print same.shape()[0]
    print same.shape()[1]
}
