+++
term = "generic call size argument incomplete"
kind = "reject"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "functio_decl", "generic_params", "size_param_list", "size_param", "param_list", "parameter", "return_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "type_arguments", "type_argument", "shape_suffix", "figura", "figura_list", "incipit_stmt", "fixum_decl", "redde_stmt", "call_expr", "call_suffix", "call_type_args", "call_type_arg", "call_size_arg", "dimension_tail", "argument_list", "argument", "expression", "literal"]
category = "type"
canonical = false
summary = "A call-site dimension term needs a natural number after its operator: `2 +` is not a size argument."
syntax = "take<2 +>(grid)"
related = ["tensor", "size", "generic"]
locale = "en"
+++

fn take<size M, size N>(tensor<f32, [M, N]> value) → tensor<f32, [M, N]> {
    return value
}

main {
    const list<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    const tensor<f32, [2, 2]> grid ← flat ↦ tensor<f32, [2, 2]>
    const tensor<f32, [2, 2]> same ← take<2 +>(grid)
}
