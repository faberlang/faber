# =============================================================================
# generic union option — a generic union constructed and matched
# =============================================================================
#
# What this teaches:
#   • A union (discretio) with a type parameter carries the parameter in its
#     payload field, and a generic function matches over its variants.
#   • Related keywords: union, fn, match, variant
#
# Common mistakes:
#   • Dropping the ascription on variant construction: the value is
#     `variant Some { v = 4 } ∷ Opt<int>`, never a bare `variant Some { v = 4 }`.
#
# See also: generic, discerne, variant
# =============================================================================

# EXPECTED OUTPUT:
#   4
#   0

union Opt<T> {
    Some {
        T v
    },
    Nada
}

fn unwrap_or<T>(Opt<T> o, T d) → T {
    match o {
        case Some let v {
            return v
        }
        case Nada {
            return d
        }
    }
}

main {
    let Opt<int> a ← variant Some { v = 4 } ∷ Opt<int>
    let Opt<int> b ← variant Nada { } ∷ Opt<int>
    print unwrap_or(a, 0)
    print unwrap_or(b, 0)
}
