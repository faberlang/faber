# An explicit size argument says what the number means, the way `axis 1` does:
# `make<int, size 4>(xs)`. A bare `4` is SEM057 size_marker_required; write
# `size 4` (or `size [4]` for a whole shape).

fn make<T, size N>(list<T> xs) → tensor<T, [N]> ⇥ string {
    return xs ↦ tensor<T, [N]>
}

main {
    let list<int> data ← [5, 6, 7, 8]
    let tensor<int, [4]> row ← make<int, 4>(data)
}
