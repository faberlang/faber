# =============================================================================
# generic — f(x) in argument position
# =============================================================================
#
# What this teaches:
#   • A function-typed generic parameter called in argument position infers
#     its result: `ap` binds T from the list element and U from the closure
#   • Related keywords: fn, for, ←
#
# See also: generic, clausura, lista
# =============================================================================

# generic fn-param-call — a generic parameter called as a function value
#
# EXPECTED OUTPUT:
#   [5, 6]
#
# BACKEND:
#   Runner: a value callee whose function type mentions generic parameters
#   borrows the enclosing function's bindings, so `f(x)` typechecks and runs.

fn ap<T, U>((T) → U f, list<T> xs) → list<U> {
    mut list<U> out ← empty
    for from xs let x {
        out.append(f(x))
    }
    return out
}

main {
    print ap(int x ∴ x + 1, [4, 5])
}
