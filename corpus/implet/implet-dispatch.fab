# =============================================================================
# implet — Dispatch through an interface-typed parameter
# =============================================================================

interface Nominatum {
    fn plenum() → string
}

class Civis implements Nominatum {
    mut string nomen

    fn plenum() → string {
        return "§"(self.nomen)
    }
}

fn nomen_of(Nominatum civis) → string {
    return civis.plenum()
}

main {
    let Civis civis ← Civis { nomen = "Aurelia" }
    print nomen_of(civis)
}
