# =============================================================================
# implet on an intersection bound — a type argument misses one conjunct
# =============================================================================
#
# What this teaches:
#   • `T implements A ∩ B` bounds a type parameter by the intersection of two
#     contracts: every type argument must satisfy both conjuncts.
#   • `OnlyA` witnesses `A` but not `B`, so the call `both(OnlyA {})` is the
#     rejected form: the whole bound is checked at the call site and the type
#     argument fails the `B` conjunct (`SEM011:generic_type_arg_bound`).
#
# DELIBERATE: the accepted spelling passes a type implementing both contracts,
# as `corpus/implet/multi-bound.fab` does with `class C implements A, B`.
#
# See also: implet, implendum, generic
# =============================================================================

interface A {
    fn a() → int
}

interface B {
    fn b() → int
}

class OnlyA implements A {
    fn a() → int {
        return 1
    }
}

fn both<T implements A ∩ B>(T x) → int {
    return x.a() + x.b()
}

main {
    print both(OnlyA {})
}
