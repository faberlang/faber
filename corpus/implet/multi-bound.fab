# =============================================================================
# implet on an intersection bound — a type parameter bounded by two contracts
# =============================================================================
#
# What this teaches:
#   • `T implements A ∩ B` bounds a type parameter by the intersection of two
#     contracts: inside the function, the methods of both are callable on `T`.
#   • A class that writes `implements A, B` satisfies the intersection, so it
#     is accepted wherever `T implements A ∩ B` is required.
#   • The whole bound is checked at the call site: an argument type that lacks
#     either contract is rejected at compile time.
#
# See also: implet, implendum, generic
# =============================================================================
#
# EXPECTED OUTPUT:
#   3

interface A {
    fn a() → int
}

interface B {
    fn b() → int
}

class C implements A, B {
    fn a() → int {
        return 1
    }

    fn b() → int {
        return 2
    }
}

fn both<T implements A ∩ B>(T x) → int {
    return x.a() + x.b()
}

main {
    print both(C {})
}
