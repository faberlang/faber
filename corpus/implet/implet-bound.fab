# =============================================================================
# implet on a type parameter — bound a generic by a contract (D1.1, D1.2)
# =============================================================================
#
# What this teaches:
#   • `T implements Weighable<T>` bounds a type parameter: inside the function,
#     the contract's methods are callable on `T`.
#   • A generic contract is always written with its arguments, both on the
#     bound and on the class: `class Box implements Weighable<Box>`.
#   • Every call checks that the argument type declares the bound; a type
#     that does not `implements Weighable<…>` is rejected at compile time.
#
# See also: implet, implendum, generic
# =============================================================================
#
# EXPECTED OUTPUT:
#   heavier box: 5
#   heavier chest: 9

interface Weighable<T> {
    fn weigh(T other) → int
}

class Box implements Weighable<Box> {
    mut int weight = 0

    fn weigh(Box other) → int {
        return self.weight - other.weight
    }
}

class Chest implements Weighable<Chest> {
    mut int load = 0

    fn weigh(Chest other) → int {
        return self.load - other.load
    }
}

fn larger<T implements Weighable<T>>(T a, T b) → T {
    if a.weigh(b) ≻ 0 {
        return a
    }
    return b
}

main {
    let Box heavyBox ← larger(Box { weight = 3 }, Box { weight = 5 })
    let Chest heavyChest ← larger(Chest { load = 9 }, Chest { load = 4 })
    print "heavier box: §"(heavyBox.weight)
    print "heavier chest: §"(heavyChest.load)
}
