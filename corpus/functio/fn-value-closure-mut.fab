# =============================================================================
# functio — closure with a mut parameter
# =============================================================================
#
# What this teaches:
#   • A function-typed binding whose parameter is `mut` is called like any
#     function: the caller's list is the one the closure appends to
#
# See also: functio, clausura
# =============================================================================

# functio fn-value-closure-mut — closure with a mut parameter
#
# EXPECTED OUTPUT:
#   fn-value-closure-mut.expected
#
# BACKEND:
#   Runner: a call through a function value passes arguments exactly as a
#   direct call does, so a `mut` parameter is written through to the caller.

main {
    mut list<int> a ← [1, 2, 3]
    let (mut list<int>) → void grow ← mut list<int> xs ∴ xs.append(9)
    grow(mut a)
    print a.length()
    print a
}
