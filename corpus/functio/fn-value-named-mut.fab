# =============================================================================
# functio — named mut function as a value
# =============================================================================
#
# What this teaches:
#   • A named function whose parameter is `mut` keeps that mode as a value:
#     calling it through a parameter or a binding mutates the caller's list
#
# See also: functio, clausura
# =============================================================================

# functio fn-value-named-mut — named mut function as a value
#
# EXPECTED OUTPUT:
#   fn-value-named-mut.expected
#
# BACKEND:
#   Runner: a call through a function value passes arguments exactly as a
#   direct call does, so a `mut` parameter is written through to the caller.

fn grow(mut list<int> xs) → void {
    xs.append(9)
}

fn apply((mut list<int>) → void f, mut list<int> xs) → void {
    f(mut xs)
}

main {
    mut list<int> a ← [1, 2, 3]
    apply(grow, mut a)
    print a
    let (mut list<int>) → void g ← grow
    g(mut a)
    print a.length()
}
