# =============================================================================
# functio — every path of a value-returning function returns
# =============================================================================
# This exemplum intentionally fails to compile: the guard returns on one path
# and falls off the end of the function on the other.

fn f(int a) → int {
    if a ≻ 0 {
        return 1
    }
}

main {
    print f(1)
}
