# =============================================================================
# functio — Failable function-value callback: (string, int) → Tensor ⇥ LookupError
# =============================================================================
#
# What this teaches:
#   • A named (string, int) → tensor<f32, [1]> ⇥ LookupError callback keeps E
#     as a function value. Call-through from a ⇥ LookupError apply site
#     propagates the throw (Rust Result + ?).
#   • Related keywords: functio, ⇥, iace, redde
#
# Common mistakes:
#   • Assuming a failable closure cannot be passed — the old
#     `rust_failable_closure_unsupported` rust-emit rejection is gone.
#
# See also: functio, ⇥, iace, redde
# =============================================================================

# functio failable-fn-value — named callback throw through a function-typed parameter
#
# (string, int) → tensor<f32, [1]> ⇥ LookupError
# apply(lookup, name, layer) re-throws lookup's ⇥ without fac/cape.
#
# GRAMMAR:
#   funcType :← '(' typeList ')' '→' type '⇥' type
#
# EXPECTED OUTPUT:
#   compile-only probe — rust emit keeps Result + ? on the callback call.
#
# BACKEND:
#   Rust application lane emits `&impl Fn(String, i64) -> Result<…, LookupError>`
#   and `?` at the apply call site (FF-1 / D10).

union LookupError {
    Missing {
        string key
        int layer
    }
}

# Named thrower — live throw, not a bool-struct. Passed as the callback value.
fn lookup_throw(string name, int layer) → tensor<f32, [1]> ⇥ LookupError {
    throw variant Missing { key = name, layer = layer }
}

# ⇥ caller invokes the function-typed parameter. The throw propagates.
fn apply((string, int) → tensor<f32, [1]> ⇥ LookupError lookup, string name, int layer) → tensor<f32, [1]> ⇥ LookupError {
    return lookup(name, layer)
}

main {
    do {
        let tensor<f32, [1]> t ← apply(lookup_throw, "missing", 0)
    }
    catch err {
        warn "threw"
    }
}
