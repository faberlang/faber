# =============================================================================
# functio — Declares a named function or method
# =============================================================================
#
# What this teaches:
#   • Declares a named function or method.
#   • Related keywords: →, ⇥, redde, sponte, ceteri, prae, curata, futura, cursor
#
# Common mistakes:
#   • Using a value after it has been moved by `ex` — `ex` consumes ownership; accessing the value after a move is a use-after-move error (SEM050).
#
# See also: →, ⇥, redde, sponte, ceteri, prae, curata, futura, cursor
# =============================================================================

# Parameter access markers live in the type position:
#
# ref <type> <nomen>  -- shared read-only view
# mut <type> <nomen>  -- mutable borrow; writes reach the caller
# own <type> <nomen>  -- consume ownership into the callee
# copy <type> <nomen>  -- duplicate at acquisition, then own the copy
#
# The old parameter-prefix slot is retired. The `from`/`ex` token identity
# remains available for imports, iteration, and field extraction.
#
# EXPECTED OUTPUT:
#   mutabile
#   6
#   salve
#
# BACKEND: Rust emission propagates the scalar mutable borrow as `&mut i64`.
# The MIR runner still drops that scalar borrow during execution; the gap is
# recorded in the mutability-engine ledger and is a non-blocking residual.

# --- Shared borrow: read label without taking ownership ---

fn imprime(ref string label) → void {
    print label
}

# --- Mutable borrow: double the caller's numerus in place ---

fn duplica(mut int value) → void {
    value ← value * 2
    print value
}

# --- Consume: take ownership of textus and return it ---

fn consume(own string buffer) → string {
    return buffer
}

main {
    imprime("mutabile")

    var int value ← 3
    # mut borrows the caller's scalar inside duplica
    duplica(value)

    # own consumes the literal into consume
    print consume("salve")
}
