# =============================================================================
# functio — closure capturing a local with a mut parameter
# =============================================================================
#
# What this teaches:
#   • A closure may capture a local and take a `mut` parameter together: the
#     capture is read, the parameter is written through to the caller
#
# See also: functio, clausura
# =============================================================================

# functio fn-value-closure-capture-mut — closure capturing a local with a mut parameter
#
# EXPECTED OUTPUT:
#   fn-value-closure-capture-mut.expected
#
# BACKEND:
#   Runner: a call through a function value passes arguments exactly as a
#   direct call does, so a `mut` parameter is written through to the caller.

main {
    let int extra ← 7
    mut list<int> a ← [1, 2, 3]
    let (mut list<int>) → void add ← mut list<int> xs ∴ xs.append(extra)
    add(mut a)
    add(mut a)
    print a
}
