# =============================================================================
# functio — named function as a value
# =============================================================================
#
# What this teaches:
#   • A top-level function name used as a value has the function type of its
#     signature: it can be passed to a parameter and bound to a constant
#
# See also: functio, clausura
# =============================================================================

# functio fn-value-named — named function as a value
#
# EXPECTED OUTPUT:
#   fn-value-named.expected
#
# BACKEND:
#   Runner: a call through a function value passes arguments exactly as a
#   direct call does, so a `mut` parameter is written through to the caller.

fn peek(list<int> xs) → void {
    print xs.length()
}

fn apply((list<int>) → void f, list<int> xs) → void {
    f(xs)
}

fn twice(int n) → int {
    return n * 2
}

main {
    mut list<int> a ← [1, 2, 3]
    apply(peek, a)
    let (list<int>) → void g ← peek
    g(a)
    let (int) → int t ← twice
    print t(21)
}
