# =============================================================================
# typus — Alias chains resolve to the underlying type
# =============================================================================
#
# What this teaches:
#   • Alias of an alias — `B = A` and `C = list<B>` name the same type as `A`
#   • Function-type alias — `F = (int) → int` is the type of a function value
#   • Union alias — `U = int ∪ string` is transparent at the binding and at print
#
# See also: typus, ∪
# =============================================================================

type A = int
type B = A
type C = list<B>
type F = (int) → int
type U = int ∪ string

fn ap(F f, B x) → int { return f(x) }

main {
    let C c ← [1, 2]
    print c.length()
    print ap(int x ∴ x + 1, 4)
    let U u ← "s"
    print u
}
