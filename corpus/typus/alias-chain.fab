# =============================================================================
# typus — An alias chain resolves to the underlying type
# =============================================================================
#
# What this teaches:
#   • Stacked aliases — `C = B` and `B = A` name the same type as `A = int`
#   • Transparency — an alias is not a new type: a local, a parameter and a
#     field declared with any link in the chain all take the same `int`
#   • The chain resolves because each alias names another alias, and the last
#     link names a concrete type
#
# Common mistakes:
#   • treating an alias as nominal — `A`, `B` and `C` are interchangeable here
#   • closing a chain on another alias forever — an alias cycle is a check
#     error (see alias-cycle-reject)
#
# See also: typus, genus
# =============================================================================

type A = int
type B = A
type C = B

class Holder {
    let C n
}

fn twice(B x) → int {
    return x * 2
}

main {
    # A local through the first link
    let A local ← 1
    print local

    # A parameter through the middle link
    print twice(2)

    # A field through the last link
    let Holder h ← Holder { n = 3 }
    print h.n
}
