# =============================================================================
# typus — A generic typus alias applied to type arguments expands like its body
# =============================================================================
#
# What this teaches:
#   • Generic aliases — an alias declared with type parameters names a family of types
#   • Applying an alias to type arguments — `Pairs<int>` expands like its body `list<int>`
#
# Common mistakes:
#   • treating an alias as a new type — a typus alias is transparent, not nominal
#
# See also: typus, generic, lista, tabula
# =============================================================================

type Pairs<T> = list<T>
type Table<K, V> = map<K, V>

fn count(Pairs<int> p) → int {
    return p.length()
}

main {
    let Pairs<int> p ← [1, 2]
    print p.length()
    print count(p)
    print p
    mut Table<string, int> t ← empty
    t.put("a", 1)
    print t.length()
}
