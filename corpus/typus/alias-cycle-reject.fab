# =============================================================================
# typus — A type alias cycle is a check error
# =============================================================================
# Each alias names another alias, and the pair never reaches a concrete type.
# An alias is transparent, so `A` must equal `B` must equal `A`: no type exists
# to give the binding. Break the cycle by making one member name a real type.

type A = B
type B = A

main {
    let A a ← 1
    print a
}
