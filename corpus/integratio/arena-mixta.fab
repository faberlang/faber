# =============================================================================
# integratio — Dense syntax tour: genus, closures, ranges, and optional chaining
# =============================================================================
#
# What this teaches:
#   • Dense syntax tour: genus, closures, ranges, and optional chaining.
#   • Related keywords: genus, clausa, ?., itera
#
# Common mistakes:
#   • Using optional chaining (`?.`) on a non-nullable value — `?.` is only valid on `T ∪ nihil` types; use `.` for non-nullable values.
#
# See also: genus, clausa, ?., itera
# =============================================================================

# integratio — dense syntax tour (genus, closures, ranges, optional chaining)
#
# genus G { field sponte; field = default; functio … }
# fixum T f ← T x ∴ fac { … }
# n?.field vel default
# itera ab lo usque hi per step { … }
#
# GRAMMAR:
#   (multi-construct tour — genus, sponte, vel, ?., itera, lista intrinsics)
#
# EXPECTED OUTPUT:
#   none — smoke asserts exit 0 only.
#
# BACKEND:
#   Go e2e whitelist — expression-valued block / arena typing not yet for Go.

class Nauta {
    mut string nomen
    mut string navis optional
    mut int gradus = 0

    fn titulus() → string {
        return "§@§"(self.nomen, self.navis coalesce "terra")
    }
}

fn classificata(int n) → string {
    if n ≥ 10 { return "veteranus" }
    if n ≥ 5 { return "peritus" }
    return "novus"
}

main {
    let list<Nauta, 3> nautae ← [Nauta { nomen = "Aelia", navis = "Fortuna", gradus = 12 }, Nauta { nomen = "Brutus", gradus = 3 }, Nauta { nomen = "Claudia", navis = "Aurora", gradus = 7 }]
    let (Nauta) → string titulus ← Nauta n → string ∴ do {
        let string navis ← n?.navis coalesce "nulla navis"
        return "§ :: § :: §"(n.nomen, navis, classificata(n.gradus))
    }
    for from nautae let n {
        print titulus(n)
    }
    mut list<int> gradus ← empty
    for range 0…6 step 2 let i {
        gradus.append(i * 3)
    }
    let list<int> magni ← gradus.filter(int g ∴ g ≥ 6).map(int g ∴ g + 1)
    print magni
}
