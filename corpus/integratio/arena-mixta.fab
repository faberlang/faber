# =============================================================================
# integratio — Dense syntax tour: genus, closures, ranges, and optional chaining
# =============================================================================
#
# What this teaches:
#   • Dense syntax tour: genus, closures, ranges, and optional chaining.
#   • Related keywords: genus, clausa, ?., itera
#
# Common mistakes:
#   • Using optional chaining (`?.`) on a non-nullable value — `?.` is only valid on `T ∪ nihil` types; use `.` for non-nullable values.
#
# See also: genus, clausa, ?., itera
# =============================================================================

# integratio — dense syntax tour (genus, closures, ranges, optional chaining)
#
# genus G { field sponte; field = default; functio … }
# fixum T f ← T x ∴ fac { … }
# n?.field vel default
# itera ab lo usque hi per step { … }
#
# GRAMMAR:
#   (multi-construct tour — genus, sponte, vel, ?., itera, lista intrinsics)
#
# EXPECTED OUTPUT:
#   none — smoke asserts exit 0 only.
#
# BACKEND:
#   Go e2e whitelist — expression-valued block / arena typing not yet for Go.

class Nauta {
    string nomen
    string navis optional
    int gradus = 0

    fn titulus() → string {
        return "§@§"(self.nomen, self.navis coalesce "terra")
    }
}

fn classis(int n) → string {
    return n ≥ 10 yields "veteranus" else (n ≥ 5 yields "peritus" else "novus")
}

main {
    const _ nautae ← [Nauta { nomen = "Aelia", navis = "Fortuna", gradus = 12 }, Nauta { nomen = "Brutus", gradus = 3 }, Nauta { nomen = "Claudia", navis = "Aurora", gradus = 7 }]

    const _ titulus ← Nauta n → string ∴ do {
        const _ navis ← n?.navis coalesce "nulla navis"
        return "§ :: § :: §"(n.nomen, navis, classis(n.gradus))
    }

    for from nautae const n {
        print titulus(n)
    }

    var list<int> gradus ← vacua
    for range 0…6 step 2 const i {
        gradus.appende(i * 3)
    }

    const _ magni ← gradus.filtrata(int g ∴ g ≥ 6).mappata(int g ∴ g + 1)
    print magni
}
