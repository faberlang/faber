# =============================================================================
# discerne — Multi-feature smoke: discretio, finge, discerne omnia, and per-field ut aliases
# =============================================================================
#
# What this teaches:
#   • Multi-feature smoke: discretio, finge, discerne omnia, and per-field ut aliases.
#   • Related keywords: discretio, finge, ut, casu
#
# Common mistakes:
#   • Using `discerne omnia` with a catchall arm — `omnia` forbids `ceterum`; list every variant explicitly or remove `omnia` (SEM044).
#
# See also: discretio, finge, ut, casu
# =============================================================================

# integratio — discretio, finge, discerne omnia, and payload destructuring
#
# discretio Name { Variant { fields… }, … }
# fixum T v ← finge Variant { field = value }
# discerne omnia v { casu Variant fixum fields { … } }
#
# GRAMMAR:
#   discretioDecl :← 'discretio' ident '{' variantDecl* '}'
#   matchStmt     :← 'discerne' ('omnia')? expr '{' casuClause* '}'
#
# EXPECTED OUTPUT:
#   none — deterministic variant strings; no .expected sidecar.

union Mandatum {
    Moveo { string locus, int passus },
    Loquere { string verba },
    Tace
}

fn narra(Mandatum m) → string {
    match all m {
        case Moveo const locus, passus {
            return "moveo § per §"(locus, passus)
        }
        case Loquere const verba as dictum {
            return "loquere §"(dictum)
        }
        case Tace {
            return "silentium"
        }
    }
}

main {
    const Mandatum a ← variant Moveo { locus = "forum", passus = 8 }
    const Mandatum b ← variant Loquere { verba = "salve" }
    const Mandatum c ← variant Tace

    print narra(a)
    print narra(b)
    print narra(c)
}
