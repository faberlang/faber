# =============================================================================
# integratio — Async await-bind and stream yield in one program
# =============================================================================
#
# What this teaches:
#   • Async `fiet` await-bind and `fiunt` stream yield in one program.
#   • Related keywords: fiet, fiunt, cede, incipiet
#
# Common mistakes:
#   • Using `cede` outside a generator body; use `figendum`/`variandum` for
#     await-bind in async contexts.
#
# See also: fiet, fiunt, cede, incipiet
# =============================================================================

# integratio — async finite and stream yield in one program
#
# functio f() fiet → T { … }
# functio g(n) fiunt → T { itera … { cede expr } }
# incipiet { figendum _ x ← f(); … }
#
# GRAMMAR:
#   postureFunc   :← funcDecl ('fiet' | 'fiunt' | 'fient')?
#   awaitBind     :← 'figendum' type binding '←' callExpr
#   asyncEntry    :← 'incipiet' block
#
# EXPECTED OUTPUT:
#   none — smoke asserts exit 0 when runtime is linked.
#
# BACKEND:
#   Rust/Go e2e whitelist — async/tokio runtime not linked in harness.

fn accipe() async → string {
    return "Livia"
}

fn paria(int finis) generator → int {
    for range 0 before finis let i {
        if i % 2 ≡ 0 {
            yield i
        }
    }
}

async_main {
    await_const _ nomen ← accipe()
    print "salve §"(nomen)

    for from paria(8) let n {
        print n
    }
}
