# =============================================================================
# find_all — every regex match, in one pass
# =============================================================================
#
# What this teaches:
#   • `r.find_all(text)` returns a list of matches in left-to-right order; no
#     match gives an empty list, never `none`
#   • the matches never overlap, and an empty match that would start exactly
#     where the previous match ended is skipped (RE2's rule): `a*` over
#     `baaac` gives the spans (0,0) (1,4) (5,5), not four empties
#   • each element is the same match `find` returns, so `text`, `start`, `end`,
#     `group` and `named` read it; offsets are code points, never bytes
#   • the whole text is walked once: the cost grows with the text, not with
#     the number of matches
#
# Common mistakes:
#   • expecting an empty match right after a non-empty one (`a*` over `baaac`
#     has no (4,4))
#   • reading offsets as UTF-8 bytes or UTF-16 units
#   • passing a start offset to resume the search: there is no such form, the
#     list already holds every match
#
# See also: regex, ↦, find, split.
# =============================================================================

# find_all — empty-match rule, code point offsets, groups
#
# <regex>.find_all(<textus>)   -- lista of match
#
# EXPECTED OUTPUT:
#   The count and spans of `a*` over `baaac`, the spans over text holding an
#   emoji, then each key and value of a two-group pattern, a miss, and the
#   whole-match span of an empty pattern.

main {
    # the empty-match rule: (0,0) (1,4) (5,5)
    let regex stars ← "a*" ↦ regex
    let runs ← stars.find_all("baaac")
    print runs.length()
    for from runs let run {
        print run.start()
        print run.end()
    }

    # offsets count code points: the emoji is one position
    let regex word ← "[a-z]+" ↦ regex
    let words ← word.find_all("😀é abc d")
    for from words let hit {
        print hit.text()
        print hit.start()
        print hit.end()
    }

    # groups and names are per match; a group that did not take part is none
    let regex pair ← "(?P<key>[a-z]+)=([0-9]+)?" ↦ regex
    let pairs ← pair.find_all("a=1 b= c=3")
    for from pairs let kv {
        print kv.named("key")
        print kv.group(2) coalesce "unset"
    }

    # no match is an empty list
    let regex digits ← "[0-9]+" ↦ regex
    print digits.find_all("none here").length()

    # the empty pattern matches before each character and at the end
    let regex nothing ← "" ↦ regex
    print nothing.find_all("ab").length()
}
