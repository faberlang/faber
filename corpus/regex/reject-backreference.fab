category = "regex"
canonical = false
summary = "Backreferences are not in the dialect: `\\1`, `\\k<n>`, `(?P=n)` and the octal and NUL escapes fail with the leading id `backreference`."
syntax = "<textus> ↦ regex"
related = ["regex", "↦", "find", "find_all", "split", "replace"]
locale = "en"
+++
# =============================================================================
# reject-backreference — regex conformance cell
# =============================================================================
#
# Pins: PIN-REJECT (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `(a)\1`, `(?P<n>a)\k<n>`, `(?P<n>a)(?P=n)`, `\0` and `\012` fail with `backreference`
#   • a repeated-text check belongs in code: read the group with `group` and compare
#
# Common mistakes:
#   • expecting `\1` to repeat a group (it is rejected, never a literal)
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# reject-backreference — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# `accepted` when the conversion takes the pattern; otherwise the leading construct id of the
# rejection payload (the text before the first colon). The engine's prose is never printed.
fn verdict(string pat) → string {
    do {
        pat ↦ regex
        return "accepted"
    }
    catch err {
        let list<string> parts ← err.split(":")
        return parts[0]
    }
}

main {
    print "k-backref-num: " + verdict("(a)\\1")
    print "k-backref-named-k: " + verdict("(?P<n>a)\\k<n>")
    print "k-backref-named-P=: " + verdict("(?P<n>a)(?P=n)")
    print "k-escape-digit-0: " + verdict("\\0")
    print "k-octal: " + verdict("\\012")
}
