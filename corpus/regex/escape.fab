# =============================================================================
# escape — a pattern that matches the text literally
# =============================================================================
#
# What this teaches:
#   • `text.escape()` returns a pattern text; converting `^` + the escaped
#     text + `$` with `↦ regex` gives a regex that matches exactly `text`
#   • exactly these characters are escaped, each with one backslash:
#     `\ . + * ? ( ) | [ ] { } ^ $ # & - ~`; every other character, including
#     letters, digits, spaces and non-ASCII text, is copied unchanged
#   • use it to put user text inside a larger pattern, for example an
#     alternation built from a list of words
#
# Common mistakes:
#   • escaping text that is already a pattern: the result matches the pattern
#     characters themselves, not what they mean
#   • expecting `escape` to be a regex method: it is a method of text
#
# See also: regex, ↦, find, replace.
# =============================================================================

# escape — the metacharacters, and the round trip
#
# <textus>.escape()   -- textus
#
# EXPECTED OUTPUT:
#   Three escaped texts, a line for any probe whose anchored escaped pattern
#   misses or matches only part of it (none expected), the count of probes
#   matched whole, then the count of probes tried (the two counts agree).

main {
    # the metacharacters are escaped; everything else is copied
    print "a.b*c".escape()
    print "(1+1)=[2]{3}|?^$".escape()
    print "\\#&-~ é😀 x".escape()

    # round trip: ^ + escaped + $ matches the whole probe
    let list<string> probes ← [
        "\\", ".", "+", "*", "?", "(", ")", "|", "[", "]", "{", "}", "^", "$", "#", "&", "-", "~",
        "a.b", "x+y*z", "(a|b)", "[a-z]{2}", "^start$", "a\\d", "tab\there", "line\nbreak",
        "é", "😀", "naïve café 😀", "日本語", "", "plain"
    ]
    mut int tried ← 0
    mut int whole ← 0
    for from probes let probe {
        tried ← tried + 1
        let string head ← "^" + probe.escape()
        let regex anchored ← (head + "$") ↦ regex
        let hit ← anchored.find(probe)
        if hit ≡ null {
            print "miss"
        } else {
            if hit!.text() ≡ probe {
                whole ← whole + 1
            } else {
                print "partial"
            }
        }
    }
    print whole
    print tried
}
