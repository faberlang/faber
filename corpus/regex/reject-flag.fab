+++
# =============================================================================
# reject-flag — regex conformance cell
# =============================================================================
#
# Pins: PIN-REJECT, PIN-FLAGS (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `(?g)a`, `(?y)a`, `(?U)a+`, `(?u)a` and `(?-u)a` fail with `unsupported_flag`
#   • the accepted flags are exactly `i m s x`, alone, combined or scoped to a group
#
# Common mistakes:
#   • expecting a flag the reference engine tolerates, such as `(?U)` or `(?u)`, to work: the dialect is the portable core
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# reject-flag — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# `accepted` when the conversion takes the pattern; otherwise the leading construct id of the
# rejection payload (the text before the first colon). The engine's prose is never printed.
fn verdict(string pat) → string {
    do {
        pat ↦ regex
        return "accepted"
    }
    catch err {
        let list<string> parts ← err.split(":")
        return parts[0]
    }
}

main {
    print "flag-g: " + verdict("(?g)a")
    print "flag-unknown-letter: " + verdict("(?y)a")
    print "flag-U: " + verdict("(?U)a+")
    print "flag-u: " + verdict("(?u)a")
    print "flag-neg-u: " + verdict("(?-u)a")
    print "ok-i: " + verdict("(?i)a")
    print "ok-ims: " + verdict("(?ims)a")
    print "ok-x-scoped: " + verdict("(?x:a b)")
}
