# =============================================================================
# named-groups — regex conformance cell
# =============================================================================
#
# Pins: PIN-NAME (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `(?P<n>a)` and `(?<n>a)` both name a group; a Unicode name such as `é` is accepted
#   • named and unnamed groups share one numbering, left to right: `(a)(?P<n>b)(c)` over `abc` has the groups abc, a, b, c
#   • a name absent from the pattern and a named group that did not take part both read as `none`
#
# Common mistakes:
#   • expecting a separate numbering for named groups
#   • treating `none` from `named` as an error: it only says the group has no text in this match
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# named-groups — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# The text of a named group of the first match; `none` when the group did not take part or the
# name is not in the pattern; `nomatch` for no match.
fn named(string pat, string text, string name) → string {
    do {
        let regex r ← pat ↦ regex
        let h ← r.find(text)
        if h ≡ null {
            return "nomatch"
        }
        return h!.named(name) coalesce "none"
    }
    catch err {
        return "error"
    }
}

# Groups 0..n of the first match, each as `|text`, `none` for a group that did not take part;
# `nomatch` for no match.
fn groups(string pat, string text, int n) → string {
    do {
        let regex r ← pat ↦ regex
        let h ← r.find(text)
        if h ≡ null {
            return "nomatch"
        }
        mut string out ← ""
        mut int i ← 0
        while i ≤ n {
            out ← out + "|§"(h!.group(i) coalesce "none")
            i ← i + 1
        }
        return out
    }
    catch err {
        return "error"
    }
}

main {
    print "name-P: " + named("(?P<n>a)", "xa", "n")
    print "name-angle: " + named("(?<n>a)", "xa", "n")
    print "name-unknown: " + named("(?P<n>a)", "a", "zzz")
    print "name-nonparticipating: " + named("(?P<n>a)|(?P<m>b)", "b", "n")
    print "name-participating: " + named("(?P<n>a)|(?P<m>b)", "b", "m")
    print "name-unicode: " + named("(?P<é>a)", "a", "é")
    print "name-numbering:" + groups("(a)(?P<n>b)(c)", "abc", 3)
}
