# =============================================================================
# split — the pieces between regex matches, in one pass
# =============================================================================
#
# What this teaches:
#   • `r.split(text)` cuts the text at every match and returns the pieces as
#     a list of text
#   • a separator at the start or the end leaves an empty first or last
#     piece, and two adjacent separators leave an empty piece between them
#   • a capture group in the pattern only groups: its text is not added to
#     the result (use `find_all` when the separators themselves are wanted)
#   • no match returns the whole text as one piece; empty text returns one
#     empty piece
#   • the empty-match rule of `find_all` applies: `a*` over `baaac` cuts at
#     (0,0) (1,4) (5,5) and gives "", b, c, ""
#
# Common mistakes:
#   • expecting the leading or trailing empty piece to be dropped
#   • expecting `(,)` to put the comma in the result
#   • confusing this with `textus.split`, which cuts at a literal separator
#
# See also: regex, ↦, find, find_all.
# =============================================================================

# split — edges, adjacent separators, captures, empty matches
#
# <regex>.split(<textus>)   -- lista of textus
#
# EXPECTED OUTPUT:
#   One printed list per cell, in the order below.

main {
    let regex comma ← "," ↦ regex

    # leading and trailing separators keep empty pieces
    print comma.split(",a,")

    # adjacent separators give an empty piece
    print comma.split("a,,b")

    # a capture group in the pattern is not spliced into the pieces
    let regex grouped ← "(,)" ↦ regex
    print grouped.split("a,b")

    # a run of whitespace is one separator
    let regex spaces ← "\\s+" ↦ regex
    print spaces.split(" a  b ")

    # the empty-match rule: cuts at (0,0) (1,4) (5,5)
    let regex stars ← "a*" ↦ regex
    print stars.split("baaac")

    # the empty pattern cuts between every character
    let regex nothing ← "" ↦ regex
    print nothing.split("abc")

    # no match is the whole text; empty text is one empty piece
    let regex absent ← "x" ↦ regex
    print absent.split("abc")
    print comma.split("")

    # offsets are not involved: an emoji stays inside its piece
    print comma.split("😀,a")
}
