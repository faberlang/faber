# =============================================================================
# split-edges — regex conformance cell
# =============================================================================
#
# Pins: PIN-SPLIT (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `,` over `,a,` gives the pieces empty, a, empty; over `a,,b` it gives a, empty, b; over empty text it gives one empty piece
#   • the empty pattern over `abc` gives empty, a, b, c, empty; `a*` over `baaac` gives empty, b, c, empty; a pattern equal to the whole text gives two empty pieces
#   • a capture group only groups: `(,)` over `a,b` gives a and b, not the comma
#
# Common mistakes:
#   • expecting the leading or trailing empty piece to be dropped
#   • expecting a captured separator in the result
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# split-edges — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# The pieces of split, each as `<piece>`.
fn pieces(string pat, string text) → string {
    do {
        let regex r ← pat ↦ regex
        mut string out ← ""
        for from r.split(text) let piece {
            out ← out + "<§>"(piece)
        }
        return out
    }
    catch err {
        return "error"
    }
}

main {
    print "split-basic: " + pieces(",", "a,b,c")
    print "split-leading-trailing: " + pieces(",", ",a,")
    print "split-adjacent: " + pieces(",", "a,,b")
    print "split-empty-pattern: " + pieces("", "abc")
    print "split-empty-text: " + pieces(",", "")
    print "split-capture-not-spliced: " + pieces("(,)", "a,b")
    print "split-a-star: " + pieces("a*", "baaac")
    print "split-spaces: " + pieces("\\s+", " a b ")
    print "split-no-match: " + pieces("x", "abc")
    print "split-astral: " + pieces(",", "😀,a")
    print "split-whole: " + pieces("abc", "abc")
}
