# =============================================================================
# group-repeat — regex conformance cell
# =============================================================================
#
# Pins: PIN-GROUP (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `((a)|b)*` over `ab` gives group 1 `b` and group 2 `a`: group 2 keeps the value from the first iteration although the last iteration did not set it
#   • `(a*)*` over `b` gives an empty group 1 and an empty group 0 match, not `none`
#
# Common mistakes:
#   • expecting a repeated group to reset at each iteration
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# group-repeat — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# Groups 0..n of the first match, each as `|text`, `none` for a group that did not take part;
# `nomatch` for no match.
fn groups(string pat, string text, int n) → string {
    do {
        let regex r ← pat ↦ regex
        let h ← r.find(text)
        if h ≡ null {
            return "nomatch"
        }
        mut string out ← ""
        mut int i ← 0
        while i ≤ n {
            out ← out + "|§"(h!.group(i) coalesce "none")
            i ← i + 1
        }
        return out
    }
    catch err {
        return "error"
    }
}

main {
    print "grp-repeat-last-iter:" + groups("((a)|b)*", "ab", 2)
    print "grp-star-empty:" + groups("(a*)*", "b", 1)
}
