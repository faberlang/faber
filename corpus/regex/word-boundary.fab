+++
term = "word-boundary"
kind = "conformance"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "functio_decl", "param_list", "parameter", "return_clause", "type_annotation", "owned_type", "base_type", "qualified_type", "hole_type", "type_arguments", "type_argument", "redde_stmt", "incipit_stmt", "fixum_decl", "conversio_expr", "fac_stmt", "cape_clause", "si_stmt", "call_expr", "call_suffix", "member_suffix", "non_null_suffix", "argument_list", "argument", "expression", "ternary", "literal", "nota_stmt", "additive_expr", "equality", "equality_tail", "assignment", "place", "itera_stmt", "dum_stmt", "comparison", "vel_expr", "vel_rhs", "sit_decl", "expr_stmt"]
category = "regex"
canonical = false
summary = "Unicode `\\b` and `\\B`: a boundary sits between a word character (the Unicode `\\w`) and a non-word character or a text end."
syntax = "<textus> ↦ regex"
related = ["regex", "↦", "find", "find_all", "split", "replace"]
locale = "en"
+++
# =============================================================================
# word-boundary — regex conformance cell
# =============================================================================
#
# Pins: PIN-B (docs/design/regex-dialect.md). One line per probe cell;
# the label is the cell id of the dialect's Appendix B, and the value is the reference
# engine's answer. A target whose engine disagrees fails the line, never the dialect.
#
# What this teaches:
#   • `\bé` matches `é` and `a\b` does not match `aé`: `é` is a word character, so there is no boundary between `a` and `é`
#   • over empty text `\b` is false and `\B` is true; `e\b` over `e` plus a combining mark is false, because the mark is a word character
#   • `\b` over `hé x` yields the positions (0,0) (2,2) (3,3) (4,4), counted in code points
#
# Common mistakes:
#   • assuming `\b` is the ASCII boundary: a letter outside ASCII is a word character
#   • assuming a boundary between a letter and its combining mark
#
# See also: regex, ↦, find, find_all, split, replace.
# =============================================================================

# word-boundary — probes, one line each
#
# <textus> ↦ regex, then the operation the pin is about
#
# EXPECTED OUTPUT:
#   One `<cell id>: <value>` line per probe, in the order below.

# The one-letter text for a code point: characters that are invisible or look like another
# letter are written by number, never as a literal.
fn u(int n) → string {
    let char c ← n ↦ char via Code ⊥ '?'
    return c ↦ string
}

# y when the pattern matches somewhere in the text, n when it does not; `error` when the
# conversion rejects the pattern.
fn hits(string pat, string text) → string {
    do {
        let regex r ← pat ↦ regex
        return r.matches(text) ✓ "y" ✗ "n"
    }
    catch err {
        return "error"
    }
}

# The code point span of every match, left to right, as ` (start,end)`; ` none` for no match.
fn spans(string pat, string text) → string {
    do {
        let regex r ← pat ↦ regex
        mut string out ← ""
        for from r.find_all(text) let h {
            out ← out + " (§,§)"(h.start(), h.end())
        }
        if out ≡ "" {
            return " none"
        }
        return out
    }
    catch err {
        return "error"
    }
}

main {
    print "b-leading-e-acute: " + hits("\\bé", "é")
    print "b-inside-word: " + hits("a\\b", "aé")
    print "B-inside-word: " + hits("a\\Bé", "aé")
    print "b-empty-text: " + hits("\\b", "")
    print "B-empty-text: " + hits("\\B", "")
    print "b-space-x: " + hits("\\bx", " x")
    print "b-both-sides: " + hits("\\bé\\b", "é")
    print "b-before-combining: " + hits("e\\b", "e§"(u(769)))
    print "b-astral-letter: " + hits("\\b𝐀", "𝐀")
    print "b-iter-ab:" + spans("\\b", "ab")
    print "b-iter-unicode:" + spans("\\b", "hé x")
}
