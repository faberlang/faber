# =============================================================================
# erratur — Marks a test as expected to fail
# =============================================================================
#
# What this teaches:
#   • Expected failure — `erratur` records a test whose failing assertion is a known defect, with no argument.
#   • Modifier position — it sits between the test name and the body, like `omitte` and `fragilis`.
#
# Common mistakes:
#   • Confusing erratur (expected failure) with omitte (skipped) — an erratur test still runs.
#
# See also: proba, fragilis, omitte
# =============================================================================

# erratur — expected-failure test modifier
#
# GRAMMAR:
#   testModifier :← 'erratur'
#
# EXPECTED OUTPUT:
#   erratur declared

test "known defect" expect_failure {
    assert 1 + 1 ≡ 3
}

main {
    print "erratur declared"
}
