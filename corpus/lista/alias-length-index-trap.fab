# =============================================================================
# alias-length-index-trap — a let alias is not a frozen length.
# =============================================================================
#
# What this teaches:
#   • `let list<int> xs ← ys` shares the list: `xs` cannot be written, but
#     `ys` can, and the change is visible through both names.
#   • `0‥xs.length()` takes the length once, at loop entry. The call that
#     shrinks `ys` in the body makes the later `xs[i]` read past the end, and
#     the run aborts there: the compiler must not drop that index check on the
#     ground that `xs` is a `let`.
#
# Common mistakes:
#   • Treating a `let` list as a snapshot — `let` fixes the name, and the list
#     it names can still be written through another name. Detach it with
#     `copy ys` when a snapshot is wanted.
#
# See also: lista, alias-on-bind, range-index-oob
# =============================================================================

fn shrink(mut list<int> zs) {
    zs.remove_last()
}

main {
    mut list<int> ys ← [1, 2, 3]
    let list<int> xs ← ys
    for range 0‥xs.length() let i {
        shrink(mut ys)
        print xs[i]
    }
    print "unreached"
}
