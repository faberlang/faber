# =============================================================================
# mut-list-element-alias — indexed mut genus bind preserves element identity.
# =============================================================================
# The binder points at the boxed list element rather than a shallow struct copy.

class Cell {
    mut int value
}

main {
    mut list<Cell> cells ← [Cell { value = 7 }]
    mut Cell c ← cells[0]
    c.value ← 42
    print cells[0].value
}
