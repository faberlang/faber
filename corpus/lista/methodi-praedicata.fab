# =============================================================================
# omnia / quilibet — list predicate method twins.
# =============================================================================
#
# What this teaches:
#   • `all` is true for an empty list; `any` is false for an empty list.
#   • A decisive element determines each fold: one negative makes `all` false
#     and makes `any` true.
#   • `reject <condition> throw <error>` is a guard-shaped use of `any` for
#     rejecting a list that contains a negative dimension.
#
# Common mistakes:
#   • Treating an empty `all` as false or an empty `any` as true.
#   • Replacing a predicate twin with a hand-written loop when the list method
#     already expresses the contract.
#   • Reading `reject` as `require`: reject throws when its condition is true.
#
# EBNF determination (LPT-3): no new row — the method-call surface already
# exists and EBNF enumerates no intrinsic method names.
#
# See also: lista, filtrata, requirit, reice
# =============================================================================

main {
    # Empty-list identities: all → true, any → false.
    let list<int> empty_values ← empty
    print empty_values.all(int d ∴ d ≥ 0)
    print empty_values.any(int d ∴ d ≺ 0)

    # Decisive element: -1 makes all non-negative false and any-negative true.
    let list<int> mixed ← [2, -1, 4]
    print mixed.all(int d ∴ d ≥ 0)
    print mixed.any(int d ∴ d ≺ 0)

    # Guard-shaped reject: the true `any` result throws into this catch.
    do {
        reject mixed.any(int d ∴ d ≺ 0) throw "negative dimension"
        print "accepted"
    }
    catch err {
        print "caught: §"(err)
    }
}
