# =============================================================================
# list<T, size N>.append — append past capacity aborts
# =============================================================================
# The bounded list is full before the append. The operation traps with
# "bounded collection push at capacity" and does not reach the final print.

main {
    mut list<int, size 2> xs ← [1, 2]
    print "before"
    xs.append(3)
    print "unreached"
}
