# =============================================================================
# bounded list append at capacity — an indexed bounded row traps on overflow
# =============================================================================
# A list nested in a growable list retains its own bound when projected by
# index. Appending when that row is full is a run-time capacity trap.

main {
    mut list<list<int, size 1>> rows ← [[1]]
    print "before"
    rows[0].append(2)
    print "after"
}
