# =============================================================================
# list<T, size N>.append — an indexed receiver still has its capacity
# =============================================================================
# `rows[0]` is a bounded list, even though the receiver is a projection.
# Appending to the full inner list traps with "bounded collection push at
# capacity" and does not reach the final print.

main {
    mut list<list<int, size 2>, size 1> rows ← [[1, 2]]
    print "before"
    rows[0].append(3)
    print "unreached"
}
