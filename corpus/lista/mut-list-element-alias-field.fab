# =============================================================================
# mut-list-element-alias-field — the element is reached through a record field.
# =============================================================================
# Each binder aliases its own list element, so writes through it (a scalar and a
# list-field append) are visible when the element is read back from the list.

class Comp {
    mut int cid
    mut int pw
    mut list<int> plane
}

class Frame {
    mut list<Comp> comps
}

main {
    mut Frame f ← Frame { comps = empty }
    f.comps.append(Comp { cid = 1, pw = 0, plane = empty })
    mut Comp c ← f.comps[0]
    c.pw ← 7
    c.plane.append(5)
    print f.comps[0].pw
    print f.comps[0].plane.length()
    mut Comp d ← f.comps[0]
    d.cid ← 42
    print f.comps[0].cid
}
