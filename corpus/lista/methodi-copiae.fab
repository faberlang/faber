# =============================================================================
# lista — Generic ordered collection type.
# =============================================================================
#
# What this teaches:
#   • copy, slice, and reordering intrinsics — `addita()`, `sectio()`, `prima()`, `ultima()`
#   • `mut list<int> mutata ← res[0‥2]` gets a new list containing the same
#     value elements. This is a shallow window copy: replacing a slot in
#     `mutata` does not replace a slot in `res`.
#   • ordering operations — `inversa()`, `ordinata()`
#
# Common mistakes:
#   • Forgetting that sectio(lo, hi) uses an exclusive hi bound — the returned slice may be shorter than expected.
#   • Assuming a window aliases the source list itself; it is a new list with
#     the same elements, not a view into the source's slots.
#
# See also: tabula, copia, ∷, itera
# =============================================================================

# lista<T> copy, slice, and ordering intrinsics
#
# res.added(x) | res.slice(lo, hi) | res.take(n) | res.take_last(n)   -- copies
# res.drop(n) | res.invert() | res.sorted()                      -- reorder
#
# GRAMMAR:
#   listMethod :← expr '.' ('addita' | 'sectio' | 'prima' | 'ultima'
#                         | 'omissa' | 'inversa' | 'ordinata') '(' args? ')'
#
# EXPECTED OUTPUT:
#   [1, 2, 3, 4, 5, 6]
#   [2, 3, 4]
#   [1, 2]
#   [4, 5]
#   [3, 4, 5]
#   [5, 4, 3, 2, 1]
#   [1, 2, 3]
#   [0]
#   [0]
#   [1, 2]
#   [99, 2]
#   [1, 2, 3, 4, 5]
#
# BACKEND: Go e2e whitelist — lista intrinsic methods not yet lowered for Go
# (whitelist: lista/methodi-copiae.fab).

main {
    let _ res ← [1, 2, 3, 4, 5] ∷ list<int>
    let _ addita ← res.added(6)
    let _ sectio ← res.slice(1, 4) ⊥ [0]
    let _ primaduo ← res.take(2) ⊥ [0]
    let _ ultimaduo ← res.take_last(2)
    let _ omissaduo ← res.drop(2)
    let _ inversa ← res.invert()
    let _ ordinata ← [3, 1, 2].sorted()
    print addita
    print sectio
    print primaduo
    print ultimaduo
    print omissaduo
    print inversa
    print ordinata

    let list<int> sectiofallax ← res.slice(1, 9) ⊥ [0]
    let list<int> primafallax ← res.take(9) ⊥ [0]
    let list<int> fenestra ← res[0‥2]
    mut list<int> mutata ← res[0‥2]
    mutata[0] ← 99
    print sectiofallax
    print primafallax
    print fenestra
    print mutata
    print res
}
