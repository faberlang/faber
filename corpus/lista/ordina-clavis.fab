# =============================================================================
# lista — sort by a key
# =============================================================================
#
# What this teaches:
#   • `sort via asc from list let x { return key }` returns a new list
#     ordered by the key each element maps to; `desc` reverses the order
#   • `sort(key)` reorders a `mut` list in place
#   • keys are numbers or text; text orders by Unicode code point
#   • the sort is stable: elements with equal keys keep their source order
#
# EXPECTED OUTPUT:
#   Aulus Cornelia Livia Marcus Titus Émilia
#   Livia Marcus Aulus Cornelia Titus Émilia
#   Titus Livia Marcus Émilia Aulus Cornelia
#   Aulus Cornelia Livia Marcus Émilia Titus
#   [1, 2, 3]

class Persona {
    mut string nomen
    mut int aetas
}

fn nomina(list<Persona> ps) → string {
    mut string out ← ""
    for from ps let p {
        if out ≡ "" {
            out ← p.nomen
        } else {
            out ← out + " " + p.nomen
        }
    }
    return out
}

main {
    let list<Persona> personae ← [
        Persona { nomen = "Livia", aetas = 30 },
        Persona { nomen = "Marcus", aetas = 30 },
        Persona { nomen = "Aulus", aetas = 25 },
        Persona { nomen = "Cornelia", aetas = 25 },
        Persona { nomen = "Titus", aetas = 40 },
        Persona { nomen = "Émilia", aetas = 30 }
    ]

    # Text key: code-point order puts "É" (U+00C9) after every ASCII letter.
    let list<Persona> per_nomen ← sort via asc from personae let p { return p.nomen }
    print nomina(per_nomen)

    # The source list is unchanged.
    print nomina(personae)

    # The direction is `desc`, not a negated key; equal keys stay stable.
    let list<Persona> senes ← sort via desc from personae let p { return p.aetas }
    print nomina(senes)

    # Numeric key, stable: 25s keep Aulus before Cornelia; 30s keep
    # Livia, Marcus, Émilia in source order.
    mut list<Persona> per_aetatem ← copy personae
    per_aetatem.sort(Persona p ∴ p.aetas)
    print nomina(per_aetatem)

    # Without a body, the elements sort by their natural order.
    let list<int> numeri ← [3, 1, 2]
    print sort via asc from numeri
}
