# =============================================================================
# list<T, lo‥hi> — the length is checked where a list is converted into it
# =============================================================================
#
# What this teaches:
#   • `list<int> ↦ list<int, 2‥5>` checks the source length against the range
#     when the conversion runs; a length outside the range fails.
#   • `⊥` supplies the recovery value for a failed conversion.
#   • A range converts back to a plain list with `↦ list<int>`, which always
#     fits.
#
# Common mistakes:
#   • Expecting a too-short list to be padded or a too-long one truncated.

main {
    let list<int> three ← [1, 2, 3]

    let list<int, 2‥5> fits ← three ↦ list<int, 2‥5> ⊥ [0, 0]
    print fits

    let list<int, 5…9> short ← three ↦ list<int, 5…9> ⊥ [9, 9, 9, 9, 9]
    print short

    let list<int, 1…∞> never_empty ← three ↦ list<int, 1…∞> ⊥ [0]
    print never_empty.first()

    let list<int> back ← fits ↦ list<int>
    print back.length()
}
