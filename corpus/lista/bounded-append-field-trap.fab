# =============================================================================
# list<T, size N>.append — a field receiver still has its capacity
# =============================================================================
# `box.values` is a bounded list, even though it is a field projection.
# Appending to the full field traps with "bounded collection push at
# capacity" and does not reach the final print.

class Box {
    mut list<int, size 2> values = [1, 2]
}

main {
    mut Box box ← Box { }
    print "before"
    box.values.append(3)
    print "unreached"
}
