# =============================================================================
# bounded list append at capacity — a bounded field traps on overflow
# =============================================================================
# A bounded list stored in a mutable field keeps its capacity when reached
# through that field projection. The append aborts before the next statement.

class Holder {
    mut list<int, size 1> row
}

main {
    mut Holder holder ← Holder { row = [1] }
    print "before"
    holder.row.append(2)
    print "after"
}
