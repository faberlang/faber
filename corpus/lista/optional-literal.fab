# =============================================================================
# lista — a list literal (or `empty`) in an optional slot
# =============================================================================
#
# What this teaches:
#   • a list literal stores into a `list<T> ∪ none` slot exactly as it stores
#     into a plain `list<T>` slot: the optional slot holds the list itself
#   • the same holds at every store site: declaration, reassignment, call
#     argument, return value, and class field
#   • the literal's elements are checked against `T`, not against the optional
#   • `empty` stores the same way: the optional slot holds an empty list, which
#     is not `none`
#   • an optional slot may still hold `none`; test it with `not is none`
#     before calling a list method on it
#
# Common mistakes:
#   • calling a list method on an optional list without testing it first:
#     `xs.length()` needs the `xs not is none` branch around it
#
# EXPECTED OUTPUT:
#   The length of the list stored at each site, one per line: declaration,
#   reassignment, argument, return value, field. Then the same sites for
#   `empty`, printing `held` (-1 only when the slot is `none`).
#   2
#   4
#   2
#   3
#   1
#   0
#   0
#   0
#   0
#   0
#   -1

class Bag {
    mut list<int> ∪ none items
}

fn make() → list<int> ∪ none {
    return [1, 2, 3]
}

fn size(list<int> ∪ none xs) → int {
    if xs not is none {
        return xs.length()
    }
    return 0
}

fn held(list<int> ∪ none xs) → int {
    if xs not is none {
        return xs.length()
    }
    return -1
}

fn make_empty() → list<int> ∪ none {
    return empty
}

main {
    let list<int> ∪ none declared ← [10, 20]
    print size(declared)

    mut list<int> ∪ none later ← null
    later ← [4, 5, 6, 7]
    print size(later)

    print size([8, 9])

    let list<int> ∪ none returned ← make()
    print size(returned)

    let Bag bag ← Bag { items = [1] }
    print size(bag.items)

    let list<int> ∪ none blank ← empty
    print held(blank)

    mut list<int> ∪ none refilled ← [1, 2]
    refilled ← empty
    print held(refilled)

    print held(empty)

    let list<int> ∪ none made ← make_empty()
    print held(made)

    let Bag empty_bag ← Bag { items = empty }
    print held(empty_bag.items)

    let list<int> ∪ none absent ← null
    print held(absent)
}
