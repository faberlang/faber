# =============================================================================
# list<T, lo‥hi> — a policy word around a list
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • A list length range is spelled on the list, list<int, 1…3>, and always traps; saturating, trapping and wrapping take a number width.
#
# Common mistakes:
#   • Choosing a clamping or wrapping length; a list cannot grow or shrink silently.

main {
    let saturating<list<int>, 1…3> xs ← [1]
    print xs
}
