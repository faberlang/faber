# =============================================================================
# list<T, lo‥hi> — a range with no length
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • 4‥4 is half open, so it holds no length; 4…4 holds exactly 4.
#
# Common mistakes:
#   • Writing 4‥4 for exactly four; write 4…4, or list<int, 4>.

main {
    let list<int, 4‥4> xs ← [1, 2, 3, 4]
    print xs
}
