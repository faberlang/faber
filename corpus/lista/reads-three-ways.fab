# =============================================================================
# Three reads of one element — bracket, get, at
# =============================================================================
#
# What this teaches:
#   • `c[i]` is the read where the programmer knows the element is there; a
#     missing element kills the run
#   • `c.get(i)` returns `T ∪ none`: the element, or `none` when missing
#   • `c.at(i)` is the failable read: out of range it reports on the error
#     channel, so a `⊥` default or a `cape` handler takes it
#   • the same three reads hold on a list and on a text (a text indexes by
#     Unicode character)
#
# Common mistakes:
#   • using `c[i]` on an index that may be missing — it dies, it never gives
#     `none`; choose `get` or `at` for an index that may be out of range
#   • expecting `at` to give `none` — `get` gives `none`, `at` reports
#
# See also: methodi-accessus, defectus, fac-cape
# =============================================================================

# EXPECTED stdout: see reads-three-ways.expected

main {
    const list<int> xs ← [10, 20, 30]
    const string s ← "héj"
    var int far ← 2
    far ← far + 5

    # bracket read: in range only (out of range would end the run)
    print xs[1]
    print s[1]

    # get: the element, or none
    print xs.get(1)
    print xs.get(far)
    print s.get(1)
    print s.get(far)

    # at: the element, or a report that a default or a handler takes
    print xs.at(1) ⊥ 0
    print xs.at(far) ⊥ 0
    print s.at(1) ⊥ "?"
    print s.at(far) ⊥ "?"

    do {
        print xs.at(far)
    }
    catch err {
        print "list at reported"
    }
    do {
        print s.at(far)
    }
    catch err {
        print "text at reported"
    }
}
