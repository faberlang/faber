# =============================================================================
# reperta over optional elements — one optional result, never a nested one.
# =============================================================================
#
# What this teaches:
#   • `find` over `list<int ∪ none>` returns `int ∪ none`, the same shape it
#     returns over `list<int>`. The result is not an optional of an optional.
#   • A matching element that is itself `none` and a search that matches
#     nothing both read `none`; the first matching `7` reads `7`.
#
# Common mistakes:
#   • Expecting to tell "found a none" from "found nothing": the result type
#     has one `none`, so it cannot.
#
# See also: reperta
# =============================================================================

main {
    let list<int ∪ none> xs ← [null, 7]
    let int ∪ none found ← xs.find((int ∪ none x) → bool ∴ true)
    print found
    let int ∪ none seven ← xs.find((int ∪ none x) → bool ∴ x ≢ null)
    print seven
}
