# A mutable f32 list parameter read inside arithmetic.
#
# The indexed read must use a checked `get(index as usize)` and preserve the
# list-index trap. This also exercises a variable index in a larger floating-
# point expression, rather than a standalone integer-list read.

fn add_at(mut list<f32> values, int index) → f32 {
    return values[index] + (0.5 ∷ f32)
}

main {
    mut list<f32> samples ← [1.0, 2.0]
    mut int index ← 1
    print add_at(mut samples, index)
}
