# =============================================================================
# list<T, N> — the bare count is retired
# =============================================================================
# This exemplum intentionally fails to compile.
#
# What this teaches:
#   • A list bound is a count, so it follows `size`: `list<int, size 4>` holds at most 4 elements and is the sugar for `list<int, size 0…4>`.
#
# Common mistakes:
#   • Writing the capacity as a bare number, as the other bounded heads still do; a list takes `size` first.

main {
    let list<int, 4> xs ← [1, 2, 3, 4]
    print xs
}
