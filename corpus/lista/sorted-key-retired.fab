# =============================================================================
# lista — the keyed .sorted(key) method is retired
# =============================================================================
#
# What this teaches:
#   • `sorted(key)` was removed; the sort expression builds the same new list
#
# Common mistakes:
#   • calling `.sorted(key)` — write
#     `sort via asc from list let x { return key }` instead
#
# See also: ordina-clavis
# =============================================================================

# lista reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

class Persona {
    mut string nomen
    mut int aetas
}

main {
    let list<Persona> personae ← [
        Persona { nomen = "Livia", aetas = 30 },
        Persona { nomen = "Aulus", aetas = 25 }
    ]
    let list<Persona> per_aetatem ← personae.sorted(Persona p ∴ p.aetas)
    print per_aetatem.length()
}
