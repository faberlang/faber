# Multiplying two lists with `*` is refused by name.
# The operator does not select elementwise multiplication.
# The elementwise product has a dedicated operator.
# This is a semantic rejection, not a parser limitation.

main {
    let list<int> a ← [1, 2, 3]
    let list<int> b ← [4, 5, 6]
    print a * b
}
