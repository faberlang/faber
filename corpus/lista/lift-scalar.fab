# =============================================================================
# lista — % ÷ ⊙ ⊘ and unary minus over numeric lists
# =============================================================================
#
# What this teaches:
#   • `%` takes a list and a scalar on either side; `÷` takes a scalar or a list
#   • Unary minus — `-xs` negates each element
#   • Between two lists `⊙` multiplies and `⊘` divides per element; `xs * ys` and
#     `xs / ys` are errors that name them, as they are for vectors and tensors
#   • An untyped literal adopts the list's element type — `xs * 2.0` stays `f32`
#   • A float lift floors like the scalar `%` — the remainder takes the divisor's sign (`[-7.5] % 2.0` is `[0.5]`)
#   • Operand order is kept — `0.5 - xs` is `0.5 - xs[i]` for each element
#   • The sum is exact — `list<u8> + list<u8>` stores into a `list<u16>`; the range
#     check happens only at the store (a `list<u8>` target would trap)
#   • A `list<T, N>` has `len` live elements and N slots: an operator pairs the
#     `len` elements, so a list shorter than N works, but two bounded lists with
#     different live lengths stop the program — an operator dies, while the
#     method form `added` reports on `⇥`
#   • Different capacities (`list<T, 4> + list<T, 8>`) are a check-time error;
#     convert one operand with `↦`
#
# Common mistakes:
#   • writing `xs * ys` for two lists — use `⊙`
#   • writing `xs / ys` for two lists — use `⊘` (like `/`) or `÷` (true division)
#   • pairing lists of different lengths — the live lengths must be equal
#   • reading the capacity N as the number of elements an operator visits
#
# See also: lista, ⊙, ⊘, ÷, longitudo
# =============================================================================

# lista — elementwise forms
#
# WHY: a scalar with a list keeps `+ - * / %` in either order, and the two-list
# products are spelled with their own glyphs.
#
# EXPECTED stdout: see lift-scalar.expected

fn scaled(list<f32> xs) → list<f32> {
    return xs * 2.0
}

fn shifted(list<f32> xs) → list<f32> {
    return 0.5 - xs
}

fn products(list<int> xs, list<int> ys) → list<int> {
    return xs ⊙ ys
}

fn quotients(list<int> xs, list<int> ys) → list<int> {
    return xs ⊘ ys
}

fn total(list<f32, 4> x, list<f32, 4> y) → int {
    let list<f32, 4> sum ← x + y
    return sum.length()
}

main {
    let list<f32> a ← [1.5, 2.5, 4.0]
    let list<f32> b ← [2.0, 4.0, 8.0]
    print scaled(a)
    print shifted(a)
    print a % 2.0
    print 9.0 % b
    # A float lift floors like the scalar operator (ruling 14, F9 ruling 29):
    # the remainder takes the divisor's sign.
    const list<f32> signs ← [-7.5, 7.5]
    const f32 neg_two ← -2.0
    print signs % 2.0
    print signs % neg_two
    print a ÷ b
    print 3.0 ÷ b
    print -a
    let list<int> n ← [7, 8, -9]
    let list<int> m ← [2, 3, 4]
    print products(n, m)
    print quotients(n, m)
    print n % 4
    print n ÷ m
    print -n
    let list<u8> bytes ← [200, 100, 50]
    let list<u8> more ← [100, 100, 100]
    let list<u16> wide ← bytes + more
    print wide

    mut list<f32, 4> p ← empty
    p.append(1.0)
    p.append(2.0)
    mut list<f32, 4> q ← empty
    q.append(4.0)
    q.append(5.0)
    let list<f32, 4> sum ← p + q
    print sum
    print sum.length()
    print 10.0 - p
    print total(p, q)
}
