# Dividing two lists with `/` is refused by name.
# The operator does not select elementwise division.
# The elementwise division forms have dedicated operators.
# This is a semantic rejection, not a parser limitation.

main {
    let list<int> a ← [4, 6, 8]
    let list<int> b ← [2, 3, 4]
    print a / b
}
