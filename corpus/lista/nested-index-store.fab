# =============================================================================
# nested-index-store — store through a field and then an index.
# =============================================================================

class Box {
    mut list<int> xs
}

main {
    mut Box b ← Box { xs = [0, 0] }
    b.xs[1] ← 5
    print b.xs[1]
    print b.xs[0]
}
