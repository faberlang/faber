# =============================================================================
# lista — a list literal reuses a named local
# =============================================================================
#
# What this teaches:
#   • `[x, x]` reads `x` once per element; the binding is not consumed
#   • this holds for heap-backed values (`inf`, `string`) as well as plain
#     numbers: every element is an independent copy of the value
#   • the local stays readable after the literal is built
#
# Common mistakes:
#   • assuming a literal moves its named elements
#
# See also: lista, inf, textus
# =============================================================================

# EXPECTED OUTPUT:
#   2
#   5
#   2
#   hi
#   3

main {
    let inf x ← 5
    let list<inf> xs ← [x, x]
    print xs.length()
    print x

    let string s ← "hi"
    let list<string> ss ← [s, s, s]
    print ss.length() - 1
    print s
    print ss.length()
}
