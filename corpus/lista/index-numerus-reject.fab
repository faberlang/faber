# lista reject case — a text index on a list is refused.
# A list is addressed by an integer position; `xs["x"]` has no position.
# The checker names the issue `array_index_must_be_numerus`.
# This exemplum intentionally fails to check.

main {
    let list<int> xs ← [1, 2, 3]
    print xs["x"]
}
