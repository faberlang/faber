# =============================================================================
# list<T, lo‥hi> — ⇜ past the maximum aborts
# =============================================================================
# This exemplum intentionally aborts. `xs` holds lengths 1 and 2, so the
# second `⇜` fits and the third dies with
# "list length range: push past the maximum"; the method form `append` reports
# the same failure on the error channel instead.

main {
    mut list<int, 1…2> xs ← [1]
    xs ⇜ 2
    print xs
    xs ⇜ 3
    print xs
}
