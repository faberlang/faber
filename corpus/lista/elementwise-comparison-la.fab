# =============================================================================
# Numeric lista comparisons — ordering and value equality lift per element.
# =============================================================================
#
# What this teaches:
#   • `≺ ≻ ≤ ≥ ≅ ≇` apply per element between two numeric lists, or between a
#     list and a scalar on either side, and give a list of bool
#   • two lists are paired by position and must have equal length
#   • `≡` and `≢` are not lifted: they compare whole lists and give one bool
#   • a list of bool is a mask, never a truth value; `reduce via all` or
#     `reduce via any` gives a single answer
#
# Common mistakes:
#   • expecting a list to order lexicographically — a tuple does, a list does not
#   • ordering a list of bits (b8) — bits are not numbers; use ≡ on whole lists
#
# See also: elementwise-operators, lift-scalar
# =============================================================================

# EXPECTED stdout: see elementwise-comparison-la.expected

incipit {
    sit lista<numerus> xs ← [1, 5, 3]
    sit lista<numerus> ys ← [2, 4, 3]
    nota xs ≺ ys
    nota xs ≻ ys
    nota xs ≤ ys
    nota xs ≥ ys
    nota xs ≅ ys
    nota xs ≇ ys
    nota xs ≤ 3
    nota 3 ≤ xs
    sit lista<bivalens> mask ← xs ≻ 2
    nota mask
    nota xs ≡ ys
}
