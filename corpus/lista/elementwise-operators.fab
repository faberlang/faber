# =============================================================================
# Numeric lista operators — elementwise arithmetic and scalar broadcast.
# =============================================================================
#
# What this teaches:
#   • `+` and `-` apply elementwise between two numeric lists; `+`, `-`, `*`, `/` apply
#     elementwise between a list and a scalar.
#   • Two lists with `*` or `/` are errors that name `⊙` and `⊘` (see lift-scalar.fab).
#   • A scalar broadcasts on either side: `xs * 2` and `2 * xs` are list results.
#   • List operands are paired by position and must have equal length.
#   • The result is a fresh list; `*` is not Python-style list repetition.
#
# Common mistakes:
#   • Mixing numeric widths — convert explicitly with `↦`.
#   • Expecting nested lists to participate — rank-2 values belong to tensors.
#   • Treating a list capacity bound as its current runtime length.
#
# See also: lista, ↦
# =============================================================================

# A1 semantic anchor. Dynamic list length checking is A2's runtime contract.
main {
    let list<int> xs ← [10, 20, 30]
    let list<int> ys ← [1, 2, 3]
    let list<int> sums ← xs + ys
    let list<int> differences ← xs - ys
    let list<int> products ← 2 * xs
    let list<int> quotients ← xs / 10
    print sums
    print differences
    print products
    print quotients
}
