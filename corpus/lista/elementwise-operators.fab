summary = "Elementwise + and - between numeric lists, and + - * / against a scalar on either side."
syntax = "<numeric-list> (+ | -) <numeric-list> | <numeric-list> (+ | - | * | /) <scalar> | <scalar> (+ | - | * | /) <numeric-list>"
