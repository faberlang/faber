# =============================================================================
# Three reads of one element — bracket, accipe, apud
# =============================================================================
#
# What this teaches:
#   • `c[i]` is the read where the programmer knows the element is there; a
#     missing element kills the run
#   • `c.accipe(i)` returns `T ∪ none`: the element, or `none` when missing
#   • `c.apud(i)` is the failable read: out of range it reports on the error
#     channel, so a `⊥` default or a `cape` handler takes it
#   • the same three reads hold on a list and on a text (a text indexes by
#     Unicode character)
#
# Common mistakes:
#   • using `c[i]` on an index that may be missing — it dies, it never gives
#     `none`; choose `accipe` or `apud` for an index that may be out of range
#   • expecting `apud` to give `none` — `accipe` gives `none`, `apud` reports
#
# See also: methodi-accessus, defectus, fac-cape
# =============================================================================

# EXPECTED stdout: see reads-three-ways-la.expected

incipit {
    sit lista<numerus> xs ← [10, 20, 30]
    sit textus s ← "héj"
    varia numerus far ← 2
    far ← far + 5

    # bracket read: in range only (out of range would end the run)
    nota xs[1]
    nota s[1]

    # accipe: the element, or none
    nota xs.accipe(1)
    nota xs.accipe(far)
    nota s.accipe(1)
    nota s.accipe(far)

    # apud: the element, or a report that a default or a handler takes
    nota xs.apud(1) ⊥ 0
    nota xs.apud(far) ⊥ 0
    nota s.apud(1) ⊥ "?"
    nota s.apud(far) ⊥ "?"

    fac {
        nota xs.apud(far)
    }
    cape err {
        nota "list at reported"
    }
    fac {
        nota s.apud(far)
    }
    cape err {
        nota "text at reported"
    }
}
