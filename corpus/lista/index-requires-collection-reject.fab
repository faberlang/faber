# Bracket indexing is refused for an integer because it is not a collection.
# Lists and maps support indexing; integers do not.
# The expression `n[0]` therefore fails during semantic checking.
# This exemplum intentionally demonstrates that rejection.

main {
    let int n ← 1
    print n[0]
}
