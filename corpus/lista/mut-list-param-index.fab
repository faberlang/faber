# =============================================================================
# mut-list-param-index — mutable list parameters keep checked indexing.
# =============================================================================
#
# Indexing a `mut` list parameter uses the same checked `get` access as an
# ordinary list. An out-of-range index traps rather than using Rust's native
# bracket indexing or failing to compile because the source index is an `int`.
#
# The empty entry keeps this as an emitter/build case: compiling the function
# checks the access path without requiring a run-time invocation.

fn get(mut list<int> xs, int i) → int {
    return xs[i]
}

main {}
