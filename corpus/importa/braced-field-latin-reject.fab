# =============================================================================
# importa — Latin record field word in an en file (expect parse error)
# =============================================================================
#
# What this teaches:
#   • Locale surfaces are sealed — the en spelling of the source field is
#     `from`, so the Latin `ex` is refused in an en file
#   • Parse error — `PARSE050:wrong_locale_import_field` names the word written
#     and the en word to use instead
#
# Common mistakes:
#   • writing `ex`, `visibilitas`, `nomen`, `ut` or `omnia` in an en record —
#     write `from`, `visibility`, `name`, `as` or `all`
#
# See also: importa, ex
# =============================================================================

# Latin record field word in an en file (expect parse error)
#
# DELIBERATE: this exemplum keeps the Latin field word (`ex`) on purpose, to pin
# the PARSE050 `wrong_locale_import_field` diagnostic.

import { ex = "norma:text" }

print "unreachable"
