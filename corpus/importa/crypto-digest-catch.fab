category = "package"
canonical = false
summary = "A norma:crypto digest Result is unwrapped into its byte-list value inside do/catch."
syntax = "crypto.digest(alg, data) inside do/catch"
related = ["importa", "crypto", "digest", "do", "catch"]
locale = "en"
+++
import from "norma:crypto" crypto

main {
    let list<b8> data ← |61 62 63|
    do {
        let list<b8> digest_bytes ← crypto.digest("sha256", data)
        print digest_bytes.length()
    } catch err {
        print err
    }
}
