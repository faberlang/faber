# Both doors out of a target-native import: the scalar door converts silently
# into an f64 cell, while the structural door needs the explicit ↦ transfer.
import python "math" m
import python "re" re

main {
    let f64 root ← m.sqrt(2.0)
    let list<string> words ← re.findall("[a-z]+", "a1b2") ↦ list<string>
    print root
    print words
}
