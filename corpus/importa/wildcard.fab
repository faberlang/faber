# =============================================================================
# importa — a wildcard import binds every exported member under one alias
# =============================================================================
#
# What this teaches:
#   • `* as L` binds the module's exported surface under `L`; `L.greet` is the
#     exported function, reached through the alias.
#   • The alias is a namespace, not a re-export: it reaches only members the
#     module marks `@ public`.
#
# Common mistakes:
#   • Reaching a private member through the alias — an unmarked top-level
#     declaration stays module-private (`import_module_private`).
#
# See also: importa, publica, ut
# =============================================================================

# importa wildcard — every exported member under one alias
#
# GRAMMAR:
#   import from "./lib" * as L
#
# Requires module layout: wildcard.fab imports lib.fab
# (package or module mode).
#
# EXPECTED OUTPUT:
#   hi w! (wildcard.expected)

import from "./lib" * as L

main {
    print L.greet("w")
}
