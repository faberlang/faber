# =============================================================================
# importa — Sibling module consumed by importa ex …
# =============================================================================
#
# What this teaches:
#   • Sibling module consumed by importa ex … .
#   • Related keywords: importa, ex
#
# Common mistakes:
#   • Exporting a name without the module being importable — standalone compilation may fail to resolve sibling imports; use package or module mode.
#
# See also: importa, ex
# =============================================================================

# importa auxilium — sibling module for importa/importa.fab
#
# Exported functio saluta consumed via importa ex "./auxilium".
# `@ public` is the en-surface spelling of `@ publica`: only `@ publica` /
# `@ interna` declarations are importable; unmarked declarations are
# module-private.
#
# GRAMMAR:
#   functio saluta(textus nomen) → textus { … }   (module-level export)
#
# This file is the dependency target; importa/importa.fab is the consumer exemplum.
# Runnable standalone (own incipit) or as an imported module in package mode.
#
# EXPECTED OUTPUT:
#   "Salve, auxilium!" when run standalone.
#
# BACKEND: importa/importa.fab whitelisted when compiled alone (no sibling link).

@ public
fn saluta(string nomen) → string {
    return "Salve, §!"(nomen)
}

main {
    print saluta("auxilium")
}