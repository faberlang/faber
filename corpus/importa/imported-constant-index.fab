# =============================================================================
# importa — an imported module constant is a scalar tensor bracket index
# =============================================================================
#
# What this teaches:
#   • `t[module.CONST]` reads and writes a rank-1 tensor exactly like `t[[module.CONST]]`
#   • The index is an ordinary integer value: a bare imported constant, a constant
#     plus a local, and the double-bracket spelling all name the same element
#
# Common mistakes:
#   • indexing a rank-2 tensor with one scalar — a scalar index needs rank 1; use
#     `t[[r, c]]` for rank-N (`tensor_scalar_index_rank`)
#
# See also: importa, tensor, publica
# =============================================================================

# importa imported-constant-index — tensor bracket access with an imported constant index
#
# Requires module layout: imported-constant-index.fab imports
# constantia.fab (BASE is 5) in package or module mode.
#
# EXPECTED OUTPUT:
#   imported-constant-index.expected (7.0, 7.0, 8.0, 8.0)

import from "./constantia" constantia

fn read(tensor<f32, [8]> t) → f32 {
    return t[constantia.BASE]
}

main {
    mut tf32[8] cells ← tf32[8] {}

    cells[constantia.BASE] ← 7.0
    let f32 direct ← read(cells)
    let f32 doubled ← cells[[constantia.BASE]]

    let u32 step ← 1
    cells[constantia.BASE + step] ← 8.0
    let f32 shifted ← cells[constantia.BASE + step]
    let f32 shiftedDoubled ← cells[[constantia.BASE + step]]

    print direct
    print doubled
    print shifted
    print shiftedDoubled
}
