# =============================================================================
# importa — braced record fields are reader-pack words
# =============================================================================
#
# What this teaches:
#   • The five record field names (source, visibility, name, alias, wildcard
#     alias) are keywords like the rest of the surface: an `en` file writes
#     `from`, `visibility`, `name`, `as` and `all`; the Latin `ex`,
#     `visibilitas`, `nomen`, `ut` and `omnia` belong to `la` files.
#   • `visibility = public` is the only visibility value; `name` and `as`
#     bind the imported module like the sugar form `import from … name as alias`.
#
# Common mistakes:
#   • Writing the Latin field words in an `en` file — `PARSE050
#     wrong_locale_import_field` names the word to write instead
#     (`braced-field-latin-reject.fab`).
#
# See also: importa, ex, publica, ut, nomen
# =============================================================================

# importa — braced record with every field except the wildcard alias
#
# EXPECTED OUTPUT:
#   braced-fields

import { from = "norma:text", visibility = public, name = text, as = t }

print "braced-fields"
