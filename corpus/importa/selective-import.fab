grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "importa_decl", "importa_sugar", "selective_import", "import_value_binding", "incipit_stmt", "fixum_decl", "call_expr", "call_suffix", "argument_list", "argument", "expression", "literal", "nota_stmt"]
category = "package"
summary = "Selective imports bind exported members by name: one exported value or type per fixum local, with the imported file interface supplying the complete type."
syntax = "importa ex <source> [publica] fixum <member> [ut <local>]{, <member> [ut <local>]}"
aliases = ["selective imports", "importa fixum"]
