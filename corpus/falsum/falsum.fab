+++
term = "falsum"
explains = ["falsum"]
kind = "keyword"
grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "hole_type", "proba_stmt", "adfirma_stmt", "unary_expr", "comparison", "equality", "equality_tail", "expression", "literal", "nota_stmt"]
category = "boolean"
canonical = true
summary = "Represents the false boolean value and can prefix a falsity check."
