test "falsum is the false literal" {
    let bool inactive ← false
    assert inactive ≡ false
    assert not inactive
}

test "falsum contrasts with verum" {
    assert false ≢ true
    assert false ≡ false
}
# =============================================================================
# falsum — Represents the false boolean value and can prefix a falsity check
# =============================================================================
#
# What this teaches:
#   • Represents the false boolean value and can prefix a falsity check.
#   • Related keywords: verum, nihil
#
# Common mistakes:
#   • Confusing `falsum` with `none` (la `nihil`) — `falsum` is a bivalens literal (false); `none` is the absent-member type, and its value is `null` (`nulla`).
#
# See also: verum, nihil
# =============================================================================

# falsum — false literal
#
# GRAMMAR:
#   literal :← 'falsum'
#
# EXPECTED OUTPUT:
#   Scalar stdout smoke (see body).
#

main {
    let bool inactive ← false
    print inactive
}
