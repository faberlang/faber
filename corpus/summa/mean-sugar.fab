+++
locale = "en"
term = "mean-sugar"
kind = "concept"
category = "collection"
grammar = ["reducta_expr"]
canonical = true
+++

main {
    let list<f32> flat ← [3.0, 1.0, 3.0, 2.0]
    let tf32[4] a ← flat ↦ tf32[4]
    let f32 viaSum ← (reduce via sum from a) / 4.0
    print a.mean()
    print viaSum
    let list<f32> emptyData ← []
    let tf32[0] e ← emptyData ↦ tf32[0]
    print e.mean()
}
