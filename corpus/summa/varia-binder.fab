# =============================================================================
# summa varia binder — mutable element binding in a sequential reduction
# =============================================================================
#
# What this teaches:
#   • The reduction binder may be `varia`, not only `fixum`.
#   • The body still returns exactly one scalar term with `redde`.
#
# Common mistakes:
#   • reading `varia` as permission to mutate the source tensor — it only
#     changes the local binding's mutability.

functio total(tensor<f32, [4]> a) → f32 {
    redde summa ex a apud [i] fixum s {
        redde s
    }
}

incipit {
    fixum lista<f32> flat ← [1.0, 2.0, 3.0, 4.0]
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [4]> a ← seed.strue(flat, [4])
    nota total(a)
}
