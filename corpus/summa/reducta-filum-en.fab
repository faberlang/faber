# =============================================================================
# reduce … thread — every reduction operator admits the `thread` clause
# =============================================================================
#
# What this teaches:
#   • `thread` is a permission for parallel evaluation. Its sequential meaning
#     is the plain reduction folded in iteration order, so each operator —
#     product, max, min, argmax, argmin, all, any, count — lowers exactly as it
#     does without `thread`
#   • `thread` is admitted only inside a `@ kernel` function, takes a term body,
#     and (for a known extent) needs a multiple of 32 elements
#   • ties for argmax and argmin go to the lowest coordinate, with or without
#     `thread`; over an empty source max and min fall to the `coalesce` default
#     and the arg-extrema to none
#   • the ungrouped `sum` keeps its declared device recipe (see summa-en.fab)
#
# Common mistakes:
#   • `thread` without a term body — declined (reducta_filum_requires_body)
#   • `thread` outside `@ kernel` — declined (reducta_filum_requires_nucleum_kernel)
#   • grouped max or min with `thread` — a grouped max or min needs a body-less
#     `coalesce` identity, and `thread` needs a body
#
# See also: reducta-ops-en, summa-en, thread, kernel
# =============================================================================

# EXPECTED OUTPUT:
#   the runner never executes a `@ kernel` function, so only the plain twins of
#   the kernel reductions below run: max, min, product, argmax, argmin, count,
#   any, all over one list.

@ kernel
fn t_max(tf32[32] a) → f32 {
    return reduce via max from a at [i] thread lane let s { return s }
}

@ kernel
fn t_min(tf32[32] a) → f32 {
    return reduce via min from a at [i] thread lane let s { return s }
}

@ kernel
fn t_product(tf32[32] a) → f32 {
    return reduce via product from a at [i] thread lane let s { return s }
}

@ kernel
fn t_argmax(tf32[32] a) → i32 {
    return reduce via argmax from a at [i] thread lane let s { return s }
}

@ kernel
fn t_argmin(tf32[32] a) → i32 {
    return reduce via argmin from a at [i] thread lane let s { return s }
}

@ kernel
fn t_count(tf32[32] a) → i32 {
    return reduce via count from a at [i] thread lane let s { return s ≻ 2.0 }
}

@ kernel
fn t_any(tf32[32] a) → bool {
    return reduce via any from a at [i] thread lane let s { return s ≻ 3.5 }
}

@ kernel
fn t_all(tf32[32] a) → bool {
    return reduce via all from a at [i] thread lane let s { return s ≻ 0.5 }
}

@ kernel
@ public
fn entry(tf32[32] a, mut tensor<f32, [8]> out) → void {
    out[0] ← t_max(a)
    out[1] ← t_min(a)
    out[2] ← t_product(a)
    out[3] ← t_argmax(a) ↦ f32
    out[4] ← t_argmin(a) ↦ f32
    out[5] ← t_count(a) ↦ f32
    if t_any(a) and t_all(a) {
        out[6] ← 1.0
    }
}

fn p_max(tf32[4] a) → f32 {
    return reduce via max from a at [i] let s { return s }
}

fn p_min(tf32[4] a) → f32 {
    return reduce via min from a at [i] let s { return s }
}

fn p_product(tf32[4] a) → f32 {
    return reduce via product from a at [i] let s { return s }
}

fn p_argmax(tf32[4] a) → int {
    return reduce via argmax from a at [i] let s { return s }
}

fn p_argmin(tf32[4] a) → int {
    return reduce via argmin from a at [i] let s { return s }
}

fn p_count(tf32[4] a) → int {
    return reduce via count from a at [i] let s { return s ≻ 2.0 }
}

fn p_any(tf32[4] a) → bool {
    return reduce via any from a at [i] let s { return s ≻ 3.5 }
}

fn p_all(tf32[4] a) → bool {
    return reduce via all from a at [i] let s { return s ≻ 0.5 }
}

main {
    let tf32[4] a ← [3.0, 1.0, 3.0, 2.0] ↦ tf32[4]
    print p_max(a)
    print p_min(a)
    print p_product(a)
    print p_argmax(a)
    print p_argmin(a)
    print p_count(a)
    print p_any(a)
    print p_all(a)
}
