+++
locale = "la"
term = "reducta-ops"
kind = "concept"
category = "collection"
grammar = ["reducta_expr", "reducta_op", "reducta_group", "reducta_body", "reducta_identity"]
canonical = true
+++

functio summa_tot(tensor<f32, [4]> a) → f32 { redde reducta via summa ex a }
functio factum_tot(tensor<f32, [4]> a) → f32 { redde reducta via factum ex a }
functio maxima_tot(tensor<f32, [4]> a) → f32 { redde reducta via maxima ex a }
functio minima_tot(tensor<f32, [4]> a) → f32 { redde reducta via minima ex a apud [i] }
functio maxima_vacua() → f32 {
    sit tf32[0] v ← vacua
    redde reducta via maxima ex v apud [i] vel -∞
}
functio numera_maiora(tensor<f32, [4]> a) → numerus {
    redde reducta via numeratio ex a apud [i] fixum s { redde s ≻ 2.0 }
}
functio omnes_positivi(tensor<f32, [4]> a) → bivalens {
    redde reducta via omnia ex a apud [i] fixum s { redde s ≻ 0.5 }
}
functio omnes_maiores(tensor<f32, [4]> a) → bivalens {
    redde reducta via omnia ex a apud [i] fixum s { redde s ≻ 1.5 }
}
functio aliquis_maior(tensor<f32, [4]> a) → bivalens {
    redde reducta via quilibet ex a apud [i] fixum s { redde s ≻ 2.5 }
}
functio aliquis_maximus(tensor<f32, [4]> a) → bivalens {
    redde reducta via quilibet ex a apud [i] fixum s { redde s ≻ 3.5 }
}
functio summa_corpus(tensor<f32, [4]> a) → f32 {
    redde reducta via summa ex a apud [i] fixum s { redde s + 1.0 }
}
incipit {
    sit lista<f32> flat ← [3.0, 1.0, 3.0, 2.0]
        sit tf32[4] a ← flat ↦ tf32[4]
    nota summa_tot(a)
    nota factum_tot(a)
    nota maxima_tot(a)
    nota minima_tot(a)
    nota maxima_vacua()
    nota numera_maiora(a)
    nota omnes_positivi(a)
    nota omnes_maiores(a)
    nota aliquis_maior(a)
    nota aliquis_maximus(a)
    nota summa_corpus(a)
}
