+++
locale = "la"
term = "reducta-arg"
kind = "concept"
category = "collection"
grammar = ["reducta_expr", "reducta_op", "reducta_group", "reducta_body", "reducta_identity"]
canonical = true
+++

functio optimum(tensor<f32, [4]> a) → numerus { redde reducta via argmaxima ex a }
functio infimum(tensor<f32, [4]> a) → numerus { redde reducta via argminima ex a }
functio optimum_corpus(tensor<f32, [4]> a) → numerus {
    redde reducta via argmaxima ex a apud [i] sit s { redde 0.0 - s }
}
functio optimum_nan(tensor<f64, [4]> a) → numerus { redde reducta via argmaxima ex a }
functio optimum_plana(tensor<f32, [2, 3]> m) → iuncta<numerus, numerus> {
    redde reducta via argmaxima ex m apud [i, j]
}
functio infimum_plana(tensor<f32, [2, 3]> m) → iuncta<numerus, numerus> {
    redde reducta via argminima ex m apud [i, j]
}
functio optimum_vacua() → numerus ∪ nihil {
    sit tf32[0] v ← vacua
    redde reducta via argmaxima ex v apud [i]
}
functio optimum_vacua_vel() → numerus {
    sit tf32[0] v ← vacua
    redde reducta via argmaxima ex v apud [i] vel 7
}
incipit {
    sit lista<f32> flat ← [3.0, 1.0, 3.0, 2.0]
        sit tf32[4] a ← flat ↦ tf32[4]
    nota optimum(a)
    nota infimum(a)
    nota optimum_corpus(a)
    sit lista<f64> flat_nan ← [nonnumerus, 3.0, 1.0, 3.0]
        sit tf64[4] a_nan ← flat_nan ↦ tf64[4]
    nota optimum_nan(a_nan)
    sit lista<f32> flat2 ← [1.0, 5.0, 2.0, 5.0, 0.0, 1.0]
    sit tf32[2, 3] m ← flat2 ↦ tf32[2, 3]
    sit iuncta<numerus, numerus> hi ← optimum_plana(m)
    sit iuncta<numerus, numerus> lo ← infimum_plana(m)
    nota hi[0]
    nota hi[1]
    nota lo[0]
    nota lo[1]
    nota optimum_vacua()
    nota optimum_vacua_vel()
}
