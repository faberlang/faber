# =============================================================================
# sum thread — distributed sum-reduce admit inside @ kernel
# =============================================================================
#
# What this teaches:
#   • Declared distributed sum — the `thread` spelling lowers to the
#     DistributedSum plan entry: cyclic per-lane term-body fold with exactly
#     one lane collective at group exit and a broadcast result.
#   • Term body — per-lane scalar computation with exactly one valued
#     `return`; local mutation of term-local bindings is allowed.
#   • Alignment — the source length must be a multiple of the 32-lane width
#     in v1; K = 32 here. Tails (K % 32 ≠ 0) decline at admission.
#
# See also: sum, thread, kernel, at, tensor
# =============================================================================

@ kernel lane "id"
@ public
fn column_dot(tf32[32] a, tf32[1] out) → void {
    const f32 total ← sum from a at [i] thread f const s {
        var f32 t ← s * 1.4140625
        return t
    }
    out[id] ← total
}
