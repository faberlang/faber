# =============================================================================
# max/min — shaped tensor extrema with caller-stated empty identity
# =============================================================================
#
# What this teaches:
#   • Sibling reductions — `max from` and `min from` are dedicated reductions,
#     not configuration flags on `sum from`.
#   • Binderless default — omit `at [...]` when the operand needs no index.
#   • Static shape — a non-empty `tf32[4]` result is plain `f32`.
#   • Caller identity — `coalesce` accepts a runtime value when the shape may
#     be empty; the language does not invent a maximum or minimum identity.
#   • Empty lookup — a zero-length tensor returns `null` when no identity is
#     stated, so a caller that needs `f32` must state `coalesce` explicitly.
#
# Common mistakes:
#   • hand-rolling a max loop instead of using the dedicated reduction head
#   • treating `coalesce` as a declaration default rather than the empty-result
#     identity at the call site
#
# See also: summa, tensor, null, coalesce
# =============================================================================

fn max_static(tensor<f32, [4]> values) → f32 {
    const f32 result ← max from values
    return result
}

# The `at`-binder is for bodies that use the index.
fn max_scaled(tensor<f32, [4]> row, tensor<f32, [4]> scale) → f32 {
    const f32 result ← max from (row ⊙ scale) coalesce 0.0
    return result
}

fn min_with_identity(tensor<f32, [4]> values, f32 floor) → f32 {
    const f32 result ← min from values at [i] coalesce floor
    return result
}

fn max_dynamic<size Figura>(tensor<f32, Figura> values, f32 fallback) → f32 {
    const f32 result ← max from values at [i] coalesce fallback
    return result
}

fn max_empty() → f32 {
    const tensor<f32, [0]> values ← empty
    const f32 result ← max from values at [i] coalesce -∞
    return result
}

# EXPECTED OUTPUT:
#   4.0
#   1.0
#   4.0
#   -inf

main {
    const list<f32> flat ← [4.0, 1.0, 3.0, 2.0]
    const tensor<f32, []> seed ← empty
    const tensor<f32, [4]> values ← seed.from_flat(flat, [4])
    const tensor<f32, [4]> scale ← seed.from_flat([1.0, 1.0, 1.0, 1.0], [4])
    print max_static(values)
    print min_with_identity(values, 99.0)
    print max_scaled(values, scale)
    print max_empty()
}
