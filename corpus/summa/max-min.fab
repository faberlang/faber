category = "collection"
summary = "Maximum/minimum reducta over shaped tensors with optional coordinates, coalesce identities and nihil on empty."
syntax = "reduce via max from <tensor> [at [i]] [coalesce <identity>] | reduce via min from <tensor> [at [i]] [coalesce <identity>]"
related = ["summa", "tensor", "nihil"]
locale = "en"
+++

# =============================================================================
# max/min — shaped tensor extrema with caller-stated empty identity
# =============================================================================
#
# What this teaches:
#   • Sibling reductions — `reduce via max from` and `reduce via min from` are
#     dedicated reductions, not configuration flags on `reduce via sum from`.
#   • Binderless default — omit `at [...]` when the operand needs no index.
#   • Static shape — a non-empty `tf32[4]` result is plain `f32`.
#   • Caller identity — `coalesce` accepts a runtime value when the shape may
#     be empty; the language does not invent a maximum or minimum identity.
#   • Empty lookup — a zero-length tensor returns `null` when no identity is
#     stated, so a caller that needs `f32` must state `coalesce` explicitly.
#
# Common mistakes:
#   • hand-rolling a max loop instead of using the dedicated reduction form
#   • treating `coalesce` as a declaration default rather than the empty-result
#     identity at the call site
#
# See also: summa, tensor, null, coalesce
# =============================================================================

fn max_static(tf32[4] values) → f32 {
    let f32 result ← reduce via max from values
    return result
}

# The `at`-binder is for bodies that use the index.
fn max_scaled(tf32[4] row, tf32[4] scale) → f32 {
    let f32 result ← reduce via max from (row ⊙ scale) coalesce 0.0
    return result
}

fn min_with_identity(tf32[4] values, f32 floor) → f32 {
    let f32 result ← reduce via min from values at [i] coalesce floor
    return result
}

fn max_dynamic<size Figura>(tensor<f32, Figura> values, f32 fallback) → f32 {
    let f32 result ← reduce via max from values at [i] coalesce fallback
    return result
}

fn max_empty() → f32 {
    let tf32[0] values ← empty
    let f32 result ← reduce via max from values at [i] coalesce -∞
    return result
}

# EXPECTED OUTPUT:
#   4.0
#   1.0
#   4.0
#   -inf

main {
    let list<f32> flat ← [4.0, 1.0, 3.0, 2.0]
    let tf32[4] values ← flat ↦ tf32[4]
    let tf32[4] scale ← [1.0, 1.0, 1.0, 1.0] ↦ tf32[4]

    print max_static(values)
    print min_with_identity(values, 99.0)
    print max_scaled(values, scale)
    print max_empty()
}
