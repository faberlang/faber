# =============================================================================
# sum without thread — the sequential English reduction form
# =============================================================================
#
# What this teaches:
#   • `reduce via sum from` is the English surface for the sequential
#     reduction.
#   • Omitting `thread` selects the host-lane fold; the body returns one term
#     for each bound element.
#
# Common mistakes:
#   • adding `thread` to a host reduction — `thread` belongs to the distributed
#     kernel form, while this cell intentionally stays sequential.

fn total(tensor<float, [4]> a) → float {
    return reduce via sum from a at [i] let s {
        return s
    }
}

main {
    let list<float> flat ← [1.0, 2.0, 3.0, 4.0]
    let tensor<float, [4]> a ← flat ↦ tensor<float, [4]>
    print total(a)
}
