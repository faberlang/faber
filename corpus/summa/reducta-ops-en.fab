+++
locale = "en"
term = "reducta-ops-en"
kind = "concept"
category = "collection"
grammar = ["reducta_expr", "reducta_op", "reducta_group", "reducta_body", "reducta_identity"]
canonical = true
+++

fn total(tf32[4] a) → f32 { return reduce via product from a }
fn big(tf32[4] a) → int { return reduce via count from a at [i] let s { return s ≻ 2.0 } }
fn all_pos(tf32[4] a) → bool { return reduce via all from a at [i] let s { return s ≻ 0.5 } }
fn some_huge(tf32[4] a) → bool { return reduce via any from a at [i] let s { return s ≻ 3.5 } }
fn peak(tf32[4] a, f32 floor) → f32 { return reduce via max from a at [i] coalesce floor }
main {
    let list<f32> flat ← [3.0, 1.0, 3.0, 2.0]
    let tf32[4] a ← flat ↦ tf32[4]
    print total(a)
    print big(a)
    print all_pos(a)
    print some_huge(a)
    print peak(a, 0.0)
}
