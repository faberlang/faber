# =============================================================================
# extrema without coalesce — non-empty max/min reductions
# =============================================================================
#
# What this teaches:
#   • `max from` and `min from` return scalar extrema directly when the source
#     shape is statically non-empty.
#   • `coalesce` is only needed when the caller chooses an empty-result policy.
#
# Common mistakes:
#   • treating `coalesce` as mandatory — a non-empty static tensor needs no
#     identity tail.

fn extrema(tf32[4] values) → list<f32> {
    const f32 hi ← max from values
    const f32 lo ← min from values
    return [hi, lo]
}

main {
    const list<f32> flat ← [4.0, 1.0, 3.0, 2.0]
    const tf32[] seed ← empty
    const tf32[4] values ← seed.from_flat(flat, [4])
    print extrema(values)
}
