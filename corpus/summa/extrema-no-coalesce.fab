# =============================================================================
# extrema without coalesce — non-empty max/min reductions
# =============================================================================
#
# What this teaches:
#   • `reduce via max from` and `reduce via min from` return scalar extrema
#     directly when the source shape is statically non-empty.
#   • `coalesce` is only needed when the caller chooses an empty-result policy.
#
# Common mistakes:
#   • treating `coalesce` as mandatory — a non-empty static tensor needs no
#     identity tail.

fn extrema(tf32[4] values) → list<f32> {
    let f32 hi ← reduce via max from values
    let f32 lo ← reduce via min from values
    return [hi, lo]
}

main {
    let list<f32> flat ← [4.0, 1.0, 3.0, 2.0]
    let tf32[4] values ← flat ↦ tf32[4]
    print extrema(values)
}
