# =============================================================================
# libera — module-level reference stays legal (CL-5)
# =============================================================================
#
# What this teaches:
#   • Module-level functions (and other statically resolved identities) are
#     not captures, so a free-marked closure may call them
#
# See also: libera.fab, libera-reject.fab
# =============================================================================

fn duplica(int n) → int {
    return n * 2
}

main {
    const _ double ← int x → int ∴ duplica(x)
    print double(21)
}
