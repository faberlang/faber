# =============================================================================
# privata — private method call from outside the type
#
# A `@ private` method is callable only from the type's own methods.
# Outside the type the call is a check error: route callers through a
# public method instead.
#
# Common mistakes:
#   • Calling a private method from outside the type (`v.secret()`).
#
# See also: privata, genus
# =============================================================================

class V {
    mut int a
    @ private
    fn secret() → int { return 1 }
    fn open() → int { return self.secret() }
}

main {
    let V v ← V { a = 1 }
    print v.open()
    print v.secret()
}
