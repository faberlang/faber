# =============================================================================
# privata — private field read from outside the type
#
# A `@ private` field is reachable only from the type's own methods.
# Outside the type it is not part of the surface: expose a method that
# returns what callers need instead of reaching into the field.
#
# Common mistakes:
#   • Reading a private field from outside the type (`v.a`).
#
# See also: privata, genus
# =============================================================================

class V {
    @ private
    mut int a
    fn get() → int { return self.a }
}

main {
    let V v ← V { a = 1 }
    print v.get()
    print v.a
}
