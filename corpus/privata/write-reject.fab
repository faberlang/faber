# =============================================================================
# privata — private field store from outside the type
#
# A `@ private` field is writable only from the type's own methods.
# Outside the type a store is a check error even when the binding is
# `mut`: an exported method is the way to change private state.
#
# Common mistakes:
#   • Storing to a private field from outside the type (`v.a ← 4`).
#
# See also: privata, genus
# =============================================================================

class V {
    @ private
    mut int a
    fn set(int x) → void { self.a ← x }
    fn get() → int { return self.a }
}

main {
    mut V v ← V { a = 1 }
    v.a ← 4
    print v.get()
}
