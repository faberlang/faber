# =============================================================================
# implendum — A mutating method through an interface value
# =============================================================================
#
# What this teaches:
#   • Calling a mutating method on an interface-typed binding
#     changes the value that binding holds, exactly as a direct call would
#   • Dispatch picks the held class's method, so each class mutates its own
#     fields
#
# See also: implendum, implet
# =============================================================================

interface Grower {
    fn grow() → void
    fn get() → int
}

class Circ implements Grower {
    mut int r = 1

    fn grow() → void {
        self.r ← self.r + 1
    }

    fn get() → int {
        return self.r
    }
}

class Sq implements Grower {
    mut int s = 10

    fn grow() → void {
        self.s ← self.s + 5
    }

    fn get() → int {
        return self.s
    }
}

main {
    mut Grower g ← Circ {}
    g.grow()
    g.grow()
    print g.get()
    mut Grower h ← Sq {}
    h.grow()
    print h.get()
}
