# This exemplum intentionally fails to compile: `Quadratum` declares `area`
# with a `string` return where `Figurabile` requires `int`.

interface Figurabile {
    fn area() → int
}

class Quadratum implements Figurabile {
    mut int latus = 3

    fn area() → string {
        return "nine"
    }
}

main {
    let Quadratum quadratum ← Quadratum { latus = 4 }
    print quadratum.area()
}
