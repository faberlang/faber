# =============================================================================
# implendum — A `mut` or `ref` interface parameter
# =============================================================================
#
# What this teaches:
#   • A concrete class value passed to a `mut` interface parameter is changed
#     by the callee's mutating calls, exactly as a direct call would change it
#   • A `ref` interface parameter reads the held value without changing it
#
# See also: implendum, implet, unio
# =============================================================================

interface Grower {
    fn grow() → void
    fn get() → int
}

class Circ implements Grower {
    mut int r = 1

    fn grow() → void {
        self.r ← self.r + 1
    }

    fn get() → int {
        return self.r
    }
}

class Sq implements Grower {
    mut int s = 10

    fn grow() → void {
        self.s ← self.s + 5
    }

    fn get() → int {
        return self.s
    }
}

fn bump(mut Grower g) → void {
    g.grow()
    g.grow()
}

fn peek(ref Grower g) → int {
    return g.get()
}

main {
    mut Circ c ← Circ {}
    bump(mut c)
    print c.get()
    mut Sq s ← Sq {}
    bump(mut s)
    print s.get()
    print peek(ref c)
}
