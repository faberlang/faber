# =============================================================================
# implendum — Declares a behavioral contract with method signatures
# =============================================================================
#
# What this teaches:
#   • Declares a behavioral contract with method signatures.
#   • Related keywords: genus, implet
#
# Common mistakes:
#   • Declaring a `genus implet Implendum` without implementing all required methods — every method signature in the implendum must have a body in the genus.
#
# See also: genus, implet
# =============================================================================

# implendum definition and implementation
#
# implendum Nomen { functio opus() → <type> }
# genus Nomen implet Implendum { ... }
#
# GRAMMAR:
#   implendumDecl :← 'implendum' ident '{' methodSig* '}'
#   genusDecl     :← 'genus' ident 'implet' ident '{' ... '}'
#
# EXPECTED OUTPUT:
#   circulus radius: 25
#   quadratum latus: 15

interface Figurabile {
    fn depinge() → void
}

class Circulus implements Figurabile {
    mut int radius = 10

    fn depinge() → void {
        print "circulus radius: §"(self.radius)
    }
}

class Quadratum implements Figurabile {
    mut int latus = 5

    fn depinge() → void {
        print "quadratum latus: §"(self.latus)
    }
}

main {
    let Circulus circulus ← Circulus { radius = 25 }
    let Quadratum quadratum ← Quadratum { latus = 15 }
    circulus.depinge()
    quadratum.depinge()
}
