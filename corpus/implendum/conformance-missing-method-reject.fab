# This exemplum intentionally fails to compile: `Circulus` implements
# `Figurabile` without declaring `depinge`.

interface Figurabile {
    fn depinge() → void
    fn nomen() → string
}

class Circulus implements Figurabile {
    mut int radius = 1

    fn nomen() → string {
        return "circulus"
    }
}

main {
    let Circulus circulus ← Circulus { radius = 2 }
    print circulus.nomen()
}
