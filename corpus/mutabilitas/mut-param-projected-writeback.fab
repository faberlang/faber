# =============================================================================
# mutabilitas — projected field write-through via a mut parameter
# =============================================================================
#
# What this teaches:
#   • A field projection (`b.count`) is a writable place, so it may be passed
#     to a `mut` parameter: the callee rebinds it and the final value lands
#     back in the caller's field at return. The record itself survives; only
#     the projected field moves.
#
# See also: mutabilitas, functio, mut
# =============================================================================

# mutabilitas mut-param-projected-writeback — projected field write-through
#
# EXPECTED OUTPUT:
#   mut-param-projected-writeback.expected
#
# BACKEND:
#   Runner: a call bound from a projected caller place writes the callee's
#   final value back into that place at return, so the caller's field changes
#   while the rest of the record is untouched.

class Box {
    var int count = 0
    var string label = "alpha"
}

fn setseven(mut int n) → void {
    n ← 7
}

main {
    mut Box b ← Box {}
    setseven(mut b.count)
    print b.count
    print b.label
}
