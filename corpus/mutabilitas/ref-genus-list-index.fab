# Ref genus parameters preserve checked indexing on list fields.

class Shelf {
    let list<int> values
}

fn second(ref Shelf shelf, int i) → int {
    return shelf.values[i]
}

main {
    let Shelf shelf ← Shelf { values = [10, 20, 30] }
    print second(ref shelf, 1)
}
