# =============================================================================
# mutabilitas — copy parameter is writable, the caller's value is untouched
# =============================================================================
# `copy` duplicates the argument and the callee owns the duplicate, so every
# write form is legal and none of them reaches the caller.

class Cell {
    mut int n = 0

    fn bump() → void {
        self.n ← self.n + 1
    }
}

fn grow(copy list<int> xs) → int {
    xs.append(9)
    return xs.length()
}

fn rebuild(copy list<int> xs) → int {
    xs ← [1, 2]
    return xs.length()
}

fn poke(copy list<int> xs) → int {
    xs[0] ← 7
    return xs[0]
}

fn store(copy Cell c) → int {
    c.n ← 5
    return c.n
}

fn step(copy Cell c) → int {
    c.bump()
    c.bump()
    return c.n
}

main {
    let list<int> a ← [1, 2, 3]
    let Cell k ← Cell {}
    print grow(copy a)
    print rebuild(copy a)
    print poke(copy a)
    print store(copy k)
    print step(copy k)
    print a.length()
    print a[0]
    print k.n
}
