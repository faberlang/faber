# =============================================================================
# mutabilitas — own bind of a class value (MU-3)
# =============================================================================

class Holder {
    mut f64 x = 0.0
}

main {
    let Holder d ← Holder { x = 2.0 }
    let Holder f ← own d
    print f.x
}
