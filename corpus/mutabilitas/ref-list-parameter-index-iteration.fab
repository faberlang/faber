# A borrowed list parameter supports both checked indexing and iteration.

fn inspect(ref list<int> values, int i) → void {
    print values[i]
    for from values let item {
        print item
    }
}

main {
    let list<int> numbers ← [5, 8, 13]
    inspect(ref numbers, 1)
}
