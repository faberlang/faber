# =============================================================================
# mutabilitas — mutating receiver methods need a writable binding
# =============================================================================
# `.put`, `.add` and `.append` rewrite the receiver in place. A `let` binding
# is read-only, so each call below is a SEM020 reject; bind `mut` to mutate.

main {
    let map<string, int> m ← { "a": 1 }
    m.put("b", 2)
    let set<int> s ← empty
    s.add(2)
    let queue<int> q ← empty
    q.append(1)
}
