# =============================================================================
# mutabilitas — own parameter is writable
# =============================================================================
# `own` hands the callee a value it owns, so the callee writes it directly:
# method call, field store, whole reassignment, element store. Parameters take
# no `mut`/`ref`: the marker says everything. Each call passes a fresh value,
# so the caller never reads what it gave away.

class Cell {
    mut int n = 0

    fn bump() → void {
        self.n ← self.n + 1
    }
}

fn grow(own list<int> xs) → int {
    xs.append(9)
    return xs.length()
}

fn rebuild(own list<int> xs) → int {
    xs ← [1, 2]
    return xs.length()
}

fn poke(own list<int> xs) → int {
    xs[0] ← 7
    return xs[0]
}

fn store(own Cell c) → int {
    c.n ← 5
    return c.n
}

fn step(own Cell c) → int {
    c.bump()
    c.bump()
    return c.n
}

main {
    print grow(own [1, 2, 3])
    print rebuild(own [4, 5, 6])
    print poke(own [0, 0])
    print store(own Cell {})
    print step(own Cell {})
}
