# =============================================================================
# mutabilitas — mut into mut param (D-1; a let binding is not a writable place)
# =============================================================================

fn poke(mut list<int> xs) → void {
    xs.append(4)
}

main {
    mut list<int> a ← [1, 2, 3]
    poke(mut a)
    print a.length()
}
