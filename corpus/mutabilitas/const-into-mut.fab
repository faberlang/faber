# =============================================================================
# mutabilitas — const into mut param (D-1)
# =============================================================================

fn poke(mut list<int> xs) → void {
    xs.append(4)
}

main {
    const list<int> a ← [1, 2, 3]
    poke(a)
    print a.length()
}
