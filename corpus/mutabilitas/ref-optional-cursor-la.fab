# =============================================================================
# de-cursor-optionalis — cursor lectissimus, solum legens, super optionalem
# =============================================================================
#
# What this teaches:
#   • `de T ∪ nihil nomen ← locus` (Optio A, decretum 2026-10-15): `de` aut
#     `varia` super optionalem legitur cum socius non-nihil typus referentiae
#     sit (genus, collectio, textus). `de` super numerum — nudum aut
#     optionalem — adhuc recusatur (SEM008 scalar_access_marker).
#   • angustatio — `dum cursus non est nihil` angustat `cursum` ad socium
#     non-nihil intra corpus, ita `cursus.valor` sine `?.` legitur.
#     Angustatio a probatione usque ad primam re-indicationem durat.
#   • re-indicare, numquam scribere — ambulatio solum nomen movet. Scriptio
#     per cursorem recusatur (vide ref-optional-write-reject).
#
# EXPECTED OUTPUT:
#   Valor postremus, deinde longitudo: 3, 3.
#   3
#   3
# =============================================================================

genus Nodus {
    varia numerus valor
    varia Nodus proximus sponte
}

functio ultimus(Nodus caput) → numerus {
    de Nodus ∪ nihil cursus ← caput
    dum cursus non est nihil {
        si cursus.proximus est nihil {
            redde cursus.valor
        }
        cursus ← cursus.proximus
    }
    redde caput.valor
}

functio longitudo(Nodus caput) → numerus {
    de Nodus ∪ nihil cursus ← caput
    varia numerus mensura ← 0
    dum cursus non est nihil {
        mensura ← mensura + 1
        cursus ← cursus.proximus
    }
    redde mensura
}

incipit {
    sit Nodus c ← Nodus { valor = 3 }
    sit Nodus b ← Nodus { valor = 2, proximus = c }
    sit Nodus a ← Nodus { valor = 1, proximus = b }
    nota ultimus(a)
    nota longitudo(a)
}
