# =============================================================================
# mutabilitas — owned parameter forwarded to a mut parameter
# =============================================================================
# `own` and `copy` parameters are values the callee owns, so the callee may
# pass one on to a `mut` parameter and the change is visible in the callee
# afterwards. A `copy` argument is a duplicate; the caller's list is untouched.

fn poke(mut list<int> xs) → void {
    xs.append(4)
}

fn viaown(own list<int> xs) → int {
    poke(mut xs)
    return xs.length()
}

fn viacopy(copy list<int> xs) → int {
    poke(mut xs)
    return xs.length()
}

main {
    let list<int> a ← [1, 2, 3]
    print viaown(own [1, 2, 3])
    print viacopy(copy a)
    print a.length()
}
