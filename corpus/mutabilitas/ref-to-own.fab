# =============================================================================
# mutabilitas — ref into own (MU-2)
# =============================================================================
# This exemplum intentionally fails to compile.

fn take(own list<int> xs) → void {
    print xs.length()
}

main {
    const ref list<int> a ← [1, 2, 3]
    take(a)
}
