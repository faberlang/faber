# =============================================================================
# mutabilitas — unmarked param mutation (D-8)
# =============================================================================
# CPU analog of corpus/cuda/summa-proof.fab:31 (`tf32[1] out` unmarked).

fn poke(list<int> xs) → void {
    xs.append(4)
}

main {
    const list<int> a ← [1, 2, 3]
    poke(a)
    print a.length()
}
