# =============================================================================
# mutabilitas — const shared into var (need, rule 2)
# =============================================================================
# `var list<int> ys ← xs` with `xs` const would let `ys.append(2)` change `xs`.
# Write `← copy xs` for an independent value or `← own xs` to take it over.

main {
    const list<int> xs ← [1]
    var list<int> ys ← xs
    ys.append(2)
    print xs
}
