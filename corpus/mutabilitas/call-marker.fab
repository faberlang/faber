# =============================================================================
# mutabilitas — call-site access markers
# =============================================================================
# A parameter declared `mut`, `own` or `copy` receives an argument that carries
# the same marker at the call. `ref` is optional on a read parameter. A
# method's arguments follow the rule and its receiver carries no marker. A call
# through a function value is checked against the modes in the function type.
# `own` and `copy` accept a fresh value with the matching marker.

fn bump(mut list<int> xs) → void {
    xs.append(1)
}

fn eat(own list<int> xs) → void {
    const list<int> mine ← own xs
    print mine.length()
}

fn dup(copy list<int> xs) → void {
    print xs.length()
}

fn peek(list<int> xs) → void {
    print xs.length()
}

fn make() → list<int> {
    return [7, 8, 9]
}

class Sink {
    fn run(mut list<int> xs) → void {
        xs.append(2)
    }
}

fn apply((mut list<int>) → void f, mut list<int> xs) → void {
    f(mut xs)
}

main {
    var list<int> a ← [1]
    bump(mut a)
    peek(a)
    peek(ref a)
    dup(copy a)
    print a.length()

    const Sink s ← Sink {}
    s.run(mut a)
    print a.length()

    apply(bump, mut a)
    print a.length()

    eat(own make())
    dup(copy make())
    eat(own a)
}
