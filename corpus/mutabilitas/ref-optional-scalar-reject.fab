# =============================================================================
# mutabilitas — no `ref` over an optional scalar
# =============================================================================
# Option A admits `ref`/`mut` over `T ∪ none` only for reference types. A
# scalar behind an optional is still a scalar: a re-pointable read-only
# number is `mut` by another name and is refused with the same SEM008 that
# guards plain scalar refs (see ref-scalar-reject).

fn probe(int ∪ none maybe) → int {
    ref int ∪ none cur ← maybe
    return 5
}

main {
    print probe(null)
}
