# =============================================================================
# mutabilitas — mut vs live ref (MU-4)
# =============================================================================
# This exemplum intentionally fails to compile.

main {
    var list<int> a ← [1, 2, 3]
    const ref list<int> r ← a
    var mut list<int> b ← a
    print r.length()
    print b.length()
}
