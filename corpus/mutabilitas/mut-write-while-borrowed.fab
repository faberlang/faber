# =============================================================================
# mutabilitas — write while borrowed (MU-4)
# =============================================================================
# This exemplum intentionally fails to compile.

main {
    var list<int> a ← [1, 2, 3]
    var mut list<int> b ← a
    a.append(4)
    print b.length()
}
