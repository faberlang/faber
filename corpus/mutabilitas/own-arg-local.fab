# =============================================================================
# mutabilitas — own argument: whole local binding
# =============================================================================

class Box {
    mut list<int> xs
}

fn eat(own list<int> xs) → void {
    print xs.length()
}

fn dup(copy list<int> xs) → void {
    print xs.length()
}

fn make() → list<int> {
    return [7, 8, 9]
}

fn relay(own list<int> p) → void {
    eat(own p)
}

main {
    mut list<int> a ← [1, 2, 3]
    eat(own a)
    a ← [5, 6]
    print a.length()

    eat(own [1])
    eat(own make())
    relay(own make())

    let Box b ← Box { xs = [1, 2, 3, 4] }
    dup(copy b.xs)
    print b.xs.length()

    mut list<int> c ← [1]
    if a.length() ≻ 5 {
        eat(own c)
    } else {
        print c.length()
    }
}
