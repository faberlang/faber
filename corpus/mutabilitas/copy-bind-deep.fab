# =============================================================================
# mutabilitas — deep copy bind (D-6)
# =============================================================================

class Holder {
    f64 x = 0.0
    list<int> marks = []
}

main {
    const Holder a ← Holder { x = 1.0 }
    var copy Holder b ← a
    b.x ← 5.0
    b.marks.append(1)
    print a.x
    print a.marks.length()
    print b.x
    print b.marks.length()
}
