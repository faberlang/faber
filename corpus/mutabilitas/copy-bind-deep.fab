# =============================================================================
# mutabilitas — deep copy bind (D-6)
# =============================================================================
# `copy` says how a binding is INITIALIZED: `mut Holder b ← copy a` duplicates
# `a`. It is not a property of `b` afterwards. A later `b ← c` of a class value
# is always by reference, whatever `b` was first initialized from: after
# `mut Point b ← copy a; b ← c; b.x ← 5`, `c.x` is 5 and `a.x` is untouched.
# Each assignment site shows which one it is: `← copy a` copies, and a plain
# `←` never does. To copy again, write `b ← copy c`. (Pinned by the
# radix-module test `copy_duplicate_test.rs`.)

class Holder {
    mut f64 x = 0.0
    mut list<int> marks = []
}

main {
    let Holder a ← Holder { x = 1.0 }
    mut Holder b ← copy a
    b.x ← 5.0
    b.marks.append(1)
    print a.x
    print a.marks.length()
    print b.x
    print b.marks.length()
}
