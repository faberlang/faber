# =============================================================================
# mutabilitas — const field modifiers are retired
# =============================================================================
# A genus field takes `let` (set only at construction), `mut` (reassignable)
# or `static` (one per type). `const` states a compile-time fact and goes
# with `=`, so it no longer introduces a field.

class Punctum {
    const int x
    mut int y
}

main {
    print "unreachable"
}
