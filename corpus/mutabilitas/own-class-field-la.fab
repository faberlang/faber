# =============================================================================
# mutabilitas — own bind of a class value (MU-3)
# =============================================================================

genus Holder {
    varia f64 x = 0.0
}

incipit {
    sit Holder d ← Holder { x = 2.0 }
    sit Holder f ← penes d
    nota f.x
}
