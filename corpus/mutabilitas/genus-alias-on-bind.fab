# =============================================================================
# mutabilitas — genus alias on bind (D-1, operator ruling 2026-09-24)
# =============================================================================
# Unmarked binds alias for every type: a write through the new name lands in
# the source, whether the source is a local or a field place.

class V3 {
    mut f64 x = 0.0
}

class Inner {
    mut int n = 0
}

class Outer {
    mut Inner inner = Inner {}
}

main {
    mut V3 a ← V3 { x = 1.0 }
    mut V3 b ← a
    b.x ← 5.0
    print a.x
    mut Outer o ← Outer {}
    mut Inner i ← o.inner
    i.n ← 3
    print o.inner.n
}
