# =============================================================================
# mutabilitas — ref into mut (MU-2)
# =============================================================================
# This exemplum intentionally fails to compile.

fn poke(mut list<int> xs) → void {
    xs.append(4)
}

main {
    const ref list<int> a ← [1, 2, 3]
    poke(a)
}
