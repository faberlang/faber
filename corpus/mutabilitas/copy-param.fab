# =============================================================================
# mutabilitas — copy parameter (D-6)
# =============================================================================
# A `copy` parameter receives a deep duplicate at entry; the caller's value is
# untouched. The callee owns the duplicate, and it may change it exactly as far
# as an ordinary binding allows: a field write (`c.n ← 1`) and a mutating
# method call (`c.inc()`) follow one rule. A parameter is an immutable binding
# and has no `mut` spelling, so both are rejected on the parameter itself.
# To modify the duplicate, bind it to a `mut` local first, as `take` and `bump`
# do below.

class Counter {
    mut int n = 0

    fn inc() → void {
        self.n ← self.n + 1
    }
}

fn take(copy list<int> items) → int {
    mut list<int> fresh ← items
    fresh.append(5)
    return fresh.length()
}

fn bump(copy Counter c) → int {
    mut Counter mine ← c
    mine.inc()
    return mine.n
}

main {
    let list<int> a ← [1, 2]
    print take(copy a)
    print a.length()
    mut Counter c ← Counter {}
    c.inc()
    print bump(copy c)
    print c.n
}
