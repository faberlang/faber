# =============================================================================
# mutabilitas — copy parameter (D-6)
# =============================================================================

class Counter {
    var int n = 0

    fn inc() → void {
        self.n ← self.n + 1
    }
}

fn take(copy list<int> items) → int {
    items.append(5)
    return items.length()
}

fn bump(copy Counter c) → int {
    c.inc()
    return c.n
}

main {
    const list<int> a ← [1, 2]
    print take(a)
    print a.length()
    var Counter c ← Counter {}
    c.inc()
    print bump(c)
    print c.n
}
