# =============================================================================
# mutabilitas — overlapping mut arguments (MU-4)
# =============================================================================
# This exemplum intentionally fails to compile.

fn swap(mut list<int> a, mut list<int> b) → void {
    a.append(1)
    b.append(2)
}

main {
    var list<int> xs ← [1, 2, 3]
    swap(xs, xs)
}
