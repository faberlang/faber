# =============================================================================
# mutabilitas — mut genus parameter
# =============================================================================

class Counter {
    mut int n = 0

    fn inc() → void {
        self.n ← self.n + 1
    }
}

fn bump(mut Counter c) → void {
    c.inc()
    c.n ← c.n + 10
}

fn twice(mut Counter c) → void {
    bump(mut c)
    bump(mut c)
}

main {
    mut Counter c ← Counter {}
    bump(mut c)
    twice(mut c)
    print c.n
}
