+++
# =============================================================================
# mutabilitas — ref genus field transitivity (MU-2)
# =============================================================================
# This exemplum intentionally fails to compile.

class Person {
    list<int> friends
}

main {
    const ref Person p ← Person { friends = [1, 2] }
    p.friends.append(3)
}
