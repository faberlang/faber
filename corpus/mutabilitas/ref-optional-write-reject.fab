# =============================================================================
# mutabilitas — no write through an optional `ref` cursor
# =============================================================================
# `ref Node ∪ none cur ← head` re-points freely but is read-only through, with
# or without the optional wrapper. The single diagnostic for the write is
# `assign_through_ref`; the walk that only reads is ref-optional-cursor.

class Node {
    mut int value
    mut Node next optional
}

fn bump(Node head) → void {
    ref Node ∪ none cur ← head
    while cur not is none {
        cur.value ← 99
        cur ← cur.next
    }
}

main {
    let Node b ← Node { value = 2 }
    let Node a ← Node { value = 1, next = b }
    bump(a)
    print a.value
}
