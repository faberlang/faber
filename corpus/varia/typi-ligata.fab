+++

# =============================================================================
# varia — Type-first fixum and varia bindings with explicit types.
# =============================================================================
#
# What this teaches:
#   • Typed declarations — `varia <type> <name>` and `fixum <type> <name>` with explicit type annotations
#   • Mutability — `varia` for mutable bindings, `fixum` for immutable
#
# Common mistakes:
#   • providing a type annotation that doesn't match the assigned expression's type — the compiler checks exact type agreement
#
# See also: varia, fixum, ←
# =============================================================================




# Typed variable declarations (type-first syntax)
#
# varia <type> <nomen> ← <expr>   -- typed mutable
# fixum <type> <nomen> ← <expr>   -- typed immutable
#
# GRAMMAR:
#   bindingStmt :← ('varia' | 'fixum') type ident '←' expr
#
# EXPECTED OUTPUT:
#   Prints initial and updated values for numerus, textus, bivalens, and fractus.

main {
    # --- Typed immutable declarations ---

    let int aetas ← 30
    let string nomen ← "Marcus"
    let bool viget ← true

    print aetas
    print nomen
    print viget

    # --- Typed mutable declarations ---

    mut int numeratio ← 0
    mut string condicio ← "pendens"
    mut bool currit ← false

    print numeratio
    print condicio
    print currit

    # Reassign mutable typed variables (fixum bindings cannot be reassigned)
    numeratio ← 100
    condicio ← "perfectum"
    currit ← true

    print numeratio
    print condicio
    print currit

    # --- Fractional (fractus) typed bindings ---

    let float pi ← 3.14159
    mut float ratio ← 0.05

    print pi
    print ratio

    ratio ← 0.10
    print ratio
}