grammar = ["fab_file", "program", "statement", "statement_core", "block_stmt", "incipit_stmt", "fixum_decl", "type_annotation", "owned_type", "base_type", "qualified_type", "assignment", "place", "expression", "literal", "nota_stmt"]
category = "binding"
canonical = false
summary = "Type-first fixum and varia bindings with explicit types."
syntax = "varia <type> <name> ← <expr> | fixum <type> <name> ← <expr>"
