# =============================================================================
# varia — Declares a mutable binding.
# =============================================================================
#
# What this teaches:
#   • Mutable bindings — `varia` for values that can be reassigned after declaration
#   • Write-once bindings — `sit` for values that cannot be reassigned
#
# Common mistakes:
#   • declaring varia when the binding is never reassigned — use sit instead (WARN013)
#
# See also: fixum, ←, ↑
# =============================================================================




# Mutable and immutable variable declarations
#
# varia <nomen> ← <expr>   -- mutable binding (may reassign)
# sit <nomen> ← <expr>     -- write-once binding (see sit/sit.fab)
#
# GRAMMAR:
#   bindingStmt :← ('varia' | 'sit') type? ident '←' expr
#
# EXPECTED OUTPUT:
#   0, 1, 11, "Salve, Mundus!", 30, "Vale"

main {
    # --- Mutable bindings with varia ---

    mut _ computus ← 0
    print computus

    computus ← 1
    print computus

    computus ← computus + 10
    print computus

    # --- Write-once bindings: sit ---

    let salutatio ← "Salve, Mundus!"
    print salutatio

    # sit infers the type of each local
    let x ← 10
    let y ← 20
    let summa ← x + y
    print summa

    # --- Reassign only varia bindings ---

    mut _ nuntius ← "Salve"
    nuntius ← "Vale"
    print nuntius
}