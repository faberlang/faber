# =============================================================================
# fac omnia — marks the attempt as covering all cases.
# =============================================================================
#
# What this teaches:
#   • `omnia` between `fac` and the block is a surface marker (en `do all`):
#     the construct keeps plain `fac` semantics on every backend
#   • the marker round-trips the formatter — re-emission keeps `fac omnia`
#   • `iace` inside the block still resolves through the `cape` handler
#
# Common mistakes:
#   • expecting `omnia` to change behavior — it never does; recovery works
#     exactly as in plain `fac`
#   • assuming `fac omnia { … } dum cond` is rejected — it is legal and lowers
#     as a plain `fac … dum` loop (see fac-omnia-dum)
#
# See also: fac, cape, omnia
# =============================================================================

# fac omnia — caught iace resolves through the cape handler
#
# GRAMMAR:
#   facStmt :← 'fac' 'omnia'? block cape_clause?
#
# EXPECTED OUTPUT:
#   1 / 0 / planum
#
# BACKEND:
#   Runner+Rust: identical to plain fac.

functio conatus(bivalens malum) → numerus {
    fac omnia {
        si malum {
            iace "casu"
        }
        redde 1
    }
    cape err {
        redde 0
    }
}

incipit {
    nota conatus(falsum)
    nota conatus(verum)
    fac omnia {
        nota "planum"
    }
    cape err {
        nota "interceptum"
    }
}
