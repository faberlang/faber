# =============================================================================
# receptio (AIR lane) — locally-resolved handlers admit as branch dataflow.
# =============================================================================
#
# What this teaches:
#   • a handler whose throw is caught and resolved inside one expression or
#     construct admits on the AIR lane: it lowers to the union/If/Match
#     shape AIR already represents, with no new node kind
#   • the recovery arm must resolve to the outer expression's type — the
#     rule is enforced at the AIR admission path (recovery_type_mismatch)
#   • every arm position in the AR-2 map is admitted: the `si` then arm,
#     each `secus`/`sin` arm, and the whole `fac`/`elige` construct
#   • the inline-recovery conversion (`↦ T ⊥ <fallback>`) is the
#     self-resolved slice: it admits alone and inside a handler region
#
# Common mistakes:
#   • attaching `cape` to a `dum`/`itera` loop and expecting admission —
#     the whole-loop handler stays out under the loop-spectrum ruling
#     (see receptio-decline.fab)
#   • throwing from inside the catch arm — that is a rethrow, Tier 2, and
#     declines with rethrow_in_recovery (see receptio-decline.fab)
#   • a bare conversion (`s ↦ numerus` with no ⊥ fallback) inside a
#     handler region — it keeps the runtime_conversion decline everywhere
#     in v1, even inside an admitted region
#
# See also: cape, si, secus, sin, fac, elige, conversio, receptio-decline
# =============================================================================

# per-arm then — the throwing `si` arm is itself the recovery fork
@ radix lane "air"
functio bracchium(bivalens malum) → numerus {
    si malum { iace "x" } cape err { redde 0 } secus { redde 2 }
}

# per-arm secus — the handler wraps only the `secus` arm
@ radix lane "air"
functio bracchium_secus(bivalens malum) → numerus {
    si malum {
        redde 1
    } secus {
        iace "x"
    } cape err {
        redde 3
    }
}

# per-arm sin — the else-if arm carries its own handler
@ radix lane "air"
functio bracchium_sin(bivalens primus, bivalens secundus) → numerus {
    si primus {
        redde 1
    } sin secundus {
        iace "x"
    } cape err {
        redde 4
    } secus {
        redde 5
    }
}

# whole-construct fac — the guarded throw floats into an If whose taken
# side is the recovery arm
@ radix lane "air"
functio conatus(bivalens malum) → numerus {
    fac {
        si malum { iace "x" }
        redde 1
    } cape err { redde 0 }
}

# whole-construct elige — a throwing casu arm becomes the recovery arm of
# the lowered Match
@ radix lane "air"
functio electio(bivalens malum) → numerus {
    elige malum {
        casu verum { iace "x" }
        ceterum { redde 2 }
    } cape err { redde 0 }
}

# recovery-arm conversion — the inline ⊥ default resolves the conversion
# failure in its own expression
@ radix lane "air"
functio lectio(textus s) → numerus {
    fixum numerus v ← s ↦ numerus ⊥ 0
    redde v
}

# the same self-resolved conversion inside an admitted handler region
@ radix lane "air"
functio lectio_in_regione(textus s, bivalens malum) → numerus {
    fac {
        si malum { iace "x" }
        fixum numerus v ← s ↦ numerus ⊥ 0
        redde v
    } cape err { redde 1 }
}
