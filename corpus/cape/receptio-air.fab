summary = "AIR Tier 0.5 admission rows for locally-resolved handlers: per-arm si/secus/sin cape, whole-construct fac/elige cape, and the inline-recovery conversio slice lower to existing union/If/Match dataflow — no new AIR node."
syntax = "@ radix lane \"air\"; si <cond> { iace } cape <err> { redde <outer value> } secus { … }"
related = ["cape", "si", "secus", "sin", "fac", "elige", "iace", "conversio", "receptio-decline"]
locale = "la"
no_expected = "declaration-only"
