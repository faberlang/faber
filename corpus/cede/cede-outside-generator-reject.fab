# =============================================================================
# cede — yielding outside a generator body is a check error
# =============================================================================
# `cede` (yield) emits one item from a generator callable (`fiunt` or `fient`).
# An ordinary function has no caller consuming a sequence, so the statement is
# refused before any code is emitted.

fn f() → int {
    yield 1
    return 2
}

main {
    print f()
}
