# =============================================================================
# reddet — Await-return
# =============================================================================
#
# What this teaches:
#   • Await and return from a `fiet` function only (`reddet future`).
#
# See also: figendum, tacebit, fiet, redde
# =============================================================================

``
`fab
functio inner() fiet → numerus {
    redde 9
}

functio outer() fiet → numerus {
    reddet inner()
}

incipiet {
    figendum numerus v ← outer()
    nota v
}
`
``
