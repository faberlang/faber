# =============================================================================
# octeti — Octeti literals take hex digits only.
# =============================================================================
#
# What this teaches:
#   • Between the bars only hex digit pairs (and spaces) are legal
#   • `|zz|` rejects with SEM011:octeti_literal_invalid_character, naming the offending character
#
# Common mistakes:
#   • Writing a non-hex character inside `|…|` — digits 0-9 and a-f only
#
# See also: octeti, b8
# =============================================================================

# octeti reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let list<b8> a ← |zz|
    print a
}
