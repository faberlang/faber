# =============================================================================
# list<b8> — a byte buffer: every list method works on it, and a number needs ↦ u8.
# =============================================================================
#
# What this teaches:
#   • Identity — a byte buffer is `list<b8>`: a list of raw bits, not a list of numbers.
#   • Method inheritance — every `lista` method is available on `list<b8>` receivers.
#   • Conversion — `list<u8> ↦ list<b8>` keeps the width, so it takes no clause.
#   • Elements — a `b8` has no arithmetic; `↦ u8` makes it a number, `↦ b8` makes a number raw bits.
#
# Common mistakes:
#   • Assuming `list<b8>` and `list<u8>` are one type — they no longer unify; convert.
#   • Appending a `u8` to a `list<b8>` without `↦ b8`.
#
# See also: lista, bits
# =============================================================================

# list<b8>
#
# WHY: a byte buffer is `list<b8>`. A `b8` is eight raw bits: equality,
# ordering by bit pattern and the bit operations, but no arithmetic and no
# mixing with `u8`. The list is a `list`, so every `list` receiver method
# works on it. A `list<u8>` is a different type: `↦ list<b8>` converts it at
# the same width (no via clause), and an element read becomes a number with
# `↦ u8`.
#
# Cross-ref: octeti/octeti.fab (literal syntax), lista/lista.fab (list methods),
# bits/ (b8), typi/sized-numerus.fab (u8).

fn describe(list<b8> buf) → int {
    return buf.length()
}

fn firstByte(list<b8> buf) → u8 {
    let b8 raw ← buf.get(0) coalesce (0 ∷ b8)
    return raw ↦ u8
}

fn appendByte(mut list<b8> buf, u8 value) → list<b8> {
    buf.append(value ↦ b8)
    return buf
}

fn fromNumbers() → list<b8> {
    # WHY: lista<u8> is a list of numbers; the same-width conversion makes
    # it a byte list with no clause.
    mut list<u8> numbers ← empty
    numbers.append(0xde ∷ u8)
    numbers.append(0xad ∷ u8)
    let list<b8> asBytes ← numbers ↦ list<b8>
    return asBytes
}

main {
    mut list<b8> sig ← |de ad be ef|

    # lista methods on a list<b8> receiver
    let int n ← describe(sig)
    print n

    let u8 first ← firstByte(sig)
    print first

    # a number appended as raw bits
    let u8 marker ← 0xff ∷ u8
    let list<b8> grown ← appendByte(mut sig, marker)
    print grown.length()
    let list<b8> crossed ← fromNumbers()
    print crossed.length()
}
