# =============================================================================
# octeti — octeti is lista<b8>: every lista method works on it, and a number needs ↦ u8.
# =============================================================================
#
# What this teaches:
#   • Identity — `octeti` is `lista<b8>`: a list of raw bits, not a list of numbers.
#   • Method inheritance — every `lista` method is available on `octeti` receivers.
#   • Conversion — `lista<u8> ↦ lista<b8>` keeps the width, so it takes no clause.
#   • Elements — a `b8` has no arithmetic; `↦ u8` makes it a number, `↦ b8` makes a number raw bits.
#
# Common mistakes:
#   • Assuming `octeti` and `lista<u8>` are one type — they no longer unify; convert.
#   • Appending a `u8` to an `octeti` without `↦ b8`.
#
# See also: octeti, lista, bits
# =============================================================================

# octeti — lista<b8>
#
# WHY: `octeti` (en `bytes`) is `lista<b8>`. A `b8` is eight raw bits: equality,
# ordering by bit pattern and the bit operations, but no arithmetic and no
# mixing with `u8`. The list is a `lista`, so every `lista` receiver method
# works on it. A `lista<u8>` is a different type: `↦ lista<b8>` converts it at
# the same width (no via clause), and an element read becomes a number with
# `↦ u8`.
#
# Cross-ref: octeti/octeti.fab (literal syntax), lista/lista.fab (lista methods),
# bits/ (b8), typi/sized-numerus.fab (u8).

fn describe(bytes buf) → int {
    return buf.length()
}

fn firstByte(bytes buf) → u8 {
    const b8 raw ← buf.get(0) coalesce (0 ∷ b8)
    return raw ↦ u8
}

fn appendByte(mut bytes buf, u8 value) → bytes {
    buf.append(value ↦ b8)
    return buf
}

fn fromNumbers() → bytes {
    # WHY: lista<u8> is a list of numbers; the same-width conversion makes
    # it a byte list with no clause.
    var list<u8> numbers ← empty
    numbers.append(0xde ∷ u8)
    numbers.append(0xad ∷ u8)
    const bytes asBytes ← numbers ↦ list<b8>
    return asBytes
}

main {
    var bytes sig ← |de ad be ef|

    # lista methods on an octeti receiver
    const int n ← describe(sig)
    print n

    const u8 first ← firstByte(sig)
    print first

    # a number appended as raw bits
    const u8 marker ← 0xff ∷ u8
    const bytes grown ← appendByte(mut sig, marker)
    print grown.length()
    const bytes crossed ← fromNumbers()
    print crossed.length()
}
