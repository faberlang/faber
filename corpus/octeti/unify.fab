# =============================================================================
# octeti — octeti unifies with lista<u8> — every lista method works on octeti.
# =============================================================================
#
# What this teaches:
#   • Type unification — `octeti` and `lista<u8>` are representation-identical and bidirectionally assignable.
#   • Method inheritance — Because of unification, every `lista` method is available on `octeti` receivers.
#
# Common mistakes:
#   • Forgetting that octeti carries the full lista API surface, not just byte operations.
#
# See also: octeti, lista, numerus
# =============================================================================

# octeti — lista<u8> unification
#
# WHY: `octeti` is semantic sugar for `lista<u8>`. The two are
# representation-identical (Vec<u8>) and bidirectionally assignable, so octeti
# carries every `lista` receiver method and either slot accepts the other.
#
# Cross-ref: octeti/octeti.fab (literal syntax), lista/lista.fab (lista methods),
# typi/sized-numerus.fab (u8). See docs/factory/octeti-unify-lista/.

fn describe(bytes buf) → int {
    return buf.length()
}

fn firstByte(bytes buf) → u8 {
    const u8 b ← buf.get(0) coalesce (0 ∷ u8)
    return b
}

fn appendByte(mut bytes buf, u8 b) → bytes {
    buf.append(b)
    return buf
}

fn fromBytes() → bytes {
    # WHY: lista<numerus<u8>> assigns into octeti bidirectionally.
    var list<u8> bytes ← empty
    bytes.append(0xde ∷ u8)
    bytes.append(0xad ∷ u8)
    const bytes asBytes ← bytes
    return asBytes
}

main {
    var bytes sig ← |de ad be ef|

    # lista methods on an octeti receiver
    const int n ← describe(sig)
    print n

    const u8 first ← firstByte(sig)
    print first

    # construction + cross-assignment
    const u8 marker ← 0xff ∷ u8
    const bytes grown ← appendByte(mut sig, marker)
    print grown.length()
    const bytes crossed ← fromBytes()
    print crossed.length()
}
