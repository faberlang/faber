# =============================================================================
# octeti — octeti unifies with lista<numerus<u8>> — every lista method works on octeti.
# =============================================================================
#
# What this teaches:
#   • Type unification — `octeti` and `lista<numerus<u8>>` are representation-identical and bidirectionally assignable.
#   • Method inheritance — Because of unification, every `lista` method is available on `octeti` receivers.
#
# Common mistakes:
#   • Forgetting that octeti carries the full lista API surface, not just byte operations.
#
# See also: octeti, lista, numerus
# =============================================================================

# octeti — lista<numerus<u8>> unification
#
# WHY: `octeti` is semantic sugar for `lista<numerus<u8>>`. The two are
# representation-identical (Vec<u8>) and bidirectionally assignable, so octeti
# carries every `lista` receiver method and either slot accepts the other.
#
# Cross-ref: octeti/octeti.fab (literal syntax), lista/lista.fab (lista methods),
# typi/sized-numerus.fab (numerus<u8>). See docs/factory/octeti-unify-lista/.

fn describe(bytes buf) → int {
    return buf.length()
}

fn firstByte(bytes buf) → int<u8> {
    const int<u8> b ← buf.get(0) coalesce (0 ∷ int<u8>)
    return b
}

fn appendByte(mut bytes buf, int<u8> b) → bytes {
    buf.append(b)
    return buf
}

fn fromBytes() → bytes {
    # WHY: lista<numerus<u8>> assigns into octeti bidirectionally.
    var list<int<u8>> bytes ← empty
    bytes.append(0xde ∷ int<u8>)
    bytes.append(0xad ∷ int<u8>)
    const bytes asBytes ← bytes
    return asBytes
}

main {
    const bytes sig ← |de ad be ef|

    # lista methods on an octeti receiver
    const int n ← describe(sig)
    print n

    const int<u8> first ← firstByte(sig)
    print first

    # construction + cross-assignment
    const int<u8> marker ← 0xff ∷ int<u8>
    const bytes grown ← appendByte(sig, marker)
    print grown.length()
    const bytes crossed ← fromBytes()
    print crossed.length()
}
