# =============================================================================
# list<b8> — a byte-list literal is not a callable template
# =============================================================================
#
# What this teaches:
#   • Byte-buffer literals are data, not templates — no holes, no application
#   • `|00|(id)` parses as a call on the literal and rejects with
#     SEM011:octeti_literal_template_application
#
# Common mistakes:
#   • Writing `|…|(args)` for string-style templating — use string (scriptum)
#     formatting instead of calling a byte-list literal
#
# See also: list<b8>, scriptum
# =============================================================================

# list<b8> reject case — expected compile failure
#
# This exemplum intentionally fails to compile.

main {
    let _ id ← 1
    let _ bad ← |00|(id)
    print bad
}
