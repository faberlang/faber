# =============================================================================
# radix — an unknown directive is rejected
# =============================================================================
# `@ radix <directive>` accepts `lane`, `backward` and `contract` only.
# Any other directive word is `SEM018:unknown_directive`.

@ radix bogus "x"
fn f() → int {
    return 1
}

main {
    print f()
}
