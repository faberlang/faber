# =============================================================================
# ad — a handler is a top-level function, never a class method
# =============================================================================
# Registering a route with `@ call` requires a top-level function. A method
# belongs to its genus and cannot serve a program route.

class C {
    @ call 'm:a'
    fn g(int n) → int {
        return n
    }
}

main {
    print 1
}
