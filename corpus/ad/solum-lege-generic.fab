# =============================================================================
# solum lege carpe hauri — solum file reads are shape-specific routes.
# =============================================================================
#
# What this teaches:
#   • Shape-specific reads — `charta.read_file<textus>` reads a file as text;
#     `solum:carpe` reads it as a line list; `solum:hauri` reads raw bytes
#   • Manifest-backed surface — each route declares exactly one result shape in
#     the solum provider manifest, so the materialized target always matches
#
# Common mistakes:
#   • assuming one generic `charta.read_file<T>` reads every shape — `lege` is
#     text-only; use `carpe` for `lista<textus>` and `hauri` for `octeti`
#
# See also: ad, solum, lege, carpe, hauri
# =============================================================================

# solum file reads — lege (text) / carpe (lines) / hauri (bytes)
#
# The provider contract (hosts/crates/solum manifest) keeps one result shape
# per route: `solum:lege` → textus, `solum:carpe` → lista<textus>,
# `solum:hauri` → octeti. The `norma:fs` wrappers `carpe`/`hauri` are
# module-private this release, so this fixture reaches the line/byte routes
# directly through the manifest-backed `ad` surface; the compiler's
# `@ radix typus` metadata on `norma:charta.read_file<T>` still admits the broader
# targets, which the provider rejects (recorded residual). Generic
# `charta.read_file<T>` across all three shapes is separate future provider work.
#
# Runtime check: files are prepared under the temp dir, keyed by process id so
# concurrent runs never share a path; each read route can prove its
# accepted result shape independently of the harness working directory.

import from "norma:fs" charta
import from "norma:process" process

main {
    let string textPath ← "§/faber-fs-lege-generic-§.txt"(charta.temp_dir(), process.pid())
    charta.write_file(textPath, "prima\nsecunda\n")
    let string body ← charta.read_file<string>(textPath)
    assert body ≡ "prima\nsecunda\n"
    let list<string> lineae ← call 'solum:carpe' (textPath) ↦ list<string>
    assert lineae ≡ (["prima", "secunda"] ↦ list<string>)
    let list<b8> data ← call 'solum:hauri' (textPath) ↦ list<b8>
    assert data ≡ |70 72 69 6d 61 0a 73 65 63 75 6e 64 61 0a|
    print body
    print lineae
    print data
    print "fs lege carpe hauri parata"
}
