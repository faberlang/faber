# =============================================================================
# ad — `@ ad '<route>'` serves a route from a Faber function.
# =============================================================================
#
# What this teaches:
#   • Serving a route — `@ ad 'salutatio:saluta'` registers `saluta` as the
#     program's handler for that route; no host is needed for it
#   • The caller side is unchanged — `ad 'salutatio:saluta' ("munde")` opens a
#     sermo and `↦ textus` materializes the reply
#   • Plain return — a handler that returns one value answers one item frame,
#     then done
#
# Common mistakes:
#   • giving a handler two parameters — a handler takes zero or one opener;
#     pass a genus to send several values
#
# See also: ad, sermo, conversio
# =============================================================================

@ ad 'salutatio:saluta'
functio saluta(textus nomen) → textus {
    redde "salve, " + nomen
}

incipit {
    sit textus responsum ← ad 'salutatio:saluta' ("munde") ↦ textus
    nota responsum
}
