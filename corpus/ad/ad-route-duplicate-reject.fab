# =============================================================================
# ad — a route is served once per program
# =============================================================================
# `@ call '<route>'` pins a handler to a route. Two handlers claiming the same
# route would answer the same traffic, so the program is refused.

@ call 'm:x'
fn a() → int {
    return 1
}
@ call 'm:x'
fn b() → int {
    return 2
}
main {
    print 1
}
