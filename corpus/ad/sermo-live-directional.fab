# =============================================================================
# meus — live outbound and inbound sermo directional views.
# =============================================================================
#
# What this teaches:
#   • Directional sermo views — `send<T>` (explain term `meus`) for outbound
#     frames, `recv<T>` (`tuus`) for inbound frames on a sermo connection
#   • Cursor iteration — `itera ex t.cursor()` consumes inbound frames
#   • Single reception — `get()` (explain term `accipe`) pulls a single
#     scrinium from the inbound queue
#
# Common mistakes:
#   • confusing `meus` (outbound) and `tuus` (inbound) sermo directional views, or mixing accipe/cursor/exhauri without intentional ordered consumption
#
# See also: ad, sermo, tuus, scrinium, cursor, accipe
# =============================================================================

# Live `send<T>` / `recv<T>` directional views
#
# runtime:echo returns one inbound textus frame per conversation.
# get, cursor, and drain may share one recv queue; mix them only when
# ordered consumption is intentional.

main {
    let channel s ← call 'runtime:echo' ("salve")
    let send<string> m ← s.send<string>()
    m.sink("ping")
    let status outbound ← m.finish()
    let recv<string> t ← s.recv<string>()
    for from t.cursor() let frame {
        assert frame.data ≡ "salve"
    }
    let status inbound ← t.finish()
    let channel s2 ← call 'runtime:echo' ("salve")
    let recv<string> t2 ← s2.recv<string>()
    let frame<string> ∪ none got ← t2.get()
    let status accipe_done ← t2.finish()
    print outbound
    print inbound
    print got?.data
    print accipe_done
}
