# =============================================================================
# channel — the conversation family under the English reader surface.
# =============================================================================
#
# What this teaches:
#   • `channel` is the en spelling of `sermo`, the handle `call` returns
#   • `frame<T>` is the en spelling of `scrinium<T>`, one typed frame
#   • `s.send<T>()` / `s.recv<T>()` are the en spellings of the outbound
#     `meus<T>` and inbound `tuus<T>` views
#
# Common mistakes:
#   • treating the words as reserved: `channel`, `frame`, `send` and `recv`
#     are type names only, and stay ordinary identifiers elsewhere
#
# See also: ad, sermo, scrinium, meus, tuus, cursor
# =============================================================================

fn count_items(channel s) → int {
    mut int n ← 0
    for from s.recv<string>().cursor() let item {
        print item.data
        n ← n + 1
    }
    return n
}

main {
    let channel s ← call 'runtime:echo' ("salve")
    let send<value> outbound ← s.send<value>()
    outbound.da("ping")
    outbound.fini()
    print count_items(s)

    let channel second ← call 'runtime:echo' ("vale")
    let frame<string> ∪ none first ← second.recv<string>().accipe()
    print first?.data
}
