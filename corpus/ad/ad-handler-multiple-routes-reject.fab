# =============================================================================
# ad — a handler serves one route, not two
# =============================================================================
# A function annotated with `@ call` is the handler for exactly one route. A
# second `@ call` on the same function has no single route to answer.

@ call 'm:a'
@ call 'm:b'
fn g(int n) → int {
    return n
}

main {
    print 1
}
