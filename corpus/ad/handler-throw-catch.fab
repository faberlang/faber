# =============================================================================
# call — a handler's alternate exit is thrown into the surrounding do/catch.
# =============================================================================
#
# What this teaches:
#   • A failure raised by a `@ call` handler crosses the call boundary as the
#     thrown text, rather than becoming a successful return value.
#   • The enclosing `do/catch` receives that text; statements after the call
#     are skipped when the handler fails.
#
# See also: ad, call, iace, cape
# =============================================================================

@ call 'm:fail'
fn fail(int n) → int ⇥ string {
    throw "bad §"(n)
}

main {
    do {
        let int b ← call 'm:fail' (4) ↦ int
        print b
    } catch e {
        print "caught §"(e)
    }
}
