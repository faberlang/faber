# =============================================================================
# tuus — typed inbound sermo stream view.
# =============================================================================
#
# What this teaches:
#   • Typed inbound stream — `s.recv<T>()` (la `s.tuus`) creates a typed
#     view over the incoming frames of a sermo connection
#   • Cursor consumption — cursor() yields frames that can be iterated with
#     `itera ex`
#
# Common mistakes:
#   • confusing ad route syntax — accessing the `recv<T>` stream after `finish()` has been called leaves no usable data
#
# See also: ad, sermo, scrinium, cursor
# =============================================================================

# s.recv<T>() — typed inbound frame stream (la s.tuus)

main {
    let channel s ← call 'runtime:echo' ("salve")
    for from s.recv<string>().cursor() let frame {
        assert frame.data ≡ "salve"
    }
}
