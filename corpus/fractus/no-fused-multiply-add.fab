# =============================================================================
# f64 — products round before a surrounding addition or subtraction
# =============================================================================
#
# These factors multiply exactly to 1 - 2^-54. The nearest f64 product is 1,
# so separate multiplication and subtraction return zero. A fused multiply-
# subtract retains the low product bit and instead returns 2^-54.

main {
    let f64 a ← 1.0
    let f64 b ← 1.000000007450580596923828125
    let f64 c ← 0.999999992549419403076171875
    let f64 result ← a - b * c
    print result ¶ ".17e"
}
