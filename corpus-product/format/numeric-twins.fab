+++
locale = "en"
+++
fn bump(int i) → int {
    return i + 1
}

main {
    let float x ← 2.0
    let float chained ← x.added(1.0).multiplied(3.0)
    let float neg ← x.negated()
    mut float acc ← 10.0
    acc.add(5.0)
    mut list<float> xs ← [1.0, 2.0]
    xs[bump(0)].add(5.0)
    print chained
    print neg
    print acc
    print xs[0]
}
