+++
locale = "en"
+++
fn bump(int i) → int {
    return i + 1
}

main {
    const float x ← 2.0
    const float chained ← x.added(1.0).multiplied(3.0)
    const float neg ← x.negated()
    var float acc ← 10.0
    acc.add(5.0)
    var list<float> xs ← [1.0, 2.0]
    xs[bump(0)].add(5.0)
    print chained
    print neg
    print acc
    print xs[0]
}
