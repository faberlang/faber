+++
locale = "en"
+++

# tcp-loopback: both ends of one plaintext TCP connection in a single program.
#
# Routes: caelum:ausculta (listen on port 0), caelum:portus (ephemeral port),
# caelum:necte (connect), caelum:accipe (accept), caelum:funde (write_bytes),
# caelum:hauri (read_bytes), caelum:locus / caelum:remotus (endpoints), and
# caelum:claude (close). The kernel backlog completes connect before accept,
# so one thread is enough: no second process and no fixed port.
#
# Error paths: a connect to a closed listener faults ConnectionRefused, a
# second listen on a live port faults AddrInUse, and listen_tls with absent
# PEM paths faults NotFound.

import from "norma:net" net
import from "norma:net/listener" listener
import from "norma:net/connection" connection
import from "norma:net/endpoint" endpoint

main {
    # caelum:ausculta — listen on an ephemeral kernel-assigned port.
    let listener.Listener server ← net.listen(0)
    assert server.id ≻ 0

    # caelum:portus — the assigned port is live.
    let int port ← server.port()
    assert port ≻ 0

    # caelum:necte — connect completes in the kernel backlog before accept.
    let connection.Socket client ← net.connect("127.0.0.1", port, false)
    assert client.id ≻ 0

    # caelum:locus / caelum:remotus — client-side endpoints.
    let endpoint.Endpoint client_local ← client.local()
    assert client_local.host ≡ "127.0.0.1"
    let endpoint.Endpoint client_remote ← client.remote()
    assert client_remote.host ≡ "127.0.0.1"
    assert client_remote.port ≡ port

    # caelum:accipe — take the queued connection.
    let connection.Socket peer ← server.accept()
    assert peer.id ≻ 0

    # caelum:locus / caelum:remotus — server-side endpoints. The accepted
    # socket's remote address is the client's local address.
    let endpoint.Endpoint peer_local ← peer.local()
    assert peer_local.host ≡ "127.0.0.1"
    assert peer_local.port ≡ port
    let endpoint.Endpoint peer_remote ← peer.remote()
    assert peer_remote.host ≡ "127.0.0.1"
    assert peer_remote.port ≡ client_local.port

    # caelum:funde / caelum:hauri — client writes, server reads it exactly.
    let list<b8> payload ← |68 65 6c 6c 6f|
    client.write_bytes(payload)
    let list<b8> request ← peer.read_bytes(payload.length()) coalesce ||
    assert request ≡ payload

    # The reply path is the mirror image: server writes, client reads.
    let list<b8> reply ← |77 6f 72 6c 64|
    peer.write_bytes(reply)
    let list<b8> response ← client.read_bytes(reply.length()) coalesce ||
    assert response ≡ reply

    # caelum:claude on the client: the peer's next read observes the closed
    # peer as an absent (none) result, not as a zero-length list.
    client.close()
    let list<b8> ∪ none eof ← peer.read_bytes(1)
    assert eof is none

    peer.close()
    server.close()

    # caelum:necte on a released port: open a listener, take its port, close
    # it, then connect. The fault crosses as the ConnectionRefused variant.
    let listener.Listener closed_server ← net.listen(0)
    let int closed_port ← closed_server.port()
    assert closed_port ≻ 0
    closed_server.close()
    mut bool refused ← false
    do {
        net.connect("127.0.0.1", closed_port, false)
        assert false panic "connect to a closed listener succeeded"
    }
    catch err {
        match err {
            case ConnectionRefused const path {
                assert path.length() ≻ 0
                refused ← true
            }
            default {
                assert false panic "connect fault was not ConnectionRefused"
            }
        }
    }
    assert refused

    # caelum:ausculta on a live port: a second listen on the port held by A
    # faults AddrInUse; A stays open until the fault is observed.
    let listener.Listener holder ← net.listen(0)
    let int holder_port ← holder.port()
    assert holder_port ≻ 0
    mut bool in_use ← false
    do {
        net.listen(holder_port)
        assert false panic "second listen on a live port succeeded"
    }
    catch err {
        match err {
            case AddrInUse const path {
                assert path.length() ≻ 0
                in_use ← true
            }
            default {
                assert false panic "second listen fault was not AddrInUse"
            }
        }
    }
    assert in_use
    holder.close()

    # caelum:ausculta with TLS: absent PEM paths fault NotFound before any
    # handshake. The TLS success path (live listener plus handshake) is proved
    # by the package-manager program: a real handshake needs
    # PEM material from lib/norma/proof/integration/gen-test-certs at run time.
    mut bool tls_faulted ← false
    do {
        net.listen_tls(0, "/nonexistent/cert.pem", "/nonexistent/key.pem")
        assert false panic "listen_tls with absent PEM files succeeded"
    }
    catch err {
        match err {
            case NotFound const path {
                assert path.length() ≻ 0
                tls_faulted ← true
            }
            case InvalidArgument const path {
                assert path.length() ≻ 0
                tls_faulted ← true
            }
            default {
                assert false panic "listen_tls fault was neither NotFound nor InvalidArgument"
            }
        }
    }
    assert tls_faulted

    print "tcp-loopback-ok"
}
