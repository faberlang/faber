+++
locale = "en"
+++

# TCP loopback async coverage: both ends live in this one program on an
# ephemeral 127.0.0.1 port, so no second process and no stale port file.
#
# Covers caelum:auscultabit (net.listen_async), caelum:nectet
# (net.connect_async), caelum:accipiet (listener.accept_async), caelum:fundet
# (socket.write_bytes_async), and caelum:hauriet (socket.read_bytes_async).
# Kept separate from the sync loopback package so a pinned async failure
# cannot hide sync coverage.

import from "norma:net" net
import from "norma:net/listener" listener
import from "norma:net/connection" connection

async_main {
    await_const listener.Listener server_listener ← net.listen_async(0)
    let int port ← server_listener.port()
    assert port ≻ 0

    await_const connection.Socket client ← net.connect_async("127.0.0.1", port, false)
    await_const connection.Socket server ← server_listener.accept_async()

    let list<b8> payload ← |74 63 70 2d 61 73 79 6e 63|
    await_const void _ ← client.write_bytes_async(payload)

    await_const list<b8> ∪ none maybe ← server.read_bytes_async(payload.length())
    let list<b8> got ← maybe coalesce ||
    assert got ≡ payload

    client.close()
    server.close()
    server_listener.close()

    print "tcp-loopback-async-ok"
}
