+++
locale = "en"
+++

# N3 stdio leaf async routes through the Norma console wrappers.
#
# Covers consolum:scribet (write_line_async), consolum:dicet
# (write_partial_async), consolum:monet (warn_line_async), consolum:videbit
# (debug_line_async), consolum:leget (read_line_async), and consolum:hauriet
# (read_bytes_async). stdout and stderr are exact goldens; stdin is
# `one\ntwo\n` so the line read and the byte read see distinct data.

import from "norma:console" console

main {
    console.write_line_async("async-line")
    console.write_partial_async("async-")
    console.write_line_async("partial")
    console.warn_line_async("async-warn")
    console.debug_line_async("async-debug")

    let string ∪ none line ← console.read_line_async()
    assert line not is none
    let string text ↤ line
    assert text ≡ "one"

    let list<b8> chunk ← console.read_bytes_async(3) coalesce ||
    assert chunk.length() ≥ 1
    assert (chunk.get(0) coalesce (0 ∷ b8)) ≡ 0x74

    console.write_line_async("stdio-async-ok")
}
