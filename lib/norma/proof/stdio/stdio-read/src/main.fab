+++
locale = "en"
+++

# N3 stdio leaf sync routes through the Norma console wrappers.
#
# Covers consolum:lege (read_line) and consolum:hauri (read_bytes). stdout is
# an exact golden; stdin is `alpha\nbeta\ngamma\n` so the two line reads and
# the byte read see distinct data. hauri does ONE read of at most n bytes, so
# only the first byte is pinned.

import from "norma:console" console

main {
    const string ∪ none a ← console.read_line()
    assert a not is none
    const string first ↤ a
    assert first ≡ "alpha"

    const string ∪ none b ← console.read_line()
    assert b not is none
    const string second ↤ b
    assert second ≡ "beta"

    const list<b8> chunk ← console.read_bytes(3) coalesce ||
    assert chunk.length() ≥ 1
    assert (chunk.get(0) coalesce (0 ∷ b8)) ≡ 0x67

    # End-of-input behaviour. The byte read above took only "gam", so stdin
    # still holds the rest of `gamma\n`. Drain it line by line: reassign
    # `rest` while the read yields a value that is not none and not empty.
    var string ∪ none rest ← console.read_line()
    while rest not is none and rest!.length() ≻ 0 {
        rest ← console.read_line()
    }

    # OBSERVED: consolum:lege returns an EMPTY STRING (not none) at end of
    # input — crates/faber-leaf/src/stdio.rs read_line maps `Ok(0)` to
    # `Str(String::new())` — so the loop exits with rest ≡ "".
    assert rest not is none
    assert (rest coalesce "") ≡ ""

    # Past the drained input, end of input holds: one more byte read hits
    # EOF. Both an empty and a none reply coalesce to the empty list, so the
    # length is zero either way.
    const list<b8> tail ← console.read_bytes(4) coalesce ||
    assert tail.length() ≡ 0

    console.write_line("stdio-read-ok")
}
