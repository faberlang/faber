+++
locale = "en"
+++

# N3 stdio leaf sync routes through the Norma console wrappers.
#
# Covers consolum:lege (read_line) and consolum:hauri (read_bytes). stdout is
# an exact golden; stdin is `alpha\nbeta\ngamma\n\n` so the two line reads and
# the byte read see distinct data. hauri does ONE read of at most n bytes, so
# only the first byte is pinned. End of input is none for both read_line and
# read_bytes; the trailing blank line stays a present empty string.

import from "norma:console" console

main {
    let string ∪ none a ← console.read_line()
    assert a not is none
    let string first ↤ a
    assert first ≡ "alpha"

    let string ∪ none b ← console.read_line()
    assert b not is none
    let string second ↤ b
    assert second ≡ "beta"

    let list<b8> chunk ← console.read_bytes(3) coalesce ||
    assert chunk.length() ≥ 1
    assert (chunk.get(0) coalesce (0 ∷ b8)) ≡ 0x67

    # End-of-input behaviour. The byte read above took only "gam", so stdin
    # still holds `ma\n\n`: the rest of the gamma line, then one blank line.
    const string ∪ none rest ← console.read_line()
    assert rest not is none
    const string rest_text ↤ rest
    assert rest_text ≡ "ma"

    # A blank line is a present empty string, not end of input.
    const string ∪ none blank ← console.read_line()
    assert blank not is none
    const string blank_text ↤ blank
    assert blank_text ≡ ""

    # Only past the last byte does a line read report none, and a byte read
    # at end of input is none as well (not an empty list).
    const string ∪ none eof ← console.read_line()
    assert eof is none

    const list<b8> ∪ none tail ← console.read_bytes(4)
    assert tail is none

    console.write_line("stdio-read-ok")
}
