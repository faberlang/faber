+++
locale = "en"
+++

# websocket-loopback: both ends of one WebSocket upgrade and echo exchange in
# one program on an ephemeral 127.0.0.1 port. The client handshake is split
# (connect_open writes the upgrade request, connect_finish reads the 101), so
# one thread is enough: the server side runs between the two halves and every
# step's peer bytes are already in the kernel buffers, the same backlog the
# tcp-loopback proof relies on. No async task, no second process, no fixed
# port.

import from "norma:http/server" server
import from "norma:websocket" websocket

main {
    let server.Listener listener ← server.bind(0)
    let int port ← listener.port()
    assert port ≻ 0

    # Client half one: TCP connect plus the upgrade request, no read yet.
    const websocket.Socket client ← websocket.connect_open("ws://127.0.0.1:§/chat"(port))

    # Server half: the request bytes are buffered, so accept completes and
    # websocket.accept writes the 101.
    const server.Incoming incoming ← listener.accept()
    let string path ← incoming.req.path
    const websocket.Socket sock ← websocket.accept(incoming.id)
    websocket.connect_finish(client)

    # Echo exchange, strictly alternating so neither side waits on the other.
    client.send("ping")
    let string got ← sock.receive() coalesce "nil"
    sock.send("pong")
    const string ∪ none reply ← client.receive()
    let string pong ← reply coalesce "nil"
    assert pong ≡ "pong"
    client.close()

    # The peer close is a clean end: the next receive is none ("nil").
    let string tail ← sock.receive() coalesce "nil"
    sock.close()

    assert path ≡ "/chat"
    assert got ≡ "ping"
    assert tail ≡ "nil"

    listener.stop()
    print "websocket-loopback-ok"
}
