+++
locale = "en"
+++

# Same assertions as leaves-roundtrip/src/main.proba, as a generated Rust binary.

import from "norma:process" process
import from "norma:time" time
import from "norma:random" random

main {
    time.sleep(0)
    const int before ← time.monotonic()
    const int after ← time.monotonic()
    assert after ≥ before
    random.seed(7)
    const int first ← random.random_int(1, 9)
    random.seed(7)
    assert random.random_int(1, 9) ≡ first
    assert process.exec("printf proba-ok") ≡ "proba-ok"
    print "proba-ok"
}
