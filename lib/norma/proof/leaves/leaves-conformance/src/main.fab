+++
locale = "en"
+++

# Same core leaf routes as the runner/Go combined conformance package.

main {
    let void _ ← call 'tempus:dormiet' (0) ↦ void
    let int before ← call 'tempus:monotonicum' ↦ int
    let int after ← call 'tempus:monotonicum' ↦ int
    assert after ≥ before

    let void _ ← call 'aleator:semina' (7) ↦ void
    let int first ← call 'aleator:sortire' ([1, 9]) ↦ int
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int replay ← call 'aleator:sortire' ([1, 9]) ↦ int
    assert replay ≡ first
    let void _ ← call 'aleator:octetos' (16) ↦ void

    let int pid ← call 'processus:identitas' ↦ int
    assert pid ≻ 0
    let string output ← call 'processus:exsequi' ("printf proba-ok") ↦ string
    assert output ≡ "proba-ok"
    print "proba-ok"
}
