+++
locale = "en"
+++

# The route set exercised here spans process, clock and entropy on runner and
# Go; Go leaf tests pin OS bytes, UUID shape, process faults and exit status.

main {
    let void _ ← call 'tempus:dormiet' (0) ↦ void
    let int before ← call 'tempus:monotonicum' ↦ int
    let int after ← call 'tempus:monotonicum' ↦ int
    assert after ≥ before

    let void _ ← call 'aleator:semina' (7) ↦ void
    let int first ← call 'aleator:sortire' ([1, 9]) ↦ int
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int second ← call 'aleator:sortire' ([1, 9]) ↦ int
    assert first ≡ second
    let string id ← call 'aleator:uuid' ↦ string
    assert id.length() ≡ 36

    let int pid ← call 'processus:identitas' ↦ int
    assert pid ≻ 0
    let string cwd ← call 'processus:sedes' ↦ string
    assert cwd.length() ≻ 0
    let string output ← call 'processus:exsequi' ("printf leaves-ok") ↦ string
    assert output ≡ "leaves-ok"
    print "leaves-ok"
}
