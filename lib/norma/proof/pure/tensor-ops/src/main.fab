+++
locale = "en"
+++

# Pure-module proof for norma:tensor. The tensors are built with the language's
# own conversion, then each wrapper is called with inferred type arguments.
# `construct` takes its shape from the annotation of the store it feeds, with
# the element type inferred or written (`construct<int>`). Where no annotation
# supplies the shape (an argument position), an explicit call writes the whole
# shape behind the `size` marker (`construct<int, size [4]>`, or shape-only
# `construct<size [2, 2]>`).
# Output must match under `faber run` and a `faber build` Rust binary.

import from "norma:tensor" tensor

main {
    let tensor<int, [2, 2]> grid ← [[1, 2], [3, 4]] ↦ tensor<int, [2, 2]>
    let list<int> back ← tensor.flatten(grid)
    print back
    let tensor<int, [2, 2]> scaled ← tensor.apply(grid, int x ∴ x + 1)
    let list<int> bumped ← tensor.flatten(scaled)
    print bumped
    print tensor.sum(scaled)
    print tensor.product([2, 3, 4])

    let tensor<f32, [4]> wide ← [0.5, 1.5, 2.0, 4.0] ↦ tensor<f32, [4]>
    print tensor.sum_f32(wide)

    let list<int> cells ← [5, 6, 7, 8]
    let tensor<int, [2, 2]> built ← tensor.construct(cells)
    print tensor.flatten(built)
    let tensor<int, [4]> row ← tensor.construct<int>(cells)
    print tensor.sum(row)

    let tensor<int, [4]> sized ← tensor.construct<int, size [4]>(cells)
    print tensor.sum(sized)
    let tensor<int, [2, 2]> shaped ← tensor.construct<size [2, 2]>(cells)
    print tensor.flatten(shaped)
    print tensor.sum(tensor.construct<int, size [4]>(cells))
}
