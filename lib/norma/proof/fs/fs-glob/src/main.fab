+++
locale = "en"
+++

# fs leaf glob route: the shallow glob contract. The pattern is split on "/",
# a "*" segment lists its directory and joins every entry (the star matches
# exactly one segment), a literal segment is appended only when that path
# exists, and every hit is an absolute path joined onto the root.
import from "norma:fs" fs
import from "norma:process" process

main {
    let string root ← fs.join([fs.temp_dir(), "norma-fs-glob-§"(process.pid())])
    fs.create_dir(root)

    let string alpha ← fs.join([root, "alpha"])
    let string beta ← fs.join([root, "beta"])
    fs.create_dir(alpha)
    fs.create_dir(beta)

    fs.write_file(fs.join([alpha, "SKILL.md"]), "a")
    fs.write_file(fs.join([beta, "SKILL.md"]), "b")
    fs.write_file(fs.join([beta, "README.md"]), "r")

    let list<string> hits ← fs.glob(root, "*/SKILL.md")
    assert hits.length() ≡ 2
    assert hits.contains(fs.join([alpha, "SKILL.md"]))
    assert hits.contains(fs.join([beta, "SKILL.md"]))

    let list<string> misses ← fs.glob(root, "*/missing.md")
    assert misses.length() ≡ 0

    assert fs.glob(root, "*").length() ≡ 2

    fs.remove_tree(root)
    print "norma/fs/fs-glob ok"
}
