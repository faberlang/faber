+++
locale = "en"
+++

# fs leaf tree routes: create_dir, touch, copy, rename, set_mode, list_dir,
# delete, and remove_tree on a populated directory.
import from "norma:fs" fs
import from "norma:process" process

main {
    let string root ← fs.join([fs.temp_dir(), "fs-tree-§"(process.pid())])
    fs.create_dir(root)
    assert fs.exists(root)
    assert fs.is_directory(root)

    let string alpha ← fs.join([root, "alpha.txt"])
    fs.touch(alpha)
    assert fs.is_regular(alpha)

    let string beta ← fs.join([root, "beta.txt"])
    fs.copy(alpha, beta)
    assert fs.exists(beta)
    assert fs.is_regular(beta)

    let string gamma ← fs.join([root, "gamma.txt"])
    fs.rename(beta, gamma)
    assert fs.exists(gamma)
    assert fs.exists(beta) ≢ true

    fs.set_mode(gamma, 0o600)
    assert fs.mode(gamma) ≡ 0o600

    let list<string> entries ← fs.list_dir(root)
    let list<string> names ← entries.sorted()
    assert names.length() ≡ 2
    assert names.contains("alpha.txt")
    assert names.contains("gamma.txt")

    fs.delete(gamma)
    assert fs.exists(gamma) ≢ true

    fs.remove_tree(root)
    assert fs.exists(root) ≢ true

    print "fs-tree-ok"
}
