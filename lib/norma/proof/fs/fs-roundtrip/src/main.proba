+++
locale = "en"
+++

# Fs leaf conformance: the same Norma wrappers the acceptance program uses.
import from "norma:fs" fs

fn write_then_read(string path, string payload) → string {
    fs.write_file(path, payload)
    return fs.read_file<string>(path)
}

describe "fs leaf" {
    test "write_file then read_file returns the payload" {
        let string dir ← fs.temp_dir()
        let string path ← fs.join([dir, "core-norma-fs-proba.txt"])
        assert write_then_read(path, "proba-ok") ≡ "proba-ok"
        assert fs.exists(path)
        fs.delete(path)
    }
}
