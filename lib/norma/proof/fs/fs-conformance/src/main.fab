+++
locale = "en"
+++

# Same assertions as fs-roundtrip/src/main.proba, as a generated Rust binary.
import from "norma:fs" fs

main {
    let string dir ← fs.temp_dir()
    let string path ← fs.join([dir, "core-norma-fs-proba.txt"])
    fs.write_file(path, "proba-ok")
    assert fs.read_file<string>(path) ≡ "proba-ok"
    assert fs.exists(path)
    fs.delete(path)
    print "proba-ok"
}
