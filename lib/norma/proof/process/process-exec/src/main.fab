+++
locale = "en"
+++

# Execute both process exec routes, capture's success and non-zero status
# paths. The Go leaf tests pin captured bytes and exit-code records directly.

main {
    let string output ← call 'processus:exsequi' ("printf proof-ok") ↦ string
    assert output ≡ "proof-ok"
    let string second ← call 'processus:exsequetur' ("printf proof-ok") ↦ string
    assert second ≡ "proof-ok"

    let void _ ← call 'processus:captura' (["sh", "-c", "printf out; echo err-bytes 1>&2; exit 7"]) ↦ void
    let void _ ← call 'processus:captura' (["printf", "proof-ok"]) ↦ void
    print "process-exec-ok"
}
