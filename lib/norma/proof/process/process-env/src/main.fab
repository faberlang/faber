+++
locale = "en"
+++

# Environment, current directory, pid, argv and chdir routes are all opened
# through the Go/runner leaf bridge. Detailed record and path assertions live
# in the runtime leaf tests.

main {
    let int pid ← call 'processus:identitas' ↦ int
    let void _ ← call 'processus:argumenta' ↦ void
    let void _ ← call 'processus:lege' ("PATH") ↦ void
    let void _ ← call 'processus:sedes' ↦ void
    let void _ ← call 'processus:muta' (".") ↦ void
    assert pid ≻ 0
    print "process-env-ok"
}
