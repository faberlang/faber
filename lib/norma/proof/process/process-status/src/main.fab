+++
locale = "en"
+++

# Capture preserves stdout, stderr and nonzero status as route data. The Go
# route tests assert those bytes and status, including EOF after child exit.

main {
    let void _ ← call 'processus:captura' (["sh", "-c", "exit 7"]) ↦ void
    let void _ ← call 'processus:captura' (["sh", "-c", "printf out; echo err-bytes 1>&2"]) ↦ void
    print "process-status-ok"
}
