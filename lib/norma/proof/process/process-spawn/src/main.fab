+++
locale = "en"
+++

# Process leaf lifecycle: spawn+wait, kill+wait, detach.
# Output must match under `faber run` and a `faber build` Rust binary.

import from "norma:process" process

main {
    let process.Subprocess exited ← process.spawn(["sh", "-c", "exit 3"])
    assert process.wait(exited) ≡ 3

    let process.Subprocess sleeper ← process.spawn(["sleep", "30"])
    process.kill(sleeper)
    assert process.wait(sleeper) ≢ 0

    let int dismissed ← process.detach(["sleep", "0"])
    assert dismissed ≻ 0

    print "process-spawn-ok"
}
