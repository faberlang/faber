+++
locale = "en"
+++

# Spawn/wait, kill/wait, and detach through native processus routes.

main {
    let int exited ← call 'processus:genera' (["sh", "-c", "exit 3"]) ↦ int
    let int exitStatus ← call 'processus:exspecta' (exited) ↦ int
    assert exitStatus ≡ 3

    let int sleeper ← call 'processus:genera' (["sleep", "30"]) ↦ int
    let void _ ← call 'processus:neca' (sleeper) ↦ void
    let int killed ← call 'processus:exspecta' (sleeper) ↦ int
    assert killed ≢ 0

    let int dismissed ← call 'processus:dimitte' (["sleep", "0"]) ↦ int
    assert dismissed ≻ 0
    print "process-spawn-ok"
}
