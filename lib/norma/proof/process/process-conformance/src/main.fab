+++
locale = "en"
+++

# N3 process leaf: pid, cwd, exec. Output must match under `faber run`
# and a `faber build` Rust binary.

import from "norma:process" process

main {
    assert process.pid() ≻ 0
    assert process.cwd().length() ≻ 0
    assert process.exec("printf process-ok") ≡ "process-ok"
    print "process-ok"
}
