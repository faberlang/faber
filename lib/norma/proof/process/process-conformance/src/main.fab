+++
locale = "en"
+++

# Direct processus route conformance for generated and runner targets.

main {
    let int pid ← call 'processus:identitas' ↦ int
    assert pid ≻ 0
    let string cwd ← call 'processus:sedes' ↦ string
    assert cwd.length() ≻ 0
    let string output ← call 'processus:exsequi' ("printf process-ok") ↦ string
    assert output ≡ "process-ok"
    print "process-ok"
}
