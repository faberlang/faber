+++
locale = "en"
+++

# NA2: HTTPS JSON, SSE, WebSocket echo, and /stop. Serve and client
# are separate processes because leaves are blocking.
# Generate ca.pem / cert.pem / key.pem in this directory first:
# ../gen-test-certs .

import from "norma:fs" fs
import from "norma:process" process
import from "norma:time" time
import from "norma:http/server" server
import from "norma:http/client" client
import from "norma:http/headers" headers
import from "norma:http/response" response
import from "norma:http/sse" sse
import from "norma:websocket" websocket

fn port_path() → string {
    return fs.join([fs.temp_dir(), "na2-port"])
}

fn is_serve() → bool {
    let list<string> args ← process.argv()
    if args.length() ≡ 0 then return false
    return (args.get(0) coalesce "") ≡ "serve"
}

fn trusted_client() → client.Client {
    let int agent ↤ call 'http:agent' ([60000 ↦ value, "ca.pem" ↦ value])
    return client.Client { agent = agent }
}

fn run_serve() → void {
    let server.Listener listener ← server.bind_tls(0, "cert.pem", "key.pem")
    let int port ← listener.port()
    assert port ≻ 0
    fs.write_file(port_path(), port ↦ string)
    mut bool running ← true
    while running {
        let server.Incoming incoming ← listener.accept()
        let string path ← incoming.req.path
        if path ≡ "/json" {
            server.reply(incoming, 200, headers.empty(), incoming.req.body)
        }
        elif path ≡ "/sse" {
            server.reply(incoming, 200, headers.empty(), "event: ping\ndata: one\n\nevent: ping\ndata: two\n\n")
        }
        elif path ≡ "/ws" {
            let websocket.Socket sock ← websocket.accept(incoming.id)
            let string msg ← sock.receive()
            sock.send(msg)
            sock.close()
        }
        elif path ≡ "/stop" {
            server.reply(incoming, 200, headers.empty(), "stopped")
            running ← false
        }
        else {
            server.reply(incoming, 404, headers.empty(), "missing")
        }
    }
    listener.stop()
}

fn wait_port() → string {
    let string path ← port_path()
    mut int spins ← 0
    while not fs.exists(path) {
        time.sleep(50)
        spins ← spins + 1
        if spins ≻ 200 {
            panic "na2: port file missing"
        }
    }
    return fs.read_file<string>(path)
}

fn run_client() → void {
    let string port ← wait_port()
    let client.Client session ← trusted_client()
    let string json_url ← "https://127.0.0.1:§/json"(port)
    let response.Response posted ← client.post_on(session, json_url, "{\"ok\":true}")
    assert posted.status ≡ 200
    assert posted.body.length() ≻ 0

    let string sse_url ← "https://127.0.0.1:§/sse"(port)
    let response.Response streamed ← client.get_on(session, sse_url)
    assert streamed.status ≡ 200
    mut list<sse.Event> events ← []
    do {
        events ← sse.parse(streamed.body)
    }
    catch err {
        panic "na2: sse.parse: §"(err)
    }
    assert events.length() ≥ 2
    mut int seen ← 0
    for from events const event {
        if event.data ≡ "one" or event.data ≡ "two" {
            seen ← seen + 1
        }
    }
    assert seen ≥ 2

    let string ws_url ← "wss://127.0.0.1:§/ws"(port)
    let websocket.Socket sock ← websocket.connect_tls(ws_url, "ca.pem")
    sock.send("echo-me")
    let string echoed ← sock.receive()
    assert echoed ≡ "echo-me"
    sock.close()

    let string stop_url ← "https://127.0.0.1:§/stop"(port)
    let response.Response stopped ← client.get_on(session, stop_url)
    assert stopped.status ≡ 200
    print "na2-ok"
}

main {
    if is_serve() {
        run_serve()
    }
    else {
        run_client()
    }
}
