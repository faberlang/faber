+++
locale = "en"
+++

# NA1: CSV → JSON → HTTPS POST → file. Serve and client are separate
# processes because leaves are blocking (one-thread accept vs POST).
# Generate ca.pem / cert.pem / key.pem in this directory first:
# ../gen-test-certs .

import from "norma:csv" csv
import from "norma:json" json
import from "norma:fs" fs
import from "norma:process" process
import from "norma:time" time
import from "norma:http/server" server
import from "norma:http/client" client
import from "norma:http/headers" headers
import from "norma:http/response" response

fn port_path() → string {
    return fs.join([fs.temp_dir(), "na1-port"])
}

fn is_serve() → bool {
    let list<string> args ← process.argv()
    if args.length() ≡ 0 then return false
    return (args.get(0) coalesce "") ≡ "serve"
}

fn run_serve() → void {
    let server.Listener listener ← server.bind_tls(0, "cert.pem", "key.pem")
    let int port ← listener.port()
    assert port ≻ 0
    fs.write_file(port_path(), port ↦ string)
    let server.Incoming incoming ← listener.accept()
    assert incoming.req.method ≡ "POST"
    server.reply(incoming, 200, headers.empty(), incoming.req.body)
    listener.stop()
}

fn wait_port() → string {
    let string path ← port_path()
    mut int spins ← 0
    while not fs.exists(path) {
        time.sleep(50)
        spins ← spins + 1
        if spins ≻ 200 {
            panic "na1: port file missing"
        }
    }
    return fs.read_file<string>(path)
}

fn run_client() → void {
    let string csv_text ← "name,age\nalice,30"
    let string csv_path ← fs.join([fs.temp_dir(), "na1-input.csv"])
    fs.write_file(csv_path, csv_text)
    let string loaded ← fs.read_file<string>(csv_path)
    let list<list<string>> rows ← csv.parse(loaded)
    mut string name ← ""
    mut string age ← ""
    mut int i ← 0
    for from rows let row {
        if i ≡ 1 {
            name ← row.get(0) coalesce ""
            age ← row.get(1) coalesce ""
        }
        i ← i + 1
    }
    assert name ≡ "alice"
    assert age ≡ "30"
    let string payload ← "{\"name\":\"alice\",\"age\":\"30\"}"
    let json ∪ none parsed ← json.try_parse(payload)
    assert parsed not is none
    let json doc ↤ parsed
    let string wire ← json.stringify(doc)
    let string port ← wait_port()
    let string url ← "https://127.0.0.1:§/json"(port)
    let int agent ↤ call 'http:agent' ([60000 ↦ value, "ca.pem" ↦ value])
    let client.Client session ← client.Client { agent = agent }
    let response.Response reply ← client.post_on(session, url, wire)
    assert reply.status ≡ 200
    let string out_path ← fs.join([fs.temp_dir(), "na1-response.json"])
    fs.write_file(out_path, reply.body)
    let string saved ← fs.read_file<string>(out_path)
    assert saved.length() ≻ 0
    print "na1-ok"
}

main {
    if is_serve() {
        run_serve()
    }
    else {
        run_client()
    }
}
