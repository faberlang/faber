+++
locale = "en"
+++

# Route-level entropy conformance, including OS-byte and UUID lanes.

main {
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int first ← call 'aleator:sortire' ([1, 9]) ↦ int
    let int second ← call 'aleator:sortire' ([1, 9]) ↦ int
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int replayFirst ← call 'aleator:sortire' ([1, 9]) ↦ int
    let int replaySecond ← call 'aleator:sortire' ([1, 9]) ↦ int
    assert first ≡ replayFirst
    assert second ≡ replaySecond

    let void _ ← call 'aleator:fractum' ↦ void
    let void _ ← call 'aleator:octetos' (16) ↦ void
    let void _ ← call 'aleator:octetos' (0) ↦ void
    let string id ← call 'aleator:uuid' ↦ string
    assert id.length() ≡ 36

    print "norma/entropy/entropy-routes ok"
}
