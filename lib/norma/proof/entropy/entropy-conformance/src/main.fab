+++
locale = "en"
+++

# Seed, integer, UUID and OS-byte routes execute through the native leaf seam.

main {
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int first ← call 'aleator:sortire' ([1, 9]) ↦ int
    let void _ ← call 'aleator:semina' (7) ↦ void
    let int second ← call 'aleator:sortire' ([1, 9]) ↦ int
    assert first ≡ second
    let void _ ← call 'aleator:octetos' (16) ↦ void
    let string id ← call 'aleator:uuid' ↦ string
    assert id.length() ≡ 36
    print "entropy-ok"
}
