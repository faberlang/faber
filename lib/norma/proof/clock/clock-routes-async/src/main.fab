+++
locale = "en"
+++

# Async posture of the clock leaf route tempus:dormiet through the Norma
# wrapper time.sleep_async. Kept in its own package so a pinned async failure
# cannot hide the sync coverage in clock-routes.

import from "norma:time" time

async_main {
    let int before ← time.monotonic()
    await time.sleep_async(5)
    let int after ← time.monotonic()
    assert after - before ≥ 4000000

    print "norma/clock/clock-routes-async ok"
}
