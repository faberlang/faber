+++
locale = "en"
+++

# Direct route conformance for tempus:*; each value-bearing route is opened
# through the same leaf boundary used by generated Go programs.

main {
    let int earlier ← call 'tempus:nunc' ↦ int
    let int later ← call 'tempus:nunc' ↦ int
    assert later ≥ earlier

    let int first ← call 'tempus:monotonicum' ↦ int
    let int second ← call 'tempus:monotonicum' ↦ int
    assert second ≥ first

    let int cpu ← call 'tempus:activum' ↦ int
    assert cpu ≥ 0

    let void _ ← call 'tempus:dormiet' (5) ↦ void
    print "norma/clock/clock-routes ok"
}
