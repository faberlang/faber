+++
locale = "en"
+++

# process.fab - Process Device
#
# Etymology: process — forward movement / execution; Latin locale spelling `processus`.
# A going forward, a process in motion.
#
# Every verb blocks on its `ad` frame response. Async is host-side plumbing:
# the gateway decides how long to hold a request; Faber's posture is uniform.
# There is no `@ future` — sync/async is a route-naming distinction, not a
# Faber-side marker. Sync and async verbs name distinct `processus:*` routes.
# `spawn` returns a `Subprocess` built in Norma from the child pid.
# Drifted annotation state is not preserved: the live surface is @ public.
#
# Design principles:
# - Different verbs for different spawn semantics:
# - spawn: spawn attached, caller manages lifecycle
# - detach: spawn detached, dismiss to run independently
# - Shell execution uses traditional sync/async:
# - Imperative (exec): sync, blocks until complete
# - Future (exec_async): async, returns promise
# - Environment uses read_env (read) - simple and consistent

import from "norma:fault" fault

# Boundary row: the leaf's `{kind, path}` crossing record becomes the
# declared IoFault; the reporting bodies stay canonical `call` one-liners.
@ conversion
fn io_fault(value raw) → fault.IoFault {
    return fault.io_fault_from(raw)
}


# =============================================================================
# TYPES
# =============================================================================

# Spawned subprocess handle for attached processes
# Holds the child pid; pass it to `wait` (block for exit code) or `kill`
# (terminate the child). Both call the same `processus:*` routes by pid.
@ public
class Subprocess {
    var int pid
}

# =========================================================================
# SPAWN - Attached
# =========================================================================
# Verb: spawn from "generare" (to generate, beget, bring forth)
# Why: Caller maintains control — can wait for exit, capture output via handle.
# Maps to: Bun.spawn() with handle returned

# Spawn attached process. The leaf returns the pid; Norma wraps `Subprocess`.
# Param named `args` because `argumenta` is TokenKind::Argumenta.
@ public
fn spawn(list<string> args) → Subprocess ⇥ fault.IoFault {
    const int child ← call 'processus:genera' (args) ↦ int
    return Subprocess { pid = child }
}

# =========================================================================
# LIFECYCLE - Wait / Kill
# =========================================================================
# Verb: wait from "exspectare" (to wait for, expect)
# Why: Attached spawn owns the child lifecycle; wait reaps it and yields the
# exit code (-1 when the child was killed by a signal).
# Maps to: proc.waited / waitpid

# Block until the child exits; returns its exit code (-1 if signal-killed)
@ public
fn wait(Subprocess child) → int ⇥ fault.IoFault {
    return call 'processus:exspecta' (child.pid) ↦ int
}

# =========================================================================
# Verb: kill from "necare" (to kill)
# Why: Terminates an attached child; killing an already-exited child is not
# an error. Reap afterwards with `wait`.
# Maps to: proc.kill()

# Kill the child process
@ public
fn kill(Subprocess child) → void ⇥ fault.IoFault {
    return call 'processus:neca' (child.pid) ↦ void
}

# =========================================================================
# SPAWN - Detached
# =========================================================================
# Verb: detach from "dimittere" (to send away, dismiss, release)
# Why: Distinct from spawn: fire-and-forget; process survives parent exit.
# Maps to: Bun.spawn() with proc.unref(), stdio ignored

# Dismiss process to run independently - returns PID.
# Param named `args` because `argumenta` is TokenKind::Argumenta (CLI
# argument binding). Optional cwd/env are not on this opener: a mixed
# lista<string | nihil | tabula> is untyped, so they stay off the
# surface until a later typed record (R1: one meaning).
@ public
fn detach(list<string> args) → int ⇥ fault.IoFault {
    return call 'processus:dimitte' (args) ↦ int
}

# Execute an argv vector directly and capture status, stdout, and stderr.
# No shell is involved; args[0] is the executable and the remaining elements
# are passed as literal argv entries.
@ public
fn capture(list<string> args) → value ⇥ fault.IoFault {
    return call 'processus:captura' (args) ↦ value
}

# =========================================================================
# SHELL EXECUTION
# =========================================================================
# Verb: exec/exec_async from "exsequi" (to follow out, execute, accomplish)
# Why: Shell features available (pipes, redirects, &&, ||, etc). Returns stdout.
# Maps to: sh -c "cmd" via Bun.spawnSync / Bun.spawn

# Execute shell command, block until complete, return stdout (sync)
@ public
fn exec(string command) → string ⇥ fault.IoFault {
    return call 'processus:exsequi' (command) ↦ string
}

# Execute shell command, return stdout when complete (async route; Faber blocks)
@ public
fn exec_async(string command) → string ⇥ fault.IoFault {
    return call 'processus:exsequetur' (command) ↦ string
}

# =========================================================================
# ENVIRONMENT - Read
# =========================================================================
# Verb: read_env from "legere" (to read, gather)
# Why: Same verb as file reading - context (processus vs solum) disambiguates.
# Maps to: Bun.env[name] / process.env[name]

# Read environment variable (Imperativus: fails when unset; set-to-empty → "")
@ public
fn read_env(string name) → string ∪ none {
    return call 'processus:lege' (name) ↦ string
}

# =========================================================================
# PROCESS INFO - Working Directory
# =========================================================================
# Noun: sedes (seat, dwelling place, residence)
# Why: Avoids collision with solum.directorium which extracts directory from
# path strings.
# Maps to: process.cwd()

# Get current working directory (where the process dwells)
@ public
fn cwd() → string {
    return call 'processus:sedes' ↦ string
}

# =========================================================================
# PROCESS INFO - Change Directory
# =========================================================================
# Verb: chdir from "mutare" (to change, alter)
# Maps to: process.chdir(path)

# Change current working directory
@ public
fn chdir(string path) → void ⇥ fault.IoFault {
    return call 'processus:muta' (path) ↦ void
}

# =========================================================================
# PROCESS INFO - Identity
# =========================================================================
# Noun: identitas (identity)
# Why: Accessor for process identity (PID). Not a verb - it's a property.
# Maps to: process.pid

# Get process ID
@ public
fn pid() → int {
    return call 'processus:identitas' ↦ int
}

# =========================================================================
# PROCESS INFO - Arguments
# =========================================================================
# Noun: argumenta (arguments)
# Why: Accessor for command line arguments. Not a verb - it's a property.
# Maps to: Bun.argv.slice(2) / process.argv.slice(2)

# Get command line arguments (excludes runtime and script path)
@ public
fn argv() → list<string> {
    return call 'processus:argumenta' ↦ list<string>
}

# =========================================================================
# EXIT
# =========================================================================
# Verb: exit_process from "exire" (to go out, exit, depart)
# Why: Returns never — this call does not return.
# Maps to: process.exit(code)

# Exit process with code (never returns)
@ public
fn exit_process(int code) → never {
    const void _ ← call 'processus:exi' (code) ↦ void
    panic "process exit returned unexpectedly"
}
