+++
locale = "en"
+++
# json/solve.fab — recursive-descent JSON parser
#
# The parser is ordinary Faber. It builds a codec-neutral `value` tree, then
# lets the language's existing `value ↦ json` conversion enforce the
# object-rooted document contract. No target runtime or host route participates.

import from "norma:json/cursor" cursor

import from "norma:json/lexer" lexer

@ public
fn parse(string wire) → json ⇥ string {
    let int start ← lexer.skip_whitespace(wire, 0)
    if start ≥ wire.length() {
        throw "empty JSON document"
    }
    let cursor.ScanResult scanned ← parse_value(wire, start)
    let int end ← lexer.skip_whitespace(wire, scanned.index)
    if end ≢ wire.length() {
        throw "trailing characters at position §"(end)
    }
    return scanned.payload ↦ json
}

@ public
fn try_parse(string wire) → json ∪ none {
    do {
        return parse(wire)
    }
    catch err {
        return null
    }
}

fn result(value payload, int index) → cursor.ScanResult {
    return cursor.ScanResult { payload = payload, index = index }
}

fn parse_value(string wire, int start) → cursor.ScanResult ⇥ string {
    let int index ← lexer.skip_whitespace(wire, start)
    if index ≥ wire.length() {
        throw "expected JSON value at end of input"
    }
    let string c ← wire.slice(index, index + 1)
    if c ≡ "{" then return parse_object(wire, index)
    if c ≡ "[" then return parse_array(wire, index)
    if c ≡ «"» then return parse_string(wire, index)
    if c ≡ "t" then return parse_keyword(wire, index, "true", true ↦ value)
    if c ≡ "f" then return parse_keyword(wire, index, "false", false ↦ value)
    if c ≡ "n" then return parse_keyword(wire, index, "null", null ↦ value)
    if c ≡ "-" or lexer.is_digit(c) then return parse_number(wire, index)
    throw "unexpected JSON token at position §"(index)
}

fn parse_keyword(string wire, int start, string keyword, value payload) → cursor.ScanResult ⇥ string {
    let int end ← start + keyword.length()
    if end ≻ wire.length() {
        throw "truncated JSON keyword at position §"(start)
    }
    if wire.slice(start, end) ≢ keyword {
        throw "invalid JSON keyword at position §"(start)
    }
    if end ≺ wire.length() and not lexer.is_terminator(wire.slice(end, end + 1)) {
        throw "invalid character after JSON keyword at position §"(end)
    }
    return result(payload, end)
}

fn parse_object(string wire, int start) → cursor.ScanResult ⇥ string {
    mut map<string, value> fields ← empty
    mut int index ← lexer.skip_whitespace(wire, start + 1)
    if index ≺ wire.length() and wire.slice(index, index + 1) ≡ "}" then return result(fields ↦ value, index + 1)
    while index ≺ wire.length() {
        if wire.slice(index, index + 1) ≢ «"» {
            throw "expected JSON object key at position §"(index)
        }
        let cursor.ScanResult key_scan ← parse_string(wire, index)
        let string key ↤ key_scan.payload
        if fields.has(key) {
            throw "duplicate JSON object key: §"(key)
        }
        index ← lexer.skip_whitespace(wire, key_scan.index)
        if index ≥ wire.length() or wire.slice(index, index + 1) ≢ ":" {
            throw "expected ':' after JSON object key at position §"(index)
        }
        let cursor.ScanResult value_scan ← parse_value(wire, index + 1)
        fields.put(key, value_scan.payload)
        index ← lexer.skip_whitespace(wire, value_scan.index)
        if index ≥ wire.length() {
            throw "unterminated JSON object"
        }
        let string delimiter ← wire.slice(index, index + 1)
        if delimiter ≡ "}" then return result(fields ↦ value, index + 1)
        if delimiter ≢ "," {
            throw "expected ',' or '}' at position §"(index)
        }
        index ← lexer.skip_whitespace(wire, index + 1)
    }
    throw "unterminated JSON object"
}

fn parse_array(string wire, int start) → cursor.ScanResult ⇥ string {
    mut list<value> items ← empty
    mut int index ← lexer.skip_whitespace(wire, start + 1)
    if index ≺ wire.length() and wire.slice(index, index + 1) ≡ "]" then return result(items ↦ value, index + 1)
    while index ≺ wire.length() {
        let cursor.ScanResult item ← parse_value(wire, index)
        items.append(item.payload)
        index ← lexer.skip_whitespace(wire, item.index)
        if index ≥ wire.length() {
            throw "unterminated JSON array"
        }
        let string delimiter ← wire.slice(index, index + 1)
        if delimiter ≡ "]" then return result(items ↦ value, index + 1)
        if delimiter ≢ "," {
            throw "expected ',' or ']' at position §"(index)
        }
        index ← lexer.skip_whitespace(wire, index + 1)
    }
    throw "unterminated JSON array"
}

fn parse_string(string wire, int start) → cursor.ScanResult ⇥ string {
    mut string decoded ← ""
    mut int index ← start + 1
    while index ≺ wire.length() {
        let string c ← wire.slice(index, index + 1)
        if c ≡ «"» then return result(decoded ↦ value, index + 1)
        if c ≢ "\\" {
            if lexer.is_control(c) {
                throw "unescaped control character at position §"(index)
            }
            decoded ← decoded + c
            index ← index + 1
        }
        else {
            if index + 1 ≥ wire.length() {
                throw "unterminated JSON escape"
            }
            let string escaped ← wire.slice(index + 1, index + 2)
            if escaped ≡ "u" {
                let cursor.ScanResult unicode ← parse_unicode_escape(wire, index)
                decoded ← decoded + (unicode.payload ↦ string)
                index ← unicode.index
            }
            else {
                let string ∪ none replacement ← lexer.unescape_char(escaped)
                if replacement is none {
                    throw "invalid JSON escape at position §"(index)
                }
                decoded ← decoded + replacement coalesce ""
                index ← index + 2
            }
        }
    }
    throw "unterminated JSON string"
}

fn parse_unicode_escape(string wire, int slash) → cursor.ScanResult ⇥ string {
    let int first ← parse_hex_quad(wire, slash + 2)
    mut int scalar ← first
    mut int end ← slash + 6
    if first ≥ 55296 and first ≤ 56319 {
        if end + 6 ≻ wire.length() {
            throw "missing low surrogate at position §"(slash)
        }
        if wire.slice(end, end + 2) ≢ "\\u" {
            throw "missing low surrogate at position §"(slash)
        }
        let int second ← parse_hex_quad(wire, end + 2)
        if second ≺ 56320 or second ≻ 57343 {
            throw "invalid low surrogate at position §"(end)
        }
        scalar ← (65536 + (first - 55296) * 1024 + second) - 56320
        end ← end + 6
    }
    else {
        if first ≥ 56320 and first ≤ 57343 {
            throw "unexpected low surrogate at position §"(slash)
        }
    }
    return result(scalar_to_string(scalar) ↦ value, end)
}

fn parse_hex_quad(string wire, int start) → int ⇥ string {
    if start + 4 ≻ wire.length() {
        throw "truncated Unicode escape at position §"(start - 2)
    }
    mut int scalar ← 0
    mut int offset ← 0
    while offset ≺ 4 {
        let int ∪ none digit ← lexer.hex_value(wire.slice(start + offset, start + offset + 1))
        if digit is none {
            throw "invalid Unicode escape at position §"(start - 2)
        }
        scalar ← scalar * 16 + digit coalesce 0
        offset ← offset + 1
    }
    return scalar
}

fn scalar_to_string(int scalar) → string ⇥ string {
    if scalar ≺ 0 or scalar ≻ 1114111 {
        throw "invalid Unicode scalar"
    }
    if scalar ≥ 55296 and scalar ≤ 57343 {
        throw "invalid Unicode scalar"
    }
    mut list<u8> octets ← empty
    if scalar ≤ 127 {
        octets.append(scalar ↦ u8)
    }
    elif scalar ≤ 2047 {
        octets.append((192 + scalar / 64) ↦ u8)
        octets.append((128 + scalar % 64) ↦ u8)
    }
    elif scalar ≤ 65535 {
        octets.append((224 + scalar / 4096) ↦ u8)
        octets.append((128 + (scalar / 64) % 64) ↦ u8)
        octets.append((128 + scalar % 64) ↦ u8)
    }
    else {
        octets.append((240 + scalar / 262144) ↦ u8)
        octets.append((128 + (scalar / 4096) % 64) ↦ u8)
        octets.append((128 + (scalar / 64) % 64) ↦ u8)
        octets.append((128 + scalar % 64) ↦ u8)
    }
    let list<b8> encoded ← octets ↦ list<b8>
    return encoded ↦ string
}

fn parse_number(string wire, int start) → cursor.ScanResult ⇥ string {
    let int integer_end ← scan_integer_part(wire, start)
    let int fraction_end ← scan_fraction_part(wire, integer_end)
    let int end ← scan_exponent_part(wire, fraction_end)
    if end ≺ wire.length() and not lexer.is_terminator(wire.slice(end, end + 1)) {
        throw "invalid character in JSON number at position §"(end)
    }
    let string token ← wire.slice(start, end)
    if end ≢ integer_end then return result((token ↦ float) ↦ value, end)
    return result(integer_value(token), end)
}

# An integer token keeps every digit: one that fits `int` is an `int`, anything
# longer is an `inf`. Nineteen digits can still fit, so those compare first.
fn integer_value(string token) → value ⇥ string {
    if token.length() ≤ 18 then return (token ↦ int) ↦ value
    let inf exact ← token ↦ inf
    let inf lowest ← -9223372036854775808
    let inf highest ← 9223372036854775807
    if exact ≥ lowest and exact ≤ highest then return (exact ↦ int) ↦ value
    return exact ↦ value
}

fn scan_integer_part(string wire, int start) → int ⇥ string {
    mut int index ← start
    if wire.slice(index, index + 1) ≡ "-" {
        index ← index + 1
        if index ≥ wire.length() {
            throw "truncated JSON number at position §"(start)
        }
    }
    let string first ← wire.slice(index, index + 1)
    if first ≡ "0" {
        index ← index + 1
        if index ≺ wire.length() and lexer.is_digit(wire.slice(index, index + 1)) {
            throw "leading zero in JSON number at position §"(start)
        }
    }
    else {
        if not lexer.is_digit(first) {
            throw "invalid JSON number at position §"(start)
        }
        while index ≺ wire.length() and lexer.is_digit(wire.slice(index, index + 1)) {
            index ← index + 1
        }
    }
    return index
}

fn scan_fraction_part(string wire, int start) → int ⇥ string {
    if start ≥ wire.length() or wire.slice(start, start + 1) ≢ "." then return start
    let int digits_start ← start + 1
    if digits_start ≥ wire.length() or not lexer.is_digit(wire.slice(digits_start, digits_start + 1)) {
        throw "missing fraction digits at position §"(digits_start)
    }
    return scan_digits(wire, digits_start)
}

fn scan_exponent_part(string wire, int start) → int ⇥ string {
    if start ≥ wire.length() then return start
    let string marker ← wire.slice(start, start + 1)
    if marker ≢ "e" and marker ≢ "E" then return start
    mut int digits_start ← start + 1
    if digits_start ≺ wire.length() {
        let string sign ← wire.slice(digits_start, digits_start + 1)
        if sign ≡ "+" or sign ≡ "-" {
            digits_start ← digits_start + 1
        }
    }
    if digits_start ≥ wire.length() or not lexer.is_digit(wire.slice(digits_start, digits_start + 1)) {
        throw "missing exponent digits at position §"(digits_start)
    }
    return scan_digits(wire, digits_start)
}

fn scan_digits(string wire, int start) → int {
    mut int index ← start
    while index ≺ wire.length() and lexer.is_digit(wire.slice(index, index + 1)) {
        index ← index + 1
    }
    return index
}
