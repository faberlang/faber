+++
locale = "en"
+++

# http/sse.fab — Server-Sent Events codec
#
# Public import: import from "norma:http/sse" sse
#
# Pure format/parse of text/event-stream (WHATWG HTML living standard,
# Server-sent events). Field names, multi-line data, comment lines,
# id/retry, LF / CR / CRLF line endings. No transport.

@ public
class Event {
    mut string name = ""
    mut string data = ""
    mut string id = ""
    mut string retry = ""
}

@ public
fn stringify(Event event) → string {
    mut string out ← ""
    if event.name.length() ≻ 0 {
        out ← out + "event: " + event.name + "\n"
    }
    if event.id.length() ≻ 0 {
        out ← out + "id: " + event.id + "\n"
    }
    if event.retry.length() ≻ 0 {
        out ← out + "retry: " + event.retry + "\n"
    }
    let list<string> lines ← data_lines(event.data)
    mut int i ← 0
    while i ≺ lines.length() {
        out ← out + "data: " + lines[i] + "\n"
        i ← i + 1
    }
    out ← out + "\n"
    return out
}

@ public
fn parse(string wire) → list<Event> ⇥ string {
    mut string src ← wire
    let string bom ↤ |ef bb bf|
    if src.length() ≻ 0 and src.slice(0, 1) ≡ bom {
        src ← src.slice(1, src.length())
    }
    mut list<Event> events ← []
    mut string last_id ← ""
    mut string name ← ""
    mut string data ← ""
    mut string id ← ""
    mut string retry ← ""
    mut bool has_data ← false
    mut bool has_id ← false
    mut int i ← 0
    let int n ← src.length()
    while i ≺ n {
        let int line_end_pos ← line_end(src, i)
        let string line ← src.slice(i, line_end_pos)
        i ← after_line(src, line_end_pos)
        if line.length() ≡ 0 {
            let Event ∪ none ev ← finish_event(name, data, id, retry, last_id, has_data, has_id)
            if ev not is none {
                let Event ready ↤ ev
                events.append(ready)
            }
            if has_id {
                last_id ← id
            }
            name ← ""
            data ← ""
            id ← ""
            retry ← ""
            has_data ← false
            has_id ← false
        }
        elif line.slice(0, 1) ≡ ":" {
            # comment / keep-alive
        }
        else {
            let int colon ← colon_at(line)
            mut string field_name ← line
            mut string field_value ← ""
            if colon ≥ 0 {
                field_name ← line.slice(0, colon)
                field_value ← line.slice(colon + 1, line.length())
                if field_value.length() ≻ 0 and field_value.slice(0, 1) ≡ " " {
                    field_value ← field_value.slice(1, field_value.length())
                }
            }
            if field_name ≡ "data" {
                data ← data + field_value + "\n"
                has_data ← true
            }
            elif field_name ≡ "event" {
                name ← field_value
            }
            elif field_name ≡ "id" {
                if has_nul(field_value) {
                    throw "norma:http/sse.parse: illegal id"
                }
                id ← field_value
                has_id ← true
            }
            elif field_name ≡ "retry" {
                if field_value.length() ≻ 0 and not is_digits(field_value) {
                    throw "norma:http/sse.parse: invalid retry"
                }
                if field_value.length() ≻ 0 {
                    retry ← field_value
                }
            }
        }
    }
    if has_data {
        let Event ∪ none ev ← finish_event(name, data, id, retry, last_id, has_data, has_id)
        if ev not is none {
            let Event ready ↤ ev
            events.append(ready)
        }
    }
    return events
}

fn data_lines(string data) → list<string> {
    mut list<string> lines ← []
    mut int start ← 0
    mut int i ← 0
    while i ≺ data.length() {
        if data.slice(i, i + 1) ≡ "\n" {
            lines.append(data.slice(start, i))
            i ← i + 1
            start ← i
        }
        else {
            i ← i + 1
        }
    }
    lines.append(data.slice(start, data.length()))
    return lines
}

fn line_end(string s, int start) → int {
    mut int i ← start
    while i ≺ s.length() {
        let string c ← s.slice(i, i + 1)
        if c ≡ "\n" or c ≡ "\r" then return i
        i ← i + 1
    }
    return s.length()
}

fn after_line(string s, int line_end) → int {
    if line_end ≥ s.length() then return s.length()
    if s.slice(line_end, line_end + 1) ≡ "\r" {
        if line_end + 1 ≺ s.length() and s.slice(line_end + 1, line_end + 2) ≡ "\n" {
            return line_end + 2
        }
        return line_end + 1
    }
    return line_end + 1
}

fn colon_at(string line) → int {
    mut int i ← 0
    while i ≺ line.length() {
        if line.slice(i, i + 1) ≡ ":" then return i
        i ← i + 1
    }
    return -1
}

fn has_nul(string s) → bool {
    mut int i ← 0
    while i ≺ s.length() {
        # NUL is valid UTF-8, so the conversion cannot fail; the default only satisfies D17.8.
        if s.slice(i, i + 1) ≡ (|00| ↦ string ⊥ "") then return true
        i ← i + 1
    }
    return false
}

fn is_digits(string s) → bool {
    if s.length() ≡ 0 then return false
    mut int i ← 0
    while i ≺ s.length() {
        if not "0123456789".contains(s.slice(i, i + 1)) then return false
        i ← i + 1
    }
    return true
}

fn finish_event(string name, string data, string id, string retry, string last_id, bool has_data, bool has_id) → Event ∪ none {
    if not has_data then return null
    mut string payload ← data
    if payload.length() ≻ 0 and payload.slice(payload.length() - 1, payload.length()) ≡ "\n" {
        payload ← payload.slice(0, payload.length() - 1)
    }
    if payload.length() ≡ 0 then return null
    mut string evid ← last_id
    if has_id {
        evid ← id
    }
    return Event { name = name, data = payload, id = evid, retry = retry }
}

fn must_parse(string wire) → list<Event> {
    mut list<Event> out ← []
    mut bool ok ← false
    do {
        out ← parse(wire)
        ok ← true
    }
    catch err {
        ok ← false
    }
    assert ok
    return out
}

fn parse_msg(string wire) → string {
    mut string msg ← ""
    do {
        let list<Event> events ← parse(wire)
        msg ← events.length() ↦ string
    }
    catch err {
        msg ← err
    }
    return msg
}

describe "sse" {
    test "serialize data hello golden" {
        let Event ev ← Event { data = "hello" }
        assert stringify(ev) ≡ "data: hello\n\n"
    }

    test "parse data hello golden" {
        let list<Event> evs ← must_parse("data: hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
        assert evs[0].name ≡ ""
        assert evs[0].id ≡ ""
        assert evs[0].retry ≡ ""
    }

    test "roundtrip hello" {
        let Event ev ← Event { data = "hello" }
        let list<Event> evs ← must_parse(stringify(ev))
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
    }

    test "serialize and parse multi-line data" {
        let Event ev ← Event { data = "hello\nworld" }
        assert stringify(ev) ≡ "data: hello\ndata: world\n\n"
        let list<Event> evs ← must_parse(stringify(ev))
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello\nworld"
    }

    test "parse multi-line data without space after colon" {
        let list<Event> evs ← must_parse("data:line1\ndata:line2\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "line1\nline2"
    }

    test "serialize and parse id and retry" {
        let Event ev ← Event { name = "token", data = "hello", id = "42", retry = "3000" }
        let string wire ← stringify(ev)
        assert wire ≡ "event: token\nid: 42\nretry: 3000\ndata: hello\n\n"
        let list<Event> evs ← must_parse(wire)
        assert evs.length() ≡ 1
        assert evs[0].name ≡ "token"
        assert evs[0].data ≡ "hello"
        assert evs[0].id ≡ "42"
        assert evs[0].retry ≡ "3000"
    }

    test "parse comment lines do not dispatch" {
        let list<Event> evs ← must_parse(": keep-alive\n\n")
        assert evs.length() ≡ 0
    }

    test "parse comment then data" {
        let list<Event> evs ← must_parse(": ping\ndata: hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
    }

    test "parse unknown fields ignored" {
        let list<Event> evs ← must_parse("foo: bar\ndata: hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
    }

    test "parse crlf and cr line endings" {
        let list<Event> a ← must_parse("data: hello\r\n\r\n")
        assert a.length() ≡ 1
        assert a[0].data ≡ "hello"
        let list<Event> b ← must_parse("data: hello\r\r")
        assert b.length() ≡ 1
        assert b[0].data ≡ "hello"
    }

    test "parse leading bom stripped" {
        let string bom ↤ |ef bb bf| ⊥ ""
        let list<Event> evs ← must_parse(bom + "data: hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
    }

    test "parse two events" {
        let list<Event> evs ← must_parse("data: one\n\ndata: two\n\n")
        assert evs.length() ≡ 2
        assert evs[0].data ≡ "one"
        assert evs[1].data ≡ "two"
    }

    test "parse inherits last event id" {
        let list<Event> evs ← must_parse("id: 7\n\ndata: hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
        assert evs[0].id ≡ "7"
    }

    test "parse split-boundary trailing event without blank line" {
        let list<Event> evs ← must_parse("data: hello")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ "hello"
    }

    test "parse empty stream" {
        let list<Event> evs ← must_parse("")
        assert evs.length() ≡ 0
    }

    test "parse strips one leading space after colon" {
        let list<Event> evs ← must_parse("data:  hello\n\n")
        assert evs.length() ≡ 1
        assert evs[0].data ≡ " hello"
    }

    test "rejects non-digit retry" {
        assert parse_msg("retry: 3a\ndata: hello\n\n") ≡ "norma:http/sse.parse: invalid retry"
    }

    test "rejects nul in id" {
        let string nul ↤ |00| ⊥ ""
        assert parse_msg("id: a" + nul + "b\ndata: hello\n\n") ≡ "norma:http/sse.parse: illegal id"
    }
}
