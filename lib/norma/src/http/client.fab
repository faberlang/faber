+++
locale = "en"
+++

# http/client.fab — HTTP client verbs
#
# Public import: import from "norma:http/client" client
# Depends on: norma:http/headers, norma:http/response
#
# URL split, header assembly, Client agent reuse, and I/O verbs over
# dispatched http:* client routes:
#   http:agent           [] or [timeout_ms] → handle
#   http:get|delete      [url] | [url, headers] | [agent, url] | [agent, url, headers]
#   http:post|put|patch  [url, body] | [url, headers, body] | [agent, …]
#   http:request         [method, url, headers, body] | [agent, method, url, headers, body]
#   http:request_open    same arity as http:request → {reader, status, headers}
#   http:read            [reader] | [reader, max_bytes] → {bytes, done}
# Streaming receive pulls one bounded chunk per call (never read_to_end)
# so an SSE consumer can parse events as they arrive.
#
# Stems (Grade D HTTP loanwords) and open cells:
#   get, delete — finite: bare | _with headers | _on Client
#   post, put, patch — finite: url+body | _with headers | _on Client
#   send — finite generic (send_request folds a map; send_on reuses Client)
#   open — streaming start (bare | _on Client)
#   receive — one chunk (receive_n bounds the read)

import from "norma:http/headers" headers
import from "norma:http/response" response
import from "norma:fault" fault

# A bare leaf `call ↦ T` failure crosses as the record (`valor`); this
# same-file row converts it through the boundary row in `norma:fault`, so
# every leaf call below reports on the declared `⇥ fault.IoFault` channel.
@ conversion
fn fault_from_value(value raw) → fault.IoFault {
    return fault.io_fault_from(raw)
}

# Minimal origin-form split (scheme/host/port/path/query). No standalone
# URL genus elsewhere — design killed that leaf for v1.
@ public
class Url {
    mut string scheme = ""
    mut string host = ""
    mut int port = 0
    mut string path = ""
    mut string query = ""
}

# Reuse holder. `agent` is the http:agent handle; 0 means ephemeral
# (the provider builds a one-shot agent for that call).
@ public
class Client {
    mut int agent = 0
}

# Incremental receive handle from http:request_open. `next` / `next_n`
# pull one chunk via http:read; they never drain the remainder.
@ public
class Receive {
    mut int reader = 0
    mut int status = 0
    mut headers.Headers headers = headers.Headers { }

    fn next() → Chunk ⇥ fault.IoFault {
        return receive(self)
    }

    fn next_n(int max_bytes) → Chunk ⇥ fault.IoFault {
        return receive_n(self, max_bytes)
    }
}

# Pended client request from http:request_send. finish_pending reads the
# response head after the server answered.
@ public
class Request {
    mut int id = 0
}

# One incremental body chunk. `text` is the UTF-8 decode of this read
# (empty when the bytes are not UTF-8). `done` is true only on the
# terminal read; a later receive after done fails at the provider.
@ public
class Chunk {
    mut string text = ""
    mut bool done = false
}

@ public
fn empty() → Client {
    return Client { }
}

@ public
fn session() → Client {
    let list<value> none ← []
    let int handle ↤ call 'http:agent' (none)
    return Client { agent = handle }
}

@ public
fn session_timeout(int timeout_ms) → Client {
    let int handle ↤ call 'http:agent' ([timeout_ms ↦ value])
    return Client { agent = handle }
}

# Split an absolute URL. Invalid input yields an empty scheme (no host).
# Default ports: http 80, https 443. Empty path becomes `/`. Fragment
# is dropped. Port, when present, must be between 1 and 65535.
@ public
fn split(string url) → Url {
    let int sep ← find_scheme_sep(url)
    if sep ≺ 0 then return Url { }
    let string scheme ← ascii_lower(url.slice(0, sep))
    if not is_scheme(scheme) then return Url { }
    let string rest ← url.slice(sep + 3, url.length())
    let int auth_end ← authority_end(rest)
    if auth_end ≺ 0 then return Url { }
    let string authority ← rest.slice(0, auth_end)
    let string remainder ← rest.slice(auth_end, rest.length())
    let string hostport ← strip_userinfo(authority)
    let string host ← ascii_lower(host_of(hostport))
    if host.length() ≡ 0 then return Url { }
    if not is_host(host) then return Url { }
    let int ∪ none port ← port_of(hostport, scheme)
    if port is none then return Url { }
    let string path ← remainder_path(remainder)
    let string query ← remainder_query(remainder)
    return Url {
        scheme = scheme,
        host = host,
        port = port ↦ int,
        path = path,
        query = query
    }
}

@ public
fn is_absolute(Url url) → bool {
    return url.scheme.length() ≻ 0 and url.host.length() ≻ 0
}

# Host header value: omit the port when it is the scheme default.
@ public
fn host_header(Url url) → string {
    if is_default_port(url.scheme, url.port) {
        return host_literal(url.host)
    }
    return "§:§"(host_literal(url.host), url.port ↦ string)
}

# Origin-form request target (`/path` or `/path?query`).
@ public
fn request_target(Url url) → string {
    if url.query.length() ≡ 0 {
        return url.path
    }
    return "§?§"(url.path, url.query)
}

# Fold a name→value map into the shared Headers genus (illegal lines dropped).
@ public
fn headers_from_map(map<string, string> pairs) → headers.Headers {
    mut headers.Headers out ← headers.empty()
    let list<string> names ← pairs.keys()
    for from names let name {
        let string ∪ none value ← pairs.get(name)
        if value not is none {
            if out.append(name, value ↦ string) {
            }
        }
    }
    return out
}

@ public
fn get(string url) → response.Response ⇥ fault.IoFault {
    return no_body("http:get", 0, url, headers.empty())
}

@ public
fn get_with(string url, headers.Headers headers) → response.Response ⇥ fault.IoFault {
    return no_body("http:get", 0, url, headers)
}

@ public
fn get_on(Client client, string url) → response.Response ⇥ fault.IoFault {
    return no_body("http:get", client.agent, url, headers.empty())
}

@ public
fn post(string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:post", 0, url, headers.empty(), body)
}

@ public
fn post_with(string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:post", 0, url, headers, body)
}

@ public
fn post_on(Client client, string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:post", client.agent, url, headers.empty(), body)
}

@ public
fn put(string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:put", 0, url, headers.empty(), body)
}

@ public
fn put_with(string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:put", 0, url, headers, body)
}

@ public
fn put_on(Client client, string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:put", client.agent, url, headers.empty(), body)
}

@ public
fn delete(string url) → response.Response ⇥ fault.IoFault {
    return no_body("http:delete", 0, url, headers.empty())
}

@ public
fn delete_with(string url, headers.Headers headers) → response.Response ⇥ fault.IoFault {
    return no_body("http:delete", 0, url, headers)
}

@ public
fn delete_on(Client client, string url) → response.Response ⇥ fault.IoFault {
    return no_body("http:delete", client.agent, url, headers.empty())
}

@ public
fn patch(string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:patch", 0, url, headers.empty(), body)
}

@ public
fn patch_with(string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:patch", 0, url, headers, body)
}

@ public
fn patch_on(Client client, string url, string body) → response.Response ⇥ fault.IoFault {
    return with_body("http:patch", client.agent, url, headers.empty(), body)
}

@ public
fn send_request(string method, string url, map<string, string> pairs, string body) → response.Response ⇥ fault.IoFault {
    return send(method, url, headers_from_map(pairs), body)
}

@ public
fn send(string method, string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    return generic(0, method, url, headers, body)
}

@ public
fn send_on(Client client, string method, string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    return generic(client.agent, method, url, headers, body)
}

# Open a streaming receive. The body is not buffered; pull chunks with
# receive / Receive.next. Designed for text/event-stream consumption.
@ public
fn open(string method, string url, headers.Headers headers, string body) → Receive ⇥ fault.IoFault {
    return open_stream(0, method, url, headers, body)
}

@ public
fn open_on(Client client, string method, string url, headers.Headers headers, string body) → Receive ⇥ fault.IoFault {
    return open_stream(client.agent, method, url, headers, body)
}

# Split client exchange, the http twin of websocket connect_open/connect_finish:
# open_pending writes the request and pends; finish_pending reads the response
# head after the server answered. One thread can serve the listener between
# the halves, the same interleave the sequential loopback proofs rely on.
@ public
fn open_pending(string method, string url, headers.Headers headers, string body) → Request ⇥ fault.IoFault {
    require_url(url, "http:request_send")
    let list<value> args ← [method ↦ value, url ↦ value, headers_carrier(headers) ↦ value, body ↦ value]
    let int id ↤ call 'http:request_send' (args) ↦ int
    return Request { id = id }
}

@ public
fn finish_pending(Request request) → Receive ⇥ fault.IoFault {
    let value raw ↤ call 'http:request_head' ([request.id ↦ value]) ↦ value
    return receive_of(raw)
}

# A clean end of body is the leaf's `done` flag (an empty terminal chunk),
# not a failure, so the return stays `Chunk`; `⇥ IoFault` carries only a
# real crossing failure.
@ public
fn receive(Receive stream) → Chunk ⇥ fault.IoFault {
    let list<value> args ↤ [stream.reader ↦ value]
    return chunk_of(call 'http:read' (args) ↦ value)
}

@ public
fn receive_n(Receive stream, int max_bytes) → Chunk ⇥ fault.IoFault {
    let list<value> args ↤ [stream.reader ↦ value, max_bytes ↦ value]
    return chunk_of(call 'http:read' (args) ↦ value)
}

fn require_url(string url, string verb) → void {
    let Url parsed ← split(url)
    if not is_absolute(parsed) {
        panic "norma:http/client.§: invalid URL"(verb)
    }
    return
}

fn no_body(string route, int agent, string url, headers.Headers headers) → response.Response ⇥ fault.IoFault {
    require_url(url, route)
    mut list<value> args ← []
    if agent ≻ 0 {
        args.append(agent ↦ value)
    }
    args.append(url ↦ value)
    if headers.length() ≻ 0 {
        args.append(headers_carrier(headers) ↦ value)
    }
    if route ≡ "http:get" {
        return response_of(call 'http:get' (args) ↦ value)
    }
    return response_of(call 'http:delete' (args) ↦ value)
}

fn with_body(string route, int agent, string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    require_url(url, route)
    mut list<value> args ← []
    if agent ≻ 0 {
        args.append(agent ↦ value)
    }
    args.append(url ↦ value)
    if headers.length() ≻ 0 {
        args.append(headers_carrier(headers) ↦ value)
    }
    args.append(body ↦ value)
    if route ≡ "http:post" {
        return response_of(call 'http:post' (args) ↦ value)
    }
    if route ≡ "http:put" {
        return response_of(call 'http:put' (args) ↦ value)
    }
    return response_of(call 'http:patch' (args) ↦ value)
}

fn generic(int agent, string method, string url, headers.Headers headers, string body) → response.Response ⇥ fault.IoFault {
    require_url(url, "http:request")
    let value raw ← dispatch_generic("http:request", agent, method, url, headers, body)
    return response_of(raw)
}

fn open_stream(int agent, string method, string url, headers.Headers headers, string body) → Receive ⇥ fault.IoFault {
    require_url(url, "http:request_open")
    let value raw ← dispatch_generic("http:request_open", agent, method, url, headers, body)
    return receive_of(raw)
}

fn receive_of(value raw) → Receive {
    # Why: a carrier that is not {reader, status, headers} is a broken host
    # contract, not caller input, so it panics (like require_url) instead of
    # defaulting a reader or status.
    do {
        let map<string, value> fields ↤ raw
        return Receive {
            reader = fields["reader"] ↦ int,
            status = fields["status"] ↦ int,
            headers = headers_from_carrier(fields["headers"])
        }
    }
    catch err {
        panic "norma:http/client: malformed stream response: §"(err)
    }
}

fn dispatch_generic(string route, int agent, string method, string url, headers.Headers headers, string body) → value ⇥ fault.IoFault {
    mut list<value> args ← []
    if agent ≻ 0 {
        args.append(agent ↦ value)
    }
    args.append(method ↦ value)
    args.append(url ↦ value)
    args.append(headers_carrier(headers) ↦ value)
    args.append(body ↦ value)
    if route ≡ "http:request_open" {
        return call 'http:request_open' (args) ↦ value
    }
    return call 'http:request' (args) ↦ value
}

fn response_of(value raw) → response.Response {
    do {
        let map<string, value> fields ↤ raw
        return response.of(
            fields["status"] ↦ int,
            headers_from_carrier(fields["headers"]),
            body_text(fields["body"])
        )
    }
    catch err {
        panic "norma:http/client: malformed response carrier: §"(err)
    }
}

fn chunk_of(value raw) → Chunk {
    do {
        let map<string, value> fields ↤ raw
        return Chunk {
            text = body_text(fields["bytes"]),
            done = fields["done"] ↦ bool
        }
    }
    catch err {
        panic "norma:http/client.receive: malformed http:read response: §"(err)
    }
}

fn headers_carrier(headers.Headers headers) → list<value> {
    mut list<value> out ← []
    for from headers.entries let entry {
        mut map<string, value> row ← {}
        row.put("name", entry.name ↦ value)
        row.put("value", entry.value ↦ value)
        out.append(row ↦ value)
    }
    return out
}

fn headers_from_carrier(value raw) → headers.Headers {
    mut headers.Headers out ← headers.empty()
    if raw not is list<value> then return out
    do {
        let list<value> items ↤ raw
        for from items let item {
            if item is map<string, value> {
                let map<string, value> row ↤ item
                let string name ↤ row["name"]
                let string header_value ↤ row["value"]
                if out.append(name, header_value) {
                }
            }
        }
        return out
    }
    catch err {
        panic "norma:http/client: malformed headers carrier: §"(err)
    }
}

fn body_text(value raw) → string {
    if raw is none then return ""
    # Guarded by the `is` test, so the default never applies.
    if raw is string then return raw ↦ string ⊥ ""
    do {
        let list<b8> data ↤ raw
        do {
            return data ↦ string
        }
        catch err {
            return ""
        }
    }
    catch err {
        return ""
    }
}

fn find_scheme_sep(string url) → int {
    mut int i ← 0
    while i + 2 ≺ url.length() {
        if url.slice(i, i + 3) ≡ "://" {
            return i
        }
        i ← i + 1
    }
    return -1
}

fn is_scheme(string scheme) → bool {
    if scheme.length() ≡ 0 then return false
    if not is_alpha(scheme.slice(0, 1)) then return false
    mut int i ← 1
    while i ≺ scheme.length() {
        let string c ← scheme.slice(i, i + 1)
        if not is_alpha(c) and not is_digit(c) and c ≢ "+" and c ≢ "-" and c ≢ "." {
            return false
        }
        i ← i + 1
    }
    return true
}

fn authority_end(string rest) → int {
    if rest.length() ≡ 0 then return -1
    mut int i ← 0
    mut bool v6 ← false
    while i ≺ rest.length() {
        let string c ← rest.slice(i, i + 1)
        if c ≡ "[" {
            v6 ← true
        }
        elif c ≡ "]" {
            v6 ← false
        }
        elif not v6 and (c ≡ "/" or c ≡ "?" or c ≡ "#") {
            return i
        }
        i ← i + 1
    }
    return rest.length()
}

fn strip_userinfo(string authority) → string {
    mut int at ← -1
    mut int i ← 0
    mut bool v6 ← false
    while i ≺ authority.length() {
        let string c ← authority.slice(i, i + 1)
        if c ≡ "[" {
            v6 ← true
        }
        elif c ≡ "]" {
            v6 ← false
        }
        elif c ≡ "@" and not v6 {
            at ← i
        }
        i ← i + 1
    }
    if at ≺ 0 then return authority
    return authority.slice(at + 1, authority.length())
}

fn host_of(string hostport) → string {
    if hostport.length() ≡ 0 then return ""
    if hostport.slice(0, 1) ≡ "[" {
        mut int i ← 1
        while i ≺ hostport.length() {
            if hostport.slice(i, i + 1) ≡ "]" {
                return hostport.slice(1, i)
            }
            i ← i + 1
        }
        return ""
    }
    mut int i ← 0
    while i ≺ hostport.length() {
        if hostport.slice(i, i + 1) ≡ ":" {
            return hostport.slice(0, i)
        }
        i ← i + 1
    }
    return hostport
}

fn port_of(string hostport, string scheme) → int ∪ none {
    if hostport.length() ≡ 0 then return null
    mut string digits ← ""
    if hostport.slice(0, 1) ≡ "[" {
        mut int i ← 1
        mut bool closed ← false
        while i ≺ hostport.length() {
            if hostport.slice(i, i + 1) ≡ "]" {
                closed ← true
                i ← i + 1
                break
            }
            i ← i + 1
        }
        if not closed then return null
        if i ≡ hostport.length() {
            return default_port(scheme)
        }
        if hostport.slice(i, i + 1) ≢ ":" then return null
        digits ← hostport.slice(i + 1, hostport.length())
    }
    else {
        mut int colon ← -1
        mut int i ← 0
        while i ≺ hostport.length() {
            if hostport.slice(i, i + 1) ≡ ":" {
                if colon ≥ 0 then return null
                colon ← i
            }
            i ← i + 1
        }
        if colon ≺ 0 {
            return default_port(scheme)
        }
        digits ← hostport.slice(colon + 1, hostport.length())
    }
    if digits.length() ≡ 0 then return null
    mut int i ← 0
    while i ≺ digits.length() {
        if not is_digit(digits.slice(i, i + 1)) then return null
        i ← i + 1
    }
    do {
        let int n ↤ digits
        if n ≺ 1 or n ≻ 65535 then return null
        return n
    }
    catch err {
        return null
    }
}

fn default_port(string scheme) → int {
    if scheme ≡ "http" then return 80
    if scheme ≡ "https" then return 443
    return 0
}

fn is_default_port(string scheme, int port) → bool {
    let int def ← default_port(scheme)
    return def ≻ 0 and port ≡ def
}

fn is_host(string host) → bool {
    if host.length() ≡ 0 then return false
    mut int i ← 0
    while i ≺ host.length() {
        let string c ← host.slice(i, i + 1)
        if c ≡ " " or c ≡ "/" or c ≡ "?" or c ≡ "#" or c ≡ "@" or c ≡ "[" or c ≡ "]" {
            return false
        }
        i ← i + 1
    }
    return true
}

fn host_literal(string host) → string {
    mut int i ← 0
    while i ≺ host.length() {
        if host.slice(i, i + 1) ≡ ":" {
            return "[§]"(host)
        }
        i ← i + 1
    }
    return host
}

fn remainder_path(string remainder) → string {
    if remainder.length() ≡ 0 then return "/"
    let string first ← remainder.slice(0, 1)
    if first ≡ "?" or first ≡ "#" then return "/"
    mut int i ← 0
    while i ≺ remainder.length() {
        let string c ← remainder.slice(i, i + 1)
        if c ≡ "?" or c ≡ "#" {
            let string path ← remainder.slice(0, i)
            if path.length() ≡ 0 then return "/"
            return path
        }
        i ← i + 1
    }
    return remainder
}

fn remainder_query(string remainder) → string {
    mut int i ← 0
    while i ≺ remainder.length() {
        let string c ← remainder.slice(i, i + 1)
        if c ≡ "#" {
            return ""
        }
        if c ≡ "?" {
            let int start ← i + 1
            mut int j ← start
            while j ≺ remainder.length() {
                if remainder.slice(j, j + 1) ≡ "#" {
                    return remainder.slice(start, j)
                }
                j ← j + 1
            }
            return remainder.slice(start, remainder.length())
        }
        i ← i + 1
    }
    return ""
}

fn ascii_lower(string s) → string {
    mut string out ← ""
    mut int i ← 0
    while i ≺ s.length() {
        out ← out + lower_char(s.slice(i, i + 1))
        i ← i + 1
    }
    return out
}

fn lower_char(string c) → string {
    let string upper ← "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let string lower ← "abcdefghijklmnopqrstuvwxyz"
    mut int i ← 0
    while i ≺ 26 {
        if upper.slice(i, i + 1) ≡ c {
            return lower.slice(i, i + 1)
        }
        i ← i + 1
    }
    return c
}

fn is_alpha(string c) → bool {
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c)
}

fn is_digit(string c) → bool {
    return "0123456789".contains(c)
}
