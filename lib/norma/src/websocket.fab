+++
locale = "en"
+++

# websocket.fab — WebSocket client and HTTP-upgrade accept
#
# Public import: import from "norma:websocket" websocket
# Leaves: websocket:connect, websocket:connect_open, websocket:connect_finish,
# websocket:accept, websocket:send, websocket:receive, websocket:close.

import from "norma:fault" fault

# Boundary row: a leaf failure crosses as the `{kind, path}` record and this
# `@ conversion` row turns it into the typed `IoFault` at the `⇥` edge.
@ conversion
fn fault_from(value raw) → fault.IoFault {
    return fault.io_fault_from(raw)
}

@ public
class Socket {
    mut int id = 0

    fn send(string text) → void ⇥ fault.IoFault {
        return send_text(self, text)
    }

    fn receive() → string ∪ none ⇥ fault.IoFault {
        return receive_text(self)
    }

    fn close() → void {
        return close_socket(self)
    }
}

@ public
fn connect(string url) → Socket ⇥ fault.IoFault {
    let int id ↤ call 'websocket:connect' ([url ↦ value])
    return Socket { id = id }
}

@ public
fn connect_tls(string url, string ca_path) → Socket ⇥ fault.IoFault {
    let int id ↤ call 'websocket:connect' ([url ↦ value, ca_path ↦ value])
    return Socket { id = id }
}

# Split handshake: connect_open writes the upgrade request and returns;
# connect_finish reads the 101 after the server accepted. One thread can
# interleave the server side between the halves, the same split as the http
# open/receive pair over http:request_open.
@ public
fn connect_open(string url) → Socket ⇥ fault.IoFault {
    const int id ↤ call 'websocket:connect_open' ([url ↦ value])
    return Socket { id = id }
}

@ public
fn connect_finish(Socket socket) → void ⇥ fault.IoFault {
    return call 'websocket:connect_finish' ([socket.id ↦ value]) ↦ void
}

@ public
fn accept(string request_id) → Socket ⇥ fault.IoFault {
    let int id ↤ call 'websocket:accept' ([request_id ↦ value])
    return Socket { id = id }
}

@ public
fn send_text(Socket socket, string text) → void ⇥ fault.IoFault {
    return call 'websocket:send' ([socket.id ↦ value, text ↦ value]) ↦ void
}

# A clean close is a `done` frame today (not a `Closed` error).
@ public
fn receive_text(Socket socket) → string ∪ none ⇥ fault.IoFault {
    let value raw ← call 'websocket:receive' ([socket.id ↦ value]) ↦ value
    do {
        let map<string, value> fields ↤ raw
        let bool done ← fields["done"] ↦ bool ⊥ false
        if done then return null
        return fields["text"] ↦ string
    }
    catch err {
        panic "norma:websocket.receive: malformed carrier: §"(err)
    }
}

@ public
fn close_socket(Socket socket) → void {
    return call 'websocket:close' ([socket.id ↦ value]) ↦ void
}
