+++
locale = "en"
+++

# vector.fab — compiler-owned vector register intrinsics
#
# Public import: importa ex "norma:vector" privata vector

@ public
fn add<elem, size N>(vector<elem, size N> a, vector<elem, size N> b) → vector<elem, size N> {
    return a.added(b)
}

@ public
fn subtract<elem, size N>(vector<elem, size N> a, vector<elem, size N> b) → vector<elem, size N> {
    return a.subtracted(b)
}

@ public
fn multiply<elem, size N>(vector<elem, size N> a, vector<elem, size N> b) → vector<elem, size N> {
    return a.multiplied(b)
}

@ public
fn divide<elem, size N>(vector<elem, size N> a, vector<elem, size N> b) → vector<elem, size N> {
    return a.divided(b)
}

@ public
fn dot<elem, size N>(vector<elem, size N> a, vector<elem, size N> b) → elem {
    return a.dot(b)
}

@ public
fn cross<elem>(vector<elem, size 3> a, vector<elem, size 3> b) → vector<elem, size 3> {
    return a.cross(b)
}

# NOTE: no generic `swizzle` wrapper here — the intrinsic's result width is
# the swizzle pattern length, which the typechecker cannot resolve for a
# `size N` receiver (SEM014 cannot_infer_tensor_shape). A fixed-width wrapper
# would lie about the pattern contract, so the intrinsic is left exposed
# until the shape-param gap closes.
