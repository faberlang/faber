+++
locale = "en"
+++
# Canonical module: norma:net/listener; Latin locale spelling: auscultator.

# net/listener.fab — TCP listener

import from "norma:fault" fault
import from "norma:net/connection" connection

# Boundary row: a leaf failure crosses as the `{kind, path}` record and this
# `@ conversion` row turns it into the typed `IoFault` at the `⇥` edge.
@ conversion
fn fault_from(value raw) → fault.IoFault {
    return fault.io_fault_from(raw)
}

@ public
class Listener {
    mut int id = 0

    fn accept() → connection.Socket ⇥ fault.IoFault {
        return listener_accept(self)
    }

    @ future
    fn accept_async() → connection.Socket ⇥ fault.IoFault {
        return listener_accept(self)
    }

    fn close() → void {
        return listener_close(self)
    }

    fn port() → int {
        return listener_port(self)
    }
}

fn listener_accept(Listener listener) → connection.Socket ⇥ fault.IoFault {
    let int child ← call 'caelum:accipe' (listener.id) ↦ int
    return connection.Socket { id = child }
}

fn listener_close(Listener listener) → void {
    return call 'caelum:claude' (listener.id) ↦ void
}

fn listener_port(Listener listener) → int {
    return call 'caelum:portus' (listener.id) ↦ int
}
