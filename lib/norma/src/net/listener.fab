# Canonical module: norma:net/listener; Latin locale spelling: auscultator.

# net/listener.fab — TCP listener

import from "norma:net/connection" connection

@ public
class Listener {
    var int id = 0

    fn accept() → connection.Socket {
        return listener_accept(self)
    }

    @ future
    fn accept_async() → connection.Socket {
        return listener_accept(self)
    }

    fn close() → void {
        return listener_close(self)
    }

    fn port() → int {
        return listener_port(self)
    }
}

fn listener_accept(Listener listener) → connection.Socket {
    const int child ← call 'caelum:accipe' (listener.id) ↦ int
    return connection.Socket { id = child }
}

fn listener_close(Listener listener) → void {
    return call 'caelum:claude' (listener.id) ↦ void
}

fn listener_port(Listener listener) → int {
    return call 'caelum:portus' (listener.id) ↦ int
}
