+++
locale = "en"
+++
# Canonical module: norma:net/connection; Latin locale spelling: connexus.

# net/connection.fab — TCP socket (connected byte stream)

import from "norma:net/endpoint" endpoint
import from "norma:value" value

@ public
class Socket {
    var int id = 0

    fn read_bytes(int n optional) → bytes {
        return socket_read(self, n)
    }

    @ future
    fn read_bytes_async(int n optional) → bytes {
        return socket_read(self, n)
    }

    fn write_bytes(bytes data) → void {
        return socket_write(self, data)
    }

    @ future
    fn write_bytes_async(bytes data) → void {
        return socket_write(self, data)
    }

    fn close() → void {
        return socket_close(self)
    }

    fn remote() → endpoint.Endpoint {
        return socket_remote(self)
    }

    fn local() → endpoint.Endpoint {
        return socket_local(self)
    }
}

fn socket_read(Socket socket, int n optional) → bytes {
    if n is none {
        return call 'caelum:hauri' (socket.id) ↦ bytes
    }
    return call 'caelum:hauri' ([socket.id, n coalesce 0]) ↦ bytes
}

fn socket_write(Socket socket, bytes data) → void {
    return call 'caelum:funde' ([socket.id ↦ value, data ↦ value]) ↦ void
}

fn socket_close(Socket socket) → void {
    return call 'caelum:claude' (socket.id) ↦ void
}

fn socket_remote(Socket socket) → endpoint.Endpoint {
    return endpoint_from(call 'caelum:remotus' (socket.id) ↦ value)
}

fn socket_local(Socket socket) → endpoint.Endpoint {
    return endpoint_from(call 'caelum:locus' (socket.id) ↦ value)
}

fn endpoint_from(value raw) → endpoint.Endpoint {
    return endpoint.Endpoint {
        host = value.get(raw, "host") ↦ string ⊥ "",
        port = value.get(raw, "port") ↦ int ⊥ 0
    }
}
