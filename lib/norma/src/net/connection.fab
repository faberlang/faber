+++
locale = "en"
+++
# Canonical module: norma:net/connection; Latin locale spelling: connexus.

# net/connection.fab — TCP socket (connected byte stream)

import from "norma:fault" fault
import from "norma:net/endpoint" endpoint
import from "norma:value" value

# Boundary row: a leaf failure crosses as the `{kind, path}` record and this
# `@ conversion` row turns it into the typed `IoFault` at the `⇥` edge.
@ conversion
fn fault_from(value raw) → fault.IoFault {
    return fault.io_fault_from(raw)
}

@ public
class Socket {
    mut int id = 0

    # A clean close is an empty read today (not a `Closed` error).
    fn read_bytes(int n optional) → list<b8> ∪ none ⇥ fault.IoFault {
        return socket_read(self, n)
    }

    @ future
    fn read_bytes_async(int n optional) → list<b8> ∪ none ⇥ fault.IoFault {
        return socket_read(self, n)
    }

    fn write_bytes(list<b8> data) → void ⇥ fault.IoFault {
        return socket_write(self, data)
    }

    @ future
    fn write_bytes_async(list<b8> data) → void ⇥ fault.IoFault {
        return socket_write(self, data)
    }

    fn close() → void {
        return socket_close(self)
    }

    fn remote() → endpoint.Endpoint {
        return socket_remote(self)
    }

    fn local() → endpoint.Endpoint {
        return socket_local(self)
    }
}

fn socket_read(Socket socket, int n optional) → list<b8> ∪ none ⇥ fault.IoFault {
    if n is none {
        let list<b8> data ← call 'caelum:hauri' (socket.id) ↦ list<b8>
        if data.length() ≡ 0 then return null
        return data
    }
    let list<b8> data ← call 'caelum:hauri' ([socket.id, n coalesce 0]) ↦ list<b8>
    if data.length() ≡ 0 then return null
    return data
}

fn socket_write(Socket socket, list<b8> data) → void ⇥ fault.IoFault {
    return call 'caelum:funde' ([socket.id ↦ value, data ↦ value]) ↦ void
}

fn socket_close(Socket socket) → void {
    return call 'caelum:claude' (socket.id) ↦ void
}

fn socket_remote(Socket socket) → endpoint.Endpoint {
    return endpoint_from(call 'caelum:remotus' (socket.id) ↦ value)
}

fn socket_local(Socket socket) → endpoint.Endpoint {
    return endpoint_from(call 'caelum:locus' (socket.id) ↦ value)
}

fn endpoint_from(value raw) → endpoint.Endpoint {
    return endpoint.Endpoint {
        host = value.get(raw, "host") ↦ string ⊥ "",
        port = value.get(raw, "port") ↦ int ⊥ 0
    }
}
