+++
locale = "en"
+++
# Canonical module: norma:time; Latin locale spelling: tempus.

# time.fab — public Faber datetime library (native Faber catalog)
#
# Public import: import from "norma:time" time
# Method ledger: sibling radix docs/stdlib/tempus-methods.md
# Layering: wire/civil native; clock read and timer verbs over stream `ad`
# (`tempus:*` routes). Duration constants are pure numeric literals.
#
# Timer model: rather than Faber implementing the delay itself or registering
# callbacks, timers open an `ad` route to the host, which holds the request
# for the requested duration before responding. One-shot timers (sleep)
# block on the materialized response; recurring timers (interval) return a
# cursor that drains indefinitely. This matches the HTTP server pattern —
# the host is the event edge; Faber owns the iteration.


# Why: Pad a single-digit field to two decimal characters for RFC3339 wire.
@ private
fn pad2(int n) → string {
    if n ≺ 10 then return "0§"(n ↦ string)

    return n ↦ string
}

# Why: Pad a year (or similar) to four decimal digits on the wire.
@ private
fn pad4(int n) → string {
    var string out ↤ n
    while out.length() ≺ 4 {
        out ← "0§"(out)
    }
    return out
}

# Why: Slice a fixed wire substring and parse it as a civil integer field.
@ private
fn field(instant t, int start, int end) → int {
    const string wire ↤ t
    # An instant's canonical wire has digits at every civil position, so the default never applies.
    return wire.slice(start, end) ↦ int ⊥ 0
}

# Why: Build canonical UTC RFC3339 wire from civil components (always ends with Z).
@ private
fn wire(int year, int month, int day, int hour, int minute, int second) → string {
    return "§-§-§T§:§:§Z"(pad4(year), pad2(month), pad2(day), pad2(hour), pad2(minute), pad2(second))
}

# =========================================================================
# WIRE ↔ INSTANT
# =========================================================================

# Verb: parse from "solvere" (to loosen, untangle)
@ public
fn parse(string wire) → instant ⇥ string {
    return wire ↦ instant
}

# Verb: render from "exprimere" (to express, render outward)
@ public
fn render(instant t) → string {
    return t ↦ string
}

# =========================================================================
# CIVIL PROJECTION (UTC wire fields, 1-indexed months)
# =========================================================================

# Why: Four-digit calendar year from wire positions [0, 4).
@ public
fn year(instant t) → int {
    return field(t, 0, 4)
}

# Why: Month of year (1-indexed) from wire positions [5, 7).
@ public
fn month(instant t) → int {
    return field(t, 5, 7)
}

# Why: Day of month from wire positions [8, 10).
@ public
fn day(instant t) → int {
    return field(t, 8, 10)
}

# Why: UTC hour from wire positions [11, 13).
@ public
fn hour(instant t) → int {
    return field(t, 11, 13)
}

# Why: UTC minute from wire positions [14, 16).
@ public
fn minute(instant t) → int {
    return field(t, 14, 16)
}

# Why: UTC second from wire positions [17, 19); sub-second wire tails are floored.
@ public
fn second(instant t) → int {
    return field(t, 17, 19)
}

# =========================================================================
# STRICT CIVIL CONSTRUCTION (UTC)
# =========================================================================

# Verb: construct from "struere" (to build, arrange)
# Why: midnight UTC from calendar date; invalid civil input throws.
@ public
fn construct(int year, int month, int day) → instant ⇥ string {
    const string wire_text ← wire(year, month, day, 0, 0, 0)
    return wire_text ↦ instant
}

# Verb: construct_moment — full civil moment (date + time)
# Why: UTC instant from all civil components; invalid input throws.
@ public
fn construct_moment(int year, int month, int day, int hour, int minute, int second) → instant ⇥ string {
    const string wire_text ← wire(year, month, day, hour, minute, second)
    return wire_text ↦ instant
}

# =========================================================================
# WALL CLOCK (can jump forward/backward)
# =========================================================================

# Current epoch time in nanoseconds (canonical wall clock; downconvert at use site)
@ public
fn now() → instant<ns> {
    return call 'tempus:nunc' ↦ instant<ns>
}

# =========================================================================
# MONOTONIC CLOCK (never decreases)
# =========================================================================

@ public
fn monotonic() → int {
    return call 'tempus:monotonicum' ↦ int
}

@ public
fn active() → int {
    return call 'tempus:activum' ↦ int
}

# =========================================================================
# SLEEP / DELAY (host-side timer — Faber blocks on the host response)
# =========================================================================
# Verb: sleep/sleep_async from "dormire" (to sleep)
# Why: The host holds the request for `ms` milliseconds before responding,
# so the caller's materialization blocks for the delay. No callback
# registration, no Faber-side timing — the host is the event edge.
# Both postures share `tempus:dormiet`; `@ future` is caller posture, not a
# second route.

@ public
@ future
fn sleep_async(int ms) → void {
    return call 'tempus:dormiet' (ms) ↦ void
}

@ public
fn sleep(int ms) → void {
    return call 'tempus:dormiet' (ms) ↦ void
}

# =========================================================================
# TIMER STREAMS (host pushes events; Faber drains via cursor)
# =========================================================================
# Verb: interval from "vigilare" (to watch, stay awake)
# Why: Recurring timer; host pushes one frame per interval; Faber drains
# the cursor. Stop by dropping the cursor or breaking the iteration.
# Deferred as a bodiless `@ unstable` declaration: the runtime cannot yet return live inbound
# cursor values from functions ("live tuus cursor values cannot be returned
# from functions yet"). Matches thesaurus.messages. A native Faber `ad`
# body becomes possible once cursor-return-from-function ships.
@ cursor
@ public
@ unstable "deferred pending Stage 2 dispatch"
fn interval(int ms) → iterator<instant>

# =========================================================================
# DURATION CONSTANTS (milliseconds — pure numeric literals)
# =========================================================================
# Why: trivial native Faber bodies; no host route needed.

@ public
fn MILLISECOND() → int {
    return 1
}

@ public
fn SECOND() → int {
    return 1000
}

@ public
fn MINUTE() → int {
    return 60000
}

@ public
fn HOUR() → int {
    return 3600000
}

@ public
fn DAY() → int {
    return 86400000
}
