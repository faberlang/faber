+++
locale = "en"
+++

# encoding.fab - Encoding/Decoding
#
# Etymology: encoding — book / code; Latin locale spelling `codex`.
#
# Part of the Standard Library.
#
# Design notes:
# - All operations are synchronous (pure in-memory transforms)
# - Encoding: raw bytes → text representation
# - Decoding: text representation → raw bytes
# - URL encoding operates on text (percent-encoding)
# - Public surface migrates to norma:text (pange/solve/tempta). See
# docs/stdlib/chorda-methods.md and docs/stdlib/stdlib-mechanical-verbs.md.

# =========================================================================
# BASE64
# =========================================================================

@ private
fn alphabet() → string {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

@ private
fn byte_at(bytes data, int i) → int {
    return (data.get(i) coalesce (0 ∷ b8)) ↦ u8 ↦ int
}

@ private
fn hex_digit(int digit) → string {
    return "0123456789abcdef".slice(digit, digit + 1)
}

fn hex_digit_upper(int digit) → string {
    return "0123456789ABCDEF".slice(digit, digit + 1)
}

@ private
fn hex_value(string c) → int ∪ none {
    const string lower ← "0123456789abcdef"
    const string upper ← "0123456789ABCDEF"
    var int digit ← 0
    while digit ≺ 16 {
        if lower.slice(digit, digit + 1) ≡ c or upper.slice(digit, digit + 1) ≡ c then return digit
        digit ← digit + 1
    }
    return null
}

@ private
fn sextet(int bits) → string {
    return alphabet().slice(bits, bits + 1)
}

# Encode bytes to base64 string
@ public
fn base64(bytes data) → string {
    var string out ← ""
    var int i ← 0
    const int n ← data.length()
    while i + 3 ≤ n {
        const int b0 ← byte_at(data, i)
        const int b1 ← byte_at(data, i + 1)
        const int b2 ← byte_at(data, i + 2)
        const int triple ← (b0 * 65536) + (b1 * 256) + b2
        out ← out + sextet((triple / 262144) % 64)
        out ← out + sextet((triple / 4096) % 64)
        out ← out + sextet((triple / 64) % 64)
        out ← out + sextet(triple % 64)
        i ← i + 3
    }
    const int rem ← n - i
    if rem ≡ 1 {
        const int b0 ← byte_at(data, i)
        const int triple ← b0 * 65536
        out ← out + sextet((triple / 262144) % 64)
        out ← out + sextet((triple / 4096) % 64)
        out ← out + "=="
    }
    if rem ≡ 2 {
        const int b0 ← byte_at(data, i)
        const int b1 ← byte_at(data, i + 1)
        const int triple ← (b0 * 65536) + (b1 * 256)
        out ← out + sextet((triple / 262144) % 64)
        out ← out + sextet((triple / 4096) % 64)
        out ← out + sextet((triple / 64) % 64)
        out ← out + "="
    }
    return out
}

@ private
fn alphabet_index(string c) → int ∪ none {
    var int i ← 0
    const string table ← alphabet()
    while i ≺ 64 {
        if table.slice(i, i + 1) ≡ c then return i
        i ← i + 1
    }
    return null
}

# Decode base64 string to bytes (throws on invalid input)
@ public
fn decode_base64(string data) → bytes ⇥ string {
    var list<int> sextets ← []
    var int i ← 0
    while i ≺ data.length() {
        const string c ← data.slice(i, i + 1)
        if c ≡ " " or c ≡ "\n" or c ≡ "\r" or c ≡ "\t" {
            i ← i + 1
            continue
        }
        if c ≡ "=" then break
        const int ∪ none idx ← alphabet_index(c)
        if idx is none then throw "norma:encoding.decode_base64: invalid character"
        sextets.append(idx ↦ int ⊥ 0)
        i ← i + 1
    }
    var int pads ← 0
    while i ≺ data.length() {
        const string c ← data.slice(i, i + 1)
        if c ≡ "=" {
            pads ← pads + 1
        }
        elif c ≢ " " and c ≢ "\n" and c ≢ "\r" and c ≢ "\t" {
            throw "norma:encoding.decode_base64: invalid character after padding"
        }
        i ← i + 1
    }
    if sextets.length() % 4 ≡ 1 then throw "norma:encoding.decode_base64: truncated input"
    var list<u8> out ← []
    var int j ← 0
    const int n ← sextets.length()
    while j ≺ n {
        const int s0 ← sextets.get(j) coalesce 0
        const int s1 ← sextets.get(j + 1) coalesce 0
        const int s2 ← sextets.get(j + 2) coalesce 0
        const int s3 ← sextets.get(j + 3) coalesce 0
        const int triple ← (s0 * 262144) + (s1 * 4096) + (s2 * 64) + s3
        out.append(((triple / 65536) % 256) ↦ u8 ⊥ 0)
        if j + 2 ≺ n then out.append(((triple / 256) % 256) ↦ u8 ⊥ 0)
        if j + 3 ≺ n then out.append((triple % 256) ↦ u8 ⊥ 0)
        j ← j + 4
    }
    return out ↦ list<b8>
}

# Attempt to decode base64 (returns nihil on invalid input)
@ public
fn try_decode_base64(string data) → bytes ∪ none {
    do {
        return decode_base64(data)
    }
    catch err {
        return null
    }
}

# =========================================================================
# HEX
# =========================================================================

# Encode bytes to lowercase hex string
@ public
fn hex(bytes data) → string {
    var string out ← ""
    var int i ← 0
    while i ≺ data.length() {
        const int b ← byte_at(data, i)
        out ← out + hex_digit(b / 16)
        out ← out + hex_digit(b % 16)
        i ← i + 1
    }
    return out
}

# Decode hex string to bytes (throws on invalid input)
@ public
fn decode_hex(string data) → bytes ⇥ string {
    if data.length() % 2 ≢ 0 then throw "norma:encoding.decode_hex: odd digit count"
    var list<u8> out ← []
    var int i ← 0
    while i ≺ data.length() {
        const int ∪ none hi ← hex_value(data.slice(i, i + 1))
        const int ∪ none lo ← hex_value(data.slice(i + 1, i + 2))
        if hi is none or lo is none then throw "norma:encoding.decode_hex: invalid hex digit"
        out.append(((hi ↦ int ⊥ 0) * 16 + (lo ↦ int ⊥ 0)) ↦ u8 ⊥ 0)
        i ← i + 2
    }
    return out ↦ list<b8>
}

# Attempt to decode hex (returns nihil on invalid input)
@ public
fn try_decode_hex(string data) → bytes ∪ none {
    do {
        return decode_hex(data)
    }
    catch err {
        return null
    }
}

# =========================================================================
# URL ENCODING (percent-encoding)
# =========================================================================

@ private
fn is_unreserved(string c) → bool {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~".contains(c)
}

@ private
fn percent_encode_bytes(bytes raw) → string {
    var string out ← ""
    var int i ← 0
    while i ≺ raw.length() {
        const int b ← byte_at(raw, i)
        out ← out + "%§§"(hex_digit_upper(b / 16), hex_digit_upper(b % 16))
        i ← i + 1
    }
    return out
}

@ private
fn encode_form(string data, bool plus_space) → string {
    var string out ← ""
    var int i ← 0
    while i ≺ data.length() {
        const string c ← data.slice(i, i + 1)
        if plus_space and c ≡ " " {
            out ← out + "+"
        }
        elif is_unreserved(c) {
            out ← out + c
        }
        else {
            out ← out + percent_encode_bytes(c ↦ bytes)
        }
        i ← i + 1
    }
    return out
}

# Encode text for URL (percent-encoding; space becomes +)
@ public
fn url(string data) → string {
    return encode_form(data, true)
}

@ private
fn decode_percent(string data, bool plus_space) → string ⇥ string {
    var list<u8> out ← []
    var int i ← 0
    while i ≺ data.length() {
        const string c ← data.slice(i, i + 1)
        if plus_space and c ≡ "+" {
            out.append(32 ↦ u8 ⊥ 0)
            i ← i + 1
        }
        elif c ≡ "%" {
            if i + 3 ≻ data.length() then throw "norma:encoding.decode_url: truncated escape"
            const int ∪ none hi ← hex_value(data.slice(i + 1, i + 2))
            const int ∪ none lo ← hex_value(data.slice(i + 2, i + 3))
            if hi is none or lo is none then throw "norma:encoding.decode_url: invalid escape"
            out.append(((hi ↦ int ⊥ 0) * 16 + (lo ↦ int ⊥ 0)) ↦ u8 ⊥ 0)
            i ← i + 3
        }
        else {
            const bytes raw ← c ↦ bytes
            var int k ← 0
            while k ≺ raw.length() {
                out.append((raw.get(k) coalesce (0 ∷ b8)) ↦ u8)
                k ← k + 1
            }
            i ← i + 1
        }
    }
    return (out ↦ list<b8>) ↦ string
}

# Decode URL-encoded text
@ public
fn decode_url(string data) → string ⇥ string {
    return decode_percent(data, true)
}

# Encode for URL query component (also encodes &, =, etc.)
@ public
fn encode_url_component(string data) → string {
    return encode_form(data, false)
}

# Decode URL query component
@ public
fn decode_url_component(string data) → string ⇥ string {
    return decode_percent(data, false)
}
