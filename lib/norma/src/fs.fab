# =========================================================================
# PATH UTILITIES (proxies — canonical definitions live in norma:fs/path)
# =========================================================================
# These top-level proxies preserve the facade while sharing the canonical
# solum:* routes with norma:fs/path.

# Join path segments
@ public
fn join(list<string> parts) → string {
    return call 'solum:iunge' (parts) ↦ string
}

# Parent path segment (directory part)
@ public
fn parent(string path) → string {
    return call 'solum:parens' (path) ↦ string
}

# Final path segment (filename)
@ public
fn file_name(string path) → string {
    return call 'solum:nomen' (path) ↦ string
}

# File extension (includes dot)
@ public
fn extension(string path) → string {
    return call 'solum:suffixum' (path) ↦ string
}

# Resolve to absolute path
@ public
fn resolve(string path) → string {
    return call 'solum:absolve' (path) ↦ string
}

# Get user's home directory
@ public
fn home() → string {
    return call 'solum:domus' ↦ string
}

# Get system temp directory
@ public
fn temp_dir() → string {
    return call 'solum:temporarium' ↦ string
}

@ private
fn join_two(string base, string segment) → string {
    if base.ends_with("/") {
        return "§§"(base, segment)
    }
    return "§/§"(base, segment)
}

# =========================================================================
# SHALLOW GLOB (native composition — v1 single-segment star)
# =========================================================================
#
# Contract: glob(radix, exemplar) → lista<textus> ⇥ textus
# v1: * matches exactly one path segment (e.g. "*/SKILL.md").
#
@ public
fn glob(string root, string pattern) → list<string> ⇥ string {
    const list<string> segments ← pattern.split("/")
    var list<string> candidatos ← [root]
    var int index ← 0
    while index ≺ segments.length() {
        const string segment ← segments.get(index) coalesce ""
        if segment ≡ "" {
            throw "empty path segment in solum.glob pattern"
        }

        var list<string> proximos ← []
        if segment ≡ "*" {
            for from candidatos const base {
                const list<string> entries ← list_dir(base)
                for from entries const entry {
                    proximos.append(join_two(base, entry))
                }
            }
        }
        else {
            for from candidatos const base {
                const string path ← join_two(base, segment)
                if exists(path) {
                    proximos.append(path)
                }
            }
        }

        candidatos ← proximos
        index ← index + 1
    }
    return candidatos
}
