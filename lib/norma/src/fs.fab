@ public
fn touch_async(string path) → void {
    return call 'solum:tanget' (path) ↦ void
}

# Set permission/mode bits.
@ public
fn set_mode(string path, int mode) → void {
    const list<value> args ← [path ↦ value, mode ↦ value]
    return call 'solum:modum' (args) ↦ void
}

