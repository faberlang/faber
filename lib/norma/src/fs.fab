# Delete file (sync)
@ public
fn delete(string path) → void {
    return call 'solum:dele' (path) ↦ void
}

# Delete file (async route; Faber blocks)
@ future
@ public
fn delete_async(string path) → void {
    return call 'solum:delet' (path) ↦ void
}

