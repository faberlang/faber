+++
locale = "en"
+++

# fs.fab - File System Device
#
# Etymology: fs — ground / base, local file I/O; Latin locale spelling `solum`.
#
# Operations route over `ad`; stat/stat_async are bodiless `@ unstable` declarations (refused at
# compile time) until Stage 2 can materialize FileStatus values.
# Top-level path operations proxy norma:fs/path for compatibility.
#
# Sync and async wrappers use the same `ad` frame contract; `@ future` marks the
# async caller posture. Text, bytes, and lines use distinct public operations.


# =============================================================================
# TYPES
# =============================================================================

# Full file status returned by stat/stat_async
# Maps to: stat(), lstat()
@ public
class FileStatus {
    var int mode
    # permission bits (e.g., 0o755)
    var int link_count
    # hard link count
    var int owner
    # owner uid
    var int group
    # group gid
    var int byte_length
    # size in bytes
    var int modified
    # mtime (ms since epoch)
    var bool is_directory
    var bool is_symlink
}

# =========================================================================
# READING - Text
# =========================================================================
# Maps to: fs.readFileSync(path, 'utf8') / fs.readFile(path, 'utf8')

# Read entire file as text (sync)
@ public
@ radix type T mut string list<string> bytes
fn read_file<T>(string path) → T {
    return call 'solum:lege' (path) ↦ T
}

# Read entire file as text with async caller materialization.
@ public
@ radix type T mut string list<string> bytes
@ future
fn read_file_async<T>(string path) → T {
    return call 'solum:lege' (path) ↦ T
}

# =========================================================================
# READING - Bytes
# =========================================================================
# Maps to: fs.readFileSync(path) / fs.readFile(path) returning Buffer

# Draw entire file as bytes (sync)
@ public
fn read_bytes(string path) → bytes {
    return call 'solum:hauri' (path) ↦ bytes
}

# Draw entire file as bytes (async route; Faber blocks on the frame)
@ future
@ public
fn read_bytes_async(string path) → bytes {
    return call 'solum:hauriet' (path) ↦ bytes
}

# Draw a bounded byte range from a file.
@ public
fn read_range(string path, int offset, int length) → bytes {
    const list<value> args ← [path ↦ value, offset ↦ value, length ↦ value]
    return call 'solum:partem' (args) ↦ bytes
}

# Find a text byte pattern within a bounded file range, or -1 when absent.
@ public
fn find(string path, string pattern, int offset, int length) → int {
    const list<value> args ← [path ↦ value, pattern ↦ value, offset ↦ value, length ↦ value]
    return call 'solum:inveni' (args) ↦ int
}

# =========================================================================
# READING - Lines
# =========================================================================
# Maps to: readline interface or line-by-line file reading

# Pluck lines from file (sync)
@ public
fn read_lines(string path) → list<string> {
    return call 'solum:carpe' (path) ↦ list<string>
}

# Pluck lines from file (async route; Faber blocks on the frame)
@ future
@ public
fn read_lines_async(string path) → list<string> {
    return call 'solum:carpiet' (path) ↦ list<string>
}

# =========================================================================
# WRITING - Text
# =========================================================================
# Maps to: fs.writeFileSync(path, data, 'utf8') / fs.writeFile(...)

# Write text to file, overwrites existing (sync)
@ public
fn write_file(string path, string data) → void {
    return call 'solum:scribe' ([path, data]) ↦ void
}

# Write text to file, overwrites existing (async route; Faber blocks)
@ future
@ public
fn write_file_async(string path, string data) → void {
    return call 'solum:scribet' ([path, data]) ↦ void
}

# =========================================================================
# WRITING - Bytes
# =========================================================================
# Maps to: fs.writeFileSync(path, buffer) / fs.writeFile(path, buffer)

# Pour bytes to file, overwrites existing (sync)
@ public
fn write_bytes(string path, bytes data) → void {
    const list<value> args ← [path ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# Pour bytes to file with async caller materialization.
@ public
@ future
fn write_bytes_async(string path, bytes data) → void {
    const list<value> args ← [path ↦ value, data ↦ value]
    return call 'solum:funde' (args) ↦ void
}

# =========================================================================
# WRITING - Append
# =========================================================================
# Maps to: fs.appendFileSync(path, data) / fs.appendFile(path, data)

# Append text to file (sync)
@ public
fn append(string path, string data) → void {
    return call 'solum:appone' ([path, data]) ↦ void
}

# Append text to file (async route; Faber blocks)
@ future
@ public
fn append_async(string path, string data) → void {
    return call 'solum:apponet' ([path, data]) ↦ void
}

# =========================================================================
# FILE INFO - Existence
# =========================================================================
# Maps to: fs.existsSync(path) / fs.access(path)

# Check if path exists (sync)
@ public
fn exists(string path) → bool {
    return call 'solum:exstat' (path) ↦ bool
}

# Check if path exists (async route; Faber blocks)
@ future
@ public
fn exists_async(string path) → bool {
    return call 'solum:exstabit' (path) ↦ bool
}

# True when path metadata says directory.
@ public
fn is_directory(string path) → bool {
    return call 'solum:directoriumne' (path) ↦ bool
}

# True when path metadata says regular file.
@ public
fn is_regular(string path) → bool {
    return call 'solum:regularene' (path) ↦ bool
}

# True when path is a regular file and can be opened for reading.
@ public
fn is_readable(string path) → bool {
    return call 'solum:legibilene' (path) ↦ bool
}

# True when path itself is a symbolic link.
@ public
fn is_symlink(string path) → bool {
    return call 'solum:vinculumne' (path) ↦ bool
}

# File size in bytes.
@ public
fn byte_length(string path) → int {
    return call 'solum:mensura' (path) ↦ int
}

# Permission/mode bits as a numeric value.
@ public
fn mode(string path) → int {
    return call 'solum:modus' (path) ↦ int
}

# =========================================================================
# FILE INFO - Details
# =========================================================================
# Maps to: fs.statSync(path) / fs.stat(path) - uses lstat to not follow symlinks

# Get file details (sync)
# WHY: deferred because the `ad` materializer does not support
# arbitrary genera like SolumStatus — only vacuum, valor, scalars, octeti,
# instans, and lista<T> (empirically confirmed July 2026). Migrating to
# `ad` requires extending the materializer's conversio-valor genus table
# to lower SolumStatus as a Tabula walk. The host gateway work is the
# right moment to land that.
@ public
@ unstable "deferred pending Stage 2 dispatch"
fn stat(string path) → FileStatus

# Get file details (async — same materializer blocker as stat)
@ future
@ public
@ unstable "deferred pending Stage 2 dispatch"
fn stat_async(string path) → FileStatus

# =========================================================================
# FILE INFO - Symlinks
# =========================================================================
# Maps to: fs.readlinkSync(path) / fs.readlink(path)

# Follow symlink to get target path (sync)
@ public
fn read_link(string path) → string {
    return call 'solum:sequere' (path) ↦ string
}

# Follow symlink to get target path (async route; Faber blocks)
@ future
@ public
fn read_link_async(string path) → string {
    return call 'solum:sequetur' (path) ↦ string
}

# Create a symbolic link pointing from destinatio to fons.
@ public
fn create_link(string source, string destination) → void {
    return call 'solum:vincula' ([source, destination]) ↦ void
}

