# List directory contents (sync)
@ public
fn list_dir(string path) → list<string> {
    return call 'solum:enumera' (path) ↦ list<string>
}

# List directory contents (async route; Faber blocks)
@ future
@ public
fn list_dir_async(string path) → list<string> {
    return call 'solum:enumerabit' (path) ↦ list<string>
