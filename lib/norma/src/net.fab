+++
locale = "en"
+++

# net.fab - Network Socket Device (TCP)
#
# Public import: import from "norma:net" net
# Sub-modules: norma:net/endpoint, norma:net/connection, norma:net/listener
#
# TLS: `listen_tls(port, cert, key)` for PEM paths; `connect` takes `secure`.

import from "norma:net/endpoint" endpoint
import from "norma:net/connection" connection
import from "norma:net/listener" listener

@ public
fn listen(int port) → listener.Listener {
    const int id ← call 'caelum:ausculta' (port) ↦ int
    return listener.Listener { id = id }
}

@ public
@ future
fn listen_async(int port) → listener.Listener {
    const int id ← call 'caelum:auscultabit' (port) ↦ int
    return listener.Listener { id = id }
}

@ public
fn listen_tls(int port, string cert, string key) → listener.Listener {
    const int id ← call 'caelum:ausculta' ([port ↦ value, cert ↦ value, key ↦ value]) ↦ int
    return listener.Listener { id = id }
}

@ public
fn connect(string host, int port, bool secure optional coalesce false) → connection.Socket {
    const int id ← call 'caelum:necte' ([host ↦ value, port ↦ value, secure ↦ value]) ↦ int
    return connection.Socket { id = id }
}

@ public
@ future
fn connect_async(string host, int port, bool secure optional coalesce false) → connection.Socket {
    const int id ← call 'caelum:nectet' ([host ↦ value, port ↦ value, secure ↦ value]) ↦ int
    return connection.Socket { id = id }
}
