+++
locale = "en"
+++
# toml/serialize.fab — TOML wire serializer
#
# Ordinary Faber. Renders a codec-neutral value tree as TOML text.
# Nested maps become [tables]; lists of maps become [[array of tables]].

import from "norma:text" text

@ public
fn stringify(value document) → string ⇥ string {
    if document is none then throw "norma:toml.stringify: TOML has no null"
    if document is map<string, value> {
        const map<string, value> fields ↤ document ⊥ empty
        return encode_document(document)
    }
    throw "norma:toml.stringify: document must be a table"
}

fn as_text(value node) → string {
    return node ↦ string ⊥ ""
}

fn as_bool(value node) → bool {
    return node ↦ bool ⊥ false
}

fn as_integer(value node) → inf {
    return node ↦ inf ⊥ 0
}

fn as_float(value node) → float {
    return node ↦ float ⊥ 0.0
}

fn quote(string s) → string {
    var string out ← «"»
    var int i ← 0
    while i ≺ s.length() {
        const string c ← s.slice(i, i + 1)
        if c ≡ «"» {
            out ← out + «\\"»
        }
        elif c ≡ "\\" {
            out ← out + "\\\\"
        }
        elif c ≡ "\n" {
            out ← out + "\\n"
        }
        elif c ≡ "\r" {
            out ← out + "\\r"
        }
        elif c ≡ "\t" {
            out ← out + "\\t"
        }
        else {
            out ← out + c
        }
        i ← i + 1
    }
    return out + «"»
}

fn is_bare_key(string key) → bool {
    if key.length() ≡ 0 then return false
    var int i ← 0
    while i ≺ key.length() {
        const string c ← key.slice(i, i + 1)
        if not "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-".contains(c) {
            return false
        }
        i ← i + 1
    }
    return true
}

fn emit_key(string key) → string {
    if is_bare_key(key) then return key
    return quote(key)
}

fn encode_scalar(value node) → string ⇥ string {
    if node is bool {
        if as_bool(node) then return "true"
        return "false"
    }
    if node is string then return quote(as_text(node))
    if node is int then return as_integer(node) ↦ string
    if node is float then return as_float(node) ↦ string
    if node is instant {
        const string wire ↤ node ⊥ ""
        return wire
    }
    if node is none then throw "norma:toml.stringify: TOML has no null"
    do {
        const inf big ↤ node
        return big ↦ string
    }
    catch err {
    }
    throw "norma:toml.stringify: unsupported scalar"
}

fn encode_array(list<value> items) → string ⇥ string {
    var list<string> encoded ← empty
    for from items const item {
        if item is map<string, value> then throw "norma:toml.stringify: table arrays must be top-level [[tables]]"
        if item is list<value> {
            const list<value> nested ↤ item ⊥ empty
            encoded.append(encode_array(nested))
        }
        else {
            encoded.append(encode_scalar(item))
        }
    }
    return text.join(["[", text.join(encoded, ", "), "]"], "")
}

fn is_table_array(list<value> items) → bool {
    for from items const item {
        if not (item is map<string, value>) then return false
    }
    return true
}

fn encode_value(value node) → string ⇥ string {
    if node is list<value> {
        const list<value> items ↤ node ⊥ empty
        return encode_array(items)
    }
    if node is map<string, value> {
        const map<string, value> table ↤ node ⊥ empty
        var list<string> keys ← table.keys()
        keys.sort()
        var list<string> pairs ← empty
        for from keys const key {
            pairs.append(text.join([emit_key(key), " = ", encode_value(table[key])], ""))
        }
        return text.join(["{ ", text.join(pairs, ", "), " }"], "")
    }
    return encode_scalar(node)
}

fn encode_members(map<string, value> fields) → string ⇥ string {
    var list<string> keys ← fields.keys()
    keys.sort()
    var list<string> members ← empty
    for from keys const key {
        members.append(text.join([emit_key(key), " = ", encode_value(fields[key])], ""))
    }
    return text.join(members, "\n") + "\n"
}

fn encode_document(value document) → string ⇥ string {
    const map<string, value> fields ↤ document ⊥ empty
    var list<string> keys ← fields.keys()
    keys.sort()
    var list<string> members ← empty
    var list<string> tables ← empty
    for from keys const key {
        const value item ↤ fields[key]
        if item is map<string, value> {
            const map<string, value> inner ↤ item ⊥ empty
            tables.append(text.join(["[", emit_key(key), "]\n", encode_members(inner), "\n"], ""))
        }
        elif item is list<value> {
            const list<value> items ↤ item ⊥ empty
            if is_table_array(items) {
                for from items const entry {
                    const map<string, value> inner ↤ entry ⊥ empty
                    tables.append(text.join(["[[", emit_key(key), "]]\n", encode_members(inner), "\n"], ""))
                }
            }
            else {
                members.append(text.join([emit_key(key), " = ", encode_value(item)], ""))
            }
        }
        else {
            members.append(text.join([emit_key(key), " = ", encode_value(item)], ""))
        }
    }
    return text.join(members, "\n") + "\n" + text.join(tables, "")
}
