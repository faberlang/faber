+++
locale = "en"
+++

# Exemplum server: stream N SSE frames over one connection with O(1)
# in-language memory (each write is the current event only). Mode `stall`
# writes large frames so a stalled reader blocks the write loop.
#
# `faber check` compiles the listen/open_sse/send_event loop. A rust
# package run currently hits the faber-runtime tag-pin plus rust-emit
# residuals in the imported module graph (same window as client-io).
# N5: `http:*` is served by `faber-leaf` on both runtimes.
#
# argv: [mode] [port] [n]
#   mode = sse (default) | stall
#   port = listen port (default 18766)
#   n    = frame count (default 8)

import from "norma:http/server" server
import from "norma:http/sse" sse
import from "norma:http/headers" headers
import from "norma:http/request" httpreq
import from "norma:process" process

fn arg_at(int index, string fallback) → string {
    let list<string> args ← process.argv()
    if args.length() ≻ index {
        let string ∪ none item ← args.get(index)
        if item not is none {
            return item ↦ string
        }
    }
    return fallback
}

# 64 KiB payload via doubling — O(n) copies, not per-byte concat.
fn stall_frame() → list<b8> {
    mut string block ← "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    mut int i ← 0
    while i ≺ 10 {
        block ← block + block
        i ← i + 1
    }
    return block ↦ list<b8>
}

main {
    let string mode ← arg_at(0, "sse")
    let int port ↤ arg_at(1, "18766")
    let int n ↤ arg_at(2, "8")

    let server.Listener listener ← server.bind(port)
    print "listening"
    print port

    let server.Incoming incoming ← server.accept_incoming(listener.handle)
    print "accepted"
    print incoming.id
    let httpreq.Request req ← incoming.req
    print req.path

    let headers.Headers head ← req.headers
    let bool persist ← server.keep_alive(head)
    let server.Stream stream ← server.open_sse(incoming)

    if mode ≡ "stall" {
        let list<b8> frame ← stall_frame()
        print "frame-bytes"
        print frame.length()
        mut int i ← 0
        while i ≺ n {
            print "write-start"
            print i
            server.write_chunk(stream, frame)
            print "write-done"
            print i
            i ← i + 1
        }
    }
    else {
        mut int i ← 0
        while i ≺ n {
            print "write-start"
            print i
            let sse.Event ev ← sse.Event {
                name = "",
                data = i ↦ string,
                id = "",
                retry = ""
            }
            server.send_event(stream, ev)
            print "write-done"
            print i
            i ← i + 1
        }
    }

    server.finish_stream(stream, persist)
    server.stop(listener.handle)
    print "done"
}
