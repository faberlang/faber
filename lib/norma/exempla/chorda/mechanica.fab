locale = "en"
+++

# chorda/mechanica — UTF-8 mechanical trio contract tests
#
# encode: textus → list<b8> (UTF-8 encode)
# decode: list<b8> → textus (UTF-8 decode, throws on invalid)
# try_decode: list<b8> → textus ∪ nihil (tries decode, returns nihil on invalid)
#
# N4a: encode/decode/try_decode are ordinary Faber bodies.

import from "norma:chorda" chorda

main {
    let list<b8> hello ← chorda.encode("Salve")
    assert chorda.decode(hello) ≡ "Salve"
    assert chorda.decode(chorda.encode("")) ≡ ""
    assert chorda.decode(chorda.encode("π ≈ 3.14")) ≡ "π ≈ 3.14"
    assert chorda.decode(|68 65 6c 6c 6f|) ≡ "hello"
    assert chorda.decode(|ce bb|) ≡ "λ"
    let string ∪ none ok ← chorda.try_decode(|68 65 6c 6c 6f|)
    assert ok ≡ "hello"
    let string ∪ none bad ← chorda.try_decode(|ff fe|)
    assert bad is none
    print "mechanica-ok"
}
