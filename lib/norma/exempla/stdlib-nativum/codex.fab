# stdlib-nativum/codex — norma:encoding encoding/decoding API contract tests
#
# N4a: all public functions are ordinary Faber bodies.

import from "norma:encoding" encoding

main {
    assert encoding.base64(|61 62 63|) ≡ "YWJj"
    assert encoding.hex(encoding.decode_base64("AQID")) ≡ "010203"
    assert encoding.try_decode_base64("!!!!") is none

    assert encoding.hex(|61 62 63|) ≡ "616263"
    assert encoding.hex(encoding.decode_hex("616263")) ≡ "616263"
    assert encoding.try_decode_hex("zz") is none

    assert encoding.url("hello world") ≡ "hello+world"
    assert encoding.decode_url("hello+world") ≡ "hello world"
    assert encoding.encode_url_component("a&b=c") ≡ "a%26b%3Dc"
    assert encoding.decode_url_component("a%26b%3Dc") ≡ "a&b=c"
    print "codex-ok"
}
