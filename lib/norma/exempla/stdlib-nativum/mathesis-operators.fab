+++
term = "mathesis-operators"
kind = "concept"
category = "stdlib"
canonical = false
summary = "mathesis operator catalog vs glyph and receiver method parity."
syntax = "mathesis.add | x.added"
related = ["mathesis", "stdlib-nativum"]
locale = "en"
+++


# stdlib-nativum/mathesis-operators — catalog + glyph + receiver parity
#
# EXPECTED OUTPUT:
#   3.5
#   3.5
#   3.5
#   verum
#   16

import from "norma:mathesis" mathesis

main {
    const float x ← 1.5

    const float per_glyph ← x + 2.0
    const float per_method ← x.added(2.0)
    const float per_catalog ← mathesis.add(x, 2.0)
    const float pipeline ← x.added(1.0).multiplied(3.0)

    print per_glyph
    print per_method
    print per_catalog
    print pipeline
    assert mathesis.at_most(pipeline, 5.0)

    const int bits ← 1
    const int per_shift_glyph ← bits ⇐ 4
    const int per_shift_method ← bits.shifted_left(4)
    const int per_shift_catalog ← mathesis.shift_left(bits, 4)
    assert per_shift_glyph ≡ per_shift_method
    assert per_shift_method ≡ per_shift_catalog
    print per_shift_glyph
}
