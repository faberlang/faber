# stdlib-nativum/chorda — chorda v1 subset (cord + UTF-8 mechanical trio)
#
# EXPECTED OUTPUT:
#   amor
#   alpha_beta_gamma
#   2
#   verum
#   Salve
#   Salve

import from "norma:chorda" chorda

main {
    print chorda.reverse("roma")
    print chorda.join(["alpha", "beta", "gamma"], "_")
    print chorda.count("banana", "an")
    print chorda.is_palindrome("anna")
    const bytes raw ← chorda.encode("Salve")
    print chorda.decode(raw)
    const bytes probe ← chorda.encode("Salve")
    print chorda.try_decode(probe)
    print chorda.keep_between("hello7!", "a", "z")
    print chorda.collapse_spaces("  foo   bar  ")
    print chorda.split_n("a=b=c", "=", 2).first()
}
