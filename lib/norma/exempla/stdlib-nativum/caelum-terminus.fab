# stdlib-nativum/caelum-terminus — type-only file namespace import
#
# EXPECTED OUTPUT:
#   localhost

import from "norma:caelum/terminus" terminus

main {
    const terminus.Endpoint endpoint ← terminus.Endpoint {
        host = "localhost",
        port = 8080
    }
    print endpoint.host
}
