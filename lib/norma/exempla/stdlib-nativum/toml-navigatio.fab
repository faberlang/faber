+++
# stdlib-nativum/toml-navigatio — native valor tree walk over parsed TOML
#
# EXPECTED OUTPUT:
#   faber, 1, sample

import from "norma:toml" toml
import from "norma:valor" value

fn sampleToml() → string {
    return «name = "faber"
version = 1
id = "sample"»
}

main {
    const value doc ← toml.parse(sampleToml())

    assert value.is_map(doc)
    assert value.is_string(value.get(doc, "name"))
    assert value.is_int(value.get(doc, "version"))
    assert value.is_null(doc) ≡ false

    const string name ↤ value.get(doc, "name") ⊥ "missing"
    const int version ↤ value.get(doc, "version") ⊥ 0
    const string id ↤ value.find(doc, "id") ⊥ "missing"

    do {
        const string required ← value.require_string(doc, "id")
        assert required ≡ "sample"
    }
    catch err {
        assert false
    }

    assert name ≡ "faber"
    assert version ≡ 1
    assert id ≡ "sample"

    do {
        value.require_string(doc, "absent")
        assert false
    }
    catch err {
        assert err.contains("missing key")
    }

    print name, version, id
}
