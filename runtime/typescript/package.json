{
  "name": "@faber/runtime",
  "version": "0.1.0",
  "description": "Faber language runtime package for generated TypeScript: the display namespace (display.value and its renderers), and the regex namespace (@faber/runtime/regex).",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./regex": {
      "types": "./regex.ts",
      "default": "./regex.ts"
    }
  },
  "files": [
    "index.ts",
    "display.ts",
    "regex.ts",
    "tsconfig.json",
    "package.json"
  ],
  "private": true,
  "scripts": {
    "test": "node --test display.test.ts regex.test.ts"
  }
}
