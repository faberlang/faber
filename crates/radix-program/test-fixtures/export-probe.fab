# N4b materialization fixture (goal flow-narrowing-and-match-patterns, §N4b):
# the ruling-6 acceptance story — `fn probe(_ u)` with a type-pattern match.
# N4a's finalize writeback solves the param hole to `list ∪ string` and writes
# the normalized union back onto the HIR param slot, so the exported signature
# materializes at the S0-G6 file-interface seam instead of failing
# unrepresentable. Asserted end-to-end by
# `export_probe_fixture_materializes_solved_union_param`
# (`cargo test -p radix-program file_interface`).
#
# Validation: `cargo run -p faber -- check crates/radix-program/test-fixtures/export-probe.fab`

fn probe(_ u) → string {
    match u {
        case list<int> let xs { return "list" }
        case string let s { return "string" }
    }
}

main {
    print probe([1, 2])
    print probe("hi")
}
