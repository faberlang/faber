+++
locale = "en"
+++

# u3 — same success and error type: legal under the tagged form (ruling
# f9d8a611), because `R` and `T` are separate slots and the variants carry
# the discrimination. The `trap_union_collapsed` guard retired with the
# untagged union result.

class Payload {
    mut string message
}

fn same() → Payload ⇥ Payload {
    return Payload { message = "x" }
}

main {
    let _ r ← trap { same() }
    match r {
        case returned let value {
            print "returned"
            print value.message
        }
        case thrown let error {
            print "thrown"
            print error.message
        }
    }
}
