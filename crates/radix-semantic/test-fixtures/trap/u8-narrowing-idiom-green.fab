+++
locale = "en"
+++

# u8 — the ruled idiom over a trap: annotate the tagged result and read it
# with the variant arms. (The retired form spelled its annotation
# `T ∪ E` and narrowed with `is`; the tagged result is not a union, so that
# spelling now mismatches.)

fn failable(bool fail) → int ⇥ string {
    if fail {
        throw "boom"
    }
    return 42
}

main {
    let trapped<int, string> r ← trap { failable(false) }
    match r {
        case returned let value {
            print value
        }
        case thrown let error {
            print error.length()
        }
    }
}
