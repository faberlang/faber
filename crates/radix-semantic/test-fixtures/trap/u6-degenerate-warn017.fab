+++
locale = "en"
+++

# u6 — empty error channel: nothing inside can fail, so the `T` slot types
# as the uninhabited `never` and WARN036 (`trap_error_channel_empty`) fires
# instead of an inference error.

fn infallible() → int {
    return 42
}

main {
    let _ r ← trap { infallible() }
    match r {
        case returned let value {
            print value
        }
        case thrown let error {
            print "unreachable"
        }
    }
}
