+++
locale = "en"
+++

# u4 — partial overlap: the success type is also a member of the error
# channel. Legal; each slot keeps its own shape and the variants keep them
# apart.

fn partial() → int ⇥ int ∪ string {
    return 1
}

main {
    let _ r ← trap { partial() }
    match r {
        case returned let value {
            print value
        }
        case thrown let error {
            print "thrown"
        }
    }
}
