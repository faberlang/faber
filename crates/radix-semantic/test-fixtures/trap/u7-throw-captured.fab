+++
locale = "en"
+++

# u7 — an explicit `throw` inside the body is an alternate exit toward the
# same `T` slot; it wraps into `thrown { error }` and never reaches
# ReturnError.

fn failable() → int ⇥ string {
    throw "boom"
}

main {
    let _ r ← trap { failable() }
    match r {
        case returned let value {
            print value
        }
        case thrown let error {
            print error
        }
    }
}
