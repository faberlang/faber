+++
locale = "en"
+++

# u1 — the third answer: `trap` accepts a failable call and reifies the
# channel into the tagged genus `trapped<int, string>` (ruling f9d8a611):
# variants `returned { value }` / `thrown { error }`, read with a match.

fn failable() → int ⇥ string {
    return 42
}

main {
    let _ r ← trap { failable() }
    match r {
        case returned let value {
            print value
        }
        case thrown let error {
            print error
        }
    }
}
