+++
locale = "en"
+++
# `Genus { … } from source` copies every omitted field shallowly from the
# source and applies the given entries as overrides; the source may be any
# postfix expression, such as a call. The source itself is unchanged.

class Point {
    let int x
    mut int y
    let string name
    let list<int> steps
}

fn origin() → Point {
    return Point { x = 7, y = 2, name = "origin", steps = [0] }
}

main {
    let Point p ← Point { x = 1, y = 2, name = "origin", steps = [1, 2] }
    let Point q ← Point { y = 9 } from p
    print q.x
    print q.y
    print q.name
    print q.steps.length()
    let Point s ← Point {} from p
    print s.x
    print s.y
    print s.name
    let Point t ← Point { steps = [3, 4] } from origin()
    print t.x
    print t.name
    print t.steps.length()
}
