+++
locale = "en"
+++
# `list<wrapping<W>>`: the element is the plain width, its store reduces
# modulo 2^W, its read widens, and `get` carries the word's optional.

main {
    let list<wrapping<u8>> bytes ← [255, 1]
    print bytes
    print bytes.get(0) coalesce 0 ∷ wrapping<u8>
    print bytes.get(1) coalesce 0 ∷ wrapping<u8>
    print bytes.get(9) coalesce 0 ∷ wrapping<u8>

    let list<wrapping<u16>> shorts ← [65535, 2]
    print shorts

    let list<wrapping<i32>> signed ← [-1, 2]
    print signed

    mut list<wrapping<u64>> big ← [18446744073709551615, 3, 10, 2]
    big.sort()
    print big
}
