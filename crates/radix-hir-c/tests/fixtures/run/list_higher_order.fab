+++
locale = "en"
+++
# Higher-order list methods over a non-capturing closure: filter, map,
# reduce, cumulate, all and any.

main {
    let list<int> xs ← [1, 2, 3, 4, 5] ∷ list<int>
    let list<int> pares ← xs.filter(int x ∴ x % 2 ≡ 0)
    let list<int> duplicata ← xs.map(int x ∴ x * 2)
    let int summa ← xs.reduce((int acc, int x) ∴ acc + x, 0)
    let list<int> cumulata ← xs.cumulate((int acc, int x) ∴ acc + x, 0)
    print pares
    print duplicata
    print summa
    print cumulata
    print xs.all(int x ∴ x ≻ 0)
    print xs.any(int x ∴ x ≻ 4)
    print xs.any(int x ∴ x ≻ 9)
}
