+++
locale = "en"
+++
# A deferred binding: declared without an initializer, assigned before any
# read. The C cell is declared unwritten and stored once.
main {
    let int pending
    pending ← 7
    print pending
    let label
    label ← "deferred"
    print label
    mut list<int> later
    later ← [1, 2]
    print later.length()
}
