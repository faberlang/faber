+++
locale = "en"
+++
# Floats (binary64): arithmetic, the runner's display rules, the floored %,
# ÷ on integers, rounding (ties to even, saturating), exact int/float
# comparison, and floats through functions, lists, templates and a genus.
class Reading {
    var string label = "r"
    var float value = 0.5
}

fn mean(list<float> xs) → float {
    var float total ← 0.0
    for from xs const x {
        total ← total + x
    }
    return total / 2.0
}

main {
    var float a ← 0.1
    var float b ← a + 0.2
    print b
    print 1.0
    print -2.5
    print 1e21
    print 123456789012345680000.0
    print 1e-7
    print 1.0 / 3.0
    var float zero ← 0.0
    print 1.0 / zero
    print -1.0 / zero
    print zero / zero
    print -zero
    print 1e300 * 1e300
    print -7.5 % 2.0
    print 7.5 % -2.0
    print 6.0 % -2.0
    var int n ← 7
    print n ÷ 2
    print ⌊2.5⌉
    print ⌊3.5⌉
    print ⌊-2.5⌉
    print ⌊b⌋
    print ⌈b⌉
    print ⌊1e300⌉
    var int edge ← 9007199254740993
    var float near ← 9007199254740992.0
    print edge ≻ near
    print near ≺ edge
    print edge ≤ near
    print b ≺ 1.0
    print a ≡ 0.1
    const list<float> xs ← [1.5, 2.25]
    print xs
    print mean(xs)
    print "b=§, n÷2=§"(b, n ÷ 2)
    var Reading r ← { value = 2.0 }
    print r
}
