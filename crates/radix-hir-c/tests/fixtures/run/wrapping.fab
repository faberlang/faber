+++
locale = "en"
+++
# `wrapping<W>` reduces modulo 2^W at the store and `saturating<W>` clamps
# there; arithmetic is exact until the store. Shifts, bitwise not, negation,
# division and the rounded conversions all land through the same store.

main {
    mut wrapping<u8> max ← 255
    let wrapping<u8> one ← 1
    let wrapping<u8> ring1 ← max + one
    print ring1
    let wrapping<u8> ring2 ← max * 2
    print ring2
    print max ⇒ 8
    print one ⇐ 8
    max ↑
    print max
    let wrapping<i8> m ← -128
    print m / -1
    print ¬m
    let int wide ← 300
    print wide ↦ wrapping<i8>
    let wrapping<u64> big ← 18446744073709551615
    let wrapping<u64> one64 ← 1
    let wrapping<u64> wrapped ← big + one64
    print wrapped
    let saturating<u8> high ← 250
    let saturating<u8> clamped ← high + 100
    print clamped
    let saturating<u8> low ← 5
    print low - 10
    print high * 2
    let wrapping<u8> fromInt ← 300
    print fromInt
}
