+++
locale = "en"
+++
# Sized integers: stores check the range, reads widen, u64 reaches 2^64 - 1,
# and a sized field, parameter and result all go through the same check.
class Pixel {
    var u8 red
    var u8 green
    var i16 offset
}

fn scale(u8 x, u8 by) → u16 {
    return x * by
}

fn clamp8(int n) → u8 {
    if n ≺ 0 {
        return 0
    }
    if n ≻ 255 {
        return 255
    }
    return n
}

main {
    let u8 a ← 200
    mut i32 b ← -5
    b ← b * 1000
    print a, b
    let u64 big ← 18446744073709551615
    print big, big - 1
    let i8 low ← -128
    print low
    mut u16 w ← 65535
    w ← w - 1
    print w
    print scale(20, 200)
    print clamp8(-4), clamp8(100), clamp8(999)
    let Pixel p ← Pixel { red = 255, green = 0, offset = -300 }
    print p.red, p.green, p.offset
    print p
    let u32 mixed ← 4000000000
    print mixed + 1
    let int total ← a + b
    print total
    let u8 viaAscription ← 42 ∷ u8
    print viaAscription
}
