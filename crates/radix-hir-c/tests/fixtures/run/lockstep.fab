+++
locale = "en"
+++
# Lockstep `for from a, b const x, y`: every source is evaluated once, all
# must have equal length, and the binders read the aligned element. `apud [i]`
# binds the shared index.
main {
    const list<string> labels ← ["one", "two", "three"]
    const list<int> values ← [1, 2, 3]
    for from labels, values const label, value {
        print label
        print value
    }
    const list<int> left ← [10, 20, 30]
    const list<int> right ← [1, 2, 3]
    for from left, right const a, b {
        print a - b
    }
    const list<int> bases ← [100, 200]
    const list<int> keys ← [1, 2]
    const list<int> payloads ← [10, 20]
    for from bases, keys, payloads at [slot] const base, key, payload {
        const int total ← slot + base + key + payload
        print total
    }
}
