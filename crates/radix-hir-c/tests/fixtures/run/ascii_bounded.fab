+++
locale = "en"
+++
# `ascii` is an ASCII-only text; `ascii<N>` and `string<N>` are bounded text.
# The bytes are the same counted UTF-8 value a `string` is, the typechecker
# proves a literal fits, and a run-time `↦ string<N>` checks the capacity.
main {
    let ascii route ← 'pg:query'
    print route
    const ascii<8> a ← 'ab'
    const ascii<8> b ← 'ab'
    print a.length(), a.is_empty()
    if a ≡ b {
        print 1
    }
    let string s ← a ↦ string
    print s
    let string raw ← "héj"
    const string<8> t ← raw ↦ string<8>
    print t
    print t.slice(0, 2)
    const string<8> u ← t ↦ string<8>
    print u
    # The capacity is in code points: these two fit `string<2>` / `string<4>`
    # though their UTF-8 is three and four bytes.
    const string<2> acute ← "hé" ↦ string<2>
    const string<4> emoji ← "😀" ↦ string<4>
    print acute, emoji
}
