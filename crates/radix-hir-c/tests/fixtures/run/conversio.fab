+++
locale = "en"
+++
# Conversions between the scalar classes: parsing text, narrowing, rounding
# hints, and recovery. Failures without a recovery have their own fixtures.
main {
    const int n ← 7
    const float f ← 3.75
    print n ↦ float
    print n ↦ string
    print f ↦ string
    print 1.0 ↦ string, 0.1 ↦ string, 1e21 ↦ string
    print true ↦ string
    print true ↦ int
    print 0 ↦ bool, 5 ↦ bool, -3 ↦ bool
    print "42" ↦ int
    print "x" ↦ int ⊥ -1
    print "+7" ↦ int, "007" ↦ int, "-0" ↦ int
    print "1_000" ↦ int ⊥ 99, "0x10" ↦ int ⊥ 98, "9223372036854775808" ↦ int ⊥ 97
    print "2.5" ↦ float
    print "1e3" ↦ float, ".5" ↦ float ⊥ 1.0, "inf" ↦ float ⊥ 2.0, "NaN" ↦ float ⊥ 3.0, "1." ↦ float ⊥ 4.0
    print "bad" ↦ float ⊥ 0.5
    print "300" ↦ u8 ⊥ 0
    print "255" ↦ u8
    print "18446744073709551615" ↦ u64
    print "18446744073709551616" ↦ u64 ⊥ 7
    const int big ← 300
    print big ↦ u8 ⊥ 7
    const int small ← 200
    print small ↦ u8
    const float g ← 2.5
    print g ↦ int via HalfEven, (3.5 ↦ int via HalfEven), (-2.5 ↦ int via Floor), (-2.5 ↦ int via Trunc)
    print f ↦ int via Floor, f ↦ int via Ceil, f ↦ int via Trunc, f ↦ int via HalfEven
    const int huge ← 9007199254740993
    print huge ↦ float
    print "  42 " ↦ int ⊥ 5
    print "ff" ↦ i32 via Hex, "101" ↦ u8 via Bin, "777" ↦ i32 via Oct
    print "ffffffffffffffff" ↦ u64 via Hex ⊥ 7
    print "10000000000000000" ↦ u64 via Hex ⊥ 7
    print "-ff" ↦ i32 via Hex, "zz" ↦ i32 via Hex ⊥ 5
}
