+++
locale = "en"
+++
# Exact integer arithmetic over variables, both loop jumps, and the logical
# operators. Values below are chosen so floor division and remainder differ
# from C's truncating `/` and `%`.
main {
    # Longest Collatz chain for a start below 1000: 871 with 178 steps.
    mut int best ← 0
    mut int best_start ← 0
    mut int start ← 1
    while start ≺ 1000 {
        mut int n ← start
        mut int steps ← 0
        while n ≢ 1 {
            if n % 2 ≡ 0 {
                n ← n / 2
            } else {
                n ← 3 * n + 1
            }
            steps ← steps + 1
        }
        if steps ≻ best {
            best ← steps
            best_start ← start
        }
        start ← start + 1
    }
    print best_start, best

    # Floor division and remainder take the divisor's sign.
    mut int a ← -7
    mut int b ← 2
    mut int seven ← 7
    mut int nb ← 0 - b
    print a / b, a % b, seven / nb, seven % nb, -a

    # break and continue act on the innermost loop.
    mut int i ← 0
    mut int total ← 0
    while true {
        i ← i + 1
        if i ≻ 20 {
            break
        }
        if i % 3 ≡ 0 or i % 5 ≡ 0 {
            continue
        }
        if i ≥ 2 and not (i ≡ 7) {
            total ← total + i
        }
    }
    print total

    # An unstored intermediate has no width: 2^63 prints exactly.
    let int top ← 9223372036854775807
    mut int one ← 1
    print top + one
}
