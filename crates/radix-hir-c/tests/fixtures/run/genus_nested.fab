+++
locale = "en"
+++
# Genera that hold a list, a boolean and another genus; display recurses,
# a method builds text in the arena, and a genus passed to a function is the
# caller's genus.
class Tag {
    mut string label = "none"
    mut bool hot = false
}

class Item {
    mut int id = 0
    mut Tag tag = { label = "default" }
    mut list<int> counts = empty

    fn describe() → string {
        return "item §: §"(self.id, self.tag.label)
    }
}

fn heat(mut Item item) {
    item.tag.hot ← true
    item.counts.append(item.id * 10)
}

main {
    mut Item a ← { id = 1, tag = { label = "x\ty", hot = false } }
    mut Item b ← { id = 2 }
    heat(mut a)
    heat(mut a)
    print a
    print b
    print a.describe(), b.describe()
    b.tag ← a.tag
    b.tag.label ← "shared"
    print a.tag.label, b.tag.hot
}
