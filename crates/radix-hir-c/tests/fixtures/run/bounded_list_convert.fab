+++
locale = "en"
+++
# `list<T> ↦ list<T, N>`: a fixed-capacity copy, or the `⊥` fallback when the
# source is longer. `↤` converts then stores in one step.

main {
    let list<int> base ← [1, 2]
    let list<int, 8> raw ← base ↦ list<int, 8>
    let list<int, 4> out ← raw ↦ list<int, 4>
    print out

    let list<int> big ← [1, 2, 3]
    let list<int, 2> over ← big ↦ list<int, 2> ⊥ [7, 8]
    print over
    print over.length()

    let list<int> small ← [4, 5]
    let list<int, 2> fits ← small ↦ list<int, 2> ⊥ [7, 8]
    print fits

    mut int count ← 0
    count ↤ "42"
    print count
}
