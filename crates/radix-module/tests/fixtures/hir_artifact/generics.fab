# U4.1 fixture: generics
# Generic function and type — exercises TypeTable, generic parameter paths.

functio identitas<T>(T x) → T {
    redde x
}

functio paria<T>(T a, T b) → lista<T> {
    redde [a, b]
}

incipit {
    sit numerus n ← identitas(42)
    sit textus s ← identitas("salve")
    sit lista<numerus> xs ← paria(1, 2)
    nota n
    nota s
    nota xs
}
