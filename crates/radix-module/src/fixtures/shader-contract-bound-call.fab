+++
term = "shader-contract-bound-call"
kind = "concept"
category = "library"
canonical = true
summary = "Fragment stage body that calls a bound library function through a library import (SS-2B2)."
locale = "la"
+++

# Fragment stage body calling a library function. The library `zqlib:shade`
# is written into a temp library home by the driver test; the call arrives in
# MIR as a provider runtime call and emits the spelling the target bindings give.

importa ex "zqlib:shade" shade

@ shader_contract "varying"
functio varying_matches(
    textus source_name, numerus location, numerus format_code,
    numerus interpolation_code, numerus role_code
) → bivalens {
    redde verum
}

@ shader_contract "fragment_output"
functio fragment_output_matches(
    numerus location, numerus format_code, numerus role_code
) → bivalens {
    redde verum
}

@ fragment
functio shader_bound_call_fragment() → vacuum {
    sit f32 energy ← shade.zq_halve(uv · uv)
    sit vector<f32, magnitudo 3> shaded ↤ [energy, energy, energy]
    out_color ← shaded
}

incipit {
    adfirma varying_matches("uv", 0, 2, 1, 4) mori "uv varying at location 0, Float32x2"
    adfirma fragment_output_matches(0, 4, 2) mori "fragment output location 0, vec4<f32>"
}
