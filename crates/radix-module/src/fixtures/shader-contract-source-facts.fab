# =============================================================================
# shader-contract-source-facts — generic shader-contract fixture (U4-A)
# =============================================================================
#
# Synthetic, dependency-free fixture for the WGSL shader-contract boundary
# (docs/factory/wgsl-shader-contract-boundary). It exercises the compiler-owned
# generic contract surface WITHOUT any `triga:` imports and WITHOUT live-sibling
# checkout resolution:
#
#   * contract-role functions annotated with the landed decision-D1 grammar
#     `@ shader_contract "<role>"` (U2 driver ingestion)
#   * contract facts declared by calling the annotated functions inside
#     `adfirma` assertions in `incipit` with constant positional arguments
#   * an `@ vertex` stage entry with an empty body
#
# Contract-role annotation grammar and identity-resolved recognition are
# implemented by U2 (driver ingestion): the driver registers every
# `@ shader_contract "<role>"` function by its resolved definition identity and
# collects facts only from calls whose callee resolves to a registered role
# function. Unresolvable roles, non-constant arguments, malformed calls, and
# duplicate/conflicting facts are structured diagnostics (fail closed).
#
# This fixture is the source U4-B tests compile once U2+U3 land; it replaces
# the Triga-importing `triga-stage4-source-facts.fab` (moved to U5's
# conformance suite in the triga repo).
# =============================================================================

# Contract-role function (decision D1 surface): the `vertex_layout` role
# declares one vertex-buffer attribute per call. The call argument shape is
# `(geo, index, source_name, location, format_code, offset_bytes,
# stride_bytes, step_mode_code, role_code)`; `geo`/`index` are reserved for the
# library surface and carry no fact content. `role_code` is the explicit
# stage-I/O role (`radix_mir::shader_contract::stage_io_role_from_code`: 1 =
# position, 2 = color, 3 = transform, 4 = other).
@ shader_contract "vertex_layout"
functio vertex_layout_matches(
    numerus geo, numerus index, textus source_name,
    numerus location, numerus format_code, numerus offset_bytes,
    numerus stride_bytes, numerus step_mode_code, numerus role_code,
) → bivalens {
    redde verum
}

# ---------------------------------------------------------------------------
# Stage entry
# ---------------------------------------------------------------------------

@ vertex
functio shader_plane_vertex() → vacuum {
}

# ---------------------------------------------------------------------------
# Program body: declare the vertex-layout contract facts with constant
# arguments — the declaration surface U2 ingests. The three attributes mirror
# the canonical plane geometry the old Triga fixture exercised: position
# (location 0, Float32x3, 12-byte stride), normal (location 1, Float32x3,
# 12-byte stride), and uv (location 2, Float32x2, 8-byte stride).
# ---------------------------------------------------------------------------

incipit {
    adfirma vertex_layout_matches(0, 0, "position", 0, 3, 0, 12, 1, 1) mori "position layout fixes location 0, Float32x3, zero offset, 12-byte stride, and vertex step mode"
    adfirma vertex_layout_matches(0, 1, "normal", 1, 3, 0, 12, 1, 4) mori "normal layout fixes location 1, Float32x3, zero offset, 12-byte stride, and vertex step mode"
    adfirma vertex_layout_matches(0, 2, "uv", 2, 2, 0, 8, 1, 4) mori "uv layout fixes location 2, Float32x2, zero offset, 8-byte stride, and vertex step mode"
}
