# Faber grammar source — EBNF.md transcription with GSD-4 repairs.
# @grammar 2. ID-spine rename pass: snake_case, Latin introducers, and aliases.

@grammar 2
@start fab_file

@glyphs
# GSD-2 glyph/glossary registry.
#
# Each `glyph` is one source codepoint.  Multi-codepoint terminals such as
# `?.`, `![`, and `+++` claim their component codepoints here; the complete
# terminal remains named by the claiming production slot.  Findings are
# report-only reconciliation rows and do not grant a consumer glyph grammar
# authority.

[registry]
schema = 1
source = "docs/EBNF.md"
role_table = [
  "access",
  "alternate_exit",
  "annotation",
  "arithmetic",
  "assignment",
  "bitwise",
  "closure_joint",
  "comparison",
  "conditional",
  "conversion",
  "default",
  "equality",
  "generic",
  "gradient",
  "increment",
  "literal",
  "range",
  "return_type",
  "separator",
  "shift",
  "string_delimiter",
  "template_hole",
  "tensor_product",
  "transpose",
  "type_ascription",
  "type_union",
  "unary",
]

[[glyphs]]
glyph = "!"
codepoint = "U+0021"
unicode_name = "EXCLAMATION MARK"
role = "access"
claiming_slots = ["non_null_suffix"]

[[glyphs]]
glyph = "%"
codepoint = "U+0025"
unicode_name = "PERCENT SIGN"
role = "arithmetic"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "+"
codepoint = "U+002B"
unicode_name = "PLUS SIGN"
role = "arithmetic"
claiming_slots = ["additive_expr"]

[[glyphs]]
glyph = "-"
codepoint = "U+002D"
unicode_name = "HYPHEN-MINUS"
role = "arithmetic"
claiming_slots = ["additive_expr", "enum_member", "unary_expr"]

[[glyphs]]
glyph = "."
codepoint = "U+002E"
unicode_name = "FULL STOP"
role = "access"
claiming_slots = ["member_suffix", "non_null_suffix", "optional_suffix", "qualified_ident", "qualified_type"]

[[glyphs]]
glyph = "/"
codepoint = "U+002F"
unicode_name = "SOLIDUS"
role = "arithmetic"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = ":"
codepoint = "U+003A"
unicode_name = "COLON"
role = "separator"
claiming_slots = ["json_member", "clausura_legacy_expr"]

[[glyphs]]
glyph = "<"
codepoint = "U+003C"
unicode_name = "LESS-THAN SIGN"
role = "generic"
claiming_slots = ["call_type_args", "generic_params", "type_arguments"]

[[glyphs]]
glyph = "="
codepoint = "U+003D"
unicode_name = "EQUALS SIGN"
role = "assignment"
claiming_slots = ["annotation_field", "enum_member", "field_decl", "field_init", "ut_field", "nomen_field", "ex_field", "visibilitas_field", "omnia_field", "nucleum_field", "typus_decl"]

[[glyphs]]
glyph = ">"
codepoint = "U+003E"
unicode_name = "GREATER-THAN SIGN"
role = "generic"
claiming_slots = ["call_type_args", "generic_params", "type_arguments"]

[[glyphs]]
glyph = "?"
codepoint = "U+003F"
unicode_name = "QUESTION MARK"
role = "access"
claiming_slots = ["optional_suffix"]

[[glyphs]]
glyph = "@"
codepoint = "U+0040"
unicode_name = "COMMERCIAL AT"
role = "annotation"
claiming_slots = ["ad_annotation", "annotation_sugar", "braced_annotation", "nucleum_braced", "nucleum_sugar", "radix_annotation"]

[[glyphs]]
glyph = "¬"
codepoint = "U+00AC"
unicode_name = "NOT SIGN"
role = "unary"
claiming_slots = ["unary_expr"]

[[glyphs]]
glyph = "·"
codepoint = "U+00B7"
unicode_name = "MIDDLE DOT"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "×"
codepoint = "U+00D7"
unicode_name = "MULTIPLICATION SIGN"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "ᵀ"
codepoint = "U+1D40"
unicode_name = "MODIFIER LETTER CAPITAL T"
role = "transpose"
claiming_slots = ["transpose_suffix"]

[[glyphs]]
glyph = "‥"
codepoint = "U+2025"
unicode_name = "TWO DOT LEADER"
role = "range"
claiming_slots = ["range_tail", "vel_range_tail"]

[[glyphs]]
glyph = "…"
codepoint = "U+2026"
unicode_name = "HORIZONTAL ELLIPSIS"
role = "range"
claiming_slots = ["range_tail", "vel_range_tail"]

[[glyphs]]
glyph = "←"
codepoint = "U+2190"
unicode_name = "LEFTWARDS ARROW"
role = "assignment"
claiming_slots = ["array_destruct", "assignment", "figendum_decl", "object_destruct", "sit_decl", "fixum_decl"]

[[glyphs]]
glyph = "↑"
codepoint = "U+2191"
unicode_name = "UPWARDS ARROW"
role = "increment"
claiming_slots = ["inc_dec_stmt"]

[[glyphs]]
glyph = "→"
codepoint = "U+2192"
unicode_name = "RIGHTWARDS ARROW"
role = "return_type"
claiming_slots = ["function_type", "clausura_legacy_expr", "return_clause"]

[[glyphs]]
glyph = "↓"
codepoint = "U+2193"
unicode_name = "DOWNWARDS ARROW"
role = "increment"
claiming_slots = ["inc_dec_stmt"]

[[glyphs]]
glyph = "↤"
codepoint = "U+21A4"
unicode_name = "LEFTWARDS ARROW FROM BAR"
role = "assignment"
claiming_slots = ["assignment", "fixum_decl"]

[[glyphs]]
glyph = "↦"
codepoint = "U+21A6"
unicode_name = "RIGHTWARDS ARROW FROM BAR"
role = "conversion"
claiming_slots = ["conversio_expr"]

[[glyphs]]
glyph = "⇐"
codepoint = "U+21D0"
unicode_name = "LEFTWARDS DOUBLE ARROW"
role = "shift"
claiming_slots = ["shift_expr"]

[[glyphs]]
glyph = "⇒"
codepoint = "U+21D2"
unicode_name = "RIGHTWARDS DOUBLE ARROW"
role = "shift"
claiming_slots = ["shift_expr"]

[[glyphs]]
glyph = "⇥"
codepoint = "U+21E5"
unicode_name = "RIGHTWARDS ARROW TO BAR"
role = "alternate_exit"
claiming_slots = ["alternate_exit_clause"]

[[glyphs]]
glyph = "⊥"
codepoint = "U+22A5"
unicode_name = "UP TACK"
role = "default"
claiming_slots = ["inline_default"]

[[glyphs]]
glyph = "✓"
codepoint = "U+2713"
unicode_name = "CHECK MARK"
role = "conditional"
claiming_slots = ["ternary"]

[[glyphs]]
glyph = "✗"
codepoint = "U+2717"
unicode_name = "BALLOT X"
role = "conditional"
claiming_slots = ["ternary"]

[[glyphs]]
glyph = "↢"
codepoint = "U+21A2"
unicode_name = "LEFTWARDS ARROW WITH TAIL"
role = "await_assignment"
claiming_slots = ["fixum_decl", "sit_decl"]

[[glyphs]]
glyph = "∇"
codepoint = "U+2207"
unicode_name = "NABLA"
role = "gradient"
claiming_slots = ["gradient_expr"]

[[glyphs]]
glyph = "∞"
codepoint = "U+221E"
unicode_name = "INFINITY"
role = "literal"
claiming_slots = ["literal"]

[[glyphs]]
glyph = "∧"
codepoint = "U+2227"
unicode_name = "LOGICAL AND"
role = "bitwise"
claiming_slots = ["bitwise_and_expr"]

[[glyphs]]
glyph = "∨"
codepoint = "U+2228"
unicode_name = "LOGICAL OR"
role = "bitwise"
claiming_slots = ["bitwise_or_expr"]

[[glyphs]]
glyph = "∪"
codepoint = "U+222A"
unicode_name = "UNION"
role = "type_union"
claiming_slots = ["hole_type", "type_annotation"]

[[glyphs]]
glyph = "∴"
codepoint = "U+2234"
unicode_name = "THEREFORE"
role = "closure_joint"
claiming_slots = ["clausura_joint"]

[[glyphs]]
glyph = "∷"
codepoint = "U+2237"
unicode_name = "PROPORTION"
role = "type_ascription"
claiming_slots = ["cast_expr", "finge_expr"]

[[glyphs]]
glyph = "≅"
codepoint = "U+2245"
unicode_name = "APPROXIMATELY EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≇"
codepoint = "U+2247"
unicode_name = "NEITHER APPROXIMATELY NOR ACTUALLY EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≈"
codepoint = "U+2248"
unicode_name = "ALMOST EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≉"
codepoint = "U+2249"
unicode_name = "NOT ALMOST EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≠"
codepoint = "U+2260"
unicode_name = "NOT EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≡"
codepoint = "U+2261"
unicode_name = "IDENTICAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≢"
codepoint = "U+2262"
unicode_name = "NOT IDENTICAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≤"
codepoint = "U+2264"
unicode_name = "LESS-THAN OR EQUAL TO"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≥"
codepoint = "U+2265"
unicode_name = "GREATER-THAN OR EQUAL TO"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≺"
codepoint = "U+227A"
unicode_name = "PRECEDES"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≻"
codepoint = "U+227B"
unicode_name = "SUCCEEDS"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "⊗"
codepoint = "U+2297"
unicode_name = "CIRCLED TIMES"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "⊘"
codepoint = "U+2298"
unicode_name = "CIRCLED DIVISION SLASH"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "⊙"
codepoint = "U+2299"
unicode_name = "CIRCLED DOT OPERATOR"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "⊻"
codepoint = "U+22BB"
