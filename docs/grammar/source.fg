# Faber grammar source — EBNF.md transcription with GSD-4 repairs.
# @grammar 2. ID-spine rename pass: snake_case, Latin introducers, and aliases.

@grammar 2
@start fab_file

@glyphs
# GSD-2 glyph/glossary registry.
#
# Each `glyph` is one source codepoint.  Multi-codepoint terminals such as
# `?.`, `![`, and `+++` claim their component codepoints here; the complete
# terminal remains named by the claiming production slot.  Findings are
# report-only reconciliation rows and do not grant a consumer glyph grammar
# authority.

[registry]
schema = 1
source = "docs/EBNF.md"
role_table = [
  "access",
  "alternate_exit",
  "annotation",
  "arithmetic",
  "assignment",
  "bitwise",
  "closure_joint",
  "comparison",
  "conditional",
  "conversion",
  "equality",
  "generic",
  "gradient",
  "increment",
  "range",
  "return_type",
  "shift",
  "string_delimiter",
  "template_hole",
  "tensor_product",
  "type_ascription",
  "type_union",
  "unary",
]

[[glyphs]]
glyph = "!"
codepoint = "U+0021"
unicode_name = "EXCLAMATION MARK"
role = "access"
claiming_slots = ["non_null_suffix"]

[[glyphs]]
glyph = "%"
codepoint = "U+0025"
unicode_name = "PERCENT SIGN"
role = "arithmetic"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "+"
codepoint = "U+002B"
unicode_name = "PLUS SIGN"
role = "arithmetic"
claiming_slots = ["additive_expr"]

[[glyphs]]
glyph = "-"
codepoint = "U+002D"
unicode_name = "HYPHEN-MINUS"
role = "arithmetic"
claiming_slots = ["additive_expr", "enum_member", "unary_expr"]

[[glyphs]]
glyph = "."
codepoint = "U+002E"
unicode_name = "FULL STOP"
role = "access"
claiming_slots = ["member_suffix", "non_null_suffix", "optional_suffix", "qualified_ident", "qualified_type"]

[[glyphs]]
glyph = "/"
codepoint = "U+002F"
unicode_name = "SOLIDUS"
role = "arithmetic"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = ":"
codepoint = "U+003A"
unicode_name = "COLON"
role = "conditional"
claiming_slots = ["json_member", "clausura_legacy_expr", "ternary"]

[[glyphs]]
glyph = "<"
codepoint = "U+003C"
unicode_name = "LESS-THAN SIGN"
role = "generic"
claiming_slots = ["call_type_args", "generic_params", "type_arguments"]

[[glyphs]]
glyph = "="
codepoint = "U+003D"
unicode_name = "EQUALS SIGN"
role = "assignment"
claiming_slots = ["annotation_field", "enum_member", "field_decl", "field_init", "ut_field", "nomen_field", "ex_field", "visibilitas_field", "omnia_field", "nucleum_field", "typus_decl"]

[[glyphs]]
glyph = ">"
codepoint = "U+003E"
unicode_name = "GREATER-THAN SIGN"
role = "generic"
claiming_slots = ["call_type_args", "generic_params", "type_arguments"]

[[glyphs]]
glyph = "?"
codepoint = "U+003F"
unicode_name = "QUESTION MARK"
role = "conditional"
claiming_slots = ["optional_suffix", "ternary"]

[[glyphs]]
glyph = "@"
codepoint = "U+0040"
unicode_name = "COMMERCIAL AT"
role = "annotation"
claiming_slots = ["annotation_sugar", "braced_annotation", "nucleum_braced", "nucleum_sugar"]

[[glyphs]]
glyph = "¬"
codepoint = "U+00AC"
unicode_name = "NOT SIGN"
role = "unary"
claiming_slots = ["unary_expr"]

[[glyphs]]
glyph = "·"
codepoint = "U+00B7"
unicode_name = "MIDDLE DOT"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "×"
codepoint = "U+00D7"
unicode_name = "MULTIPLICATION SIGN"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "‥"
codepoint = "U+2025"
unicode_name = "TWO DOT LEADER"
role = "range"
claiming_slots = ["range_tail", "vel_range_tail"]

[[glyphs]]
glyph = "…"
codepoint = "U+2026"
unicode_name = "HORIZONTAL ELLIPSIS"
role = "range"
claiming_slots = ["range_tail", "vel_range_tail"]

[[glyphs]]
glyph = "←"
codepoint = "U+2190"
unicode_name = "LEFTWARDS ARROW"
role = "assignment"
claiming_slots = ["array_destruct", "assignment", "figendum_decl", "object_destruct", "sit_decl", "fixum_decl"]

[[glyphs]]
glyph = "↑"
codepoint = "U+2191"
unicode_name = "UPWARDS ARROW"
role = "increment"
claiming_slots = ["inc_dec_stmt"]

[[glyphs]]
glyph = "→"
codepoint = "U+2192"
unicode_name = "RIGHTWARDS ARROW"
role = "return_type"
claiming_slots = ["function_type", "clausura_legacy_expr", "return_clause"]

[[glyphs]]
glyph = "↓"
codepoint = "U+2193"
unicode_name = "DOWNWARDS ARROW"
role = "increment"
claiming_slots = ["inc_dec_stmt"]

[[glyphs]]
glyph = "↤"
codepoint = "U+21A4"
unicode_name = "LEFTWARDS ARROW FROM BAR"
role = "assignment"
claiming_slots = ["assignment", "fixum_decl"]

[[glyphs]]
glyph = "↦"
codepoint = "U+21A6"
unicode_name = "RIGHTWARDS ARROW FROM BAR"
role = "conversion"
claiming_slots = ["conversio_expr"]

[[glyphs]]
glyph = "⇐"
codepoint = "U+21D0"
unicode_name = "LEFTWARDS DOUBLE ARROW"
role = "shift"
claiming_slots = ["shift_expr"]

[[glyphs]]
glyph = "⇒"
codepoint = "U+21D2"
unicode_name = "RIGHTWARDS DOUBLE ARROW"
role = "shift"
claiming_slots = ["shift_expr"]

[[glyphs]]
glyph = "⇥"
codepoint = "U+21E5"
unicode_name = "RIGHTWARDS ARROW TO BAR"
role = "alternate_exit"
claiming_slots = ["alternate_exit_clause", "inline_recovery"]

[[glyphs]]
glyph = "∇"
codepoint = "U+2207"
unicode_name = "NABLA"
role = "gradient"
claiming_slots = ["gradient_expr"]

[[glyphs]]
glyph = "∧"
codepoint = "U+2227"
unicode_name = "LOGICAL AND"
role = "bitwise"
claiming_slots = ["bitwise_and_expr"]

[[glyphs]]
glyph = "∨"
codepoint = "U+2228"
unicode_name = "LOGICAL OR"
role = "bitwise"
claiming_slots = ["bitwise_or_expr"]

[[glyphs]]
glyph = "∪"
codepoint = "U+222A"
unicode_name = "UNION"
role = "type_union"
claiming_slots = ["hole_type", "type_annotation"]

[[glyphs]]
glyph = "∴"
codepoint = "U+2234"
unicode_name = "THEREFORE"
role = "closure_joint"
claiming_slots = ["clausura_joint"]

[[glyphs]]
glyph = "∷"
codepoint = "U+2237"
unicode_name = "PROPORTION"
role = "type_ascription"
claiming_slots = ["cast_expr", "finge_expr"]

[[glyphs]]
glyph = "≈"
codepoint = "U+2248"
unicode_name = "ALMOST EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≉"
codepoint = "U+2249"
unicode_name = "NOT ALMOST EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≠"
codepoint = "U+2260"
unicode_name = "NOT EQUAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≡"
codepoint = "U+2261"
unicode_name = "IDENTICAL TO"
role = "equality"
claiming_slots = ["equality_tail"]

[[glyphs]]
glyph = "≤"
codepoint = "U+2264"
unicode_name = "LESS-THAN OR EQUAL TO"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≥"
codepoint = "U+2265"
unicode_name = "GREATER-THAN OR EQUAL TO"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≺"
codepoint = "U+227A"
unicode_name = "PRECEDES"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "≻"
codepoint = "U+227B"
unicode_name = "SUCCEEDS"
role = "comparison"
claiming_slots = ["comparison"]

[[glyphs]]
glyph = "⊗"
codepoint = "U+2297"
unicode_name = "CIRCLED TIMES"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "⊙"
codepoint = "U+2299"
unicode_name = "CIRCLED DOT OPERATOR"
role = "tensor_product"
claiming_slots = ["multiplicative_expr"]

[[glyphs]]
glyph = "⊻"
codepoint = "U+22BB"
unicode_name = "XOR"
role = "bitwise"
claiming_slots = ["bitwise_xor_expr"]

[[glyphs]]
glyph = "§"
codepoint = "U+00A7"
unicode_name = "SECTION SIGN"
role = "template_hole"
claiming_slots = ["string_template"]
source_refs = ["EBNF.md:768"]

[[glyphs]]
glyph = "«"
codepoint = "U+00AB"
unicode_name = "LEFT-POINTING DOUBLE ANGLE QUOTATION MARK"
role = "string_delimiter"
claiming_slots = ["block_string_literal"]
source_refs = ["EBNF.md:760", "EBNF.md:779"]

[[glyphs]]
glyph = "»"
codepoint = "U+00BB"
unicode_name = "RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK"
role = "string_delimiter"
claiming_slots = ["block_string_literal"]
source_refs = ["EBNF.md:760", "EBNF.md:779"]

# Read-only reconciliation findings.  These rows record consumer/corpus drift;
# they do not add a glyph to the grammar registry.
[[findings]]
kind = "corpus-stray"
glyph = "↔"
codepoint = "U+2194"
unicode_name = "LEFT RIGHT ARROW"
source = "radix/corpus/**/*.fab"
occurrences = 22
status = "not-claimed"
note = "Corpus prose uses ↔ for bidirectional conversion; no EBNF production claims it."

[[findings]]
kind = "corpus-stray"
glyph = "∈"
codepoint = "U+2208"
unicode_name = "ELEMENT OF"
source = "radix/corpus/itera/nidificatus.fab"
occurrences = 2
status = "not-claimed"
note = "Comment-only mathematical notation; EBNF.md explicitly says ∈ is not an active glyph alias."

[[findings]]
kind = "corpus-stray"
glyph = "−"
codepoint = "U+2212"
unicode_name = "MINUS SIGN"
source = "radix/corpus/binarius/binarius.fab"
occurrences = 2
status = "not-claimed"
note = "Comment-only typographic minus; the active arithmetic terminal is ASCII '-'."

[[findings]]
kind = "corpus-stray"
glyph = "≯"
codepoint = "U+226F"
unicode_name = "NOT GREATER-THAN"
source = "radix/corpus/si/si.fab"
occurrences = 1
status = "not-claimed"
note = "Comment-only skipped example; no EBNF production claims it."

[[findings]]
kind = "corpus-prose"
glyph = "–"
codepoint = "U+2013"
unicode_name = "EN DASH"
source = "radix/corpus/**/*.fab"
occurrences = 3
status = "documentation-only"
note = "Prose punctuation, not a Faber terminal."

[[findings]]
kind = "corpus-prose"
glyph = "—"
codepoint = "U+2014"
unicode_name = "EM DASH"
source = "radix/corpus/**/*.fab"
occurrences = 1500
status = "documentation-only"
note = "Prose punctuation, not a Faber terminal."

[[findings]]
kind = "corpus-prose"
glyph = "•"
codepoint = "U+2022"
unicode_name = "BULLET"
source = "radix/corpus/**/*.fab"
occurrences = 1048
status = "documentation-only"
note = "Prose list marker, not a Faber terminal."

[[findings]]
kind = "corpus-prose"
glyph = "❝"
codepoint = "U+275D"
unicode_name = "HEAVY DOUBLE TURNED COMMA QUOTATION MARK ORNAMENT"
source = "radix/corpus/literalia/block-string.fab"
occurrences = 1
status = "documentation-only"
note = "Comment-only retired block-string delimiter example; active block strings use «...»."

[[findings]]
kind = "corpus-prose"
glyph = "❞"
codepoint = "U+275E"
unicode_name = "HEAVY DOUBLE COMMA QUOTATION MARK ORNAMENT"
source = "radix/corpus/literalia/block-string.fab"
occurrences = 1
status = "documentation-only"
note = "Comment-only retired block-string delimiter example; active block strings use «...»."

[[findings]]
kind = "consumer-extra"
glyph = "!"
codepoint = "U+0021"
unicode_name = "EXCLAMATION MARK"
source = "tree-sitter-faber/grammar.js:526"
status = "consumer-only"
note = "tree-sitter-faber lists bare !; EBNF claims ! only as part of !., ![, and !( in nonNullSuffix."

[[findings]]
kind = "consumer-extra"
glyph = "⊜"
codepoint = "U+229C"
unicode_name = "SQUARED DOT OPERATOR"
source = "tree-sitter-faber/grammar.js:562"
status = "consumer-only"
note = "tree-sitter-faber lists ⊜, but no EBNF production or corpus language example claims it."

[[findings]]
kind = "consumer-missing"
glyph = "·"
codepoint = "U+00B7"
unicode_name = "MIDDLE DOT"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF and corpus claim the tensor inner-product glyph; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "×"
codepoint = "U+00D7"
unicode_name = "MULTIPLICATION SIGN"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF and corpus claim the tensor cross-product glyph; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "∇"
codepoint = "U+2207"
unicode_name = "NABLA"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF claims postfix gradient selection; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "≺"
codepoint = "U+227A"
unicode_name = "PRECEDES"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF claims canonical less-than ordering; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "≻"
codepoint = "U+227B"
unicode_name = "SUCCEEDS"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF claims canonical greater-than ordering; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "⊗"
codepoint = "U+2297"
unicode_name = "CIRCLED TIMES"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF and corpus claim the tensor outer-product glyph; tree-sitter's operator choice does not list it."

[[findings]]
kind = "consumer-missing"
glyph = "⊙"
codepoint = "U+2299"
unicode_name = "CIRCLED DOT OPERATOR"
source = "tree-sitter-faber/grammar.js:521-566"
status = "registry-only"
note = "EBNF and corpus claim the tensor Hadamard glyph; tree-sitter's operator choice does not list it."

[reconciliation]
explain_consumer = "radix/corpus/**/*.fab via faber explain"
explain_symbolic_gaps = []
tree_sitter_extra = ["!", "⊜"]
tree_sitter_missing = ["·", "×", "∇", "≺", "≻", "⊗", "⊙"]
@keywords
## Keyword Reference
