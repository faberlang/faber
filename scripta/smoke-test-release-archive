#!/usr/bin/env python3
"""Consumer smoke test for a published Faber release archive.

Installs a release archive into a clean prefix (fresh HOME, minimal PATH, no
sibling checkouts, no env overrides) and proves a fresh consumer can use it:
pack-exercising assertions first, the version assertion last, then the
archive-layout structural proof. Fails fast on the first failing assertion.

Fixed assertion order (faber 1.5.1 pack-release delivery §5 U3, amended
e4b0c5f; head-cto D3 additions fire-21+22):

  1. PACK-EXERCISING FIRST (class `pack-error`) — a bare-binary archive
     surfaces its fail-closed pack error here, verbatim, before any version
     check:
       a. `faber check --locale en <self-contained hello-world>` exits 0
       b. `faber explain SEM001` exits 0 (diagnostic reader pack)
       c. `faber explain functio` exits 0 (reference pack present)
       d. bare `faber check <hello-world>` — NO explicit --locale — exits 0
          (default-locale path works for a fresh consumer; the fixture
          declares no [reader] locale, so the product-default `en` pack
          must resolve)
       e. WALK-UP GUARD — the extracted tree is relocated to a different
          prefix depth and a pack-exercising assertion re-runs from there,
          proving the resolver's parent-directory walk-up finds the pack
          beside the binary (binary-relative, not cwd/absolute).
  2. VERSION ASSERTION LAST (class `version-mismatch`) —
     `faber --version` contains the expected version. A version mismatch on
     an old archive is the least diagnostic failure; a bare archive never
     reaches this assertion.
  3. ARCHIVE-LAYOUT STRUCTURAL PROOF (final) — `tar -tzf` shows
     `bin/faber` + `share/faber/reference/` +
     `share/faber/locale/<8>/pack.toml` (ar, en, hi, la, th-TH, vi,
     zh-Hans, zh-Hant). Guards against a correct-version but non-dev-kit
     shape.

Negative-mode `--expect-fail-class pack-error|version-mismatch` runs the full
positive suite against an archive that MUST be rejected and asserts the
failure class: exit 0 = rejected for the expected class (negative proof
GREEN), exit 1 = rejected with a different class or not rejected at all.

Exit codes: 0 = RELEASABLE (or negative proof GREEN), 1 = UNRELEASABLE
(failing assertion named) or negative proof NOT established, 2 = usage error.

Usage:
    scripta/smoke-test-release-archive \\
        --archive <tar.gz> --version 1.5.1 --triple <triple> \\
        [--expect-fail-class pack-error|version-mismatch]

    scripta/smoke-test-release-archive \\
        --download-into <dir> --version 1.5.1 --triple <triple> \\
        [--expect-fail-class pack-error|version-mismatch]
        # readback mode: gh release download + shasum -c, then smoke the
        # downloaded bytes (release-checklist step 7)

Exactly one of --archive / --download-into is required.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

MINIMAL_PATH = "/usr/bin:/bin"

RELEASE_REPO = "faberlang/releases"
COMPONENT = "faber"

LOCALE_DIRS = ["ar", "en", "hi", "la", "th-TH", "vi", "zh-Hans", "zh-Hant"]

PACK_CLASS = "pack-error"
VERSION_CLASS = "version-mismatch"
LAYOUT_CLASS = "layout"

EXPECTED_CLASSES = (PACK_CLASS, VERSION_CLASS)


def run(args: list[str], env: dict[str, str], cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        env=env,
        cwd=str(cwd),
        capture_output=True,
        text=True,
    )


def clean_env(work: Path) -> dict[str, str]:
    """Fresh consumer environment: fresh HOME, minimal PATH, no overrides."""
    return {
        "HOME": str(work / "home"),
        "PATH": MINIMAL_PATH,
        "TMPDIR": str(work / "tmp"),
        "LC_ALL": "C",
    }


def write_hello_world(root: Path) -> Path:
    """Self-contained hello-world fixture (mirrors verify-dev-kit)."""
    (root / "src").mkdir(parents=True, exist_ok=True)
    (root / "faber.toml").write_text(
        "[package]\n"
        'name = "smoke-hello"\n'
        'version = "0.0.0"\n'
        "\n"
        "[paths]\n"
        'source = "src"\n'
        'entry = "main.fab"\n'
        "\n"
        "[build]\n"
        'target = "rust"\n'
        'kind = "bin"\n',
        encoding="utf-8",
    )
    (root / "src" / "main.fab").write_text(
        'incipit { nota "Salve, munde!" }\n', encoding="utf-8"
    )
    return root


def locate_binary(prefix: Path) -> Path | None:
    direct = prefix / "bin" / "faber"
    if direct.is_file():
        return direct
    # Older archive shapes wrap the binary in a top-level dir
    # (e.g. faber-v1.5.0-<triple>/faber).
    for candidate in sorted(prefix.rglob("faber")):
        if candidate.is_file():
            return candidate
    return None


def extract(archive: Path, prefix: Path, env: dict[str, str]) -> subprocess.CompletedProcess[str]:
    prefix.mkdir(parents=True, exist_ok=True)
    return run(["tar", "-xzf", str(archive), "-C", str(prefix)], env, prefix)


def stderr_detail(res: subprocess.CompletedProcess[str]) -> str:
    text = (res.stderr or res.stdout).strip()
    return text[-2000:] if len(text) > 2000 else text


def pack_assertions(binary: Path, work: Path, env: dict[str, str]) -> list[tuple[str, list[str]]]:
    hello = write_hello_world(work / "hello")
    return [
        (
            "faber check --locale en <hello-world>",
            [str(binary), "check", "--locale", "en", str(hello)],
        ),
        (
            "faber explain SEM001 (reader pack)",
            [str(binary), "explain", "SEM001"],
        ),
        (
            "faber explain functio (reference pack)",
            [str(binary), "explain", "functio"],
        ),
        (
            "faber check <hello-world> (default locale, no --locale)",
            [str(binary), "check", str(hello)],
        ),
    ]


def walk_up_guard(
    binary: Path, prefix: Path, work: Path, env: dict[str, str]
) -> tuple[bool, str, str]:
    """Relocate the whole tree to a different prefix depth and re-run a
    pack-exercising assertion. Proves the resolver's parent-directory walk-up
    finds the pack beside the binary, not via cwd or an absolute path.
    """
    relocated = work / "relocated" / "nested" / "deeper" / "prefix"
    shutil.copytree(prefix, relocated)
    rel_binary = relocated / "bin" / "faber"
    if not rel_binary.is_file():
        found = locate_binary(relocated)
        if found is None:
            return False, "walk-up guard: no faber binary in relocated prefix", ""
        rel_binary = found
    hello = work / "hello"
    if not hello.is_dir():
        hello = write_hello_world(work / "hello")
    res = run([str(rel_binary), "check", "--locale", "en", str(hello)], env, work)
    label = (
        f"walk-up guard: {rel_binary.relative_to(work)} resolves pack "
        "beside binary from relocated prefix"
    )
    return res.returncode == 0, label, stderr_detail(res)


def layout_check(
    archive: Path, env: dict[str, str], work: Path
) -> tuple[bool, str, str]:
    res = run(["tar", "-tzf", str(archive)], env, work)
    if res.returncode != 0:
        return False, "tar -tzf archive listing", stderr_detail(res)
    entries = set(res.stdout.splitlines())
    required = ["bin/faber"] + [
        f"share/faber/locale/{loc}/pack.toml" for loc in LOCALE_DIRS
    ]
    missing = [entry for entry in required if entry not in entries]
    if missing:
        return False, "archive layout: " + ", ".join(missing), ""
    if not any(entry.startswith("share/faber/reference/") for entry in entries):
        return False, "archive layout: share/faber/reference/", ""
    return True, (
        "archive layout: bin/faber + share/faber/reference/ + "
        f"{len(LOCALE_DIRS)} locale packs"
    ), ""


def download_release_archive(dest: Path, version: str, triple: str) -> Path:
    """Readback mode: download the release archive + basename-only .sha256
    from the shared release repo and verify shasum -c (checklist step 7)."""
    dest.mkdir(parents=True, exist_ok=True)
    release_tag = f"{COMPONENT}-v{version}"
    pattern = f"{COMPONENT}-v{version}-{triple}.tar.gz*"
    res = subprocess.run(
        [
            "gh", "release", "download", release_tag,
            "--repo", RELEASE_REPO,
            "--dir", str(dest),
            "--pattern", pattern,
        ],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        raise SystemExit(
            f"error: gh release download {release_tag} failed: {res.stderr.strip()}"
        )
    archive = dest / f"{COMPONENT}-v{version}-{triple}.tar.gz"
    checksum = dest / (archive.name + ".sha256")
    if not archive.is_file() or not checksum.is_file():
        raise SystemExit(
            f"error: expected {archive.name} + {checksum.name} in {dest}"
        )
    shasum = shutil.which("shasum") or shutil.which("sha256sum")
    if shasum is None:
        raise SystemExit("error: shasum/sha256sum not found for checksum verification")
    res = subprocess.run(
        [shasum, "-c", checksum.name],
        cwd=str(dest),
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        raise SystemExit(
            f"error: checksum verification failed for {archive.name}:\n"
            f"{res.stdout}{res.stderr}"
        )
    print(f"downloaded + checksum verified: {archive}")
    return archive


def smoke_archive(
    archive: Path, version: str, triple: str, work: Path
) -> tuple[bool, str, str, str]:
    """Run the full positive suite. Returns (passes, class, label, detail)."""
    print(f"smoking archive: {archive}")
    print(f"expected version: {version} ({triple})")

    (work / "home").mkdir(parents=True, exist_ok=True)
    (work / "tmp").mkdir(parents=True, exist_ok=True)
    env = clean_env(work)

    prefix = work / "prefix"
    result = extract(archive, prefix, env)
    if result.returncode != 0:
        return False, LAYOUT_CLASS, "install: tar -xzf extraction", stderr_detail(result)
    binary = locate_binary(prefix)
    if binary is None:
        return False, LAYOUT_CLASS, "install: no faber binary found", ""
    print(f"clean prefix: {prefix}")
    print(f"binary: {binary}")

    for label, cmd in pack_assertions(binary, work, env):
        res = run(cmd, env, work)
        ok = res.returncode == 0
        print(f"  [{'PASS' if ok else 'FAIL'}] {label}")
        if not ok:
            return False, PACK_CLASS, label, stderr_detail(res)

    ok, label, detail = walk_up_guard(binary, prefix, work, env)
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}")
    if not ok:
        return False, PACK_CLASS, label, detail

    res = run([str(binary), "--version"], env, work)
    ok = res.returncode == 0 and version in res.stdout
    label = f"faber --version contains {version}"
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}")
    if not ok:
        return False, VERSION_CLASS, label, stderr_detail(res)

    ok, label, detail = layout_check(archive, env, work)
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}")
    if not ok:
        return False, LAYOUT_CLASS, label, detail

    return True, "", "", ""


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="smoke-test-release-archive",
        description="Consumer smoke-test gate for a Faber release archive.",
    )
    parser.add_argument("--archive", type=Path, help="release archive tar.gz to smoke")
    parser.add_argument(
        "--version",
        required=True,
        help="expected faber version, e.g. 1.5.1",
    )
    parser.add_argument(
        "--triple",
        required=True,
        help="target triple, e.g. aarch64-apple-darwin",
    )
    parser.add_argument(
        "--download-into",
        type=Path,
        help="download the release archive + checksum into this dir and smoke "
             "the downloaded bytes (readback)",
    )
    parser.add_argument(
        "--expect-fail-class",
        choices=list(EXPECTED_CLASSES),
        help="negative mode: the archive must be rejected with this class",
    )
    args = parser.parse_args(argv)
    if bool(args.archive) == bool(args.download_into):
        parser.error("exactly one of --archive / --download-into is required")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    work = Path(tempfile.mkdtemp(prefix="faber-smoke-"))
    try:
        if args.download_into:
            archive = download_release_archive(
                args.download_into.resolve(), args.version, args.triple
            )
        else:
            archive = args.archive.resolve()
            if not archive.is_file():
                raise SystemExit(f"error: archive not found: {archive}")
        passes, cls, label, detail = smoke_archive(
            archive, args.version, args.triple, work
        )
    finally:
        shutil.rmtree(work, ignore_errors=True)

    if args.expect_fail_class:
        if not passes:
            if cls == args.expect_fail_class:
                print(
                    f"negative proof GREEN: {archive.name} rejected with "
                    f"{cls} (failing assertion: {label})"
                )
                return 0
            print(
                f"negative proof NOT established: rejected with {cls}, "
                f"expected {args.expect_fail_class} (failing assertion: {label})"
            )
            if detail:
                print(detail)
            return 1
        print(
            f"negative proof NOT established: archive passed the full suite; "
            f"expected rejection with {args.expect_fail_class}"
        )
        return 1

    if passes:
        print("RELEASABLE")
        return 0
    print(f"UNRELEASABLE: failing assertion '{label}' (class {cls})")
    if detail:
        print(detail)
    return 1


if __name__ == "__main__":
    sys.exit(main())
