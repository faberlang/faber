#!/usr/bin/env bash
# Freshness gate for radix/corpus/measurement/*.json (compat + conversio).
#
# Regenerates the measurement JSON to a temp root and classifies it against
# the committed files. Additive measurement growth is recorded and passes;
# capability regressions fail. Wired into ./scripta/check-measurement-gates
# (stage 4a) so a regressed measurement fails before later stages run.
#
# Cache envs (skip cargo):
#   EBNF_MATRIX_HIR_LOG / EBNF_MATRIX_MIR_LOG / CONVERSIO_MATRIX_LOG

set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -n "${EBNF_MATRIX_HIR_LOG:-}" ]]; then export EBNF_MATRIX_HIR_LOG; fi
if [[ -n "${EBNF_MATRIX_MIR_LOG:-}" ]]; then export EBNF_MATRIX_MIR_LOG; fi
if [[ -n "${CONVERSIO_MATRIX_LOG:-}" ]]; then export CONVERSIO_MATRIX_LOG; fi

# The conversio measurement marks fixture-backed cells; without the examples
# fixtures the regenerated JSON would silently lose the measured flags and the
# gate would report a confusing staleness. Fail with the real cause instead.
if [[ -z "${CONVERSIO_MATRIX_FIXTURES:-}" ]] && [[ ! -d "../examples/conversio-matrix" ]]; then
    echo "error: conversio fixtures missing (../examples/conversio-matrix); pin the examples repo or set CONVERSIO_MATRIX_FIXTURES" >&2
    exit 1
fi

tmp="$(mktemp -d -t compat-json-freshness.XXXXXX)"
emit_log="$(mktemp -t compat-json-freshness-emit.XXXXXX)"
trap 'rm -rf "$tmp" "$emit_log"' EXIT

# emit-compat-json.py is noisy on success (cargo --nocapture). Keep success
# quiet; dump the captured tail if regen fails so stage 4a is fail-loud.
if ! COMPAT_OUT="$tmp" ./scripta/emit-compat-json.py >"$emit_log" 2>&1; then
  echo "error: ./scripta/emit-compat-json.py failed" >&2
  tail -n 80 "$emit_log" >&2 || true
  exit 1
fi

if ! python3 ./scripta/compare-compat-json.py corpus/measurement "$tmp"; then
  echo "error: corpus/measurement contains a regressive capability delta" >&2
  exit 1
fi

echo "compat measurement json fresh"
