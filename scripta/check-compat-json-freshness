#!/usr/bin/env bash
# Freshness gate for corpus/measurement/compat/*.json (EBNF compat matrix).
#
# Regenerates the measurement JSON for the columns this checkout can measure
# (`./scripta/emit-compat-json.py --list`) to a temp root and requires it to
# EQUAL the committed files: the regenerated bytes must be the committed bytes.
# The columns whose backends ship in this repository (`faber`, `runner`) are
# measurable everywhere; the others only where their backends are built, so a
# checkout without them checks exactly the columns it can and says which.
#
# Without --accept the gate fails on any byte difference. The class-aware diff
# (scripta/compare-compat-json.py) is the report: it names the term whose
# count moved, separates additive drift (the tree ahead of the committed
# record: `superset of tree: N additive cells uncommitted`) from capability
# regressions, and under --accept records additive drift instead of failing it.
# Capability regressions always fail, with or without --accept. Recommit the
# regenerated JSON in the same change when the measured baseline is meant to
# move.
#
# Where the gate runs: ./scripta/check-measurement-gates (stage 4a of
# ./scripta/test) in the development repository; by hand anywhere else.
#
# Env (skip cargo): COMPAT_MEASURE_LOG, and where the other columns are measured
# EBNF_MATRIX_HIR_LOG / EBNF_MATRIX_MIR_LOG.

set -euo pipefail

cd "$(dirname "$0")/.."

accept_flag=""
if [[ "${1:-}" == "--accept" ]]; then
  accept_flag="--accept"
elif [[ -n "${1:-}" ]]; then
  echo "usage: $0 [--accept]" >&2
  exit 2
fi

for var in COMPAT_MEASURE_LOG EBNF_MATRIX_HIR_LOG EBNF_MATRIX_MIR_LOG; do
  if [[ -n "${!var:-}" ]]; then export "$var"; fi
done

# Only the compat/ lane is regenerated; corpus/measurement/conversio*/ are
# frozen records with no generator.
columns="$(python3 ./scripta/emit-compat-json.py --list | paste -sd, -)"

tmp="$(mktemp -d -t compat-json-freshness.XXXXXX)"
emit_log="$(mktemp -t compat-json-freshness-emit.XXXXXX)"
trap 'rm -rf "$tmp" "$emit_log"' EXIT

# emit-compat-json.py is noisy on success (cargo output). Keep success quiet;
# dump the captured tail if regen fails so the gate is fail-loud.
if ! COMPAT_OUT="$tmp" python3 ./scripta/emit-compat-json.py >"$emit_log" 2>&1; then
  echo "error: ./scripta/emit-compat-json.py failed" >&2
  tail -n 80 "$emit_log" >&2 || true
  exit 1
fi

# accept_flag is a fixed literal: empty expands to no argument.
if ! python3 ./scripta/compare-compat-json.py $accept_flag --only "$columns" corpus/measurement/compat "$tmp/compat"; then
  echo "error: corpus/measurement is not fresh (capability regression, or additive drift needing a JSON recommit or an explicit --accept)" >&2
  exit 1
fi

if [[ -z "$accept_flag" ]]; then
  IFS=, read -ra names <<<"$columns"
  for name in "${names[@]}"; do
    if ! cmp -s "corpus/measurement/compat/$name.json" "$tmp/compat/$name.json"; then
      echo "error: corpus/measurement/compat/$name.json differs from its regeneration (rerun ./scripta/emit-compat-json.py and commit the result)" >&2
      diff -u "corpus/measurement/compat/$name.json" "$tmp/compat/$name.json" | head -n 40 >&2 || true
      exit 1
    fi
  done
  echo "compat measurement json fresh (${columns//,/ })"
else
  # Under --accept the comparator's PASS state line above already names the
  # state (fresh, or superset-of-tree drift recorded as accepted).
  echo "compat measurement json checked (${columns//,/ }; drift accepted where present)"
fi
