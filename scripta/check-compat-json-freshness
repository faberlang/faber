#!/usr/bin/env bash
# Freshness gate for radix/corpus/measurement/compat/*.json (EBNF compat matrix).
#
# Regenerates the measurement JSON to a temp root and requires it to EQUAL the
# committed files for emitter-owned content ("fresh" means regenerated ==
# committed). Additive drift — the tree ahead of the committed JSON — is a
# loud distinct state (`superset of tree: N additive cells uncommitted`) and
# fails by default; pass --accept to record it (`recorded additive drift
# (accepted)`). Capability regressions always fail, with or without --accept.
# Recommit the regenerated JSON in the same change when the measured baseline
# is meant to move. Wired into ./scripta/check-measurement-gates (stage 4a)
# so a drifted or regressed measurement fails before later stages run.
#
# Cache envs (skip cargo):
#   EBNF_MATRIX_HIR_LOG / EBNF_MATRIX_MIR_LOG

set -euo pipefail

cd "$(dirname "$0")/.."

accept_flag=""
if [[ "${1:-}" == "--accept" ]]; then
  accept_flag="--accept"
elif [[ -n "${1:-}" ]]; then
  echo "usage: $0 [--accept]" >&2
  exit 2
fi

if [[ -n "${EBNF_MATRIX_HIR_LOG:-}" ]]; then export EBNF_MATRIX_HIR_LOG; fi
if [[ -n "${EBNF_MATRIX_MIR_LOG:-}" ]]; then export EBNF_MATRIX_MIR_LOG; fi

# Only the compat/ lane is regenerated; corpus/measurement/conversio*/ are
# frozen records with no generator in radix (their fixtures lived in examples).

tmp="$(mktemp -d -t compat-json-freshness.XXXXXX)"
emit_log="$(mktemp -t compat-json-freshness-emit.XXXXXX)"
trap 'rm -rf "$tmp" "$emit_log"' EXIT

# emit-compat-json.py is noisy on success (cargo --nocapture). Keep success
# quiet; dump the captured tail if regen fails so stage 4a is fail-loud.
if ! COMPAT_OUT="$tmp" ./scripta/emit-compat-json.py >"$emit_log" 2>&1; then
  echo "error: ./scripta/emit-compat-json.py failed" >&2
  tail -n 80 "$emit_log" >&2 || true
  exit 1
fi

# accept_flag is a fixed literal: empty expands to no argument.
if ! python3 ./scripta/compare-compat-json.py $accept_flag corpus/measurement/compat "$tmp/compat"; then
  echo "error: corpus/measurement is not fresh (capability regression, or additive drift needing a JSON recommit or an explicit --accept)" >&2
  exit 1
fi

if [[ -z "$accept_flag" ]]; then
  echo "compat measurement json fresh"
else
  # Under --accept the comparator's PASS state line above already names the
  # state (fresh, or superset-of-tree drift recorded as accepted).
  echo "compat measurement json checked (drift accepted where present)"
fi
