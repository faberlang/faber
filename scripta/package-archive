#!/usr/bin/env python3
"""Package a component payload staging dir into a deterministic archive +
basename-only SHA-256 checksum.

Implements release-contract.md §5.1 (archive identity and checksum naming)
and §5.3 (immutability / idempotent retry):

- archive name: `<component>-v<version>-<target-triple>.tar.gz`
- the `.sha256` file names ONLY the downloaded archive basename, so
  `shasum -c` works on a downloaded set (F7 — radix/cista wrote
  `dist/<archive>` paths today).
- deterministic bytes: fixed uid/gid, sorted entries, normalized mtime
  (SOURCE_DATE_EPOCH, else the latest staging mtime). Identical inputs ->
  identical archive.
- retrying the same operation with identical hashes is idempotent; a
  collision with different hashes FAILS CLOSED (the existing archive is
  never overwritten).

The payload staging dir is the faber-onboarding `assemble-dev-kit` output
(`dev-kit-<version>-<triple>/bin/...`, `share/...`); its contents land at
the archive root. Dry-run-only: no upload, no tags, no credentials.

Stdlib-only python3. Exit codes: 0 = packaged/verified, 1 = collision or
verification failure, 2 = usage error.
"""

from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import os
import sys
import tarfile
from pathlib import Path

def archive_name(component: str, version: str, triple: str) -> str:
    return f"{component}-v{version}-{triple}.tar.gz"


def _tar_mtime(staging: Path) -> int:
    raw = os.environ.get("SOURCE_DATE_EPOCH")
    if raw:
        try:
            return int(raw)
        except ValueError:
            pass
    latest = 0
    for path in staging.rglob("*"):
        try:
            latest = max(latest, path.stat().st_mtime_ns)
        except OSError:
            continue
    return latest // 1_000_000_000 if latest else 0


def build_archive_bytes(staging: Path, mtime: int) -> bytes:
    """Build the deterministic tar.gz payload for the staging dir contents."""
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for path in sorted(staging.rglob("*"), key=lambda p: p.relative_to(staging).as_posix()):
            rel = path.relative_to(staging).as_posix()
            info = tar.gettarinfo(str(path), arcname=rel)
            info.uid = 0
            info.gid = 0
            info.uname = ""
            info.gname = ""
            info.mtime = mtime
            if path.is_file():
                with open(path, "rb") as fh:
                    tar.addfile(info, fh)
            else:
                tar.addfile(info)
    payload = raw.getvalue()
    out = io.BytesIO()
    with gzip.GzipFile(fileobj=out, mode="wb", mtime=mtime) as gz:
        gz.write(payload)
    return out.getvalue()


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_checksum(archive: Path, digest: str) -> Path:
    checksum = archive.with_name(archive.name + ".sha256")
    checksum.write_text(f"{digest}  {archive.name}\n", encoding="utf-8")
    return checksum


def package(staging: Path, component: str, version: str, triple: str,
            out_dir: Path) -> tuple[int, str]:
    archive_path = out_dir / archive_name(component, version, triple)
    mtime = _tar_mtime(staging)
    payload = build_archive_bytes(staging, mtime)
    produced_digest = sha256_bytes(payload)
    if archive_path.exists():
        existing_digest = sha256_file(archive_path)
        if existing_digest == produced_digest:
            write_checksum(archive_path, produced_digest)
            return 0, (f"ok: {archive_path.name} already present with identical "
                       f"bytes (idempotent retry, release-contract.md §5.3)")
        return 1, (
            f"FAIL: {archive_path.name} exists with a different hash "
            f"({existing_digest[:16]}… vs produced {produced_digest[:16]}…); "
            f"refusing to overwrite (fail closed, release-contract.md §5.3)"
        )
    out_dir.mkdir(parents=True, exist_ok=True)
    archive_path.write_bytes(payload)
    checksum = write_checksum(archive_path, produced_digest)
    return 0, f"ok: wrote {archive_path.name} + {checksum.name}"


def verify(archive_path: Path) -> tuple[int, str]:
    """Verify an archive against its basename-only .sha256 (--check)."""
    checksum_path = archive_path.with_name(archive_path.name + ".sha256")
    if not checksum_path.exists():
        return 1, f"FAIL: no checksum file {checksum_path.name}"
    if not archive_path.exists():
        return 1, f"FAIL: no archive {archive_path.name}"
    lines = checksum_path.read_text(encoding="utf-8").strip().splitlines()
    if len(lines) != 1:
        return 1, f"FAIL: checksum file must contain exactly one line ({checksum_path.name})"
    try:
        recorded_hash, _, recorded_name = lines[0].partition("  ")
    except ValueError:
        return 1, f"FAIL: unparseable checksum line in {checksum_path.name}"
    if recorded_name != archive_path.name:
        return 1, (
            f"FAIL: checksum names {recorded_name!r}, expected the archive "
            f"basename {archive_path.name!r} (basename-only rule, §5.1)"
        )
    actual = sha256_file(archive_path)
    if actual != recorded_hash:
        return 1, f"FAIL: hash mismatch for {archive_path.name}"
    return 0, f"ok: {archive_path.name} checksum verified"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="package-archive",
        description="Wrap a payload staging dir into a deterministic tar.gz "
                    "+ basename-only sha256.",
    )
    parser.add_argument("--staging", required=True,
                        help="payload staging dir (assemble-dev-kit output)")
    parser.add_argument("--component", default="faber",
                        help="component name (default: faber)")
    parser.add_argument("--version", required=True,
                        help="release version, e.g. 1.5.0")
    parser.add_argument("--triple", required=True,
                        help="target triple, e.g. aarch64-apple-darwin")
    parser.add_argument("--out", required=True,
                        help="output directory for the archive + checksum")
    parser.add_argument("--check", action="store_true",
                        help="verify an existing archive + checksum instead of "
                             "packaging; requires --version --triple")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    out_dir = Path(args.out).resolve()
    if args.check:
        archive = out_dir / archive_name(args.component, args.version, args.triple)
        code, message = verify(archive)
        print(message, file=sys.stderr if code != 0 else sys.stdout)
        return code
    staging = Path(args.staging).resolve()
    if not staging.is_dir():
        print(f"error: staging dir not found: {staging}", file=sys.stderr)
        return 2
    code, message = package(staging, args.component, args.version, args.triple,
                            out_dir)
    print(message, file=sys.stderr if code != 0 else sys.stdout)
    return code


if __name__ == "__main__":
    sys.exit(main())
