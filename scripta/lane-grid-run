#!/usr/bin/env python3
"""Faber per-lane e2e grid runner (delivery per-lane-e2e-validation, EL-5).

Runs every backend lane against a known-commit HEAD using the EL-1 per-lane
commands, then writes (1) one green/red/skipped receipt per lane and (2) the
standing status file (decision 7 default:
`faber/docs/factory/per-lane-e2e-validation/grid-status.md`).

Host posture: this script runs on grid infrastructure (pharos), never on a
dev machine that holds the Cargo build lock. It refuses to run on a host
whose name starts with `burgus` unless `--allow-burgus` is given. Every lane
command is the exact-crate EL-1 single-package command (no --workspace/--all,
no bare cargo). Receipt statuses:

- `green`    lane command exit 0 (all lane e2e assertions held)
- `red`      lane command non-zero (unexpected failure / assertion break)
- `skipped`  host toolchain probe failed — NOT a pass (the harness would
             otherwise pass trivially without running, a false-green risk)
- `error`    the runner could not execute the lane (infrastructure)

Usage:
    lane-grid-run [--root ROOT] [--head COMMIT] [--status PATH]
                  [--receipts-dir PATH] [--lanes go,ts,...] [--timeout-min N]
                  [--skip-toolcheck] [--allow-burgus] [--quiet]
"""

import argparse
import datetime
import json
import os
import socket
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

import lane_grid_common as lg  # noqa: E402

STATUS_DEFAULT = "docs/factory/per-lane-e2e-validation/grid-status.md"


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc)


def stamp():
    return utc_now().strftime("%Y%m%dT%H%M%S")


def resolve_head(faber_repo, head_arg):
    """Target commit: --head, else origin/main, else the checked-out HEAD."""
    if head_arg:
        return run_git(faber_repo, ["rev-parse", head_arg]), head_arg
    origin = run_git(faber_repo, ["rev-parse", "origin/main"])
    if origin:
        return origin, "origin/main"
    return run_git(faber_repo, ["rev-parse", "HEAD"]), "HEAD"


def run_git(repo, args):
    try:
        proc = subprocess.run(
            ["git", "-C", repo] + args,
            capture_output=True,
            text=True,
            timeout=60,
        )
        return proc.stdout.strip() if proc.returncode == 0 else ""
    except Exception:
        return ""


def sibling_pins(root):
    pins = {}
    for repo in ("radix", "cista", "faber-runtime", "hosts", "norma", "examples"):
        head = run_git(os.path.join(root, repo), ["rev-parse", "HEAD"])
        pins[repo] = head or "<absent>"
    return pins


def host_info():
    return {
        "hostname": socket.gethostname(),
        "platform": " ".join(os.uname()[:3]) if hasattr(os, "uname") else "unknown",
        "cores": os.cpu_count() or 0,
    }


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(HERE)),
                    help="container root containing faber/ radix/ cista/ faber-runtime/ hosts/ "
                         "(default: parent of the faber checkout this script lives in)")
    ap.add_argument("--head", help="pin target commit (default: origin/main, else checked-out HEAD)")
    ap.add_argument("--status", default=STATUS_DEFAULT, help="standing status file path")
    ap.add_argument("--receipts-dir", default=None, help="receipt output dir (default: <root>/receipts)")
    ap.add_argument("--lanes", default=",".join(lg.CANONICAL_ORDER),
                    help="comma-separated lanes (default: all, canonical order)")
    ap.add_argument("--timeout-min", type=float, default=120.0, help="per-lane timeout in minutes")
    ap.add_argument("--skip-toolcheck", action="store_true", help="run lanes even if host tools are missing")
    ap.add_argument("--allow-burgus", action="store_true", help="allow running on the dev host (not recommended)")
    ap.add_argument("--quiet", action="store_true", help="less stdout")
    args = ap.parse_args(argv)

    if lg.is_dev_host() and not args.allow_burgus:
        print("error: this looks like the dev machine (burgus) — the grid must run on "
              "grid infra (pharos) so it never holds the dev Cargo lock. Use "
              "--allow-burgus only for debugging.", file=sys.stderr)
        return 3

    root = os.path.abspath(args.root)
    faber = os.path.join(root, "faber")
    if not os.path.isdir(os.path.join(faber, ".git")):
        print(f"error: {faber} is not a git checkout", file=sys.stderr)
        return 2

    lanes = [l.strip() for l in args.lanes.split(",") if l.strip()]
    for l in lanes:
        if l not in lg.CANONICAL_ORDER:
            print(f"error: unknown lane {l!r} (known: {', '.join(lg.CANONICAL_ORDER)})", file=sys.stderr)
            return 2

    head_sha, head_ref = resolve_head(faber, args.head)
    if not head_sha:
        print("error: could not resolve target HEAD", file=sys.stderr)
        return 2

    run_id = "grid-" + stamp()
    receipts_dir = os.path.abspath(args.receipts_dir or os.path.join(root, "receipts"))
    run_dir = os.path.join(receipts_dir, run_id)
    os.makedirs(run_dir, exist_ok=True)

    info = {
        "run": run_id,
        "created_at": utc_now().isoformat(),
        "target": {"faber": head_sha, "ref": head_ref},
        "sibling_pins": sibling_pins(root),
        "host": host_info(),
        "root": root,
    }

    if not args.quiet:
        print(f"run {run_id}")
        print(f"  host    : {info['host']['hostname']} ({info['host']['platform']}, {info['host']['cores']} cores)")
        print(f"  target  : faber {head_sha[:8]} ({head_ref})")
        print(f"  siblings: " + " ".join(f"{k}={v[:8]}" for k, v in info["sibling_pins"].items()))

    results = []
    timeout_s = int(args.timeout_min * 60)
    for label in lanes:
        feature, target, filter_token, tools, kind = (lambda r: (r[1], r[2], r[3], r[4], r[5]))(lg.lane_row(label))
        ok, missing = lg.probe_tools(label)
        receipt = {
            "run": run_id,
            "lane": label,
            "feature": feature,
            "kind": kind,
            "status": None,
            "head": head_sha,
            "sibling_pins": info["sibling_pins"],
            "exit_code": None,
            "duration_s": None,
            "started_at": utc_now().isoformat(),
            "tool_probe": {},
            "tests_ran": None,
            "test_summary": None,
            "log": os.path.join(run_dir, label + ".log"),
            "error": None,
        }
        if not ok and not args.skip_toolcheck:
            receipt["status"] = "skipped"
            receipt["error"] = f"missing host toolchain: {', '.join(missing)}"
            if not args.quiet:
                print(f"  {label:10s} skipped — missing host toolchain: {', '.join(missing)}")
            results.append(receipt)
            continue

        cmd = lg.lane_command(label)
        if not args.quiet:
            print(f"  {label:10s} running: {' '.join(cmd)}")
        started = utc_now()
        code, output = lg.run_captured(cmd, cwd=faber, timeout_s=timeout_s)
        duration = (utc_now() - started).total_seconds()
        with open(receipt["log"], "w") as fh:
            fh.write(output)

        receipt["exit_code"] = code
        receipt["duration_s"] = round(duration, 1)
        summary = lg.extract_test_summary(output)
        receipt["test_summary"] = summary
        if summary:
            try:
                # "test result: ok. 1 passed; 0 failed; ..." → pass count.
                passed = summary.split(";")[0].split(".")[-1].strip()
                if "passed" in passed:
                    receipt["tests_ran"] = int(passed.split()[0])
            except (ValueError, IndexError):
                pass

        if code == 0:
            receipt["status"] = "green"
            note = f"test result ok"
        elif code == -1:
            receipt["status"] = "error"
            receipt["error"] = "timed out"
        elif code == -2:
            receipt["status"] = "error"
            receipt["error"] = "command not found"
        else:
            receipt["status"] = "red"
        if kind == "compile-gate" and receipt["status"] == "green":
            receipt["note"] = ("compile-gate lane: no dedicated exempla harness e2e for "
                               "mir-metal; build+harness compile is the gate (0 tests ran)")
        if not args.quiet:
            print(f"  {label:10s} {receipt['status']}  exit={code}  {duration:.0f}s"
                  + (f"  {summary}" if summary else ""))
        results.append(receipt)

    manifest = dict(info)
    manifest["lanes"] = [
        {k: r[k] for k in ("lane", "status", "exit_code", "duration_s", "tests_ran")}
        for r in results
    ]
    with open(os.path.join(run_dir, "manifest.json"), "w") as fh:
        json.dump(manifest, fh, indent=2, sort_keys=True)
    for r in results:
        with open(os.path.join(run_dir, r["lane"] + ".json"), "w") as fh:
            json.dump(r, fh, indent=2, sort_keys=True)

    status_path = args.status if os.path.isabs(args.status) else os.path.join(faber, args.status)
    write_status(status_path, info, results, run_dir)

    reds = [r["lane"] for r in results if r["status"] == "red"]
    skips = [r["lane"] for r in results if r["status"] == "skipped"]
    errors = [r["lane"] for r in results if r["status"] == "error"]
    print(f"summary: {sum(1 for r in results if r['status']=='green')} green, "
          f"{len(reds)} red, {len(skips)} skipped, {len(errors)} error"
          + (f" — red: {', '.join(reds)}" if reds else "")
          + (f" — skipped: {', '.join(skips)}" if skips else "")
          + (f" — error: {', '.join(errors)}" if errors else ""))
    print(f"status file: {status_path}")
    print(f"receipts: {run_dir}")
    return 0


def write_status(path, info, results, run_dir):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lines = []
    lines.append("# Per-Lane E2E Grid — Standing Status (Tier 1 report-only)")
    lines.append("")
    lines.append(f"- **Updated**: {utc_now().isoformat()}")
    lines.append(f"- **Run**: `{info['run']}`")
    lines.append(f"- **Target**: faber `{info['target']['faber'][:8]}` ({info['target']['ref']})")
    lines.append("- **Sibling pins**: " + " ".join(
        f"{k} `{v[:8]}`" for k, v in info["sibling_pins"].items()))
    lines.append(f"- **Host**: {info['host']['hostname']} ({info['host']['platform']}, "
                 f"{info['host']['cores']} cores)")
    lines.append(f"- **Grid root**: `{info['root']}`")
    lines.append(f"- **Receipts**: `{run_dir}`")
    lines.append("")
    lines.append("## Lane receipts")
    lines.append("")
    lines.append("| Lane | Status | Exit | Duration | Summary |")
    lines.append("| --- | --- | --- | --- | --- |")
    for r in results:
        note = r.get("note") or r.get("test_summary") or (r.get("error") or "") or ""
        note = " ".join(note.split())
        lines.append(f"| {r['lane']} | {r['status']} | "
                     f"{r['exit_code'] if r['exit_code'] is not None else '—'} | "
                     f"{r['duration_s'] if r['duration_s'] is not None else '—'}s | {note} |")
    lines.append("")
    lines.append("## Legend")
    lines.append("")
    lines.append("- `green` = lane command exit 0 (all lane e2e assertions held).")
    lines.append("- `red` = lane command non-zero (unexpected failure or assertion break).")
    lines.append("- `skipped` = host toolchain probe failed (missing tool on the grid host); "
                 "**not** a pass.")
    lines.append("- `error` = the runner could not execute the lane (infra/timeout).")
    lines.append("- Tier 1 report-only: this file does not gate merges (goal stop condition 3).")
    with open(path, "w") as fh:
        fh.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    sys.exit(main())
