#!/usr/bin/env python3
"""Assemble the Faber dev-kit payload staging directory and release manifest.

Produces a deterministic, versioned payload staging directory (the installed
layout contract of faber-onboarding Stage 2):

    out/dev-kit-<version>-<triple>/
      bin/faber                         # launcher (copied, never built here)
      share/faber/reference/            # reference pack (index.toml, PACK.toml,
                                        #   legacy-redirects.toml, exempla/)
      share/faber/locale/<locale>/      # reader packs for all eight radix locales

Then generates `faber/release-manifest.yaml` — the first instance of the single
release-manifest schema (faber/docs/release/release-manifest-schema.md §3/§4/§6)
with `pinnedInputs.source` exact commits and `pinnedInputs.packs` rows — plus a
machine-readable JSON payload receipt (`{"packs": [...]}` plus per-file sha256,
pack source commits, toolchain/version stamp). The receipt's `packs` rows are
built once and shared with the manifest, so `generate-release-manifest
--packs-receipt` consumes the real receipt with no manual translation. The
receipt never records absolute machine paths (release leakage gate,
process-local-first.md §4).

The script never builds and never touches the network. The faber binary is an
input (`--binary`); pack sources are read from the sibling radix checkout at
assembly time only — the installed payload never reads the radix tree.

Usage:
    scripta/assemble-dev-kit --version 1.4.0 --triple aarch64-apple-darwin \
        --binary target/release/faber --out /tmp/faber-dev-kit
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import subprocess
import sys
import tomllib
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CONTAINER = ROOT.parent
RADIX = CONTAINER / "radix"
LOCALES = ["ar", "en", "hi", "la", "th-TH", "vi", "zh-Hans", "zh-Hant"]
CORE_SUPPORT_MANIFEST = ROOT / "core-support-manifest.txt"

SCHEMA_SOURCE_ROWS = [
    # (component, sibling dir, has_planned_tag)
    ("faber", "faber", True),
    ("radix", "radix", False),
    ("cista", "cista", False),
    ("faber-runtime", "faber-runtime", False),
    ("hosts", "hosts", False),
]

REFERENCE_ASSEMBLER = RADIX / "scripta" / "assemble-reference-pack.py"


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def git_commit(repo: Path) -> str:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=repo,
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as err:
        fail(f"cannot resolve HEAD commit in {repo}: {err}")
    return result.stdout.strip()


def tree_digest(roots: list[Path]) -> str:
    """Deterministic digest over every file under `roots`.

    The digest input is a sorted list of `relpath<TAB>sha256hex` lines with
    relpaths expressed in the root-relative (posix) form, so the same tree
    always hashes identically regardless of build order or mtimes.
    """
    entries: list[tuple[str, str]] = []
    for root in roots:
        if not root.is_dir():
            fail(f"pack source root is not a directory: {root}")
        for path in sorted(root.rglob("*")):
            if path.is_file():
                rel = path.relative_to(root).as_posix()
                entries.append((rel, sha256_file(path)))
    canonical = "\n".join(f"{rel}\t{digest}" for rel, digest in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def tree_digest_with_prefix(prefix: str, root: Path) -> str:
    """Digest of one tree, prefixing relpaths (used for multi-root sets)."""
    entries: list[tuple[str, str]] = []
    for path in sorted(root.rglob("*")):
        if path.is_file():
            rel = f"{prefix}/{path.relative_to(root).as_posix()}"
            entries.append((rel, sha256_file(path)))
    canonical = "\n".join(f"{rel}\t{digest}" for rel, digest in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def core_support_digest() -> str:
    """Digest over the core-support source set listed in core-support-manifest.txt.

    The embedded archive (a tar.zst produced by build.rs) is verified by the
    materialization step at runtime (core_support.rs, E12); this row records a
    deterministic source-set identity computed without a build.
    """
    if not CORE_SUPPORT_MANIFEST.is_file():
        fail(f"missing {CORE_SUPPORT_MANIFEST}")
    roots: list[Path] = []
    for line in CORE_SUPPORT_MANIFEST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        root = (CONTAINER / line).resolve()
        if not root.is_dir():
            fail(f"core-support root from {CORE_SUPPORT_MANIFEST} is missing: {root}")
        roots.append(root)
    entries: list[tuple[str, str]] = []
    for root in roots:
        entries.append((root.relative_to(CONTAINER).as_posix(), tree_digest([root])))
    canonical = "\n".join(f"{rel}\t{digest}" for rel, digest in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_version_from_manifest() -> str:
    data = tomllib.loads((ROOT / "Cargo.toml").read_text(encoding="utf-8"))
    return data["package"]["version"]


def major_line(version: str) -> str:
    match = re.match(r"^(\d+)\.", version)
    if not match:
        fail(f"version {version!r} does not look like X.Y.Z")
    return f"{match.group(1)}.x"


def copy_locale_packs(staging_share: Path) -> None:
    for locale in LOCALES:
        source = RADIX / "stdlib" / "locale" / locale
        if not (source / "pack.toml").is_file():
            fail(f"locale pack source missing for {locale}: {source / 'pack.toml'}")
        dest = staging_share / "locale" / locale
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(source, dest)


def assemble_reference_pack(staging_share: Path, version: str, radix_commit: str) -> None:
    if not REFERENCE_ASSEMBLER.is_file():
        fail(f"reference pack assembler missing: {REFERENCE_ASSEMBLER}")
    dest = staging_share / "reference"
    result = subprocess.run(
        [
            sys.executable,
            str(REFERENCE_ASSEMBLER),
            "--out",
            str(dest),
            "--version",
            version,
            # Pin the PACK.toml source_commit to the SAME radix commit this
            # manifest pins, resolved once below. Without it the pack embeds
            # whatever radix HEAD is at assembly time and the manifest can race
            # a mid-assembly commit landing (sweep-14 E2): two regenerations
            # under the same pin produced different pack digests.
            "--commit",
            radix_commit,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        fail(
            "reference pack assembly failed:\n"
            + result.stdout
            + result.stderr
        )
    if not (dest / "index.toml").is_file() or not (dest / "PACK.toml").is_file():
        fail(f"reference pack assembly produced an incomplete pack at {dest}")


def tag_at_commit(repo: Path, commit: str, prefer: str | None = None) -> str | None:
    """The release tag pointing exactly at `commit`, if any.

    Schema §4 defines a source row's `tag` as "source tag when the pin IS a
    tag" — the field must not be invented when the pin is a plain commit
    (sweep-14 E3: faber stamped `tag: v{version}` for a HEAD-commit pin whose
    real vX.Y.Z tag points elsewhere). `--points-at` matches tag -> commit
    exactly; annotated tags are resolved through their peeled commit.
    """
    try:
        result = subprocess.run(
            ["git", "tag", "--points-at", commit],
            cwd=repo,
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as err:
        fail(f"cannot resolve tags at {commit[:12]} in {repo}: {err}")
    tags = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not tags:
        return None
    if prefer and prefer in tags:
        return prefer
    return tags[0]


def quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def read_version(repo_relative_manifest: Path) -> str:
    data = tomllib.loads(repo_relative_manifest.read_text(encoding="utf-8"))
    try:
        return data["package"]["version"]
    except KeyError:
        fail(f"no [package] version in {repo_relative_manifest}")


def build_pack_rows(version: str, digests: dict[str, str]) -> list[dict]:
    """The dev-kit payload packs (release-manifest-schema.md §6 rows).

    Single source of truth for the pack rows: the manifest and the
    machine-readable JSON receipt both consume this list, so the two can never
    drift apart. Keys match the schema exactly: name / component / version /
    digest / compatibility / license / destination.
    """
    return [
        {
            "name": "launcher",
            "component": "faber",
            "version": version,
            "digest": f"sha256:{digests['launcher']}",
            "compatibility": "faber 1.x; ships with matching reference and locale packs",
            "license": "MIT",
            "destination": "bin/faber",
        },
        {
            "name": "core-support",
            "component": "faber",
            "version": version,
            "digest": f"sha256:{digests['core-support']}",
            "compatibility": (
                f"faber {version}; embedded and materialized to the platform "
                "cache (content-hash-keyed)"
            ),
            "license": "MIT",
            "destination": (
                "embedded in launcher; materialized to <platform cache>/faber/"
                "core-support/tar-zst-v1/<sha256>"
            ),
        },
        {
            "name": "reference-pack",
            "component": "reference",
            "version": version,
            "digest": f"sha256:{digests['reference-pack']}",
            "compatibility": "faber 1.x major lane; pack_version_skew enforced at load",
            "license": "MIT",
            "destination": "share/faber/reference",
        },
        {
            "name": "locale-packs",
            "component": "locale",
            "version": version,
            "digest": f"sha256:{digests['locale-packs']}",
            "compatibility": f"faber {version}; locale pack schema_version 1",
            "license": "MIT",
            "destination": "share/faber/locale/<locale>/pack.toml",
        },
        {
            "name": "library-pack",
            "component": "norma",
            "version": "0.1.0",
            "digest": f"sha256:{digests['library-pack']}",
            "compatibility": "norma 0.1.x (faber_min 0.38.0); release-owned platform package",
            "license": "MIT",
            "destination": "store seeding via faber install (faber-onboarding Stage 6)",
        },
    ]


def write_manifest(
    manifest_dir: Path,
    *,
    version: str,
    faber_commit: str,
    radix_commit: str,
    digests: dict[str, str],
) -> None:
    today = date.today().isoformat()
    source_rows = []
    for component, sibling, has_planned_tag in SCHEMA_SOURCE_ROWS:
        repo = CONTAINER / sibling
        # a git worktree member has `.git` as a file, not a directory
        if not (repo / ".git").exists():
            fail(f"sibling repo for {component} is missing: {repo}")
        # The radix pin is resolved once and reused as the reference-pack
        # PACK.toml source_commit (sweep-14 E2): the two can never diverge.
        commit = radix_commit if component == "radix" else git_commit(repo)
        if has_planned_tag:
            # Schema §4: record the tag only when the pin IS a tag. A HEAD
            # commit with no exact tag gets no tag row (sweep-14 E3).
            tag = tag_at_commit(repo, commit, prefer=f"v{version}")
            if tag:
                row = (
                    f"    - name: {component}\n"
                    f"      commit: {commit}\n"
                    f"      tag: {tag}\n"
                )
            else:
                row = f"    - name: {component}\n      commit: {commit}\n"
        else:
            row = f"    - name: {component}\n      commit: {commit}\n"
        source_rows.append(row)

    pack_rows = "".join(
        f"    - name: {row['name']}\n"
        f"      component: {row['component']}\n"
        f"      version: {quote(row['version'])}\n"
        f"      digest: {row['digest']}\n"
        f"      compatibility: {quote(row['compatibility'])}\n"
        f"      license: {row['license']}\n"
        f"      destination: {quote(row['destination'])}\n"
        for row in build_pack_rows(version, digests)
    )

    radix_version = read_version(RADIX / "crates" / "radix" / "Cargo.toml")
    cista_version = read_version(CONTAINER / "cista" / "Cargo.toml")

    manifest = f"""# Freeze artifact - prepared {today} by faber/scripta/assemble-dev-kit.
# First instance of the single release-manifest schema (faber/docs/release/
# release-manifest-schema.md + release-manifest.schema.json). Do not edit by
# hand: the manifest updates only as part of a release prepare step (schema
# §7). Pins match live commits and pack digests match the assembled artifacts
# at the prepare date.
schemaVersion: "1"
manifestName: faber-release
preparedAt: {today}
releaseIntent:
  component: faber
  version: {quote(version)}
  channel: candidate
  line: {quote(major_line(version))}
pinnedInputs:
  source:
{''.join(source_rows)}
  packs:
{pack_rows}versionSources:
  - component: faber
    manifest: Cargo.toml
    version: {quote(version)}
  - component: radix
    manifest: crates/radix/Cargo.toml
    version: {quote(radix_version)}
  - component: cista
    manifest: Cargo.toml
    version: {quote(cista_version)}
exclusions:
  - component: faber
    path: crates/hygiene-ratchet
    reason: not release-aligned; stays 0.1.0
  - component: radix
    path: crates/hygiene-ratchet
    reason: not release-aligned; stays 0.1.0
  - component: cista
    path: crates/hygiene-ratchet
    reason: not release-aligned; stays 0.1.0
publication:
  releaseTag: faber-v{version}
  host: faberlang/releases
  advancesGlobalLatest: false
"""
    target = manifest_dir / "release-manifest.yaml"
    target.write_text(manifest, encoding="utf-8")
    print(f"wrote {target}")


def write_receipt(
    out_dir: Path,
    name: str,
    staging: Path,
    *,
    version: str,
    triple: str,
    faber_commit: str,
    digests: dict[str, str],
    locale_digests: dict[str, str],
    binary: Path,
) -> None:
    today = date.today().isoformat()
    per_file = [
        {
            "path": path.relative_to(staging).as_posix(),
            "sha256": sha256_file(path),
        }
        for path in sorted(staging.rglob("*"))
        if path.is_file()
    ]
    source_commits = {
        component: git_commit(CONTAINER / sibling)
        for component, sibling, _has_planned_tag in SCHEMA_SOURCE_ROWS
        if (CONTAINER / sibling / ".git").exists()
    }
    receipt = {
        "receipt": f"Faber dev-kit payload receipt - {name}",
        "prepared": today,
        "version": version,
        "triple": triple,
        "faberSourceCommit": faber_commit,
        # basename only: absolute build paths leak the developer machine
        # (release leakage gate, process-local-first.md §4)
        "launcher": {
            "file": binary.name,
            "sha256": sha256_file(binary),
            "payloadPath": "bin/faber",
        },
        "packs": build_pack_rows(version, digests),
        "payload": {
            "perFileSha256": per_file,
            "packSourceCommits": source_commits,
            "localePackDigests": {
                locale: f"sha256:{digest}"
                for locale, digest in sorted(locale_digests.items())
            },
            "toolchain": f"{sys.version.split()[0]} (python)",
        },
    }

    receipt_path = out_dir / f"{name}.receipt.json"
    receipt_path.write_text(
        json.dumps(receipt, indent=2) + "\n", encoding="utf-8"
    )
    print(f"wrote {receipt_path}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--version", required=True, help="Faber release version (e.g. 1.4.0)")
    parser.add_argument(
        "--triple",
        required=True,
        help="Target triple (e.g. aarch64-apple-darwin, x86_64-unknown-linux-gnu)",
    )
    parser.add_argument(
        "--binary", required=True, type=Path, help="Path to the built faber binary (never builds)"
    )
    parser.add_argument(
        "--out", required=True, type=Path, help="Scratch output directory for the payload"
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=ROOT,
        help="Directory for release-manifest.yaml (default: faber repo root)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    binary = args.binary.resolve()
    if not binary.is_file():
        fail(f"--binary is not a file: {binary}")
    if not REFERENCE_ASSEMBLER.is_file() or not (RADIX / "corpus" / "index.toml").is_file():
        fail("radix checkout with corpus/index.toml is required at assembly time")

    manifest_version = read_version_from_manifest()
    if manifest_version != args.version:
        fail(
            f"--version {args.version} does not match faber/Cargo.toml version "
            f"{manifest_version} (schema §5 hard stop)"
        )

    name = f"dev-kit-{args.version}-{args.triple}"
    staging = args.out / name
    if staging.exists():
        shutil.rmtree(staging)
    bin_dir = staging / "bin"
    share_dir = staging / "share" / "faber"
    bin_dir.mkdir(parents=True)
    share_dir.mkdir(parents=True)

    shutil.copy2(binary, bin_dir / "faber")
    (bin_dir / "faber").chmod(0o755)

    # Resolve the radix source commit ONCE: the reference-pack PACK.toml
    # source_commit and the manifest's radix pin both come from this value, so
    # a commit landing mid-assembly cannot split them (sweep-14 E2).
    radix_commit = git_commit(RADIX)
    assemble_reference_pack(share_dir, args.version, radix_commit)
    copy_locale_packs(share_dir)

    faber_commit = git_commit(ROOT)
    locale_digests = {
        locale: tree_digest([share_dir / "locale" / locale]) for locale in LOCALES
    }
    digests = {
        "launcher": sha256_file(bin_dir / "faber"),
        "core-support": core_support_digest(),
        "reference-pack": tree_digest([share_dir / "reference"]),
        "locale-packs": hashlib.sha256(
            "\n".join(
                f"{locale}\t{digest}" for locale, digest in sorted(locale_digests.items())
            ).encode("utf-8")
        ).hexdigest(),
        "library-pack": tree_digest_with_prefix(
            "norma", (CONTAINER / "norma" / "src").resolve()
        ),
    }

    manifest_dir = args.manifest.resolve()
    write_manifest(
        manifest_dir,
        version=args.version,
        faber_commit=faber_commit,
        radix_commit=radix_commit,
        digests=digests,
    )
    write_receipt(
        args.out.resolve(),
        name,
        staging,
        version=args.version,
        triple=args.triple,
        faber_commit=faber_commit,
        digests=digests,
        locale_digests=locale_digests,
        binary=binary,
    )

    print(f"payload staging: {staging}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
