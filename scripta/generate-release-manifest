#!/usr/bin/env python3
"""Generate faber/release-manifest.yaml from live evidence at prepare time.

The manifest is the machine-readable input/pin manifest for a Faber product
release (faber/docs/release/release-manifest-schema.md §2–§7). It is updated
ONLY as part of the release prepare step (schema §7): ad-hoc edits outside a
release intent are rejected — this script refuses to overwrite an existing
instance unless `--force` is given as part of that intent.

Evidence recorded from live sources:

- release intent (component, version, channel, line) from CLI args; the
  version must equal the faber `Cargo.toml` [package] version (hard stop).
- pinned source SHAs: faber tag commit (or HEAD) plus the radix, cista,
  faber-runtime, and hosts commits, resolved from the sibling trees at
  `<root>/../<name>` when SHAs are not given explicitly. Never invented.
- dev-kit payload `pinnedInputs.packs` rows: digests and payload facts come
  from the faber-onboarding `assemble-dev-kit` payload receipt (JSON:
  {"packs": [{name, component, version, digest, compatibility, license,
  destination}, ...]}) or `--packs` inline JSON.
- authoritative version sources: read from the component manifests
  (faber Cargo.toml, radix crates/radix/Cargo.toml, cista Cargo.toml).
- intentional exclusions: crates/hygiene-ratchet stays 0.1.0 in each
  workspace (schema §5).

The generated instance is validated against
`faber/docs/release/release-manifest.schema.json` before the script exits.

Stdlib-only python3. Dry-run-only: no tags, no pushes, no uploads.
Exit codes: 0 = generated/valid, 1 = validation failure or refused
overwrite, 2 = usage/evidence error.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tomllib
from datetime import date
from pathlib import Path

VALIDATOR = Path(__file__).with_name("validate-release-manifest")
SCHEMA_SECTION = "faber/docs/release/release-manifest-schema.md"

SEMVER_RE = r"^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$"


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


# ---------------------------------------------------------------------------
# live evidence helpers
# ---------------------------------------------------------------------------

def read_manifest_version(manifest: Path, what: str) -> str:
    data = tomllib.loads(manifest.read_text(encoding="utf-8"))
    pkg = data.get("package")
    if not pkg or "version" not in pkg:
        raise ValueError(f"{what}: no [package] version at {manifest}")
    return pkg["version"]


def git_sha(root: Path, ref: str, what: str) -> str:
    """Resolve a commit SHA locally (no network)."""
    res = subprocess.run(
        ["git", "-C", str(root), "rev-parse", ref],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        raise ValueError(
            f"{what}: cannot resolve {ref!r} in {root}: "
            f"{(res.stderr or res.stdout or '').strip()}"
        )
    sha = res.stdout.strip()
    if not sha:
        raise ValueError(f"{what}: git rev-parse returned nothing for {ref!r}")
    return sha


def sibling_dir(root: Path, name: str) -> Path:
    return (root / ".." / name).resolve()


def load_packs(receipt: Path | None, inline: str | None) -> list[dict]:
    if receipt is not None:
        receipt = Path(receipt)
        if not receipt.exists():
            raise ValueError(f"packs receipt not found: {receipt}")
        data = json.loads(receipt.read_text(encoding="utf-8"))
        packs = data.get("packs")
        if not isinstance(packs, list):
            shape = '{"packs": [...]}'
            raise ValueError(f"packs receipt {receipt}: expected {shape}")
        return packs
    if inline is not None:
        data = json.loads(inline)
        if not isinstance(data, list):
            raise ValueError("--packs must be a JSON array of pack rows")
        return data
    raise ValueError(
        "no dev-kit pack evidence: pass --packs-receipt (assemble-dev-kit "
        "payload receipt) or --packs inline JSON"
    )


# ---------------------------------------------------------------------------
# YAML emission (the subset validate-release-manifest parses)
# ---------------------------------------------------------------------------

def _parse_scalar_like(s: str):
    """Minimal scalar-type probe used only for quoting decisions."""
    if s in ("true", "True", "TRUE"):
        return True
    if s in ("false", "False", "FALSE"):
        return False
    if s in ("null", "Null", "NULL", "~"):
        return None
    import re as _re
    if _re.fullmatch(r"[-+]?[0-9]+", s):
        return int(s)
    if _re.fullmatch(r"[-+]?([0-9]+\.[0-9]*|\.[0-9]+)([eE][-+]?[0-9]+)?", s):
        return float(s)
    return s


def _fmt_scalar(v: object) -> str:
    if v is None:
        return "null"
    if v is True:
        return "true"
    if v is False:
        return "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return repr(v)
    s = str(v)
    semver_like = re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?", s)
    need_quotes = (
        s != s.strip()
        or "#" in s
        or ": " in s
        or semver_like is not None
        or s.startswith(".")
        or (isinstance(_parse_scalar_like(s), (bool, int, float)) or s in ("null", "~"))
    )
    if need_quotes:
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def _emit_entry(lines: list[str], key: str, value: object, indent: int,
                dash: bool = False) -> None:
    prefix = " " * indent
    marker = "- " if dash else ""
    if isinstance(value, dict):
        lines.append(f"{prefix}{marker}{key}:")
        for k, v in value.items():
            _emit_entry(lines, k, v, indent + 2)
    elif isinstance(value, list):
        lines.append(f"{prefix}{marker}{key}:")
        for item in value:
            if isinstance(item, dict):
                first = True
                for k, v in item.items():
                    if first:
                        _emit_entry(lines, k, v, indent + 2, dash=True)
                        first = False
                    else:
                        _emit_entry(lines, k, v, indent + 4)
            else:
                lines.append(f"{prefix}  - {_fmt_scalar(item)}")
    else:
        lines.append(f"{prefix}{marker}{key}: {_fmt_scalar(value)}")


def emit_yaml(data: dict) -> str:
    lines: list[str] = []
    for key, value in data.items():
        _emit_entry(lines, key, value, 0)
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# manifest construction
# ---------------------------------------------------------------------------

def build_manifest(args: argparse.Namespace) -> dict:
    root = Path(args.root).resolve()
    faber_manifest = root / "Cargo.toml"
    if not faber_manifest.exists():
        raise ValueError(f"not a faber repo root (no Cargo.toml): {root}")
    faber_version = read_manifest_version(faber_manifest, "faber")
    if args.version != faber_version:
        raise ValueError(
            f"version mismatch: --version {args.version} != faber Cargo.toml "
            f"version {faber_version} (authoritative version source, "
            f"{SCHEMA_SECTION} §5)"
        )

    radix_dir = sibling_dir(root, "radix")
    cista_dir = sibling_dir(root, "cista")
    radix_manifest = radix_dir / "crates/radix/Cargo.toml"
    cista_manifest = cista_dir / "Cargo.toml"
    if not radix_manifest.exists():
        raise ValueError(f"radix sibling tree missing: {radix_manifest}")
    if not cista_manifest.exists():
        raise ValueError(f"cista sibling tree missing: {cista_manifest}")
    radix_version = read_manifest_version(radix_manifest, "radix")
    cista_version = read_manifest_version(cista_manifest, "cista")

    def resolve(name: str, explicit: str | None, dir_: Path, ref: str) -> str:
        if explicit:
            return explicit
        return git_sha(dir_, ref, name)

    faber_sha = resolve(
        "faber", args.faber_sha,
        root, f"{args.faber_tag}^{{commit}}" if args.faber_tag else "HEAD",
    )
    source = [
        {"name": "faber", "commit": faber_sha},
        {"name": "radix", "commit": resolve("radix", args.radix_sha, radix_dir, "HEAD")},
        {"name": "cista", "commit": resolve("cista", args.cista_sha, cista_dir, "HEAD")},
        {"name": "faber-runtime",
         "commit": resolve("faber-runtime", args.faber_runtime_sha,
                           sibling_dir(root, "faber-runtime"), "HEAD")},
        {"name": "hosts",
         "commit": resolve("hosts", args.hosts_sha,
                           sibling_dir(root, "hosts"), "HEAD")},
    ]
    if args.faber_tag:
        source[0]["tag"] = args.faber_tag

    packs = load_packs(args.packs_receipt, args.packs)

    manifest = {
        "schemaVersion": "1",
        "manifestName": "faber-release",
        "preparedAt": date.today().isoformat(),
        "releaseIntent": {
            "component": "faber",
            "version": args.version,
            "channel": args.channel,
            "line": args.line,
        },
        "pinnedInputs": {
            "source": source,
            "packs": packs,
        },
        "versionSources": [
            {"component": "faber", "manifest": "Cargo.toml",
             "version": faber_version},
            {"component": "radix", "manifest": "crates/radix/Cargo.toml",
             "version": radix_version},
            {"component": "cista", "manifest": "Cargo.toml",
             "version": cista_version},
        ],
        "exclusions": [
            {"component": "faber", "path": "crates/hygiene-ratchet",
             "reason": "not release-aligned; stays 0.1.0"},
            {"component": "radix", "path": "crates/hygiene-ratchet",
             "reason": "not release-aligned; stays 0.1.0"},
            {"component": "cista", "path": "crates/hygiene-ratchet",
             "reason": "not release-aligned; stays 0.1.0"},
        ],
        "publication": {
            "releaseTag": f"faber-v{args.version}",
            "host": "faberlang/releases",
            "advancesGlobalLatest": args.channel in ("stable", "lts"),
        },
    }
    return manifest


def validate_generated(instance: Path) -> int:
    """Validate an instance with the co-located validator. Returns exit code."""
    res = subprocess.run(
        [sys.executable, str(VALIDATOR), str(instance)],
        check=False, capture_output=True, text=True,
    )
    if res.stdout:
        sys.stdout.write(res.stdout)
    if res.stderr:
        sys.stderr.write(res.stderr)
    return res.returncode


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="generate-release-manifest",
        description="Generate faber/release-manifest.yaml from live evidence.",
    )
    parser.add_argument("--version", default=None,
                        help="the release version (must equal faber Cargo.toml)")
    parser.add_argument("--channel", default="stable",
                        choices=["development", "candidate", "stable", "lts",
                                 "hotfix"],
                        help="release channel (default: stable)")
    parser.add_argument("--line", default=None,
                        help="explicit major line, e.g. 1.x (default: <major>.x)")
    parser.add_argument("--faber-sha", default=None, help="faber tag commit SHA")
    parser.add_argument("--faber-tag", default=None, help="faber source tag, e.g. v1.5.0")
    parser.add_argument("--radix-sha", default=None, help="radix commit SHA")
    parser.add_argument("--cista-sha", default=None, help="cista commit SHA")
    parser.add_argument("--faber-runtime-sha", default=None,
                        help="faber-runtime commit SHA")
    parser.add_argument("--hosts-sha", default=None, help="hosts commit SHA")
    packs = parser.add_mutually_exclusive_group()
    packs.add_argument("--packs-receipt", default=None,
                       help="assemble-dev-kit payload receipt JSON "
                            '({"packs": [...]})')
    packs.add_argument("--packs", default=None,
                       help="inline JSON array of pack rows")
    parser.add_argument("--out", default=None,
                        help="output path (default: faber/release-manifest.yaml)")
    parser.add_argument("--root", default=str(repo_root()),
                        help="faber repo root (default: scripta parent)")
    parser.add_argument("--force", action="store_true",
                        help="overwrite an existing instance (release intent)")
    parser.add_argument("--check", action="store_true",
                        help="validate an existing instance; never writes")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    root = Path(args.root).resolve()
    out = Path(args.out).resolve() if args.out else root / "release-manifest.yaml"
    if args.check:
        if not out.exists():
            print(f"error: instance not found: {out}", file=sys.stderr)
            return 2
        return validate_generated(out)
    if not args.version:
        print("error: --version is required to generate a manifest",
              file=sys.stderr)
        return 2
    if not re.fullmatch(SEMVER_RE, args.version):
        print(f"error: {args.version!r} is not a semver-shaped version",
              file=sys.stderr)
        return 2
    if not (args.packs_receipt or args.packs):
        print("error: no dev-kit pack evidence: pass --packs-receipt or --packs",
              file=sys.stderr)
        return 2
    line = args.line or f"{args.version.split('.')[0]}.x"
    args.line = line
    try:
        manifest = build_manifest(args)
    except (ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if out.exists() and not args.force:
        print(
            f"error: refusing to overwrite existing release manifest {out} "
            f"(freeze artifact, release-manifest-schema.md §7); pass --force "
            f"only as part of a release intent",
            file=sys.stderr,
        )
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(emit_yaml(manifest), encoding="utf-8")
    print(f"wrote {out}")
    return validate_generated(out)


if __name__ == "__main__":
    sys.exit(main())
