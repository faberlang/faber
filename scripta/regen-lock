#!/usr/bin/env python3
"""Regenerate and verify the faber Cargo.lock for a release (F2 / L2).

The observed failure mode F2 (stage0-baseline.md §5) is tagging a commit
whose lockfile is stale — `--locked` then fails with "cannot update the lock
file". L2 (release-runbook incident lessons) is the sibling trap: `cargo
update` in the main tree resolves against local (often newer) siblings, while
CI builds against the release-manifest pins. This helper closes both gaps:

    ./scripta/regen-lock                       # cargo update, then verify
    ./scripta/regen-lock --check               # verify freshness only
    ./scripta/regen-lock --pinned-siblings     # one-command pin-packet regen
    ./scripta/regen-lock --pinned-siblings --check   # pin-match + freshness

`--pinned-siblings` is the EL-6 one-command pinned-sibling rehearsal. It
reads `release-manifest.yaml` source pins, verifies each path-dep sibling
(radix, cista, faber-runtime, hosts) at `../<name>` is detached/checked out
at the pin SHA, then regenerates (or checks) the lock. Run it **inside a
pin packet** (worktree-rehearsal-procedure.md) — never against a main-tree
layout whose siblings have drifted past the pins. The command is
worktree-scoped via `--root`; it never touches another checkout's lock.

`--offline` caveat: `cargo update --offline` regenerates the lock from the
local registry cache only. On a cold machine (cache missing the required
crates) the update fails; use `--online` (network index fetch) in that case.
The default is `--offline` because the release workflow is local-first and
dry-run-only (faber/docs/release/process-local-first.md §1).

Freshness verification is a pure-local, cargo-free check: every workspace
member's `[package] version` must match its Cargo.lock entry. A mismatch
means the lock is stale versus the manifests and `--locked` would fail.

Stdlib-only python3 (faber scripta convention). Exit codes: 0 = fresh /
regenerated, 1 = stale / pin mismatch / update failure, 2 = usage error.
"""

from __future__ import annotations

import argparse
import glob
import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path

REPO_NAME = "faber"

# Path-dep siblings the faber release layout resolves via ../<name>. The
# faber source pin itself is intentionally excluded: the bump commit lands
# on top of the pinned faber source, so HEAD may already be past it.
PATH_DEP_SIBLINGS = ("radix", "cista", "faber-runtime", "hosts")

# Module-level alias so unit tests can mock the cargo / git invocations.
subprocess_run = subprocess.run


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def workspace_member_manifests(root: Path) -> list[Path]:
    """Return the Cargo.toml paths of workspace member packages."""
    root_manifest = root / "Cargo.toml"
    manifests: list[Path] = []
    if not root_manifest.exists():
        return manifests
    data = tomllib.loads(root_manifest.read_text(encoding="utf-8"))
    ws = data.get("workspace") or {}
    if "package" in data:
        manifests.append(root_manifest)
    for entry in ws.get("members", []):
        if entry == ".":
            manifests.append(root_manifest)
        elif "*" in entry:
            for match in sorted(glob.glob(str((root / entry) / "Cargo.toml"))):
                manifests.append(Path(match))
        else:
            member_toml = root / entry / "Cargo.toml"
            if member_toml.exists():
                manifests.append(member_toml)
    return sorted({m.resolve() for m in manifests})


def member_versions(root: Path) -> list[tuple[str, str, Path]]:
    """Return (name, version, manifest) for every workspace member."""
    out: list[tuple[str, str, Path]] = []
    for manifest in workspace_member_manifests(root):
        data = tomllib.loads(manifest.read_text(encoding="utf-8"))
        pkg = data.get("package")
        if not pkg or "name" not in pkg or "version" not in pkg:
            raise ValueError(f"{manifest}: no [package] name/version")
        out.append((pkg["name"], pkg["version"], manifest))
    return out


def lock_versions(root: Path) -> dict[str, str] | None:
    """Return {package name: version} from Cargo.lock, or None if absent."""
    lock = root / "Cargo.lock"
    if not lock.exists():
        return None
    data = tomllib.loads(lock.read_text(encoding="utf-8"))
    return {pkg["name"]: pkg.get("version") for pkg in data.get("package", [])}


def check_fresh(root: Path) -> list[str]:
    """Return staleness issues (empty = lock is fresh vs the manifests)."""
    issues: list[str] = []
    lock = lock_versions(root)
    if lock is None:
        return [f"no Cargo.lock at {root / 'Cargo.lock'}"]
    try:
        members = member_versions(root)
    except ValueError as exc:
        return [str(exc)]
    for name, version, manifest in members:
        locked = lock.get(name)
        if locked is None:
            issues.append(
                f"lock has no entry for workspace member {name} ({manifest})"
            )
        elif locked != version:
            issues.append(
                f"lock stale: {name} lock={locked} manifest={version} ({manifest})"
            )
    return issues


def regen(root: Path, cargo: str, offline: bool) -> tuple[int, str]:
    """Run cargo update, then verify freshness. Returns (exit_code, message)."""
    cmd = [cargo, "update"]
    if offline:
        cmd.append("--offline")
    res = subprocess_run(cmd, cwd=str(root), text=True, capture_output=True)
    if res.returncode != 0:
        detail = (res.stderr or res.stdout or "").strip()
        return 1, f"cargo update failed ({detail or 'unknown'})"
    issues = check_fresh(root)
    if issues:
        return 1, "lock still stale after cargo update:\n  " + "\n  ".join(issues)
    return 0, "ok: Cargo.lock regenerated and fresh"


# ---------------------------------------------------------------------------
# pinned-sibling rehearsal (EL-6)
# ---------------------------------------------------------------------------

def _strip_yaml_comment(line: str) -> str:
    in_dq = False
    in_sq = False
    for i, ch in enumerate(line):
        if ch == '"' and not in_sq:
            in_dq = not in_dq
        elif ch == "'" and not in_dq:
            in_sq = not in_sq
        elif ch == "#" and not in_dq and not in_sq:
            if i == 0 or line[i - 1].isspace():
                return line[:i].rstrip()
    return line.rstrip()


def load_source_pins(manifest_path: Path) -> dict[str, str]:
    """Return {name: commit} from release-manifest.yaml pinnedInputs.source.

    Accepts JSON (full instance) or the documented YAML subset. Only the
    source pin rows are required; packs / versionSources are ignored.
    """
    text = manifest_path.read_text(encoding="utf-8")
    if text.lstrip().startswith("{"):
        data = json.loads(text)
        rows = data.get("pinnedInputs", {}).get("source", [])
        pins: dict[str, str] = {}
        for row in rows:
            if isinstance(row, dict) and "name" in row and "commit" in row:
                pins[str(row["name"])] = str(row["commit"])
        if not pins:
            raise ValueError(
                f"{manifest_path}: pinnedInputs.source is empty or missing"
            )
        return pins

    # YAML subset: walk source rows under pinnedInputs.source.
    pins = {}
    in_source = False
    current_name: str | None = None
    for raw in text.splitlines():
        line = _strip_yaml_comment(raw)
        if not line.strip():
            continue
        stripped = line.strip()
        # Leave the source block on the next top-level-ish key at indent 0/2
        # that is not a list item under source.
        if in_source:
            if re.match(r"^[A-Za-z]", line) or re.match(r"^  [A-Za-z]", line):
                # packs: / versionSources: / exclusions: end the source list
                if not stripped.startswith("- ") and ":" in stripped:
                    key = stripped.split(":", 1)[0].strip()
                    if key in ("packs", "versionSources", "exclusions",
                               "releaseIntent", "schemaVersion", "manifestName",
                               "preparedAt"):
                        in_source = False
                        current_name = None
            if in_source and stripped.startswith("- name:"):
                current_name = stripped.split(":", 1)[1].strip().strip("\"'")
            elif in_source and current_name and stripped.startswith("commit:"):
                commit = stripped.split(":", 1)[1].strip().strip("\"'")
                pins[current_name] = commit
                current_name = None
            continue
        if re.match(r"^\s*source:\s*$", line) or re.match(
            r"^\s*source:\s*\[", line
        ):
            in_source = True
            current_name = None
            continue
    if not pins:
        raise ValueError(
            f"{manifest_path}: pinnedInputs.source is empty or missing"
        )
    return pins


def git_head(sibling: Path) -> tuple[int, str]:
    """Return (rc, HEAD sha or error text) for a sibling checkout."""
    res = subprocess_run(
        ["git", "-C", str(sibling), "rev-parse", "HEAD"],
        text=True,
        capture_output=True,
    )
    if res.returncode != 0:
        detail = (res.stderr or res.stdout or "").strip()
        return res.returncode, detail or "git rev-parse failed"
    return 0, res.stdout.strip()


def pins_match(live: str, pinned: str) -> bool:
    """True when live HEAD matches the pin (full or short SHA)."""
    if not live or not pinned:
        return False
    live = live.lower()
    pinned = pinned.lower()
    if live == pinned:
        return True
    # Short-SHA pins (schema allows 7+ hex) match a live full SHA prefix.
    if len(pinned) >= 7 and len(pinned) < len(live) and live.startswith(pinned):
        return True
    if len(live) >= 7 and len(live) < len(pinned) and pinned.startswith(live):
        return True
    return False


def check_pinned_siblings(
    root: Path, pins: dict[str, str]
) -> list[str]:
    """Return pin-mismatch issues for path-dep siblings (empty = match).

    Layout: each sibling lives at ``root.parent / <name>`` — the standard
    faberlang container / release pin-packet layout
    (worktree-rehearsal-procedure.md §1).
    """
    container = root.parent
    issues: list[str] = []
    for name in PATH_DEP_SIBLINGS:
        pinned = pins.get(name)
        if not pinned:
            issues.append(
                f"pin missing: release-manifest has no source pin for {name}"
            )
            continue
        sibling = (container / name).resolve()
        if not sibling.is_dir():
            issues.append(
                f"sibling missing: {name} expected at {sibling} "
                f"(run inside a pin packet; see worktree-rehearsal-procedure.md)"
            )
            continue
        if not (sibling / ".git").exists() and not (sibling / ".git").is_file():
            # Detached worktrees use a .git file; plain dirs without git fail.
            # Still try rev-parse — git handles both; only fail on the result.
            pass
        rc, live = git_head(sibling)
        if rc != 0:
            issues.append(
                f"pin unreadable: {name} at {sibling}: {live}"
            )
            continue
        if not pins_match(live, pinned):
            issues.append(
                f"pin mismatch: {name} pin={pinned[:12]}… "
                f"live={live[:12]}… (regen lock only against the pin packet)"
            )
    return issues


def resolve_manifest(root: Path, explicit: str | None) -> Path:
    if explicit:
        path = Path(explicit)
        if not path.is_absolute():
            path = (root / path).resolve()
        else:
            path = path.resolve()
    else:
        path = (root / "release-manifest.yaml").resolve()
    if not path.exists():
        raise FileNotFoundError(f"release manifest not found: {path}")
    return path


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="regen-lock",
        description=(
            f"Regenerate and verify the {REPO_NAME} Cargo.lock. "
            "With --pinned-siblings, also verify path-dep siblings match "
            "release-manifest pins (one-command pin-packet rehearsal)."
        ),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="verify only; never writes and never runs cargo",
    )
    parser.add_argument(
        "--pinned-siblings",
        action="store_true",
        help=(
            "one-command pinned-sibling rehearsal: require ../radix, "
            "../cista, ../faber-runtime, ../hosts to match "
            "release-manifest.yaml source pins before regen/check (L2)"
        ),
    )
    parser.add_argument(
        "--manifest",
        default=None,
        help=(
            "path to release-manifest.yaml (default: <root>/release-manifest.yaml); "
            "only used with --pinned-siblings"
        ),
    )
    network = parser.add_mutually_exclusive_group()
    network.add_argument(
        "--offline",
        action="store_true",
        default=True,
        help="regenerate from the local registry cache only (default)",
    )
    network.add_argument(
        "--online",
        action="store_true",
        dest="offline",
        help="allow a network index fetch during cargo update",
    )
    parser.add_argument(
        "--cargo",
        default="cargo",
        help="cargo binary to invoke (default: cargo from PATH)",
    )
    parser.add_argument(
        "--root",
        default=str(repo_root()),
        help=f"{REPO_NAME} repo root (default: scripta parent)",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    root = Path(args.root).resolve()
    if not (root / "Cargo.toml").exists():
        print(f"error: {root} is not a Cargo workspace root", file=sys.stderr)
        return 2

    if args.pinned_siblings:
        try:
            manifest = resolve_manifest(root, args.manifest)
            pins = load_source_pins(manifest)
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2
        pin_issues = check_pinned_siblings(root, pins)
        if pin_issues:
            for issue in pin_issues:
                print(f"  pin: {issue}", file=sys.stderr)
            print(
                "FAIL: pinned siblings do not match release-manifest "
                "(L2) — run inside a pin packet at the pinned SHAs",
                file=sys.stderr,
            )
            return 1
        pin_summary = ", ".join(
            f"{n}={pins[n][:12]}" for n in PATH_DEP_SIBLINGS if n in pins
        )
        print(f"ok: pinned siblings match ({pin_summary})")

    if args.check:
        issues = check_fresh(root)
        if not issues:
            if args.pinned_siblings:
                print("ok: Cargo.lock is fresh versus the manifests "
                      "(pinned-sibling rehearsal)")
            else:
                print("ok: Cargo.lock is fresh versus the manifests")
            return 0
        for issue in issues:
            print(f"  stale: {issue}", file=sys.stderr)
        print("FAIL: Cargo.lock is stale (F2) — run ./scripta/regen-lock",
              file=sys.stderr)
        return 1

    code, message = regen(root, args.cargo, args.offline)
    if code == 0 and args.pinned_siblings:
        message = "ok: Cargo.lock regenerated against pinned siblings and fresh"
    print(message, file=sys.stderr if code != 0 else sys.stdout)
    return code


if __name__ == "__main__":
    sys.exit(main())
