#!/usr/bin/env python3
"""Release preflight (dry-run) for a Faber product release candidate.

Local + dry-run only: the doctor inspects a prepared candidate and, if every
check passes, writes a PLAN file ending in `would-tag` / `would-upload`
placeholders — it never creates a tag, never uploads, never runs cargo.

Checks (release-doctor preflight; process-local-first.md §1–§2):
  1. clean tree                      (git status --porcelain empty)
  2. correct remote                  (origin == faberlang/faber)
  3. version/tag alignment           (Cargo.toml == candidate version;
                                      no local tag v<version> yet)
  4. lockfile fresh                  (co-located regen-lock --check; F2)
  5. release notes present           (docs/release/v<version>.md)
  6. pin manifest valid + pins match live evidence (release-manifest.yaml
     validates; the faber pin is the source commit to tag — accepted as HEAD
     or its parent, since the release commit (bump + lockfile + manifest)
     lands on top of it; radix/cista/faber-runtime/hosts pins must equal
     their checkout HEADs in the release layout)
  7. dev-kit packs present           (each pinnedInputs.packs row's digest
     matches the artifact at its location in the --packs-dir dev-kit payload
     tree — assemble-dev-kit output layout; embedded core-support and the
     library pack are verified against live source evidence)
  8. no ambient release credentials  (release token names not in env)

Worktree state is advisory-only (operator lifecycle per worktree-convention.md;
no creation/disposal). On failure every named reason is printed and the exit
code is 1. On success the plan file is written and the doctor stops there.

Stdlib-only python3. Exit codes: 0 = candidate passes (plan written, stopped
at would-tag/would-upload), 1 = preflight failure, 2 = usage error.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tomllib
from datetime import date
from pathlib import Path

# The preflight must not mutate the candidate tree: loading the co-located
# validator via SourceFileLoader would write scripta/__pycache__ and poison the
# clean-tree check of the next run.
sys.dont_write_bytecode = True

VALIDATOR = Path(__file__).with_name("validate-release-manifest")
REGEN_LOCK = Path(__file__).with_name("regen-lock")


def load_parse_manifest():
    """Load parse_manifest from the co-located validator (stdlib-only)."""
    loader = importlib.machinery.SourceFileLoader(
        "faber_validate_release_manifest", str(VALIDATOR)
    )
    spec = importlib.util.spec_from_loader("faber_validate_release_manifest", loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load {VALIDATOR}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module.parse_manifest


def parse_instance(path: Path) -> dict:
    """Parse a manifest instance (JSON accepted; YAML subset otherwise)."""
    text = path.read_text(encoding="utf-8")
    if text.lstrip().startswith("{"):
        return json.loads(text)
    return load_parse_manifest()(text)

# Known release credential names (threat-model.md credential-exposure class).
CREDENTIAL_NAMES = ("FABERLANG_RELEASES_TOKEN", "GH_TOKEN", "GITHUB_TOKEN",
                    "GH_ENTERPRISE_TOKEN", "GITLAB_TOKEN")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def git(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *args],
        check=False, capture_output=True, text=True,
    )


def normalize_remote(url: str) -> str:
    url = url.strip()
    for prefix in ("https://github.com/", "http://github.com/",
                   "ssh://git@github.com/", "git@github.com:"):
        if url.startswith(prefix):
            url = url[len(prefix):]
            break
    return url.removesuffix(".git").rstrip("/")


def read_package_version(manifest: Path) -> str:
    data = tomllib.loads(manifest.read_text(encoding="utf-8"))
    pkg = data.get("package")
    if not pkg or "version" not in pkg:
        raise ValueError(f"no [package] version at {manifest}")
    return pkg["version"]


# ---------------------------------------------------------------------------
# individual checks — each returns (ok, detail)
# ---------------------------------------------------------------------------

def check_clean_tree(root: Path) -> tuple[bool, str]:
    res = git(root, "status", "--porcelain")
    if res.returncode != 0:
        return False, "not a git work tree"
    dirty = [line for line in res.stdout.splitlines() if line.strip()]
    if dirty:
        return False, f"dirty tree: {'; '.join(dirty[:5])}"
    return True, "tree clean"


def check_remote(root: Path, expected: str) -> tuple[bool, str]:
    res = git(root, "remote", "get-url", "origin")
    if res.returncode != 0:
        return False, f"no origin remote configured"
    actual = normalize_remote(res.stdout)
    if actual != expected:
        return False, f"wrong remote: origin -> {actual!r}, expected {expected!r}"
    return True, f"remote ok: {expected}"


def check_version_tag(root: Path, version: str) -> tuple[bool, str]:
    try:
        manifest_version = read_package_version(root / "Cargo.toml")
    except ValueError as exc:
        return False, str(exc)
    if manifest_version != version:
        return False, (f"version mismatch: Cargo.toml says {manifest_version}, "
                       f"candidate version {version}")
    res = git(root, "tag", "-l", f"v{version}")
    if res.returncode == 0 and res.stdout.strip():
        return False, f"tag v{version} already exists"
    return True, f"version/tag aligned: {version}"


def check_lock_fresh(root: Path) -> tuple[bool, str]:
    res = subprocess.run(
        [sys.executable, str(REGEN_LOCK), "--check", "--root", str(root)],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        return False, (res.stderr or res.stdout or "").strip() or "stale lock"
    return True, "lockfile fresh"


def check_release_notes(root: Path, version: str) -> tuple[bool, str]:
    notes = root / "docs/release" / f"v{version}.md"
    if not notes.exists():
        return False, f"missing release notes: docs/release/v{version}.md"
    return True, f"release notes present: {notes.name}"


def check_manifest(root: Path, version: str) -> tuple[bool, str]:
    manifest = root / "release-manifest.yaml"
    if not manifest.exists():
        return False, "missing pin manifest: release-manifest.yaml"
    res = subprocess.run(
        [sys.executable, str(VALIDATOR), str(manifest)],
        check=False, capture_output=True, text=True,
    )
    if res.returncode != 0:
        detail = (res.stderr or res.stdout or "").strip().splitlines()
        return False, f"pin manifest invalid: {detail[0] if detail else 'unknown'}"
    # pins match live evidence
    instance = parse_instance(manifest)
    sources = instance.get("pinnedInputs", {}).get("source", [])
    for row in sources:
        name = row.get("name")
        pinned = row.get("commit")
        if name == "faber":
            # The faber pin is the source commit to tag. The release commit
            # (bump + lockfile + manifest) lands on top of it, so the pin is
            # accepted as HEAD or HEAD's parent.
            live = git(root, "rev-parse", "HEAD")
            live_shas = {live.stdout.strip()} if live.returncode == 0 else set()
            parent = git(root, "rev-parse", "HEAD~1")
            if parent.returncode == 0 and parent.stdout.strip():
                live_shas.add(parent.stdout.strip())
            if live.returncode != 0 or pinned not in live_shas:
                return False, (
                    f"pin mismatch: faber manifest={pinned[:12]}… is neither "
                    f"HEAD nor its parent (stale pin vs the candidate commit)"
                )
            continue
        sibling = root.parent / name
        if not sibling.is_dir():
            return False, f"pin mismatch: {name} — sibling tree missing ({sibling})"
        live = git(sibling, "rev-parse", "HEAD")
        if live.returncode != 0 or not live.stdout.strip():
            return False, f"pin mismatch: {name} — cannot resolve live commit"
        if live.stdout.strip() != pinned:
            return False, (f"pin mismatch: {name} manifest={pinned[:12]}… "
                           f"live={live.stdout.strip()[:12]}…")
    return True, "pin manifest valid; pins match live evidence"


def check_credentials(environ: dict[str, str]) -> tuple[bool, str]:
    found = [key for key in environ if key in CREDENTIAL_NAMES
             or key.endswith("_RELEASES_TOKEN")]
    if found:
        return False, f"ambient release credentials in env: {', '.join(sorted(found))}"
    return True, "no ambient release credentials"


# ---------------------------------------------------------------------------
# dev-kit pack digests — recompute against the real payload layout
# ---------------------------------------------------------------------------
# --packs-dir is the assemble-dev-kit output tree:
#
#   dev-kit-<version>-<triple>/
#     bin/faber                       # launcher
#     share/faber/reference/          # reference pack (index.toml, PACK.toml, …)
#     share/faber/locale/<locale>/    # reader packs for all eight locales
#
# Digests below must match scripta/assemble-dev-kit's computations exactly.

def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def tree_digest(root: Path) -> str:
    """Deterministic tree digest — must match scripta/assemble-dev-kit."""
    if not root.is_dir():
        raise ValueError(f"not a directory: {root}")
    entries: list[tuple[str, str]] = []
    for path in sorted(root.rglob("*")):
        if path.is_file():
            rel = path.relative_to(root).as_posix()
            entries.append((rel, sha256_file(path)))
    canonical = "\n".join(f"{rel}\t{digest}" for rel, digest in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def tree_digest_with_prefix(prefix: str, root: Path) -> str:
    """Digest of one tree, prefixing relpaths (multi-root sets)."""
    if not root.is_dir():
        raise ValueError(f"not a directory: {root}")
    entries: list[tuple[str, str]] = []
    for path in sorted(root.rglob("*")):
        if path.is_file():
            rel = f"{prefix}/{path.relative_to(root).as_posix()}"
            entries.append((rel, sha256_file(path)))
    canonical = "\n".join(f"{rel}\t{digest}" for rel, digest in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def locale_packs_digest(locale_root: Path) -> str:
    """Combined locale-packs digest (per-locale tree digests joined) — must
    match scripta/assemble-dev-kit's `locale-packs` row."""
    per_locale = {
        d.name: tree_digest(d)
        for d in sorted(locale_root.iterdir())
        if d.is_dir()
    }
    if not per_locale:
        raise ValueError(f"no locale pack dirs under {locale_root}")
    return hashlib.sha256(
        "\n".join(f"{loc}\t{dg}" for loc, dg in sorted(per_locale.items())).encode("utf-8")
    ).hexdigest()


def core_support_digest(root: Path) -> str:
    """Source-set identity over core-support-manifest.txt — must match
    scripta/assemble-dev-kit. Core support is embedded in the launcher, so the
    doctor verifies the pinned digest against the live source set."""
    manifest = root / "core-support-manifest.txt"
    if not manifest.is_file():
        raise ValueError(f"missing {manifest}")
    container = root.parent
    roots: list[Path] = []
    for line in manifest.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        target = (container / line).resolve()
        if not target.is_dir():
            raise ValueError(f"core-support root from {manifest} is missing: {target}")
        roots.append(target)
    entries = [
        (target.relative_to(container).as_posix(), tree_digest(target))
        for target in roots
    ]
    canonical = "\n".join(f"{rel}\t{dg}" for rel, dg in sorted(entries))
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def resolve_pack_digest(root: Path, payload: Path, pack: dict) -> str:
    """Resolve a pack row's artifact digest from the real dev-kit payload tree
    (or live source for embedded/source packs). Raises ValueError when the
    artifact is missing."""
    name = pack.get("name")
    if name == "launcher":
        artifact = payload / "bin" / "faber"
        if not artifact.is_file():
            raise ValueError(f"launcher not found at {artifact.relative_to(payload.parent)}")
        return sha256_file(artifact)
    if name == "reference-pack":
        return tree_digest(payload / "share" / "faber" / "reference")
    if name == "locale-packs":
        return locale_packs_digest(payload / "share" / "faber" / "locale")
    if name == "core-support":
        return core_support_digest(root)
    if name == "library-pack":
        return tree_digest_with_prefix(
            "norma", (root.parent / "norma" / "src").resolve()
        )
    raise ValueError(f"no known artifact location for pack {name!r}")


def check_packs(root: Path, packs_dir: Path | None) -> tuple[bool, str]:
    if packs_dir is None:
        return False, "missing dev-kit packs: no --packs-dir given"
    if not packs_dir.is_dir():
        return False, f"missing dev-kit packs: {packs_dir} is not a directory"
    instance = parse_instance(root / "release-manifest.yaml")
    packs = instance.get("pinnedInputs", {}).get("packs", [])
    if not packs:
        return False, "missing dev-kit packs: manifest pins no packs"
    verified = 0
    for pack in packs:
        name = pack.get("name")
        expected = pack.get("digest", "").removeprefix("sha256:")
        try:
            actual = resolve_pack_digest(root, packs_dir, pack)
        except ValueError as exc:
            return False, f"missing dev-kit pack: {name} ({exc})"
        if actual != expected:
            return False, (
                f"dev-kit pack digest mismatch: {name} "
                f"(manifest={expected} computed={actual})"
            )
        verified += 1
    return True, f"dev-kit packs present ({verified} verified)"


# ---------------------------------------------------------------------------
# plan file
# ---------------------------------------------------------------------------

def write_plan(root: Path, version: str, manifest: Path) -> Path:
    out_dir = root.parent / "out"
    out_dir.mkdir(parents=True, exist_ok=True)
    plan = out_dir / f"release-plan-{version}.yaml"
    plan.write_text(
        "# Dry-run release plan — NO public effect has been executed.\n"
        "releasePlan:\n"
        f"  component: faber\n"
        f'  version: "{version}"\n'
        f"  checkedAt: {date.today().isoformat()}\n"
        "  would-tag:\n"
        f'    - "git tag -a v{version} -m \'faber v{version}\'"\n'
        "  would-upload:\n"
        f"    - \"gh release create faber-v{version} -R faberlang/releases "
        f"--latest={{channel-rule}} <faber-v{version}-*.tar.gz + .sha256>\"\n"
        "  stopAfter: plan only — stopped at would-tag / would-upload\n"
        "  worktreeState: advisory-only (operator lifecycle; no creation/disposal)\n",
        encoding="utf-8",
    )
    return plan


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="release-doctor",
        description="Local dry-run preflight for a Faber release candidate.",
    )
    parser.add_argument("--version", required=True,
                        help="candidate release version, e.g. 1.5.0")
    parser.add_argument("--expected-remote", default="faberlang/faber",
                        help="expected origin owner/repo (default: faberlang/faber)")
    parser.add_argument("--packs-dir", default=None,
                        help="dev-kit payload staging dir to verify pack digests "
                             "against (assemble-dev-kit output)")
    parser.add_argument("--root", default=str(repo_root()),
                        help="faber repo root (default: scripta parent)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    root = Path(args.root).resolve()
    if not (root / "Cargo.toml").exists():
        print(f"error: {root} is not a faber repo root", file=sys.stderr)
        return 2
    packs_dir = Path(args.packs_dir) if args.packs_dir else None
    checks = [
        ("clean tree", check_clean_tree(root)),
        ("remote", check_remote(root, args.expected_remote)),
        ("version/tag", check_version_tag(root, args.version)),
        ("lock", check_lock_fresh(root)),
        ("notes", check_release_notes(root, args.version)),
        ("pin manifest", check_manifest(root, args.version)),
        ("dev-kit packs", check_packs(root, packs_dir)),
        ("credentials", check_credentials(dict(os.environ))),
    ]
    failures = [(name, detail) for name, (ok, detail) in checks if not ok]
    for name, detail in failures:
        print(f"  FAIL [{name}]: {detail}", file=sys.stderr)
    if failures:
        print(f"FAIL: release-doctor preflight found {len(failures)} problem(s)",
              file=sys.stderr)
        return 1
    plan = write_plan(root, args.version, root / "release-manifest.yaml")
    print(f"ok: candidate passes release-doctor preflight; plan written to "
          f"{plan}; stopped at would-tag / would-upload (no public effect)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
