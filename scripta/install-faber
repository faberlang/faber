def parse_version_parts(version: str) -> tuple[int, int, int, str]:
    """Numeric (major, minor, patch) plus prerelease tag ('' for releases)."""
    core, _, pre = version.partition("-")
    parts = core.split(".")
    while len(parts) < 3:
        parts.append("0")
    return int(parts[0]), int(parts[1]), int(parts[2]), pre


def semver_lt(a: str, b: str) -> bool:
    """Strict semver ordering; a prerelease sorts before its release."""
    core_a, pre_a = parse_version_parts(a)[:3], parse_version_parts(a)[3]
    core_b, pre_b = parse_version_parts(b)[:3], parse_version_parts(b)[3]
    if core_a != core_b:
        return core_a < core_b
    if pre_a == pre_b:
        return False
    if not pre_a:
        return False  # a is a release, b is a prerelease of the same core
    if not pre_b:
        return True   # a is a prerelease, b is its release
    return pre_a < pre_b


def version_lane(version: str) -> str:
    """Version lane per faber/docs/release/policy.md: odd major = development
    line, even major = language-locked LTS line."""
    return "development" if parse_version_parts(version)[0] % 2 else "lts"


def fail(message: str, code: int = 1) -> "None":
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


class InstallError(Exception):
    """An install failure that aborts cleanly (exit 1)."""


# ---------------------------------------------------------------------------
# platform / artifact identity
# ---------------------------------------------------------------------------

def detect_triple() -> str:
    """Auto-detect the platform triple; residuals and unknown hosts fail closed."""
    system = platform.system().lower()
    machine = platform.machine().lower()
    if system == "darwin":
        if machine in ("arm64", "aarch64"):
            return "aarch64-apple-darwin"
        if machine in ("x86_64", "amd64"):
            fail(
                "macOS Intel is not supported (named residual, platform-matrix.md); "
                "no release artifact exists for it",
                code=2,
            )
    if system == "linux":
        if machine in ("x86_64", "amd64"):
            return "x86_64-unknown-linux-gnu"
        fail(
            f"Linux {machine} is not in the supported slice (Linux x86_64); "
            "other variants are named residuals (platform-matrix.md)",
            code=2,
        )
    fail(
        f"unsupported host: {system}/{machine}; the supported slice is "
        "macOS arm64 and Linux x86_64 (platform-matrix.md)",
        code=2,
    )
    raise AssertionError("unreachable")


def archive_name(version: str, triple: str) -> str:
    return f"faber-v{version}-{triple}.tar.gz"


def default_base_url(version: str) -> str:
    return f"{RELEASE_HOST}/releases/download/faber-v{version}"


# ---------------------------------------------------------------------------
# fetch + checksum verification (BEFORE any unpack or execution)
# ---------------------------------------------------------------------------

def fetch(url_or_path: str, what: str) -> bytes:
    """Fetch bytes from a URL or a local path.

    urllib honors HTTP_PROXY/HTTPS_PROXY/http_proxy/https_proxy. A local
    path (or file:// URL) is read directly — used by tests and mirrors.
    """
    if "://" not in url_or_path:
        path = Path(url_or_path)
        if not path.is_file():
            raise InstallError(f"{what} not found: {url_or_path}")
        return path.read_bytes()
    try:
        with urllib.request.urlopen(url_or_path, timeout=60) as response:
            return response.read()
    except urllib.error.HTTPError as err:
        raise InstallError(
            f"failed to download {what} ({err.code} {err.reason}): {url_or_path}"
        ) from err
    except (urllib.error.URLError, OSError) as err:
        raise InstallError(
            f"failed to download {what} (offline or unreachable?): {url_or_path}\n"
            f"  {err}"
        ) from err


def verify_checksum(archive: str, archive_bytes: bytes, checksum_text: str) -> str:
    """Parse the basename-only .sha256 asset and verify the archive bytes.

    Enforces release-contract.md §5.1: the asset names ONLY the downloaded
    archive basename (a path-qualified name is rejected — F7), exactly one
    line, `sha256  <basename>`. Any deviation fails closed.
    """
    lines = [line for line in checksum_text.splitlines() if line.strip()]
    if len(lines) != 1:
        raise InstallError(
            f"checksum asset must contain exactly one line, found {len(lines)}"
        )
    fields = lines[0].split()
    if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]):
        raise InstallError(f"unparseable checksum asset line: {lines[0]!r}")
    recorded, name = fields
    if name != archive:
        raise InstallError(
            f"checksum asset names {name!r}, expected the archive basename "
            f"{archive!r} (basename-only rule, release-contract.md §5.1)"
        )
    actual = hashlib.sha256(archive_bytes).hexdigest()
    if actual != recorded:
        raise InstallError(
            f"SHA-256 mismatch for {archive}\n"
            f"  published: {recorded}\n"
            f"  computed:  {actual}\n"
            "checksum verified before install; aborting with NO partial install"
        )
    return actual


# ---------------------------------------------------------------------------
# safe archive extraction (archive traversal / symlink defenses)
# ---------------------------------------------------------------------------

def safe_copy_members(tar: tarfile.TarFile, dest: Path) -> list[str]:
    """Copy regular files + directories from the archive into `dest`.

    Rejects absolute paths, `..` traversal, symlinks/hardlinks/devices
    (package-and-lock-contract.md integrity: archive traversal/symlink
    defenses). Files are written by hand so ownership in the archive never
    causes chown behavior across Python versions; the exec bit is derived
    from the member mode. Returns the relative paths of the regular files
    only (directories are created as side effects).
    """
    dest_resolved = dest.resolve()
    relpaths: list[str] = []
    for member in tar.getmembers():
        if not (member.isfile() or member.isdir()):
            raise InstallError(
                f"archive member {member.name!r} is not a regular file or "
                "directory; refusing to install"
            )
        rel = member.name
        if rel.startswith("/") or ".." in rel.split("/"):
            raise InstallError(f"unsafe archive member path {rel!r}")
        target = (dest_resolved / rel).resolve()
        try:
            target.relative_to(dest_resolved)
        except ValueError:
            raise InstallError(f"unsafe archive member path {rel!r}")
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            source = tar.extractfile(member)
            if source is None:
                raise InstallError(f"cannot read archive member {member.name!r}")
            with target.open("wb") as out:
                shutil.copyfileobj(source, out)
            os.chmod(target, 0o755 if (member.mode & 0o111) else 0o644)
            relpaths.append(rel)
    return relpaths


# ---------------------------------------------------------------------------
# prefix state + change report
# ---------------------------------------------------------------------------

def receipt_path(prefix: Path) -> Path:
    return prefix / RECEIPT_REL


def load_receipt(prefix: Path) -> dict | None:
    path = receipt_path(prefix)
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None
    return data if isinstance(data, dict) else None


def preflight_destinations(prefix: Path, rels: list[str], what: str) -> None:
    """Prove every destination in `rels` stays beneath the canonical prefix.

    Destination-side containment (CTO audit FINDING 1): a pre-existing
    `prefix/share -> /outside` symlink must never redirect a validated
    payload write outside the install prefix. Every destination is validated
    BEFORE any write, so a compromised destination fails closed with nothing
    churned on either side (the archive-extraction defenses cover the staging
    tree only, not the destination).
    """
    for rel in rels:
        guard_destination(prefix, rel, what)


def guard_destination(prefix: Path, rel: str, what: str) -> Path:
    """Return `prefix / rel` after proving it is symlink-free beneath prefix.

    The canonical prefix must be a real directory (not itself reached through
    a symlink), and every EXISTING component from `prefix` down — ancestors
    and the destination file — must be a real directory/file, not a symlink
    or other reparse point. A missing component is fine: it is created fresh
    under an already-proven real parent. The installer never creates symlinks
    under the prefix, so any pre-existing symlink in a destination path is
    foreign and the write is rejected (fail-closed).

    Bound: this defends against PRE-EXISTING symlinks (the audit finding); a
    concurrent attacker able to swap paths mid-write is out of scope for the
    Python-level installer.
    """
    try:
        if prefix.is_symlink() or prefix.resolve() != prefix:
            raise InstallError(
                f"refusing to write {what} {rel!r}: {prefix} is reached "
                "through a symlink; the install prefix must be canonical"
            )
        dest = prefix
        parts = Path(rel).parts
        for i, part in enumerate(parts):
            dest = dest / part
            if dest.is_symlink():
                raise InstallError(
                    f"refusing to write {what} {rel!r}: {dest} is a symlink; "
                    "destination must stay beneath the canonical install "
                    f"prefix {prefix}"
                )
            if i == len(parts) - 1:
                if dest.exists() and not dest.is_file():
                    raise InstallError(
                        f"refusing to write {what} {rel!r}: {dest} is not a "
                        "regular file"
                    )
            elif dest.exists() and not dest.is_dir():
                raise InstallError(
                    f"refusing to write {what} {rel!r}: {dest} is not a "
                    "directory"
                )
    except OSError as err:
        raise InstallError(f"cannot inspect destination {prefix / rel!r}: {err}")
    return dest


def file_state(target: Path, staging: Path, rel: str) -> str:
    """'added' | 'updated' | 'unchanged' for one payload file."""
    if not target.exists():
        return "added"
    if target.is_file() and target.read_bytes() == staging.read_bytes():
        if os.access(target, os.X_OK) == os.access(staging, os.X_OK):
            return "unchanged"
    return "updated"


def write_payload(staging: Path, prefix: Path, payload_files: list[str]) -> dict[str, str]:
    """Move payload files into the prefix; per-file added/updated/unchanged.

    Destination-side containment (CTO audit FINDING 1): every destination is
    proven beneath the canonical prefix WITHOUT following a pre-existing
    symlink, BEFORE any write. A symlinked prefix child (e.g.
    `prefix/share -> /outside`) fails closed with neither side churned.

    Rollback: existing files are backed up before replacement and restored on
    failure; files added by this run are removed. Interrupted installs never
    leave a partial payload.
    """
    preflight_destinations(prefix, payload_files, "payload file")
    states: dict[str, str] = {}
    rollback = prefix / f".faber-install-rollback-{os.getpid()}"
    try:
        rollback.mkdir(parents=True, exist_ok=True)
    except OSError as err:
        raise InstallError(f"cannot create rollback dir in {prefix}: {err}")
    if rollback.is_symlink() or (rollback.exists() and not rollback.is_dir()):
        shutil.rmtree(rollback, ignore_errors=True)
        raise InstallError(
            f"refusing to install: {rollback} is a symlink; the rollback dir "
            "must be a real directory"
        )
    added: list[Path] = []
    try:
        for rel in payload_files:
            source = staging / rel
            target = guard_destination(prefix, rel, "payload file")
            state = file_state(target, source, rel)
            states[rel] = state
            if state == "unchanged":
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.parent.is_symlink():
                raise InstallError(
                    f"refusing to write {rel!r}: {target.parent} became a "
                    "symlink after validation"
                )
            if target.exists():
                backup = rollback / rel
                backup.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(target, backup)
            else:
                added.append(target)
            tmp = target.with_name(f".{target.name}.install-{os.getpid()}")
            shutil.copy2(source, tmp)
            os.chmod(tmp, os.stat(source).st_mode & 0o777)
            os.replace(tmp, target)
    except InstallError:
        shutil.rmtree(rollback, ignore_errors=True)
        shutil.rmtree(staging, ignore_errors=True)
        raise
    except OSError as err:
        # best-effort rollback: restore overwritten files, drop added ones.
        # Restoration is itself containment-guarded; a destination that is no
        # longer safe is skipped (fail-closed), never written through.
        for backup in rollback.rglob("*"):
            if backup.is_file():
                rel = backup.relative_to(rollback).as_posix()
                try:
                    dest = guard_destination(prefix, rel, "rollback restore")
                except InstallError:
                    continue
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(backup, dest)
        for target in added:
            target.unlink(missing_ok=True)
        shutil.rmtree(rollback, ignore_errors=True)
        shutil.rmtree(staging, ignore_errors=True)
        raise InstallError(f"failed to write payload: {err}")
    shutil.rmtree(rollback, ignore_errors=True)
    return states


def write_receipt(prefix: Path, *, version: str, triple: str, archive: str,
                  archive_sha256: str, source: str, payload_files: list[str],
                  asset_base: str | None = None, lane_versions: list[str] | None = None,
                  installed_at: str | None = None, updated_at: str | None = None) -> Path:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    data = {
        "receipt": "faber install receipt (faber-onboarding Stage 3; consumed by Stage 4 doctor)",
        "prefix": str(prefix),
        "version": version,
        "triple": triple,
        "archive": archive,
        "archiveSha256": archive_sha256,
        "source": source,
        "assetBase": asset_base if asset_base is not None else source.rsplit("/", 1)[0],
        "installedAt": installed_at or now,
        "files": payload_files,
    }
    if updated_at is not None:
        data["updatedAt"] = updated_at
    if lane_versions:
        data["laneVersions"] = sorted(lane_versions)
    path = receipt_path(prefix)
    guard_destination(prefix, RECEIPT_REL, "install receipt")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    return path


# ---------------------------------------------------------------------------
# PATH / shell changes (explicit and reversible)
# ---------------------------------------------------------------------------

def shell_rc_path(home: Path) -> Path:
    shell = os.environ.get("SHELL", "")
    if "zsh" in shell:
        return home / ".zshrc"
    if "bash" in shell:
        return home / ".bashrc"
    return home / ".zshrc" if sys.platform == "darwin" else home / ".bashrc"


def path_line(prefix: Path) -> str:
    return f'export PATH="{prefix}/bin:$PATH"'


def guard_home_write(dest: Path, home: Path, what: str) -> None:
    """Prove a PATH-owned write target stays inside the user's home.

    Same containment rule as the install prefix, with the home directory as
    the canonical root: the shell rc append must not follow a pre-existing
    symlink OUT of the home directory (CTO audit FINDING 1 scope). A symlink
    that resolves WITHIN home (the dotfiles pattern) is followed — the shell
    itself follows it when reading the rc.
    """
    try:
        resolved = dest.resolve(strict=False)
        home_resolved = home.resolve()
    except OSError as err:
        raise InstallError(f"cannot resolve {what} {dest}: {err}")
    if not resolved.is_relative_to(home_resolved):
        raise InstallError(
            f"refusing to write {what} {dest}: it resolves outside the home "
            f"directory ({resolved})"
        )


def add_to_path(prefix: Path, home: Path) -> tuple[Path, bool]:
    """Append the PATH export to the shell rc if absent. Returns (rc, edited)."""
    rc = shell_rc_path(home)
    guard_home_write(rc, home, "shell rc")
    line = path_line(prefix)
    if rc.is_file() and line in rc.read_text(encoding="utf-8", errors="replace"):
        return rc, False
    with rc.open("a", encoding="utf-8") as handle:
        if rc.exists() and rc.stat().st_size > 0:
            handle.write("\n")
        handle.write(f"# added by faber install-faber (reversible: faber self uninstall)\n{line}\n")
    return rc, True


def on_path(prefix: Path) -> bool:
    bin_dir = str(prefix / "bin")
    return any(os.path.normpath(p) == os.path.normpath(bin_dir)
               for p in os.environ.get("PATH", "").split(os.pathsep) if p)


# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------

def print_report(*, result: str, version: str, triple: str, prefix: Path,
                 source: str, archive_sha256: str, states: dict[str, str],
                 receipt: Path, path_edited: bool, rc_path: Path | None,
                 lane_versions: list[str] | None = None) -> None:
    added = sum(1 for s in states.values() if s == "added")
    updated = sum(1 for s in states.values() if s == "updated")
    unchanged = sum(1 for s in states.values() if s == "unchanged")
    print(f"faber install report — faber {version} ({triple})")
    print(f"  result:     {result}")
    print(f"  prefix:     {prefix}")
    print(f"  source:     {source}")
    print("  checksum:   sha256 verified before install (basename-only asset)")
    print(f"  archiveSha256: {archive_sha256}")
    if lane_versions:
        print(f"  lanes:      {', '.join(sorted(lane_versions))} (active: {version})")
    print(f"  files:      {added} added, {updated} updated, {unchanged} unchanged, 0 removed")
    for rel in sorted(states):
        print(f"    {states[rel]:<9} {rel}")
    print(f"  receipt:    {receipt}")
    if on_path(prefix):
        print(f"  PATH:       {prefix}/bin is on PATH")
    else:
        print(f"  PATH:       {prefix}/bin is not on PATH")
        print(f"              add: {path_line(prefix)}")
        if path_edited:
            print(f"              appended to {rc_path}")
        else:
            print("              (or re-run with --add-to-path to persist it)")
    print("  proxy:      downloads honor HTTPS_PROXY / HTTP_PROXY env vars")
    print(f"  verify:     scripta/verify-dev-kit --payload {prefix} --version {version}")


# ---------------------------------------------------------------------------
# downgrade policy (Stage 3 A3): fail-closed on incompatible packs
# ---------------------------------------------------------------------------

# Typed cause for a downgrade that would strand a locked pack.
INCOMPATIBLE_PACK_CAUSE = "incompatible-pack-downgrade"
# faber.lock locked-package tables; cista.toml package manifest source table.
LOCK_TABLE_HEADER = "[[package]]"
PACK_MANIFEST_SOURCE_TABLE = "[source]"
# Compatibility bound field: launcher<=>package minimum faber version
# (package-and-lock-contract.md OQ3 lock identity / OQ6 faber_min).
PACK_COMPAT_BOUND_FIELDS = ("faber_min",)


def toml_tables(text: str, header: str) -> list[dict[str, str]]:
    """Extract the scalar fields of every TOML table whose header matches.

    Minimal, dependency-free reader for the downgrade guard only (the
    installer runs on a bare python3; no TOML dependency). Returns the flat
    scalar key/value pairs of each table whose header line equals `header`
    (e.g. `[[package]]` in faber.lock, `[source]` in cista.toml); values are
    unquoted strings. A nested table ends the current table. This is not a
    general TOML parser — tables beyond the flat scalars needed here are
    ignored.
    """
    tables: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            current = {} if line == header else None
            if current is not None:
                tables.append(current)
            continue
        if current is None or "=" not in line:
            continue
        key, _, value = line.partition("=")
        current[key.strip()] = value.strip().strip('"')
    return tables


def locked_pack_compat_bound(entry: dict[str, str], project_root: Path
                             ) -> tuple[str, str] | None:
    """The compatibility bound for one locked package: `(bound, where)`.

    The bound comes from the lock entry itself (lock-identity compatibility
    metadata, package-and-lock-contract.md OQ3) or, when the entry does not
    record one, from the locked package's `cista.toml` manifest `[source]`
    section — resolved through the lock's `package_root` field (relative to
    the project root, the same resolution rule faber's lockfile reader uses;
    OQ6 faber_min). Returns None when the package records no bound.
    """
    for key in PACK_COMPAT_BOUND_FIELDS:
        if entry.get(key):
            return entry[key], "lock entry"
    package_root = entry.get("package_root")
    if not package_root:
        return None
    manifest = project_root / package_root / "cista.toml"
    try:
        text = manifest.read_text(encoding="utf-8")
    except OSError:
        return None
    for table in toml_tables(text, PACK_MANIFEST_SOURCE_TABLE):
        for key in PACK_COMPAT_BOUND_FIELDS:
            if table.get(key):
                return table[key], str(manifest)
    return None


def check_downgrade_pack_compatibility(prefix: Path, target_version: str) -> None:
    """Fail closed when the downgrade would strand a locked pack.

    A downgrade must never strand a version-incompatible pack (dev-kit layer
    4 — faber libraries; package-and-lock-contract.md compatibility): the
    older launcher would be unable to consume a locked pack whose
    `faber_min` bound the target cannot satisfy, silently mixing versions.
    The trigger is a USER PROJECT's locked pack set — `faber.lock` files
    under `<prefix>/projects/` (the discoverable project surface recorded in
    the install prefix). Store packs that no project locks contribute nothing
    (never ambient store discovery, package-and-lock-contract.md store
    ownership). Unparseable locks contribute no bounds; the manifest
    fallback still applies. Runs BEFORE any write, so a conflict leaves the
    active install byte-identical.
    """
    projects_dir = prefix / "projects"
    if not projects_dir.is_dir():
        return
    conflicts: list[tuple[str, str, str, str]] = []
    max_bound = target_version
    for lock_path in sorted(projects_dir.glob("*/faber.lock")):
        try:
            text = lock_path.read_text(encoding="utf-8")
        except OSError:
            continue
        for entry in toml_tables(text, LOCK_TABLE_HEADER):
            name = entry.get("name", "<unnamed>")
            version = entry.get("version", "?")
            bound = locked_pack_compat_bound(entry, lock_path.parent)
            if not bound:
                continue
            bound_text, where = bound
            if semver_lt(target_version, bound_text):
                conflicts.append((name, version, bound_text, where))
                if semver_lt(max_bound, bound_text):
                    max_bound = bound_text
    if not conflicts:
        return
    summary = "; ".join(
        f"`{name}`@{version} requires faber >= {bound} ({where})"
        for name, version, bound, where in conflicts
    )
    raise InstallError(
        f"cannot downgrade faber to {target_version}: incompatible locked pack set\n"
        f"  cause:  {INCOMPATIBLE_PACK_CAUSE}\n"
        f"  layer:  faber libraries (dev-kit layer 4; "
        "package-and-lock-contract.md compatibility — no silent mixing)\n"
        f"  found:  {summary}\n"
        f"  next:   keep faber at {max_bound} or newer (`faber self update "
        f"--version {max_bound}`), update the project's locked pack set for "
        f"faber {target_version}, or pin {target_version} on a fresh prefix"
    )


