def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="install-faber",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", default=DEFAULT_VERSION,
                        help=f"release version to install (default: {DEFAULT_VERSION})")
    parser.add_argument("--prefix", default="~/.faber",
                        help="install prefix (default: ~/.faber, user-local; "
                             "explicit --prefix for system/agent installs)")
    parser.add_argument("--triple", default=None,
                        help="platform triple (default: auto-detect; supported: "
                             + ", ".join(SUPPORTED_TRIPLES) + ")")
    parser.add_argument("--base-url", default=None,
                        help="asset base URL or directory (default: the release "
                             "tag download URL on the release host)")
    parser.add_argument("--add-to-path", action="store_true",
                        help="append the PATH export to the detected shell rc "
                             "(explicit opt-in; reversible)")
    parser.add_argument("--update", action="store_true",
                        help="perform a versioned install (upgrade OR pinned "
                             "downgrade) on the existing install at the "
                             "prefix (side-by-side lanes; the `faber self "
                             "update` engine)")
    parser.add_argument("--allow-lane-change", action="store_true",
                        help="explicitly allow crossing the odd development / "
                             "even LTS version lane (faber/docs/release/policy.md)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])

    if not re.fullmatch(SEMVER_RE, args.version):
        fail(f"{args.version!r} is not a semver-shaped version", code=2)
    if not args.prefix.strip():
        fail("--prefix must not be empty", code=2)

    if args.triple is None:
        triple = detect_triple()
    else:
        triple = args.triple
        if triple in RESIDUAL_TRIPLES:
            fail(f"triple {triple!r} is not supported: {RESIDUAL_TRIPLES[triple]}", code=2)
        if triple not in SUPPORTED_TRIPLES:
            fail(
                f"triple {triple!r} is not in the supported slice "
                f"({', '.join(SUPPORTED_TRIPLES)}; platform-matrix.md)",
                code=2,
            )

    prefix = Path(os.path.expanduser(args.prefix)).resolve()
    archive = archive_name(args.version, triple)
    base = args.base_url or default_base_url(args.version)
    if "://" not in base:
        base = str(Path(base).resolve())
    source = f"{base}/{archive}"

    # 1. Fetch the archive + the published checksum asset.
    archive_bytes = fetch(source, "release archive")
    checksum_text = fetch(f"{source}.sha256", "checksum asset").decode("utf-8", errors="replace")

    # 2. VERIFY BEFORE ANY UNPACK OR EXECUTION (install-channel-matrix.md).
    #    A mismatch aborts here; nothing under the prefix has been touched.
    archive_sha256 = verify_checksum(archive, archive_bytes, checksum_text)

    # 3. Prefix state checks (no writes yet).
    prefix.parent.mkdir(parents=True, exist_ok=True)
    if prefix.exists() and not prefix.is_dir():
        fail(f"prefix exists and is not a directory: {prefix}")
    # 3b. Destination-side containment (CTO audit FINDING 1): the receipt
    #     destination must stay beneath the canonical prefix WITHOUT following
    #     a pre-existing symlink; validated BEFORE any read or write.
    guard_destination(prefix, RECEIPT_REL, "install receipt")
    existing = load_receipt(prefix)
    if args.update and existing is None:
        fail(
            f"--update requires an existing install at {prefix}, but no install "
            "receipt was found there; run scripta/install-faber without "
            "--update to install fresh"
        )
    updating = False
    downgrading = False
    if existing is not None and existing.get("version") != args.version:
        if not args.update:
            fail(
                f"prefix {prefix} already has faber {existing.get('version')} "
                f"installed; installing {args.version} over it is a versioned "
                "reinstall — upgrade via `faber self update` (or "
                "scripta/install-faber --update), or downgrade with "
                "`faber self update --version <older>`. Re-run for the "
                "installed version or choose a fresh prefix"
            )
        old_version = existing.get("version")
        if semver_lt(args.version, old_version):
            # Downgrade policy (Stage 3 A3): fail closed on incompatible
            # packs BEFORE any write — the locked pack set of a user project
            # must survive the downgrade (typed cause + one next action).
            check_downgrade_pack_compatibility(prefix, args.version)
            downgrading = True
        if (version_lane(old_version) != version_lane(args.version)
                and not args.allow_lane_change):
            fail(
                f"cross-lane update: {old_version} is on the "
                f"{version_lane(old_version)} lane and {args.version} is on the "
                f"{version_lane(args.version)} lane "
                "(faber/docs/release/policy.md version lanes); pass "
                "--allow-lane-change to jump lanes explicitly"
            )
        updating = True

    # 4. Safe extraction to a sibling staging dir. The prefix itself is NOT
    #    created until checksum AND archive validation both pass, so a
    #    tampered checksum or a corrupt/unsafe archive leaves nothing behind
    #    (fail-closed, no partial install).
    staging = prefix.parent / f".{prefix.name}.faber-install-stage-{os.getpid()}"
    try:
        staging.mkdir(parents=True, exist_ok=True)
    except OSError as err:
        raise InstallError(f"cannot create staging dir in {prefix.parent}: {err}")
    if staging.is_symlink() or (staging.exists() and not staging.is_dir()):
        shutil.rmtree(staging, ignore_errors=True)
        raise InstallError(
            f"refusing to install: {staging} is a symlink; the staging dir "
            "must be a real directory"
        )
    archive_path = staging / archive
    archive_path.write_bytes(archive_bytes)
    try:
        with tarfile.open(archive_path, "r:gz") as tar:
            payload_files = safe_copy_members(tar, staging / "payload")
    except (tarfile.TarError, InstallError) as err:
        shutil.rmtree(staging, ignore_errors=True)
        raise InstallError(f"invalid release archive: {err}")

    # 5. Create the prefix and write the payload (change report + rollback).
    try:
        prefix.mkdir(parents=True, exist_ok=True)
    except OSError as err:
        shutil.rmtree(staging, ignore_errors=True)
        raise InstallError(f"cannot create prefix {prefix}: {err}")
    if prefix.is_symlink() or prefix.resolve() != prefix:
        shutil.rmtree(staging, ignore_errors=True)
        fail(f"refusing to install: prefix {prefix} is not canonical")
    lane_versions: list[str] = []
    try:
        if updating:
            # (a) preserve the current install as a side-by-side lane (run once).
            old_lane = prefix / "versions" / old_version
            if not old_lane.exists():
                old_files = existing.get("files") or []
                preflight_destinations(
                    prefix,
                    [f"versions/{old_version}/{r}" for r in old_files],
                    "version lane preserve",
                )
                for rel in old_files:
                    src = prefix / rel
                    dst = old_lane / rel
                    if src.is_file() and not src.is_symlink():
                        dst.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(src, dst)
                write_receipt(
                    old_lane, version=old_version,
                    triple=existing.get("triple") or triple,
                    archive=existing.get("archive") or archive,
                    archive_sha256=existing.get("archiveSha256") or archive_sha256,
                    source=existing.get("source") or source,
                    payload_files=existing.get("files") or [],
                    asset_base=existing.get("assetBase") or base,
                    installed_at=existing.get("installedAt"),
                )
            # (b) install the new version as its own lane (rollback-protected).
            new_lane = prefix / "versions" / args.version
            lane_states = write_payload(staging / "payload", new_lane, payload_files)
            write_receipt(
                new_lane, version=args.version, triple=triple, archive=archive,
                archive_sha256=archive_sha256, source=source,
                payload_files=payload_files, asset_base=base,
            )
            # (c) flip the active install (launcher + packs) to the new version.
            flip_states = write_payload(staging / "payload", prefix, payload_files)
            states = {
                **{f"versions/{args.version}/{rel}": s for rel, s in lane_states.items()},
                **flip_states,
            }
            lane_versions = sorted(
                p.name for p in (prefix / "versions").glob("*") if p.is_dir()
            )
        else:
            states = write_payload(staging / "payload", prefix, payload_files)
    except InstallError:
        raise
    finally:
        shutil.rmtree(staging, ignore_errors=True)

    # 6. Receipt (prefix record consumed by Stage 4 doctor). On an update the
    #    top-level receipt records the ACTIVE version and the side-by-side
    #    lanes; the previous installedAt is preserved.
    receipt = write_receipt(
        prefix, version=args.version, triple=triple, archive=archive,
        archive_sha256=archive_sha256, source=source, payload_files=payload_files,
        asset_base=base, lane_versions=lane_versions,
        installed_at=existing.get("installedAt") if updating else None,
        updated_at=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        if updating else None,
    )

    # 7. PATH / shell handling.
    home = Path(os.environ.get("HOME") or str(Path.home()))
    rc_path = None
    edited = False
    if args.add_to_path:
        rc_path, edited = add_to_path(prefix, home)

    if states and all(s == "unchanged" for s in states.values()):
        result = "already current"
    elif updating and downgrading:
        result = f"downgraded (from {old_version})"
    elif updating:
        result = f"updated (from {old_version})"
    else:
        result = "installed"
    print_report(
        result=result, version=args.version, triple=triple, prefix=prefix,
        source=source, archive_sha256=archive_sha256, states=states,
        receipt=receipt, path_edited=edited, rc_path=rc_path,
        lane_versions=lane_versions or None,
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except InstallError as err:
        print(f"error: {err}", file=sys.stderr)
        raise SystemExit(1)
