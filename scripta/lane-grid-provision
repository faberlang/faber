#!/usr/bin/env python3
"""Refresh the pharos lane-grid checkout to burgus local main (EL-5 host config).

The grid's `origin/main` is a pharos private mirror (bare repos under
`<grid-mirror>`), refreshed by pushing this machine's local `main` for each
runner repo (faber, radix, cista, faber-runtime, hosts, norma, examples). The
runner checkout at `<grid-root>` then fetches and detaches at `origin/main`.

Run this on the dev machine (burgus) after main advances; the nightly timer
on pharos only runs `lane-grid-run` against the last-provisioned checkout.

Usage:
    lane-grid-provision [--root CONTAINER_ROOT] [--host pharos.ianzepp.net]
                        [--grid-root PATH] [--mirror PATH] [--check]
                        [--repos faber,radix,cista,faber-runtime,hosts,norma,examples]
"""

import argparse
import os
import subprocess
import sys

REPOS = ["faber", "radix", "cista", "faber-runtime", "hosts", "norma", "examples"]


def sh(cmd, **kw):
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300, **kw)
    if proc.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {proc.stderr.strip()}")
    return proc.stdout.strip()


def sh_nocheck(cmd, **kw):
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300, **kw)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def remote_sh(host, cmd):
    return sh_nocheck(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host, cmd])


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                    help="local container root holding faber/ radix/ cista/ faber-runtime/ hosts/")
    ap.add_argument("--host", default="pharos.ianzepp.net")
    ap.add_argument("--grid-root", default="/home/ianzepp/work/lane-grid")
    ap.add_argument("--mirror", default="/home/ianzepp/work/lane-grid-mirror")
    ap.add_argument("--repos", default=",".join(REPOS),
                    help="comma-separated repos (default: all, including norma+examples)")
    ap.add_argument("--check", action="store_true", help="report current HEADs without pushing")
    args = ap.parse_args(argv)

    root = os.path.abspath(args.root)
    repos = [r.strip() for r in args.repos.split(",") if r.strip()]
    for r in repos:
        if not os.path.isdir(os.path.join(root, r, ".git")):
            print(f"error: {os.path.join(root, r)} is not a git checkout", file=sys.stderr)
            return 2

    print(f"host      : {args.host}")
    print(f"mirror    : {args.mirror}")
    print(f"grid root : {args.grid_root}")
    for r in repos:
        local = sh(["git", "-C", os.path.join(root, r), "rev-parse", "main"])
        if args.check:
            print(f"  {r:12s} local main {local}")
            continue
        print(f"  {r:12s} pushing {local} -> mirror")
        sh(["git", "-C", os.path.join(root, r), "push", "-q",
            f"ssh://{args.host}{args.mirror}/{r}.git", f"main:refs/heads/main"])
        rc, out, err = remote_sh(args.host, (
            f"cd {args.grid_root}/{r} && git fetch -q origin && "
            f"git checkout -q --detach origin/main && git reset -q --hard origin/main && "
            f"git rev-parse --short HEAD"
        ))
        if rc != 0:
            raise RuntimeError(f"pharos refresh for {r} failed: {err}")
        print(f"  {r:12s} pharos checkout @ {out.strip()}")
    # Static provider siblings: norma+examples are mirrored git repos above.
    # triga (not mirrored) syncs src/ directly so the radix library-home
    # ancestor walk (norma/triga dir) resolves on a fresh checkout.
    for provider in ("triga",):
        src = os.path.join(root, provider, "src")
        if not os.path.isdir(src):
            print(f"  {provider:12s} skip (no {src})")
            continue
        print(f"  {provider:12s} syncing src/ -> {args.grid_root}/{provider}/src")
        rc, out, err = remote_sh(args.host, f"mkdir -p {args.grid_root}/{provider}")
        if rc != 0:
            raise RuntimeError(f"pharos mkdir for {provider} failed: {err}")
        proc = subprocess.run(
            ["rsync", "-a", "--delete", src + "/",
             f"{args.host}:{args.grid_root}/{provider}/src/"],
            capture_output=True, text=True, timeout=600,
        )
        if proc.returncode != 0:
            raise RuntimeError(f"rsync {provider} failed: {proc.stderr.strip()}")
    print("provision complete")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RuntimeError as err:
        print(f"error: {err}", file=sys.stderr)
        sys.exit(2)
