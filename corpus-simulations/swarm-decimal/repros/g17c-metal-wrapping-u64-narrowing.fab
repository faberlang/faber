# G17c: narrowing a wrapping<u64> to a 32-bit integer in a lane kernel (`h % m ↦ u32`) is accepted
# by check and `--device cpu` (prints 0.5 1 49999.5) but not by Metal:
#
#   faber run --device metal repros/g17c-metal-wrapping-u64-narrowing.fab
#   -> E_DEVICE_NONE_ADMITTED ... MIR-to-Metal unsupported: lane kernel conversion other than a
#      32/64-bit number to f32 or an integer widening
#
# Converting the wrapping<u64> straight to `d64` runs on Metal (and on cpu), which is how the port
# turns the remainder into a decimal. The 64-bit to 32-bit step also fails at check time for the
# int and wrapping forms: `(r ↦ int ⊥ 0) - 100000000` is `nucleum_wide_intermediate` plus
# `nucleum_trapping_store` (the range of `r` is not bounded by `h % 200000001`).
@ kernel
@ public
fn k<size N>(tensor<u64, [N]> xs, mut tensor<d64, [N]> o) → void {
    for from xs at [i] thread lane let x {
        let wrapping<u64> w ← x ↦ wrapping<u64>
        let wrapping<u64> r ← w % 200000001
        let u32 q ← r ↦ u32 ⊥ 0
        o[[i]] ← (q ↦ d64) * 0.5
    }
}

main {
    let int n ← 3
    const size N ← n
    let list<u64> xl ← [1, 2, 99999]
    let tensor<u64, [N]> xs ← xl ↦ tensor<u64, [N]>
    let list<d64> ol ← [0.0, 0.0, 0.0]
    mut tensor<d64, [N]> o ← ol ↦ tensor<d64, [N]>
    k(xs, mut o)
    for range 0‥n let i {
        print o[[i]]
    }
}
